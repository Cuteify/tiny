// lexer.cute —— /home/gx/Downloads/dev/lexer/lexer.go 的移植。
//
// 词法分析器：输入源码读入字符串（宿主负责读文件），输出 token 流。
// 结构、命名、逻辑与 Go 参考实现一一对应；约定差异：
//   1. Token/Error 按 *Token/*Error 传递/缓存：本编译器不支持多字段结构体
//      按值返回（docs §15 “结构体按值/多返回值”限制都适用）；
//   2. 字节访问直接用 string[i]（Cute 原生 s[i] 返回 byte），不带 C 指针；
//   3. 下划线删除、进制/浮点解析走 std:strings（replaceAll / parseUint /
//      parseFloat），不重复写到应用层。
//
// 本文件按依赖顺序组织（callee 先于 caller，Cute 方法派发无前向解析）：
// Error、Lexer、NewLexer、TokenCoord、
// consume、makeToken、numberBase、handleNumber、handleComment、
// handleString、Prefetch、Next。
// 字符分类助手（isDigit/isSpaceByte/isIntDigit）已迁入 std:strings；
// 关键字/分隔符表见 buf.cute。
import "std:strings"

// prefetchCap 预取 FIFO 队列的固定长度（8）。队列满时新 token 不入队。
const prefetchCap: int = 8

// Error 词法错误（Pos/Line/Col 为出错 token 的起点）。
type Error struct {
    Pos: int
    Line: int
    Col: int
    Msg: string
}

fn Error.Error(e *Error) string {
    var lc: string = strings.itoa(e.Line) + ":" + strings.itoa(e.Col)
    ret e.Msg + " (at " + lc + ", byte " + strings.itoa(e.Pos) + ")"
}

// Lexer 词法分析器。
type Lexer struct {
    Text: string
    Pos: int    // 字节偏移光标
    Line: int    // 行号
    Col: int    // 列号
    Err: *Error // 首个词法错误；一旦出错，Next 恒返回 NONE

    // 内部扫描游标；宿主使用 Pos/Line/Col。
    pfPos: int
    pfCol: int
    pfLine: int
    pfCache: *RingBuffer
}

// NewLexer 以源文本创建词法分析器。
fn NewLexer(text string) *Lexer {
    var l: *Lexer = new(Lexer)
    l.Text = text
    l.Line = 1
    l.Col = 1
    l.pfLine = 1
    l.pfCol = 1
    l.Pos = 0
    l.pfPos = 0
    l.pfCache = NewRingBuffer(prefetchCap)
    ret l
}

// TokenCoord 构造 consume 用的 token 形态（仅 Pos/EndPos 生效）。
fn TokenCoord(pos int, endPos int) *Token {
    ret Token{Pos: pos, EndPos: endPos}
}

// consume 消费 [start, end) 的字节，推进 pfPos/pfLine/pfCol。
fn Lexer.consume(l *Lexer, t *Token) {
    var text: string = l.Text
    var k: uint = unsafe.cast[uint](t.Pos)
    var end: uint = unsafe.cast[uint](t.EndPos)
    for ; k < end; {
        var b: byte = text[k]
        if unsafe.cast[int](b) == 10 {
            l.pfLine = l.pfLine + 1
            l.pfCol = 1
        } else {
            l.pfCol = l.pfCol + 1
        }
        k = k + 1
    }
    l.pfPos = t.EndPos
}

// makeToken 统一构造 token：行列号（起点、结束）在此单点计算，写入预取缓存并推进光标。
fn Lexer.makeToken(l *Lexer, t *Token) *Token {
    t.Line = l.pfLine
    t.Col = l.pfCol
    l.consume(t)
    t.EndLine = l.pfLine
    t.EndCol = l.pfCol
    l.pfCache.Write(t)
    ret t
}

// numberBase 返回数字进制前缀对应的 base，不是进制前缀则返回 0。
fn numberBase(text string, i int) uint {
    if i + 1 >= unsafe.cast[int](len(text)) {
        ret 0
    }
    if unsafe.cast[int](text[unsafe.cast[uint](i)]) != 48 {
        ret 0
    }
    var c: byte = text[unsafe.cast[uint](i + 1)]
    if unsafe.cast[int](c) == 120 || unsafe.cast[int](c) == 88 {
        ret 16
    }
    if unsafe.cast[int](c) == 98 || unsafe.cast[int](c) == 66 {
        ret 2
    }
    if unsafe.cast[int](c) == 111 || unsafe.cast[int](c) == 79 {
        ret 8
    }
    ret 0
}

// handleNumber 扫描数字 token（0x/0b/0o 进制前缀、十进制、小数、科学计数法）。
fn Lexer.handleNumber(l *Lexer) *Token {
    var text: string = l.Text
    var plen: uint = len(text)
    var i: uint = unsafe.cast[uint](l.pfPos)

    // 进制前缀：0x / 0b / 0o（数字内允许下划线）
    var base: uint = numberBase(text, unsafe.cast[int](i))
    if base != 0 {
        var e: uint = i + 2
        for ; e < plen && (strings.isIntDigit(text[e], base) || unsafe.cast[int](text[e]) == 95); {
            e = e + 1
        }
        var rawText: string = strings.replaceAll(text[i+2:e], "_", "")
        if len(rawText) != 0 {
            vu, vok := strings.parseUint(rawText, base)
            if vok {
                var xnum: uint = vu
                var xstr: string = text[i:e]
                ret l.makeToken(Token{Type: NUMBER, Value: xstr, Number: f64(xnum),
                    Pos: unsafe.cast[int](i), EndPos: unsafe.cast[int](e)})
            }
        }
        // 前缀后无有效数字：退回整词作为 NAME（与 Go 参考一致：
        // “0b2” → NAME|0b2，“0x” → NAME|0x）
        var w: uint = i
        for ; w < plen; {
            var e2: int = 3
            var matched: bool = false
            for ; e2 > 0; {
                if unsafe.cast[int](w) + e2 > unsafe.cast[int](plen) {
                    e2 = e2 - 1
                    continue
                }
                var cand: string = text[w:w+unsafe.cast[uint](e2)]
                if isDelimiter(cand) {
                    matched = true
                    break
                }
                e2 = e2 - 1
            }
            if matched {
                break
            }
            w = w + 1
        }
        var wval: string = text[i:w]
        var wtype: TokenType = NAME
        if isKeyword(wval) {
            wtype = KEYWORD
        }
        ret l.makeToken(Token{Type: wtype, Value: wval,
            Pos: unsafe.cast[int](i), EndPos: unsafe.cast[int](w)})
    }

    // 十进制：整数 / 小数 / 科学计数法
    var e: uint = i
    for ; e < plen && (strings.isDigit(text[e]) || unsafe.cast[int](text[e]) == 95); {
        e = e + 1
    }
    if e < plen && unsafe.cast[int](text[e]) == 46 && e + 1 < plen && strings.isDigit(text[e + 1]) {
        e = e + 2
        for ; e < plen && (strings.isDigit(text[e]) || unsafe.cast[int](text[e]) == 95); {
            e = e + 1
        }
    }
    if e < plen && (unsafe.cast[int](text[e]) == 101 || unsafe.cast[int](text[e]) == 69) {
        var m: uint = e + 1
        if m < plen && (unsafe.cast[int](text[m]) == 43 || unsafe.cast[int](text[m]) == 45) {
            m = m + 1
        }
        if m < plen && strings.isDigit(text[m]) {
            m = m + 1
            for ; m < plen && (strings.isDigit(text[m]) || unsafe.cast[int](text[m]) == 95); {
                m = m + 1
            }
            e = m
        }
    }
    var s: string = strings.replaceAll(text[i:e], "_", "")
    var num: f64 = 0.0
    vf, vok := strings.parseFloat(s)
    if vok {
        num = vf
    }
    var numStr: string = text[i:e]
    ret l.makeToken(Token{Type: NUMBER, Value: numStr, Number: num,
        Pos: unsafe.cast[int](i), EndPos: unsafe.cast[int](e)})
}

// handleComment 处理 // 与 /* */ 注释
fn Lexer.handleComment(l *Lexer, delimiter string) {
    var text: string = l.Text
    var plen: uint = len(text)
    var start: uint = unsafe.cast[uint](l.pfPos)
    if strings.eq(delimiter, "//") {
        // 行注释：保留其后的换行
        var j: uint = start + 2
        for ; j < plen; {
            var b: byte = text[j]
            if unsafe.cast[int](b) == 10 { break }
            j = j + 1
        }
        l.consume(TokenCoord(unsafe.cast[int](start), unsafe.cast[int](j)))
        ret
    }
    // 块注释：/* ... */（非嵌套，可跨行）
    var j: uint = start + 2
    for ; j + 1 < plen; {
        var b: byte = text[j]
        var b2: byte = text[j + 1]
        if unsafe.cast[int](b) == 42 && unsafe.cast[int](b2) == 47 { break }
        j = j + 1
    }
    if j + 1 < plen {
        l.consume(TokenCoord(unsafe.cast[int](start), unsafe.cast[int](j + 2)))
        ret
    }
    // 未闭合：消费到文件尾（行列随之推进）
    l.consume(TokenCoord(unsafe.cast[int](start), unsafe.cast[int](plen)))
}

// handleString 处理字符串、字符、裸串
fn Lexer.handleString(l *Lexer, delimiter string) *Token {
    var text: string = l.Text
    var plen: uint = len(text)
    var q: byte = text[unsafe.cast[uint](l.pfPos)]
    var start: uint = unsafe.cast[uint](l.pfPos)
    var dl: uint = len(delimiter)

    var i: uint = start + dl
    for ; i < plen; {
        if unsafe.cast[int](q) != 96 && unsafe.cast[int](text[i]) == 10 {
            panic(delimiter + strings.fromByte(unsafe.cast[u8](text[i])))
        }
        if unsafe.cast[int](text[i]) == unsafe.cast[int](q) {
            var str: string = text[start + dl:i]
            if unsafe.cast[int](q) == 39 && len(str) != 1 && !(len(str) >= 1 && unsafe.cast[int](str[0]) == 92) {
                panic("")
            }
            ret l.makeToken(Token{Type: STRING, Value: str,
                Pos: unsafe.cast[int](start), EndPos: unsafe.cast[int](i + dl)})
        }
        i = i + 1
    }
    // 未闭合：消费到文件尾
    l.consume(TokenCoord(unsafe.cast[int](start), unsafe.cast[int](plen)))
    var te: *Token = Token{Type: NONE, Value: "", Line: l.pfLine, Col: l.pfCol}
    ret te
}

// Prefetch 预取
fn Lexer.Prefetch(l *Lexer) *Token {
    var plen: uint = len(l.Text)

    // 跳过空白（Go 参考 SkipSep 语义：仅空格与 Tab；换行是 DELIMITER，必须保留）
    var i: uint = unsafe.cast[uint](l.pfPos)
    for ; i < plen; {
        var ib: int = unsafe.cast[int](l.Text[i])
        if ib == 32 || ib == 9 {
            i = i + 1
            continue
        }
        break
    }
    l.consume(TokenCoord(l.pfPos, unsafe.cast[int](i)))
    if unsafe.cast[uint](l.pfPos) >= plen {
        // EOF
        var t: *Token = Token{Type: NONE, Value: "", Line: l.pfLine, Col: l.pfCol}
        ret t
    }

    var firstByte: byte = l.Text[unsafe.cast[uint](l.pfPos)]
    // secondByte 前置加载须先确认越界，否则文本以 "." 结尾时会读 Text[plen]：
    // 与 Go 参考短路 && 的行为对齐。
    var secondByte: byte = unsafe.cast[byte](0)
    if unsafe.cast[uint](l.pfPos) + 1 < plen {
        secondByte = l.Text[unsafe.cast[uint](l.pfPos) + 1]
    }
    if strings.isDigit(firstByte) || (unsafe.cast[int](firstByte) == 46 && unsafe.cast[uint](l.pfPos) + 1 < plen && strings.isDigit(secondByte)) {
        ret l.handleNumber()
    }

    // 主循环
    i = unsafe.cast[uint](l.pfPos)
    for ; i < plen; {
        // 找到分隔符
        var delimLen: int = 0
        var e: int = 3
        for ; e > 0; {
            if unsafe.cast[int](i) + e > unsafe.cast[int](plen) {
                e = e - 1
                continue
            }
            var cand: string = l.Text[i:i + unsafe.cast[uint](e)]
            if isDelimiter(cand) {
                delimLen = e
                break
            }
            e = e - 1
        }
        if delimLen == 0 {
            i = i + 1
            continue
        }

        // 处理注释
        var delimiter: string = l.Text[i:i + unsafe.cast[uint](delimLen)]
        if strings.eq(delimiter, "//") || strings.eq(delimiter, "/*") {
            l.handleComment(delimiter)
            ret l.Prefetch()
        }

        // 处理字符串
        if len(delimiter) == 1 && (unsafe.cast[int](delimiter[0]) == 96 || unsafe.cast[int](delimiter[0]) == 39 || unsafe.cast[int](delimiter[0]) == 34) {
            ret l.handleString(delimiter)
        }

        if unsafe.cast[int](i) > l.pfPos {
            // 词素 token（NAME / KEYWORD）
            var val: string = l.Text[unsafe.cast[uint](l.pfPos):i]
            var tokenTyp: TokenType = NAME
            if isKeyword(val) {
                tokenTyp = KEYWORD
            }
            ret l.makeToken(Token{Type: tokenTyp, Value: val,
                Pos: l.pfPos, EndPos: unsafe.cast[int](i)})
        }

        // delimiter token
        ret l.makeToken(Token{Type: DELIMITER, Value: delimiter,
            Pos: l.pfPos, EndPos: unsafe.cast[int](i + unsafe.cast[uint](delimLen))})
    }
    // 主循环因 EOF 退出：结尾的词法 token 需要单独处理
    if unsafe.cast[int](i) > l.pfPos {
        var val: string = l.Text[unsafe.cast[uint](l.pfPos):i]
        var tokenTyp2: TokenType = NAME
        if isKeyword(val) {
            tokenTyp2 = KEYWORD
        }
        ret l.makeToken(Token{Type: tokenTyp2, Value: val,
            Pos: l.pfPos, EndPos: unsafe.cast[int](i)})
    }
    var te: *Token = Token{Type: NONE, Value: "", Line: l.pfLine, Col: l.pfCol}
    ret te
}

// Next 返回下一个 token；缓存读穿或预取。
fn Lexer.Next(l *Lexer) *Token {
    // hit == 0 表示缓存空（无可弹出的 token）
    var hit: *Token = l.pfCache.Read()
    if unsafe.cast[uint](hit) != 0 {
        l.Pos = hit.EndPos
        l.Line = hit.EndLine
        l.Col = hit.EndCol
        ret hit
    }
    var tok: *Token = l.Prefetch()
    if tok.Type == NONE {
        // EOF
        l.Pos = l.pfPos
        l.Line = l.pfLine
        l.Col = l.pfCol
        ret tok
    }
    // 语义差异（与 Go 参考一处差异，见 README）：
    // makeToken 既把 token 写入预取缓存、又把它返回给调用者；若不弹出，
    // 纯 Next() 循环会把每个词素返回两次。这里弹出刚写入的这份副本，
    // 使 Next() 成为纯消费 API；Prefetch() 本身仍是预取扫描（与 Go main 一致）。
    var dropT: *Token = l.pfCache.Read()
    if unsafe.cast[uint](dropT) == 0 {
        // 缓存满了或已被弹出：防御性分支，直接返回新 token 即可
        l.Pos = tok.EndPos
        l.Line = tok.EndLine
        l.Col = tok.EndCol
        ret tok
    }
    l.Pos = tok.EndPos
    l.Line = tok.EndLine
    l.Col = tok.EndCol
    ret tok
}
