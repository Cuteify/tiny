// Cuteify 自举 lexer（token 流对拍驱动）。
//
// 读取环境变量 SELFTEST_CASE 指向的源文件，按 Go 参考 main.go 的格式逐行输出
// [TYPE]value；空白/注释不产生 token。空源文件也必须能正常读完并输出零 token。
// 对拍（与 .want 逐字节比较）由 scripts/selfhost_test.sh 完成，本程序不自带断言。
//
// 运行（仓库根目录）：
//   SELFTEST_CASE=selfhost/lex/testdata/sample.cute ./main
// 期望：与 Go 参考 main.go 对 sample.cute 的输出逐字节一致（104 行 [TYPE]value）。
import "std:console"
import "std:memory"
import "std:strings"
import "std:syscall"
import lex "../"

// nl 在运行时构造只含换行字节（10）的字符串（源码里的 \n 是两字符反斜杠+n；
// console 没有实装该字节，用 syscall 写出真换行）。
fn nl() string {
    var p: ptr = memory.malloc(1)
    var q: *u8 = p
    *q = 10
    ret strings.makeString(p, 1, 1)
}

// getenvStr 从 /proc/self/environ 读取环境变量（见 std:syscall.getenv）。
fn getenvStr(name string) string {
    var p: ptr = syscall.getenv(strings.toCstring(name), unsafe.cast[u64](len(name)))
    if p == unsafe.cast[ptr](0) {
        ret ""
    }
    var l: uint = 0
    for ; ; {
        var q: *u8 = p + l
        if *q == 0 {
            break
        }
        l = l + 1
    }
    ret strings.makeString(p, l, l)
}

fn main() int {
    var path: string = getenvStr("SELFTEST_CASE")
    if len(path) == 0 {
        console.print("LEXER_SELFTEST|USAGE: 需要 SELFTEST_CASE=<源文件路径>")
        console.print(nl())
        ret 2
    }
    var fd: i32 = syscall.open(strings.toCstring(path), 0, 0) // O_RDONLY
    if fd < 0 {
        console.print("LEXER_SELFTEST|READ_FAIL|")
        console.print(path)
        console.print(nl())
        ret 2
    }
    var buf: ptr = memory.malloc(65536)
    var pos: uint = 0
    for ; pos < 65536; {
        var n: i32 = syscall.read(fd, buf + pos, 65536 - pos)
        if n <= 0 {
            break
        }
        pos = pos + unsafe.cast[uint](n)
    }
    syscall.close(fd)
    var src: string = strings.makeString(buf, pos, pos)
    var l: *lex.Lexer = lex.NewLexer(src)
    for ; true; {
        var t: *lex.Token = l.Next()
        if t.Type == lex.NONE {
            break
        }
        console.print(lex.Token.String(t))
        console.print(nl())
    }
    ret 42
}
