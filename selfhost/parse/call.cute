// call.cute —— 调用参数 / 函数签名 / 返回值类型解析；含泛型参数 f[T]。
// 加载顺序：依赖 exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"
fn ExpBlock.prec(  s string) int {
    // 字符串 switch：自 2026-11-17 起与 == 等价（std:strings.eq 内容比较，
    // 不再按字符串视图指针比对——token Value 是源缓冲区视图，pointer cmp 永远不命中）。
    switch s {
    case "||":
        ret 1
    case "&&":
        ret 2
    case "==", "!=":
        ret 3
    case "<", "<=", ">", ">=":
        ret 4
    case "|":
        ret 5
    case "^":
        ret 6
    case "&":
        ret 7
    case "<<", ">>":
        ret 9
    case "+", "-":
        ret 10
    case "*", "/", "%":
        ret 11
    default:
        ret 0
    }
}

// parsePrimaryKeyword 处理 true/false/nil 关键字；非此三字时记 EEXPR。
fn ExpBlock.parsePrimaryKeyword(x *Parser, t *lex.Token) bool {
    var fileBlock: FileBlock
    if strings.eq(t.Value, "true") || strings.eq(t.Value, "false") || strings.eq(t.Value, "nil") {
        x.exprs = x.exprs + 1
        x.l.next()
        ret true
    }
    fileBlock.fail( x, EEXPR, t.Pos)
    ret false
}

// parsePrimaryName 处理单个 NAME：NAME{...} 结构体字面量需 NAME 与 '{' 严格相邻。
fn ExpBlock.parsePrimaryName(x *Parser, t *lex.Token) bool {
    var fileBlock: FileBlock
    x.exprs = x.exprs + 1
    x.l.next()
    x.lastName = t.Value
    var p: *lex.Token = x.l.peek()
    // S4 Useful：裸名紧邻 '(' → 视为对该全局函数的调用，标记。
    if p.is( lex.DELIMITER, "(") {
        fileBlock.markUse( x, t.Value)
    }
    var lp: ExpBlock
    if p.is( lex.DELIMITER, "{") && unsafe.cast[int](p.Pos) == t.EndPos {
        ret lp.parseStructLit( x)
    }
    ret true
}

// parsePrimaryParen 处理括号分组表达式。
fn ExpBlock.parsePrimaryParen(x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    x.l.skipTerminators()
    if !ExpBlock.parseExpr( x) {
        ret false
    }
    x.l.skipTerminators()
    if !fileBlock.expect( x, lex.DELIMITER, ")", EEXPR) {
        ret false
    }
    x.exprs = x.exprs + 1
    ret true
}

// parseCompositePrimary 处理 []T{...} / [N]T{...} / map[K]V{...} 复合字面量。
fn ExpBlock.parseCompositePrimary(x *Parser) bool {
    if !ExpBlock.parseCompositeType( x) {
        ret false
    }
    x.l.skipTerminators()
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "{") {
        x.exprs = x.exprs + 1
        ret ExpBlock.parseCompositeElems( x)
    }
    // 类型本身作为表达式实参，如 new([]int, 8)
    x.exprs = x.exprs + 1
    ret true
}

// isPrimaryKeywordValue 判断 token 是否为值型关键字（true/false/nil）。
fn ExpBlock.isPrimaryKeywordValue(  v string) bool {
    ret strings.eq(v, "true") || strings.eq(v, "false") || strings.eq(v, "nil")
}
fn ExpBlock.parsePrimary(x *Parser) bool {
    var fileBlock: FileBlock
    x.l.skipTerminators()
    var t: *lex.Token = x.l.peek()
    if t == nil {
        fileBlock.fail( x, EEXPR, 0)
        ret false
    }
    if t.Type == lex.NUMBER || t.Type == lex.STRING {
        x.exprs = x.exprs + 1
        x.l.next()
        ret true
    }
    if t.Type == lex.KEYWORD {
        ret ExpBlock.parsePrimaryKeyword( x, t)
    }
    if t.Type == lex.NAME {
        ret ExpBlock.parsePrimaryName( x, t)
    }
    if t.is( lex.DELIMITER, "(") {
        ret ExpBlock.parsePrimaryParen( x)
    }
    if t.is( lex.DELIMITER, "[") || strings.eq(t.Value, "map") {
        ret ExpBlock.parseCompositePrimary( x)
    }
    fileBlock.fail( x, EEXPR, t.Pos)
    ret false
}

// parseCompositeType 消费 []T / [N]T / map[K]V 前缀（不消耗 {）。
// 反向不构建 AST。
// parseMapTypeHead 解析 map[K]V 类型前缀（NAME "map" 已 peek、未消费）。
fn ExpBlock.parseMapTypeHead(  x *Parser) bool {
    var fileBlock: FileBlock
    var typeBlock: TypeBlock
    x.l.next()
    if !fileBlock.expect( x, lex.DELIMITER, "[", ETYPE) {
        ret false
    }
    if !typeBlock.skipType( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, "]", ETYPE) {
        ret false
    }
    ret typeBlock.skipType( x)
}

// parseArrayTypeHead 解析切片 []T 与定长数组 [N]T 类型前缀（`[` 已 peek、未消费）。
fn ExpBlock.parseArrayTypeHead(  x *Parser) bool {
    var fileBlock: FileBlock
    var typeBlock: TypeBlock
    x.l.next()
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "]") {
        x.l.next()
        ret typeBlock.skipType( x)
    }
    var num: *lex.Token = x.l.next()
    if num == nil || num.Type != lex.NUMBER {
        if num == nil {
            fileBlock.fail( x, ETYPE, 0)
        } else {
            fileBlock.fail( x, ETYPE, num.Pos)
        }
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, "]", ETYPE) {
        ret false
    }
    ret typeBlock.skipType( x)
}
fn ExpBlock.parseCompositeType(x *Parser) bool {
    var fileBlock: FileBlock
    x.l.skipTerminators()
    var t: *lex.Token = x.l.peek()
    if t.Type == lex.NAME && strings.eq(t.Value, "map") {
        ret ExpBlock.parseMapTypeHead( x)
    }
    if t.is( lex.DELIMITER, "[") {
        ret ExpBlock.parseArrayTypeHead( x)
    }
    fileBlock.fail( x, ETYPE, t.Pos)
    ret false
}

// parseCompositeElems 解析 { 元素, ... }（已消耗 { 的前提下）。
fn ExpBlock.parseCompositeElems(x *Parser) bool {
    var fileBlock: FileBlock
    if !fileBlock.expect( x, lex.DELIMITER, "{", EEXPR) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t.is( lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if !ExpBlock.parseExpr( x) {
            ret false
        }
        var t2: *lex.Token = x.l.peek()
        if t2.is( lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
        if t2.is( lex.DELIMITER, "}") {
            continue
        }
        fileBlock.fail( x, EEXPR, t2.Pos)
        ret false
    }
}

// parsePostfix 后缀消歧：索引/切片/选择器/调用，循环到非后缀 token。
// parseSelectorSuffix 解析 .name（选择器）。
fn ExpBlock.parseSelectorSuffix(  x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    var t2: *lex.Token = fileBlock.expectName( x, EEXPR)
    if t2 == nil {
        ret false
    }
    // S4 Useful：Receiver 是已登记类型且其后紧接 '(' → 限定名调用，
    // 按 "Type.method" 限定标记（跨包方法同限定名，这里精确命中自身登记）。
    var ln: string = x.lastName
    var t2v: string = t2.Value
    var tpeek: *lex.Token = x.l.peek()
    if ln != "" && tpeek.is(lex.DELIMITER, "(") {
        fileBlock.markUse( x, ln + "." + t2v)
    }
    // 裸名也标记（当限定名未登记命中而裸名恰好是全局函数时——保守兜底）。
    fileBlock.markUse( x, t2v)
    x.lastName = t2v
    ret true
}

// consumeSliceBoundEnd 判断当前到 ']' 或 ':' 为止：若不是，consume expr；其他接受。
fn ExpBlock.consumeSliceBoundEnd(x *Parser) bool {
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "]") {
        ret true
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, ":") {
        ret true
    }
    ret ExpBlock.parseExpr( x)
}

// parseIndexSuffix 处理 [i] / [i:j] / [i:] / [:j] / [i:j:step]
fn ExpBlock.parseIndexSuffix(x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    x.l.skipTerminators()
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, ":") {
        x.l.next()
        if !ExpBlock.consumeSliceBoundEnd( x) {
            ret false
        }
        ret fileBlock.expect( x, lex.DELIMITER, "]", EEXPR)
    }
    if !ExpBlock.parseExpr( x) {
        ret false
    }
    var tpeek: *lex.Token = x.l.peek()
    if !tpeek.is(lex.DELIMITER, ":") {
        ret fileBlock.expect( x, lex.DELIMITER, "]", EEXPR)
    }
    x.l.next()
    if !ExpBlock.consumeSliceBoundEnd( x) {
        ret false
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, ":") {
        x.l.next()
        if !ExpBlock.consumeSliceBoundEnd( x) {
            ret false
        }
    }
    ret fileBlock.expect( x, lex.DELIMITER, "]", EEXPR)
}
fn ExpBlock.parsePostfix(x *Parser) bool {
    if !ExpBlock.parsePrimary( x) {
        ret false
    }
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if t.is( lex.DELIMITER, ".") {
            if !ExpBlock.parseSelectorSuffix( x) {
                ret false
            }
            continue
        }
        if t.is( lex.DELIMITER, "[") {
            if !ExpBlock.parseIndexSuffix( x) {
                ret false
            }
            continue
        }
        if t.is( lex.DELIMITER, "(") {
            var cb: CallBlock
            if !cb.parseCallArgs( x) {
                ret false
            }
            continue
        }
        break
    }
    ret true
}

// parseUnary 解析前缀一元运算符（! - ~ * & + ^）。
fn ExpBlock.parseUnary(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    var isUnary: bool = false
    if t.is( lex.DELIMITER, "!") {
        isUnary = true
    } else if t.is( lex.DELIMITER, "-") {
        isUnary = true
    } else if t.is( lex.DELIMITER, "~") {
        isUnary = true
    } else if t.is( lex.DELIMITER, "*") {
        isUnary = true
    } else if t.is( lex.DELIMITER, "&") {
        isUnary = true
    } else if t.is( lex.DELIMITER, "+") {
        isUnary = true
    } else if t.is( lex.DELIMITER, "^") {
        isUnary = true
    }
    if isUnary {
        x.l.next()
        ret ExpBlock.parseUnary( x)
    }
    if !ExpBlock.parsePostfix( x) {
        ret false
    }
    ret true
}

// parseBinaryExpr 优先级攀升；minPrec 以下的算符停止。
fn ExpBlock.parseBinaryExpr(x *Parser, minPrec int) bool {
    if !ExpBlock.parseUnary( x) {
        ret false
    }
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if t == nil || t.Type != lex.DELIMITER {
            break
        }
        var p: int = ExpBlock.prec( t.Value)
        if p == 0 || p < minPrec {
            break
        }
        x.l.next()
        if !ExpBlock.parseBinaryExpr( x, p + 1) {
            ret false
        }
    }
    ret true
}

// parseExpr 表达式入口。
fn ExpBlock.parseExpr(x *Parser) bool {
    ret ExpBlock.parseBinaryExpr( x, 1)
}

// isOpenBracket 参数默认值的开括号。
fn CallBlock.isOpenBracket(  v string) bool {
    ret strings.eq(v, "(") || strings.eq(v, "[") || strings.eq(v, "{")
}

// isCloseBracket 形态深度的收尾括号（']'/'}'）。
fn CallBlock.isCloseBracket(  v string) bool {
    ret strings.eq(v, "]") || strings.eq(v, "}")
}

// isCloseDelim 形态深度 0 时，默认值分隔符（','/NL/CR）。
fn CallBlock.isCloseDelim(  v string, depth int) bool {
    if depth != 0 {
        ret false
    }
    if strings.eq(v, ",") {
        ret true
    }
    ret unsafe.cast[int](v[0]) == 10 || unsafe.cast[int](v[0]) == 13
}

// dispatchDefaultDelim 对分隔符分档：1=深 2=括-sub 3=括-clos 4=其他 0=收尾。
fn CallBlock.dispatchDefaultDelim(v string, depth int) int {
    if CallBlock.isOpenBracket( v) {
        ret 1
    }
    if strings.eq(v, ")") {
        if depth == 0 {
            ret 0
        }
        ret 2
    }
    if CallBlock.isCloseBracket( v) {
        ret 3
    }
    if CallBlock.isCloseDelim( v, depth) {
        ret 0
    }
    ret 4
}

// consumeParamDefaultValue 消费 `= expr` 的默认值：括号深度记录使多项式式默认值不误断。
fn CallBlock.consumeParamDefaultValue(x *Parser) bool {
    x.l.next()
    var depth: int = 0
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if t == nil || t.Type == lex.NONE {
            ret true
        }
        if t.Type == lex.DELIMITER {
            var kind: int = CallBlock.dispatchDefaultDelim( t.Value, depth)
            if kind == 0 {
                ret true
            }
            if kind == 1 {
                depth = depth + 1
            } else if kind == 2 {
                depth = depth - 1
            } else if kind == 3 {
                if depth > 0 {
                    depth = depth - 1
                }
            }
            x.l.next()
            continue
        }
        x.l.next()
    }
}

// parseParamTypeAfterName 参数类型段：name [...] | name : T | name Type，省略类型时 name 即必须有默认。
fn CallBlock.parseParamTypeAfterName(  x *Parser) bool {
    var typeBlock: TypeBlock
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "...") {
        x.l.next()
        ret typeBlock.skipType( x)
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, ":") {
        x.l.next()
        ret typeBlock.skipType( x)
    }
    ret typeBlock.skipType( x)
}

// parseParamVariadic 变参无名形态：...T，必须到 ')' 为止，否则报错。
fn CallBlock.parseParamVariadic(  x *Parser) bool {
    var typeBlock: TypeBlock
    x.l.next()
    if !typeBlock.skipType( x) {
        ret false
    }
    var tpeek: *lex.Token = x.l.peek()
    ret tpeek.is(lex.DELIMITER, ")")
}

// parseParamOne 解析一个参数段（'...T' 无名或 'name [typeExpr]'）。
fn CallBlock.parseParamOne(x *Parser) bool {
    var fileBlock: FileBlock
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "...") {
        ret CallBlock.parseParamVariadic( x)
    }
    var nameT: *lex.Token = x.l.next()
    if nameT == nil || nameT.Type != lex.NAME {
        if (nameT) {
            fileBlock.fail( x, EDECL, nameT.Pos)
        } else {
            fileBlock.fail( x, EDECL, 0)
        }
        ret false
    }
    ret CallBlock.parseParamTypeAfterName( x)
}

// consumeParamSeparator 每参之后的分隔符：) 收尾 / , 进入下一参 / 换行继续。
fn CallBlock.consumeParamSeparator(  x *Parser) bool {
    var pSep: *lex.Token = x.l.peek()
    if pSep.is( lex.DELIMITER, ")") {
        ret true
    }
    if pSep.is( lex.DELIMITER, ",") {
        x.l.next()
        ret true
    }
    if pSep != nil && pSep.Type == lex.DELIMITER && (unsafe.cast[int](pSep.Value[0]) == 10 || unsafe.cast[int](pSep.Value[0]) == 13) {
        ret true
    }
    ret false
}

// parseFuncParams 参数列表主循环：')' 收尾，每个参数可带默认值。
// 可选接收者前言：`self`（值接收者）或 `&self`（指针接收者）；与 Go 版 parser 语义一致。
// 自举解析器不校验接收者后的参数类型（语料按超集接受）；语义严格检查由 Go 编译器做。
fn CallBlock.parseFuncParams(x *Parser) bool {
    var fileBlock: FileBlock
    var t0: *lex.Token = x.l.peek()
    var receiverSeen: bool = false
    if t0.is(lex.NAME, "self") {
        // 值接收者：仅 'self'
        x.l.next()
        receiverSeen = true
    } else if t0.is(lex.DELIMITER, "&") {
        // 指针接收者：'&' + 'self'
        x.l.next()
        var t2: *lex.Token = x.l.peek()
        if !t2.is(lex.NAME, "self") {
            fileBlock.fail( x, EDECL, t2.Pos)
            ret false
        }
        x.l.next()
        receiverSeen = true
    }
    if receiverSeen {
        var pSep: *lex.Token = x.l.peek()
        if pSep.is(lex.DELIMITER, ")") {
            x.l.next()
            ret true
        }
        if !pSep.is(lex.DELIMITER, ",") {
            if pSep != nil {
                fileBlock.fail( x, EDECL, pSep.Pos)
            } else {
                fileBlock.fail( x, EDECL, 0)
            }
            ret false
        }
        x.l.next()
    }
    for ; ; {
        x.l.skipTerminators()
        var tpeek: *lex.Token = x.l.peek()
        if tpeek.is(lex.DELIMITER, ")") {
            x.l.next()
            ret true
        }
        if !CallBlock.parseParamOne( x) {
            ret false
        }
        var tpeek: *lex.Token = x.l.peek()
        if tpeek.is(lex.DELIMITER, "=") {
            if !CallBlock.consumeParamDefaultValue( x) {
                ret false
            }
        }
        if !CallBlock.consumeParamSeparator( x) {
            ret false
        }
    }
}

// consumeCallArgsTail 逗号分隔的实参尾巴（可省略，“...” 为 spread）。
fn CallBlock.consumeCallArgsTail(  x *Parser) bool {
    var fileBlock: FileBlock
    var t2: *lex.Token = x.l.peek()
    if t2.is( lex.DELIMITER, ",") || t2.is( lex.DELIMITER, "...") {
        x.l.next()
        ret true
    }
    if t2.is( lex.DELIMITER, ")") {
        ret true
    }
    if t2 == nil || t2.Type == lex.NONE {
        fileBlock.fail( x, EEXPR, 0)
        ret false
    }
    fileBlock.fail( x, EEXPR, t2.Pos)
    ret false
}
fn CallBlock.parseCallArgs(x *Parser) bool {
    var fileBlock: FileBlock
    if !fileBlock.expect( x, lex.DELIMITER, "(", EEXPR) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var tpeek: *lex.Token = x.l.peek()
        if tpeek.is(lex.DELIMITER, ")") {
            x.l.next()
            ret true
        }
        var eb: ExpBlock
        if !eb.parseExpr( x) {
            ret false
        }
        if !CallBlock.consumeCallArgsTail( x) {
            ret false
        }
    }
}

// parseRetTypes 解析函数的返回值类型列表。
fn CallBlock.parseRetTypes(  x *Parser) bool {
    var typeBlock: TypeBlock
    var t: *lex.Token = x.l.peek()
    if t.isLineEnd() {
        ret true
    }
    if t.is( lex.DELIMITER, "{") {
        ret true
    }
    if t.is( lex.DELIMITER, "(") {
        x.l.next()
        for ; ; {
            x.l.skipTerminators()
            var p: *lex.Token = x.l.peek()
            if p.is( lex.DELIMITER, ")") {
                x.l.next()
                ret true
            }
            if !typeBlock.skipType( x) {
                ret false
            }
            var p2: *lex.Token = x.l.peek()
            if p2.is( lex.DELIMITER, ",") {
                x.l.next()
                continue
            }
            var p3: *lex.Token = x.l.peek()
            if p3.is( lex.DELIMITER, ")") {
                continue
            }
            ret false
        }
    }
    ret typeBlock.skipType( x)
}


