// call.cute —— 调用参数 / 函数签名 / 返回值类型解析；含泛型参数 f[T]。
// 加载顺序：依赖 exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

fn parseFuncParams(x *Parser) bool {
    for ; ; {
        skipTerminators(x)
        var p: *lex.Token = peek(x)
        if isTok(p, lex.DELIMITER, ")") {
            next(x)
            ret true
        }
        // 变参 ...T（无名）
        if isTok(p, lex.DELIMITER, "...") {
            next(x)
            if !skipType(x) {
                ret false
            }
            var pEnd: *lex.Token = peek(x)
            if isTok(pEnd, lex.DELIMITER, ")") {
                continue
            }
            ret false
        }
        // 具名参数 name ... / name: Type / name Type
        var nameT: *lex.Token = next(x)
        if isNilTok(nameT) || nameT.Type != lex.NAME {
            if (nameT) {
                fail(x, EDECL, nameT.Pos)
            } else {
                fail(x, EDECL, 0)
            }
            ret false
        }
        // 变参具名形式 name ...Type
        var pVar: *lex.Token = peek(x)
        if isTok(pVar, lex.DELIMITER, "...") {
            next(x)
            if !skipType(x) {
                ret false
            }
        } else if isTok(pVar, lex.DELIMITER, ":") {
            next(x)
            if !skipType(x) {
                ret false
            }
        } else {
            // 裸类型：name Type
            if !skipType(x) {
                ret false
            }
        }
        // 默认值 = expr：跳过到 ',' 或 ')'
        var pDef: *lex.Token = peek(x)
        if isTok(pDef, lex.DELIMITER, "=") {
            next(x)
            var depth: int = 0
            for ; ; {
                var t: *lex.Token = peek(x)
                if isNilTok(t) {
                    ret true
                }
                if t.Type == lex.NONE {
                    ret true
                }
                if t.Type == lex.DELIMITER {
                    if strings.eq(t.Value, "(") || strings.eq(t.Value, "[") || strings.eq(t.Value, "{") {
                        depth = depth + 1
                    } else if strings.eq(t.Value, ")") {
                        if depth == 0 {
                            break
                        }
                        depth = depth - 1
                    } else if strings.eq(t.Value, "]") || strings.eq(t.Value, "}") {
                        if depth > 0 {
                            depth = depth - 1
                        }
                    } else if strings.eq(t.Value, ",") && depth == 0 {
                        break
                    } else if unsafe.cast[int](t.Value[0]) == 10 && depth == 0 {
                        break
                    }
                }
                next(x)
            }
        }
        // 分隔符
        var pSep: *lex.Token = peek(x)
        if isTok(pSep, lex.DELIMITER, ")") {
            continue
        }
        if isTok(pSep, lex.DELIMITER, ",") {
            next(x)
            continue
        }
        // 最后一参之后的行尾：允许换行（参数跨行）
        if !isNilTok(pSep) && pSep.Type == lex.DELIMITER && (unsafe.cast[int](pSep.Value[0]) == 10 || unsafe.cast[int](pSep.Value[0]) == 13) {
            continue
        }
        ret false
    }
}


// ============ M2：表达式与语句 ============

// prec 二元运算符优先级（低值先结合；与 S3 opTable 一致）。
fn parseCallArgs(x *Parser) bool {
    if !expect(x, lex.DELIMITER, "(", EEXPR) {
        ret false
    }
    for ; ; {
        skipTerminators(x)
        var t: *lex.Token = peek(x)
        if isTok(t, lex.DELIMITER, ")") {
            next(x)
            ret true
        }
        if !parseExpr(x) {
            ret false
        }
        var t2: *lex.Token = peek(x)
        if isTok(t2, lex.DELIMITER, ",") {
            next(x)
            continue
        }
        if isTok(t2, lex.DELIMITER, ")") {
            continue
        }
        if isTok(t2, lex.DELIMITER, "...") {
            next(x)
            continue
        }
        var t3: *lex.Token = peek(x)
        if isNilTok(t3) || t3.Type == lex.NONE {
            fail(x, EEXPR, 0)
            ret false
        }
        fail(x, EEXPR, t3.Pos)
        ret false
    }
}

// ============ 语句 ============

// blockStmt 解析 { 语句 }；消费并配平花括号。
fn parseRetTypes(x *Parser) bool {
    var t: *lex.Token = peek(x)
    // 无返回值：换行或 directamente '{' / EOF
    if isLineEnd(t) {
        ret true
    }
    if isTok(t, lex.DELIMITER, "{") {
        ret true
    }
    if isTok(t, lex.DELIMITER, "(") {
        next(x)
        for ; ; {
            skipTerminators(x)
            var p: *lex.Token = peek(x)
            if isTok(p, lex.DELIMITER, ")") {
                next(x)
                ret true
            }
            if !skipType(x) {
                ret false
            }
            var p2: *lex.Token = peek(x)
            if isTok(p2, lex.DELIMITER, ",") {
                next(x)
                continue
            }
            var p3: *lex.Token = peek(x)
            if isTok(p3, lex.DELIMITER, ")") {
                continue
            }
            ret false
        }
    }
    // 单返回值类型
    ret skipType(x)
}




// parseStructBody 解析结构体体（type X struct / 裸 struct X 复用）。
// structs 计数由调用方做。

