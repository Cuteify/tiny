// parser.cute —— Parser 类型、入口 file()、顶层关键字分派、FileBlock。
import "std:strings"
import "../lexer"
import "std:console"

type Parser struct {
	Block      :*Node
	ThisBlock         :*Node
	Lexer             :*lexer.Lexer
}

fn newParser(lex *lexer.Lexer) *Parser {
    ret &Parser{Lexer: lex} 
}

fn Parser.next(&self) bool {
	t := self.Lexer.prefetch()
	if t.Type == lexer.KEYWORD {
		switch t.Value {
			case "fn":
				f := FnBlock{}
				f.parse(self)
		}
		console.println(t.string())
	}
	//console.println(t.string())
	ret t.Type == lexer.NONE
}