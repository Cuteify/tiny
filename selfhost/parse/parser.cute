// parser.cute —— Parser 类型、入口 file()、顶层关键字分派、FileBlock。
import "std:strings"
import lex "../lexer"

type FileBlock struct {
}

fn mk(src string) *Parser {
    var x: *Parser = new(Parser)
    x.l = lex.newLexer(src)
    x.e = OK
    x.ep = 0
    x.decls = 0
    x.imports = 0
    x.builds = 0
    x.structs = 0
    x.enums = 0
    x.consts = 0
    x.vars = 0
    x.fns = 0
    x.stmts = 0
    x.exprs = 0
    x.root = new(Node)
    ret x
}

// err 返回首个错误码（OK 表示无错误）。
fn err(x *Parser) int {
    ret x.e
}

// errPos 返回首个错误的字节位置。
fn errPos(x *Parser) uint {
    ret x.ep
}

// declCount 返回顶层声明数（import/build/fn/type/enum/var/const 均计入）。
fn declCount(x *Parser) int {
    ret x.decls
}

// importCount 返回 import 数（分组每个成员算一条）。
fn importCount(x *Parser) int {
    ret x.imports
}

// buildCount 返回 build 数。
fn buildCount(x *Parser) int {
    ret x.builds
}

// structCount 返回 struct 数（含 type X struct 与旧式 struct X）。
fn structCount(x *Parser) int {
    ret x.structs
}

// enumCount 返回 enum 数。
fn enumCount(x *Parser) int {
    ret x.enums
}

// fnCount 返回函数声明数。
fn fnCount(x *Parser) int {
    ret x.fns
}

// varCount 返回 var 声明数。
fn varCount(x *Parser) int {
    ret x.vars
}

// constCount 返回 const 声明数。
fn constCount(x *Parser) int {
    ret x.consts
}

// stmtCount 返回语句数（块内语句）；M2 前恒为 0。
fn stmtCount(x *Parser) int {
    ret x.stmts
}

// exprCount 返回表达式数；M2 前恒为 0。
fn exprCount(x *Parser) int {
    ret x.exprs
}

// fail 记录首个错误（不覆盖已记录的错误）。
fn fail(x *Parser, e int, pos int) {
    if x.e != OK {
        ret
    }
    x.e = e
    x.ep = unsafe.cast[uint](pos)
}

// dispatchSimpleKeyword 处理具名关键字（import/build/fn/struct/enum）。
fn dispatchSimpleKeyword(x *Parser, kw string) bool {
    if strings.eq(kw, "import") { ret parseImportFromKeyword(x) }
    if strings.eq(kw, "build") { ret parseBuildFromKeyword(x) }
    if strings.eq(kw, "fn") { ret parseFnFromKeyword(x) }
    if strings.eq(kw, "struct") { ret parseStructDeclFromKeyword(x) }
    if strings.eq(kw, "enum") { ret parseEnumFromKeyword(x) }
    ret false
}

// parseTypeDeclKeyword 处理 `type` 关键字（可分组或单条）。
fn parseTypeDeclKeyword(x *Parser, t *lex.Token) bool {
    x.l.skipTerminators()
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "(") {
        ret parseGroupedDecl(x, "type")
    }
    ret parseTypeFromKeyword(x, t)
}

// isVarConstLetKindVarConstLet case for var/const/let。
fn isDeclKindVarConstLet(kw string) bool {
    ret strings.eq(kw, "var") || strings.eq(kw, "const") || strings.eq(kw, "let")
}

// parseDeclKeyword 按关键字分派顶层声明。
// 前瞻走 x.l.peek()（lexer 预取环首视图，幂等、不消费）；
// 消费走 x.l.next()（按 FIFO 弹出同一个环）；多 token 前瞻扫描用 x.l.prefetch()（入环不弹）。
fn parseDeclKeyword(x *Parser, kw string, t *lex.Token) bool {
    if dispatchSimpleKeyword(x, kw) {
        ret true
    }
    if strings.eq(kw, "type") {
        ret parseTypeDeclKeyword(x, t)
    }
    if isDeclKindVarConstLet(kw) {
        ret parseVarConstDispatch(x, kw)
    }
    fail(x, EDECL, t.Pos)
    ret false
}

// isDeclKeyword 顶层声明关键字（含裸 var/const/let）。
fn isDeclKeyword(kw string) bool {
    ret isDeclKeywordHelper(kw)
}

fn isDeclKeywordHelper(kw string) bool {
    if strings.eq(kw, "import") { ret true }
    if strings.eq(kw, "build") { ret true }
    if strings.eq(kw, "fn") { ret true }
    if strings.eq(kw, "type") { ret true }
    if strings.eq(kw, "struct") { ret true }
    if strings.eq(kw, "enum") { ret true }
    if strings.eq(kw, "var") { ret true }
    if strings.eq(kw, "const") { ret true }
    if strings.eq(kw, "let") { ret true }
    ret false
}

// fileKeywordToken 处理 t.Type == KEYWORD 的情形：分派到 isDeclKeyword 或报错。
fn fileKeywordToken(x *Parser, t *lex.Token) bool {
    if !isDeclKeyword(t.Value) {
        fail(x, EDECL, t.Pos)
        ret false
    }
    x.l.next()
    ret parseDeclKeyword(x, t.Value, t)
}

// fileImplicitVarStmt 处理 t.Type == NAME 的顶层隐式 var：name: T = v。
fn fileImplicitVarStmt(x *Parser, t *lex.Token) bool {
    var nameT: *lex.Token = x.l.next()
    var p2: *lex.Token = x.l.peek()
    if p2 != nil && p2.Type == lex.DELIMITER && strings.eq(p2.Value, ":") {
        if !expect(x, lex.DELIMITER, ":", EDECL) {
            ret false
        }
        if !skipType(x) {
            ret false
        }
        if !expect(x, lex.DELIMITER, "=", EDECL) {
            ret false
        }
        restOfLineAtDepth0(x)
        x.decls = x.decls + 1
        x.vars = x.vars + 1
        ret true
    }
    fail(x, EDECL, nameT.Pos)
    ret false
}

// file 解析整个文件。
fn file(x *Parser) {
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            ret
        }
        if t.Type == lex.NONE {
            ret
        }
        if t.Type == lex.KEYWORD {
            if !fileKeywordToken(x, t) {
                ret
            }
            continue
        }
        if t.Type == lex.NAME {
            if !fileImplicitVarStmt(x, t) {
                ret
            }
            continue
        }
        fail(x, EDECL, t.Pos)
        ret
    }
}
