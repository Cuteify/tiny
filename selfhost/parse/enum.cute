// enum.cute —— enum Name { Member = expr, ... }。
import "std:strings"
import lex "../lexer"




// parseOptionalType 解析可选的 `: type` 底层类型注解。
fn EnumBlock.parseOptionalType(  x *Parser) bool {
    var typeBlock: TypeBlock
    var tpeek: *lex.Token = x.l.peek()
    if !tpeek.is(lex.DELIMITER, ":") {
        ret true
    }
    x.l.next()
    ret typeBlock.skipType( x)
}

// parseMember 解析一个 enum 成员（name [= expr] [,] [;]）。
fn EnumBlock.parseMember(  x *Parser) bool {
    var fileBlock: FileBlock
    var t: *lex.Token = x.l.peek()
    if t.Type != lex.NAME {
        fileBlock.fail( x, EDECL, t.Pos)
        ret false
    }
    x.l.next()
    x.l.skipTerminators()
    var p2: *lex.Token = x.l.peek()
    if p2.is( lex.DELIMITER, "=") {
        x.l.next()
        fileBlock.restOfLineAtDepth0( x)
        ret true
    }
    if p2.is( lex.DELIMITER, ",") || p2.is( lex.DELIMITER, ";") {
        x.l.next()
    }
    ret true
}

// parseFromKeyword 解析 `enum Name { ... }`。
fn EnumBlock.parse(&self, x *Parser) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = fileBlock.expectName( x, EDECL)
    if nameT == nil {
        ret false
    }
    // S4 Check：类型登记（enum）。
    if !fileBlock.registerDecl( x, nameT.Value, REG_ENUM, nameT.Pos) {
        ret false
    }
    self.Name = nameT.Value
    x.l.skipTerminators()
    if !EnumBlock.parseOptionalType( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fileBlock.fail( x, ESTMT, 0)
            ret false
        }
        if t.is( lex.DELIMITER, "}") {
            x.l.next()
            x.enums = x.enums + 1
            x.decls = x.decls + 1
            ret true
        }
        if !EnumBlock.parseMember( x) {
            ret false
        }
    }
}
