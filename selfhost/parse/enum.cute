// enum.cute —— enum Name { Member = expr, ... }。
import "std:strings"
import lex "../lexer"

type EnumBlock struct {
    Name: string
}

fn parseEnumFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    x.l.skipTerminators()
    var p: *lex.Token = x.l.peek()
    if lex.Token.is(p, lex.DELIMITER, ":") {
        x.l.next()
        if !skipType(x) {
            ret false
        }
    }
    if !expect(x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fail(x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            x.enums = x.enums + 1
            x.decls = x.decls + 1
            ret true
        }
        if t.Type != lex.NAME {
            fail(x, EDECL, t.Pos)
            ret false
        }
        x.l.next()
        x.l.skipTerminators()
        var p2: *lex.Token = x.l.peek()
        if lex.Token.is(p2, lex.DELIMITER, "=") {
            x.l.next()
            restOfLineAtDepth0(x)
            continue
        }
        if lex.Token.is(p2, lex.DELIMITER, ",") || lex.Token.is(p2, lex.DELIMITER, ";") {
            x.l.next()
            continue
        }
    }
}
