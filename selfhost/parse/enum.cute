// enum.cute —— enum Name { Member = expr, ... }。
import "std:strings"
import lex "../lexer"

type EnumBlock struct {
    Name: string
}

// parseEnumOptionalType 解析可选的 `: type` 底层类型注解。
fn parseEnumOptionalType(x *Parser) bool {
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, ":") {
        ret true
    }
    x.l.next()
    ret skipType(x)
}

// parseEnumMember 解析一个 enum 成员（name [= expr] [,] [;]）。
fn parseEnumMember(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if t.Type != lex.NAME {
        fail(x, EDECL, t.Pos)
        ret false
    }
    x.l.next()
    x.l.skipTerminators()
    var p2: *lex.Token = x.l.peek()
    if lex.Token.is(p2, lex.DELIMITER, "=") {
        x.l.next()
        restOfLineAtDepth0(x)
        ret true
    }
    if lex.Token.is(p2, lex.DELIMITER, ",") || lex.Token.is(p2, lex.DELIMITER, ";") {
        x.l.next()
    }
    ret true
}

fn parseEnumFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    x.l.skipTerminators()
    if !parseEnumOptionalType(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fail(x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            x.enums = x.enums + 1
            x.decls = x.decls + 1
            ret true
        }
        if !parseEnumMember(x) {
            ret false
        }
    }
}
