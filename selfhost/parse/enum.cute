// enum.cute —— enum Name { Member = expr, ... }。
import "std:strings"
import lex "../lexer"

type EnumBlock struct {
    Name: string
}

fn parseEnumFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    skipTerminators(x)
    var p: *lex.Token = peek(x)
    if isTok(p, lex.DELIMITER, ":") {
        next(x)
        if !skipType(x) {
            ret false
        }
    }
    if !expect(x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        skipTerminators(x)
        var t: *lex.Token = peek(x)
        if t == nil {
            fail(x, ESTMT, 0)
            ret false
        }
        if isTok(t, lex.DELIMITER, "}") {
            next(x)
            x.enums = x.enums + 1
            x.decls = x.decls + 1
            ret true
        }
        if t.Type != lex.NAME {
            fail(x, EDECL, t.Pos)
            ret false
        }
        next(x)
        skipTerminators(x)
        var p2: *lex.Token = peek(x)
        if isTok(p2, lex.DELIMITER, "=") {
            next(x)
            restOfLineAtDepth0(x)
            continue
        }
        if isTok(p2, lex.DELIMITER, ",") || isTok(p2, lex.DELIMITER, ";") {
            next(x)
            continue
        }
    }
}
