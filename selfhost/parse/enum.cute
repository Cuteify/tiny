// enum.cute —— enum Name { Member = expr, ... }。
import "std:strings"
import lex "../lexer"




// parseOptionalType 解析可选的 `: type` 底层类型注解。
fn EnumBlock.parseOptionalType(r EnumBlock, x *Parser) bool {
    var typeBlock: TypeBlock
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, ":") {
        ret true
    }
    x.l.next()
    ret TypeBlock.skipType(typeBlock, x)
}

// parseMember 解析一个 enum 成员（name [= expr] [,] [;]）。
fn EnumBlock.parseMember(r EnumBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var t: *lex.Token = x.l.peek()
    if t.Type != lex.NAME {
        FileBlock.fail(fileBlock, x, EDECL, t.Pos)
        ret false
    }
    x.l.next()
    x.l.skipTerminators()
    var p2: *lex.Token = x.l.peek()
    if lex.Token.is(p2, lex.DELIMITER, "=") {
        x.l.next()
        FileBlock.restOfLineAtDepth0(fileBlock, x)
        ret true
    }
    if lex.Token.is(p2, lex.DELIMITER, ",") || lex.Token.is(p2, lex.DELIMITER, ";") {
        x.l.next()
    }
    ret true
}

// parseFromKeyword 解析 `enum Name { ... }`。
fn EnumBlock.parse(r EnumBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
    if nameT == nil {
        ret false
    }
    r.Name = nameT.Value
    x.l.skipTerminators()
    if !EnumBlock.parseOptionalType(r, x) {
        ret false
    }
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            FileBlock.fail(fileBlock, x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            x.enums = x.enums + 1
            x.decls = x.decls + 1
            ret true
        }
        if !EnumBlock.parseMember(r, x) {
            ret false
        }
    }
}
