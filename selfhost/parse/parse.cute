// Cuteify 自举 parser（S4：按 Go 参考形态实现 Block 接口）。
//
// 目标：用递归下降解析 .cute 源码，复刻 Go 参考形态
//   Node { Value Block, Father *Node, Children []*Node }
// 与 Block interface{ Tag(x) int }。本期（M0）只落：
//   - Block / Node / Parser / file() 主循环骨架
//   - 顶层分派：import / build / fn / type / var / const 各 decl
//   - 与 selfhost/lexer 6 枚举对接（Prefetch + SetCursor 分支决策）
//   - 能编译、能跑子集、不改 Go 参考已通过的语料
//
// 不做完整语义 Check；权限只用于对拍与 AST 构造。
import "std:strings"
import lex "../lexer"

// 错误码：0 表示成功；其余为语义类别。
const OK: int = 0
const ETOK: int = 1
const EDECL: int = 2
const ESTMT: int = 4
const EEXPR: int = 5

// Block 是语法树节点的抽象接口：每个语法单位对应一个具体 Block。
type Block interface {
    Tag() int
}

// Node 是任意语法节点的统一表示。Father/Children 与 Go 参考一致。
// Value 是 *某种具体的 Block（*FuncBlock 等）。
type Node struct {
    Value: Block
    Father: *Node
    Children: []*Node
}

// 具体 block 的 Tag 常量
const B_FILE: int = 0
const B_FUNC: int = 1
const B_TYPE: int = 2
const B_VAR: int = 3
const B_CONST: int = 4
const B_IMPORT: int = 5
const B_BUILD: int = 6

type FuncBlock struct {
    Name: string
    useless: int
}

fn FuncBlock.Tag(recv: *FuncBlock) int {
    ret B_FUNC
}

type TypeBlock struct {
    Name: string
}

fn TypeBlock.Tag(recv: *TypeBlock) int {
    ret B_TYPE
}

type VarBlock struct {
    Name: string
}

fn VarBlock.Tag(recv: *VarBlock) int {
    ret B_VAR
}

type ConstBlock struct {
    Name: string
}

fn ConstBlock.Tag(recv: *ConstBlock) int {
    ret B_CONST
}

type ImportBlock struct {
    Path: string
    Alias: string
}

fn ImportBlock.Tag(recv: *ImportBlock) int {
    ret B_IMPORT
}

type BuildBlock struct {
    Key: string
}

fn BuildBlock.Tag(recv: *BuildBlock) int {
    ret B_BUILD
}

type FileBlock struct {
}

fn FileBlock.Tag(recv: *FileBlock) int {
    ret B_FILE
}

// Parser 把 lexer 流向上包成语法结构。
type Parser struct {
    l: *lex.Lexer
    root: *Node
    e: int
    ep: uint
    decls: int
}

// mk 基于源码字符串创建 parser。
fn mk(src string) *Parser {
    var x: *Parser = new(Parser)
    x.l = lex.NewLexer(src)
    x.e = OK
    x.ep = 0
    x.decls = 0
    x.root = new(Node)
    ret x
}

// err 返回首个错误码（OK 表示无错误）。
fn err(x *Parser) int {
    ret x.e
}

// errPos 返回首个错误的字节位置。
fn errPos(x *Parser) uint {
    ret x.ep
}

// declCount 返回顶层声明数。
fn declCount(x *Parser) int {
    ret x.decls
}

// importCount 返回 import 数（暂以计数占位）。
fn importCount(x *Parser) int {
    ret 0
}

// buildCount 返回 build 数。
fn buildCount(x *Parser) int {
    ret 0
}

// structCount 返回 struct 数。
fn structCount(x *Parser) int {
    ret 0
}

// fnCount 返回函数声明数。
fn fnCount(x *Parser) int {
    ret 0
}

// varCount 返回 var 声明数。
fn varCount(x *Parser) int {
    ret 0
}

// constCount 返回 const 声明数。
fn constCount(x *Parser) int {
    ret 0
}

// stmtCount 返回语句数（块内语句）。
fn stmtCount(x *Parser) int {
    ret 0
}

// exprCount 返回表达式数。
fn exprCount(x *Parser) int {
    ret 0
}

// file 解析整个文件：迭代每个 token，分派到对应 decl 解析函数。
// M0 仅消费顶层 fn/type/var/const/import，语句树留到 M2。
fn file(x *Parser) {
    // 空输入：直接返回成功
    var done: bool = false
    for ; !done; {
        var t: *lex.Token = x.l.Next()
        if t.Type == lex.NONE {
            done = true
        } else if t.Type == lex.KEYWORD {
            if strings.eq(t.Value, "fn") || strings.eq(t.Value, "type") || strings.eq(t.Value, "var") || strings.eq(t.Value, "import") {
                x.decls = x.decls + 1
            }
            // v0: 不建 AST，仅计数
        } else if t.Type == lex.DELIMITER {
            // 分隔符：忽略
        } else if t.Type == lex.NAME || t.Type == lex.NUMBER || t.Type == lex.STRING {
            // 名称/字面量：忽略
        } else {
            // 未知 token：记词法错误
            x.e = ETOK
            x.ep = unsafe.cast[uint](t.Pos)
            done = true
        }
    }
}
