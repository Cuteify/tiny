// exp.cute —— 表达式递归下降（运算优先级 climb）；与 Go exp.go 同级。
// 加载顺序：依赖 helpers.cute。
import "std:strings"
import lex "../lexer"

fn prec(s string) int {
    if strings.eq(s, "||") {
        ret 1
    }
    if strings.eq(s, "&&") {
        ret 2
    }
    if strings.eq(s, "==") || strings.eq(s, "!=") {
        ret 3
    }
    if strings.eq(s, "<") || strings.eq(s, "<=") || strings.eq(s, ">") || strings.eq(s, ">=") {
        ret 4
    }
    if strings.eq(s, "|") {
        ret 5
    }
    if strings.eq(s, "^") {
        ret 6
    }
    if strings.eq(s, "&") {
        ret 7
    }
    if strings.eq(s, "<<") || strings.eq(s, ">>") {
        ret 9
    }
    if strings.eq(s, "+") || strings.eq(s, "-") {
        ret 10
    }
    if strings.eq(s, "*") || strings.eq(s, "/") || strings.eq(s, "%") {
        ret 11
    }
    ret 0
}

// parsePrimaryKeyword 处理 true/false/nil 关键字；非此三字时记 EEXPR。
fn parsePrimaryKeyword(x *Parser, t *lex.Token) bool {
    if strings.eq(t.Value, "true") || strings.eq(t.Value, "false") || strings.eq(t.Value, "nil") {
        x.exprs = x.exprs + 1
        x.l.next()
        ret true
    }
    fail(x, EEXPR, t.Pos)
    ret false
}

// parsePrimaryName 处理单个 NAME：NAME{...} 结构体字面量需 NAME 与 '{' 严格相邻。
fn parsePrimaryName(x *Parser, t *lex.Token) bool {
    x.exprs = x.exprs + 1
    x.l.next()
    var p: *lex.Token = x.l.peek()
    if lex.Token.is(p, lex.DELIMITER, "{") && unsafe.cast[int](p.Pos) == t.EndPos {
        ret parseStructLit(x)
    }
    ret true
}

// parsePrimaryParen 处理括号分组表达式。
fn parsePrimaryParen(x *Parser) bool {
    x.l.next()
    x.l.skipTerminators()
    if !parseExpr(x) {
        ret false
    }
    x.l.skipTerminators()
    if !expect(x, lex.DELIMITER, ")", EEXPR) {
        ret false
    }
    x.exprs = x.exprs + 1
    ret true
}

// parseCompositePrimary 处理 []T{...} / [N]T{...} / map[K]V{...} 复合字面量。
fn parseCompositePrimary(x *Parser) bool {
    if !parseCompositeType(x) {
        ret false
    }
    x.l.skipTerminators()
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "{") {
        x.exprs = x.exprs + 1
        ret parseCompositeElems(x)
    }
    // 类型本身作为表达式实参，如 new([]int, 8)
    x.exprs = x.exprs + 1
    ret true
}

// isPrimaryKeywordValue 判断 token 是否为值型关键字（true/false/nil）。
fn isPrimaryKeywordValue(v string) bool {
    ret strings.eq(v, "true") || strings.eq(v, "false") || strings.eq(v, "nil")
}

fn parsePrimary(x *Parser) bool {
    x.l.skipTerminators()
    var t: *lex.Token = x.l.peek()
    if t == nil {
        fail(x, EEXPR, 0)
        ret false
    }
    if t.Type == lex.NUMBER || t.Type == lex.STRING {
        x.exprs = x.exprs + 1
        x.l.next()
        ret true
    }
    if t.Type == lex.KEYWORD {
        ret parsePrimaryKeyword(x, t)
    }
    if t.Type == lex.NAME {
        ret parsePrimaryName(x, t)
    }
    if lex.Token.is(t, lex.DELIMITER, "(") {
        ret parsePrimaryParen(x)
    }
    if lex.Token.is(t, lex.DELIMITER, "[") || strings.eq(t.Value, "map") {
        ret parseCompositePrimary(x)
    }
    fail(x, EEXPR, t.Pos)
    ret false
}

// parseCompositeType 消费 []T / [N]T / map[K]V 前缀（不消耗 {）。
// 反向不构建 AST。
// parseMapTypeHead 解析 map[K]V 类型前缀（NAME "map" 已 peek、未消费）。
fn parseMapTypeHead(x *Parser) bool {
    x.l.next()
    if !expect(x, lex.DELIMITER, "[", ETYPE) {
        ret false
    }
    if !skipType(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, "]", ETYPE) {
        ret false
    }
    ret skipType(x)
}

// parseArrayTypeHead 解析切片 []T 与定长数组 [N]T 类型前缀（`[` 已 peek、未消费）。
fn parseArrayTypeHead(x *Parser) bool {
    x.l.next()
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "]") {
        x.l.next()
        ret skipType(x)
    }
    var num: *lex.Token = x.l.next()
    if num == nil || num.Type != lex.NUMBER {
        if num == nil {
            fail(x, ETYPE, 0)
        } else {
            fail(x, ETYPE, num.Pos)
        }
        ret false
    }
    if !expect(x, lex.DELIMITER, "]", ETYPE) {
        ret false
    }
    ret skipType(x)
}

fn parseCompositeType(x *Parser) bool {
    x.l.skipTerminators()
    var t: *lex.Token = x.l.peek()
    if t.Type == lex.NAME && strings.eq(t.Value, "map") {
        ret parseMapTypeHead(x)
    }
    if lex.Token.is(t, lex.DELIMITER, "[") {
        ret parseArrayTypeHead(x)
    }
    fail(x, ETYPE, t.Pos)
    ret false
}

// parseCompositeElems 解析 { 元素, ... }（已消耗 { 的前提下）。
fn parseCompositeElems(x *Parser) bool {
    if !expect(x, lex.DELIMITER, "{", EEXPR) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if !parseExpr(x) {
            ret false
        }
        var t2: *lex.Token = x.l.peek()
        if lex.Token.is(t2, lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
        if lex.Token.is(t2, lex.DELIMITER, "}") {
            continue
        }
        fail(x, EEXPR, t2.Pos)
        ret false
    }
}

// parsePostfix 后缀消歧：索引/切片/选择器/调用，循环到非后缀 token。
// parseSelectorSuffix 解析 .name（选择器）。
fn parseSelectorSuffix(x *Parser) bool {
    x.l.next()
    ret expectName(x, EEXPR) != nil
}

// consumeSliceBoundEnd 判断当前到 ']' 或 ':' 为止：若不是，consume expr；其他接受。
fn consumeSliceBoundEnd(x *Parser) bool {
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "]") {
        ret true
    }
    if lex.Token.is(x.l.peek(), lex.DELIMITER, ":") {
        ret true
    }
    ret parseExpr(x)
}

// parseIndexSuffix 处理 [i] / [i:j] / [i:] / [:j] / [i:j:step]
fn parseIndexSuffix(x *Parser) bool {
    x.l.next()
    x.l.skipTerminators()
    if lex.Token.is(x.l.peek(), lex.DELIMITER, ":") {
        x.l.next()
        if !consumeSliceBoundEnd(x) {
            ret false
        }
        ret expect(x, lex.DELIMITER, "]", EEXPR)
    }
    if !parseExpr(x) {
        ret false
    }
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, ":") {
        ret expect(x, lex.DELIMITER, "]", EEXPR)
    }
    x.l.next()
    if !consumeSliceBoundEnd(x) {
        ret false
    }
    if lex.Token.is(x.l.peek(), lex.DELIMITER, ":") {
        x.l.next()
        if !consumeSliceBoundEnd(x) {
            ret false
        }
    }
    ret expect(x, lex.DELIMITER, "]", EEXPR)
}

fn parsePostfix(x *Parser) bool {
    if !parsePrimary(x) {
        ret false
    }
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, ".") {
            if !parseSelectorSuffix(x) {
                ret false
            }
            continue
        }
        if lex.Token.is(t, lex.DELIMITER, "[") {
            if !parseIndexSuffix(x) {
                ret false
            }
            continue
        }
        if lex.Token.is(t, lex.DELIMITER, "(") {
            if !parseCallArgs(x) {
                ret false
            }
            continue
        }
        // 既不是 . [ ( 就结束——变参泛型调用在这里停（留给外层索引路径）。
        break
    }
    ret true
}

// parseUnary 解析前缀一元运算符（! - ~ * & + ^）。
fn parseUnary(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    var isUnary: bool = false
    if lex.Token.is(t, lex.DELIMITER, "!") {
        isUnary = true
    } else if lex.Token.is(t, lex.DELIMITER, "-") {
        isUnary = true
    } else if lex.Token.is(t, lex.DELIMITER, "~") {
        isUnary = true
    } else if lex.Token.is(t, lex.DELIMITER, "*") {
        isUnary = true
    } else if lex.Token.is(t, lex.DELIMITER, "&") {
        isUnary = true
    } else if lex.Token.is(t, lex.DELIMITER, "+") {
        isUnary = true
    } else if lex.Token.is(t, lex.DELIMITER, "^") {
        isUnary = true
    }
    if isUnary {
        x.l.next()
        ret parseUnary(x)
    }
    if !parsePostfix(x) {
        ret false
    }
    ret true
}

// parseBinaryExpr 优先级攀升；minPrec 以下的算符停止。
fn parseBinaryExpr(x *Parser, minPrec int) bool {
    if !parseUnary(x) {
        ret false
    }
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if t == nil || t.Type != lex.DELIMITER {
            break
        }
        var p: int = prec(t.Value)
        if p == 0 || p < minPrec {
            break
        }
        x.l.next()
        if !parseBinaryExpr(x, p + 1) {
            ret false
        }
    }
    ret true
}

// parseExpr 表达式入口。
fn parseExpr(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if t != nil {
    }
    ret parseBinaryExpr(x, 1)
}
