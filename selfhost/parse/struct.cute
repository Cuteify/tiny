// struct.cute —— 结构体声明体 `struct Name { @field ... }` 解析。
// 加载顺序：依赖 helpers.cute、type.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

fn parseStructBody(x *Parser) bool {
    if !expect(x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.SkipTerminators()
        var t: *lex.Token = x.l.Peek()
        if t == nil {
            fail(x, ESTMT, 0)
            ret false
        }
        if lex.Token.Is(t, lex.DELIMITER, "}") {
            x.l.Next()
            ret true
        }
        // 匿名嵌入父结构：@Name / alias @Name
        if lex.Token.Is(t, lex.DELIMITER, "@") {
            x.l.Next()
            var parentN: *lex.Token = expectName(x, EDECL)
            if parentN == nil {
                ret false
            }
            continue
        }
        // 访问修饰符 !（只读）/ ?（只写）
        var t0: *lex.Token = x.l.Peek()
        if lex.Token.Is(t0, lex.DELIMITER, "!") || lex.Token.Is(t0, lex.DELIMITER, "?") {
            x.l.Next()
        }
        // 尝试识别合法的字段形态（name: Type / field @Parent / 完整未识别静默忽略）
        var fieldName: *lex.Token = x.l.Peek()
        if fieldName == nil || fieldName.Type != lex.NAME {
            fail(x, EDECL, fieldName.Pos)
            ret false
        }
        // 先看 fieldName 后面是什么决定怎么处理
        x.l.Next()
        var afterField: *lex.Token = x.l.Peek()
        if lex.Token.Is(afterField, lex.DELIMITER, ":") {
            x.l.Next()
            if !skipType(x) {
                ret false
            }
            // 字段 RAW 标签：string `json:"..."`（lexer 将反引号串归入 STRING token）
            var pTag: *lex.Token = x.l.Peek()
            if pTag != nil && pTag.Type == lex.STRING {
                x.l.Next()
            }
            // 字段默认值 = expr
            var pDef: *lex.Token = x.l.Peek()
            if lex.Token.Is(pDef, lex.DELIMITER, "=") {
                x.l.Next()
                restOfLineAtDepth0(x)
            }
            continue
        }
        if lex.Token.Is(afterField, lex.DELIMITER, "@") {
            // alias @Parent：fieldName @Parent
            x.l.Next()
            var parentN: *lex.Token = expectName(x, EDECL)
            if parentN == nil {
                ret false
            }
            continue
        }
        // 未识别形态（含 `name Type` 单独出现、priv/val 等修饰符）：
        // NAME 已消费，什么也不做，回到循环态等待结构性 token；与 Go 参考一致
        continue
    }
}

// parseInterfaceBody 解析 interface { ... }（type X interface 复用）。
fn parseStructDeclFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    x.l.SkipTerminators()
    var p: *lex.Token = x.l.Peek()
    if lex.Token.Is(p, lex.DELIMITER, ":") {
        x.l.Next()
        var parentN: *lex.Token = expectName(x, EDECL)
        if parentN == nil {
            ret false
        }
    }
    if !parseStructBody(x) {
        ret false
    }
    x.structs = x.structs + 1
    x.decls = x.decls + 1
    ret true
}

