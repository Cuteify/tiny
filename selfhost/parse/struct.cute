// struct.cute —— 结构体声明体 `struct Name { @field ... }` 解析。
// 加载顺序：依赖 helpers.cute、type.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

// parseAnonymousEmbed 处理 @Name 匿名嵌入或 alias @Name。
fn StructBlock.parseAnonymousEmbed(  x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    ret fileBlock.expectName( x, EDECL) != nil
}

// consumeStructFieldTag 字段可选的 RAW 标签（`json:"..."` 归在 STRING token）。
fn StructBlock.consumeStructFieldTag(  x *Parser) bool {
    var pTag: *lex.Token = x.l.peek()
    if pTag != nil && pTag.Type == lex.STRING {
        x.l.next()
    }
    ret true
}

// consumeStructFieldDefault 字段可选的默认值 = expr。
fn StructBlock.consumeStructFieldDefault(  x *Parser) bool {
    var fileBlock: FileBlock
    var tpeek: *lex.Token = x.l.peek()
    if !tpeek.is(lex.DELIMITER, "=") {
        ret true
    }
    x.l.next()
    fileBlock.restOfLineAtDepth0( x)
    ret true
}

// parseTypedField 解析 field : Type（含可选的标签/默认值）。':' 已被调用方，位置指向类型起始。
fn StructBlock.parseTypedField(x *Parser) bool {
    var typeBlock: TypeBlock
    if !typeBlock.skipType( x) {
        ret false
    }
    StructBlock.consumeStructFieldTag( x)
    StructBlock.consumeStructFieldDefault( x)
    ret true
}

// parseStructField 解析一个字段：匿名嵌入 / 修饰符 / typed field / 别名嵌入。
fn StructBlock.parseStructField(x *Parser) bool {
    var fileBlock: FileBlock
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "@") {
        ret StructBlock.parseAnonymousEmbed( x)
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "!") || tpeek.is(lex.DELIMITER, "?") {
        x.l.next()
    }
    var fieldName: *lex.Token = x.l.peek()
    if fieldName == nil || fieldName.Type != lex.NAME {
        if (fieldName) {
            fileBlock.fail( x, EDECL, fieldName.Pos)
        } else {
            fileBlock.fail( x, EDECL, 0)
        }
        ret false
    }
    x.l.next()
    var afterField: *lex.Token = x.l.peek()
    if afterField.is( lex.DELIMITER, ":") {
        x.l.next()
        ret StructBlock.parseTypedField( x)
    }
    if afterField.is( lex.DELIMITER, "@") {
        ret StructBlock.parseAnonymousEmbed( x)
    }
    // 未识别形态（含 `name Type` 单独出现、priv/val 等修饰符）：
    // NAME 已消费，其他也不消费——等待外层循环继续找 }。
    ret true
}
fn StructBlock.parseStructBody(x *Parser) bool {
    var fileBlock: FileBlock
    if !fileBlock.expect( x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fileBlock.fail( x, ESTMT, 0)
            ret false
        }
        if t.is( lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if !StructBlock.parseStructField( x) {
            ret false
        }
    }
}

// parseInterfaceBody 解析 interface { ... }（type X interface 复用）。
fn StructBlock.parseStructDeclFromKeyword(x *Parser) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = fileBlock.expectName( x, EDECL)
    if nameT == nil {
        ret false
    }
    // S4 Check：struct 登记（遗留 struct 语法）。
    if !fileBlock.registerDecl( x, nameT.Value, REG_STRUCT, nameT.Pos) {
        ret false
    }
    x.l.skipTerminators()
    var p: *lex.Token = x.l.peek()
    if p.is( lex.DELIMITER, ":") {
        x.l.next()
        var parentN: *lex.Token = fileBlock.expectName( x, EDECL)
        if parentN == nil {
            ret false
        }
    }
    if !StructBlock.parseStructBody( x) {
        ret false
    }
    x.structs = x.structs + 1
    x.decls = x.decls + 1
    ret true
}

