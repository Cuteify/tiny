// struct.cute —— 结构体声明体 `struct Name { @field ... }` 解析。
// 加载顺序：依赖 helpers.cute、type.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

// parseAnonymousEmbed 处理 @Name 匿名嵌入或 alias @Name。
fn StructBlock.parseAnonymousEmbed(r StructBlock, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    ret FileBlock.expectName(fileBlock, x, EDECL) != nil
}

// consumeStructFieldTag 字段可选的 RAW 标签（`json:"..."` 归在 STRING token）。
fn StructBlock.consumeStructFieldTag(r StructBlock, x *Parser) bool {
    var pTag: *lex.Token = x.l.peek()
    if pTag != nil && pTag.Type == lex.STRING {
        x.l.next()
    }
    ret true
}

// consumeStructFieldDefault 字段可选的默认值 = expr。
fn StructBlock.consumeStructFieldDefault(r StructBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, "=") {
        ret true
    }
    x.l.next()
    FileBlock.restOfLineAtDepth0(fileBlock, x)
    ret true
}

// parseTypedField 解析 field : Type（含可选的标签/默认值）。':' 已被调用方，位置指向类型起始。
fn StructBlock.parseTypedField(r StructBlock, x *Parser) bool {
    var typeBlock: TypeBlock
    if !TypeBlock.skipType(typeBlock, x) {
        ret false
    }
    StructBlock.consumeStructFieldTag(r, x)
    StructBlock.consumeStructFieldDefault(r, x)
    ret true
}

// parseStructField 解析一个字段：匿名嵌入 / 修饰符 / typed field / 别名嵌入。
fn StructBlock.parseStructField(r StructBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "@") {
        ret StructBlock.parseAnonymousEmbed(r, x)
    }
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "!") || lex.Token.is(x.l.peek(), lex.DELIMITER, "?") {
        x.l.next()
    }
    var fieldName: *lex.Token = x.l.peek()
    if fieldName == nil || fieldName.Type != lex.NAME {
        if (fieldName) {
            FileBlock.fail(fileBlock, x, EDECL, fieldName.Pos)
        } else {
            FileBlock.fail(fileBlock, x, EDECL, 0)
        }
        ret false
    }
    x.l.next()
    var afterField: *lex.Token = x.l.peek()
    if lex.Token.is(afterField, lex.DELIMITER, ":") {
        x.l.next()
        ret StructBlock.parseTypedField(r, x)
    }
    if lex.Token.is(afterField, lex.DELIMITER, "@") {
        ret StructBlock.parseAnonymousEmbed(r, x)
    }
    // 未识别形态（含 `name Type` 单独出现、priv/val 等修饰符）：
    // NAME 已消费，其他也不消费——等待外层循环继续找 }。
    ret true
}

fn StructBlock.parseStructBody(r StructBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            FileBlock.fail(fileBlock, x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if !StructBlock.parseStructField(r, x) {
            ret false
        }
    }
}

// parseInterfaceBody 解析 interface { ... }（type X interface 复用）。
fn StructBlock.parseStructDeclFromKeyword(r StructBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
    if nameT == nil {
        ret false
    }
    // S4 Check：struct 登记（遗留 struct 语法）。
    if !FileBlock.registerDecl(fileBlock, x, nameT.Value, REG_STRUCT, nameT.Pos) {
        ret false
    }
    x.l.skipTerminators()
    var p: *lex.Token = x.l.peek()
    if lex.Token.is(p, lex.DELIMITER, ":") {
        x.l.next()
        var parentN: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
        if parentN == nil {
            ret false
        }
    }
    if !StructBlock.parseStructBody(r, x) {
        ret false
    }
    x.structs = x.structs + 1
    x.decls = x.decls + 1
    ret true
}

