// struct.cute —— 结构体声明体 `struct Name { @field ... }` 解析。
// 加载顺序：依赖 helpers.cute、type.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

fn parseStructBody(x *Parser) bool {
    if !expect(x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        skipTerminators(x)
        var t: *lex.Token = peek(x)
        if isNilTok(t) {
            fail(x, ESTMT, 0)
            ret false
        }
        if isTok(t, lex.DELIMITER, "}") {
            next(x)
            ret true
        }
        // 匿名嵌入父结构：@Name / alias @Name
        if isTok(t, lex.DELIMITER, "@") {
            next(x)
            var parentN: *lex.Token = expectName(x, EDECL)
            if isNilTok(parentN) {
                ret false
            }
            continue
        }
        // 访问修饰符 !（只读）/ ?（只写）
        var t0: *lex.Token = peek(x)
        if isTok(t0, lex.DELIMITER, "!") || isTok(t0, lex.DELIMITER, "?") {
            next(x)
        }
        // 尝试识别合法的字段形态（name: Type / field @Parent / 完整未识别静默忽略）
        var fieldName: *lex.Token = peek(x)
        if isNilTok(fieldName) || fieldName.Type != lex.NAME {
            fail(x, EDECL, fieldName.Pos)
            ret false
        }
        // 先看 fieldName 后面是什么决定怎么处理
        var fieldTok: *lex.Token = next(x)
        var afterField: *lex.Token = peek(x)
        if isTok(afterField, lex.DELIMITER, ":") {
            next(x)
            if !skipType(x) {
                ret false
            }
            // 字段 RAW 标签：string `json:"..."`（lexer 将反引号串归入 STRING token）
            var pTag: *lex.Token = peek(x)
            if !isNilTok(pTag) && pTag.Type == lex.STRING {
                next(x)
            }
            // 字段默认值 = expr
            var pDef: *lex.Token = peek(x)
            if isTok(pDef, lex.DELIMITER, "=") {
                next(x)
                restOfLineAtDepth0(x)
            }
            continue
        }
        if isTok(afterField, lex.DELIMITER, "@") {
            // alias @Parent：fieldName @Parent
            next(x)
            var parentN: *lex.Token = expectName(x, EDECL)
            if isNilTok(parentN) {
                ret false
            }
            continue
        }
        // 未识别形态（含 `name Type` 单独出现、priv/val 等修饰符）：
        // 静默丢弃当前 NAME，回到循环态等待结构性 token；与 Go 参考一致
        discardTok(fieldTok)
        continue
    }
}

// parseInterfaceBody 解析 interface { ... }（type X interface 复用）。
fn parseStructDeclFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if isNilTok(nameT) {
        ret false
    }
    skipTerminators(x)
    var p: *lex.Token = peek(x)
    if isTok(p, lex.DELIMITER, ":") {
        next(x)
        var parentN: *lex.Token = expectName(x, EDECL)
        if isNilTok(parentN) {
            ret false
        }
    }
    if !parseStructBody(x) {
        ret false
    }
    x.structs = x.structs + 1
    x.decls = x.decls + 1
    ret true
}

