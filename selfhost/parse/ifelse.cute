// ifelse.cute —— if / else if / else；else if 复用 if 入口。
// 加载顺序：依赖 exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

fn parseIfStmt(x *Parser) bool {
    if !expectKeyword(x, "if", ESTMT) {
        ret false
    }
    if !parseExpr(x) {
        ret false
    }
    if !parseBlock(x) {
        ret false
    }
    var t: *lex.Token = x.l.Peek()
    if lex.Token.Is(t, lex.KEYWORD, "else") {
        x.l.Next()
        var t2: *lex.Token = x.l.Peek()
        if lex.Token.Is(t2, lex.KEYWORD, "if") {
            ret parseIfStmt(x)
        }
        ret parseBlock(x)
    }
    ret true
}

