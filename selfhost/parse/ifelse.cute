// ifelse.cute —— if / else if / else；else if 复用 if 入口。
// 加载顺序：依赖 exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

fn IfBlock.parseIfStmt(r IfBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    if !FileBlock.expectKeyword(fileBlock, x, "if", ESTMT) {
        ret false
    }
    var eb: ExpBlock
    if !ExpBlock.parseExpr(eb, x) {
        ret false
    }
    if !StmtBlock.parseBlock(stmtBlock, x) {
        ret false
    }
    var t: *lex.Token = x.l.peek()
    if lex.Token.is(t, lex.KEYWORD, "else") {
        x.l.next()
        var t2: *lex.Token = x.l.peek()
        if lex.Token.is(t2, lex.KEYWORD, "if") {
            ret IfBlock.parseIfStmt(r, x)
        }
        ret StmtBlock.parseBlock(stmtBlock, x)
    }
    ret true
}

