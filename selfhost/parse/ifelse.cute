// ifelse.cute —— if / else if / else；else if 复用 if 入口。
// 加载顺序：依赖 exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"
fn IfBlock.parseIfStmt(x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    if !fileBlock.expectKeyword( x, "if", ESTMT) {
        ret false
    }
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    if !stmtBlock.parseBlock( x) {
        ret false
    }
    var t: *lex.Token = x.l.peek()
    if t.is( lex.KEYWORD, "else") {
        x.l.next()
        var t2: *lex.Token = x.l.peek()
        if t2.is( lex.KEYWORD, "if") {
            ret IfBlock.parseIfStmt( x)
        }
        ret stmtBlock.parseBlock( x)
    }
    ret true
}

