// interface.cute —— type X interface { ... } 解析。
// 加载顺序：依赖 call.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

// parseInterfaceMember 解析接口体内一项（方法头或嵌入式接口的裸名）。
fn parseInterfaceMember(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if t.Type != lex.NAME {
        fail(x, EDECL, t.Pos)
        ret false
    }
    x.l.next()
    var p: *lex.Token = x.l.peek()
    if lex.Token.isLineEnd(p) {
        ret true
    }
    if lex.Token.is(p, lex.DELIMITER, "(") {
        x.l.next()
        if !parseFuncParams(x) {
            ret false
        }
        ret parseRetTypes(x)
    }
    fail(x, EDECL, p.Pos)
    ret false
}

fn parseInterfaceBody(x *Parser) bool {
    if !expect(x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fail(x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if !parseInterfaceMember(x) {
            ret false
        }
    }
}


// parseGroupedDecl 解析 var ( ... ) / const ( ... ) / let ( ... ) / type ( ... ) 分组声明。
fn parseInterfaceFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    x.l.skipTerminators()
    if !parseInterfaceBody(x) {
        ret false
    }
    x.decls = x.decls + 1
    ret true
}

