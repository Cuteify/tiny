// interface.cute —— type X interface { ... } 解析。
// 加载顺序：依赖 call.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

// parseInterfaceMember 解析接口体内一项（方法头或嵌入式接口的裸名）。
fn TypeBlock.parseInterfaceMember(r TypeBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var t: *lex.Token = x.l.peek()
    if t.Type != lex.NAME {
        FileBlock.fail(fileBlock, x, EDECL, t.Pos)
        ret false
    }
    x.l.next()
    var p: *lex.Token = x.l.peek()
    if lex.Token.isLineEnd(p) {
        ret true
    }
    if lex.Token.is(p, lex.DELIMITER, "(") {
        // 编译器 bug：局部空串 + 堆字段链式拼接会丢失字段操作数，先落局部变量再拼。
        var mname: string = t.Value
        var ibuf: string = x.ifaceBuf
        x.ifaceBuf = ibuf + mname + ","
        x.l.next()
        var cb: CallBlock
        if !CallBlock.parseFuncParams(cb, x) {
            ret false
        }
        ret CallBlock.parseRetTypes(cb, x)
    }
    FileBlock.fail(fileBlock, x, EDECL, p.Pos)
    ret false
}

fn TypeBlock.parseInterfaceBody(r TypeBlock, x *Parser) bool {
    var fileBlock: FileBlock
    x.ifaceBuf = ""
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            FileBlock.fail(fileBlock, x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            // S4 Check：接口登记（*InterfaceType 入）。
            FileBlock.registerIface(fileBlock, x, x.ifaceName)
            ret true
        }
        if !TypeBlock.parseInterfaceMember(r, x) {
            ret false
        }
    }
}


// parseGroupedDecl 解析 var ( ... ) / const ( ... ) / let ( ... ) / type ( ... ) 分组声明。
fn TypeBlock.parseInterfaceFromKeyword(r TypeBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
    if nameT == nil {
        ret false
    }
    // S4 Check：接口登记（遗留接口语法）。
    if !FileBlock.registerDecl(fileBlock, x, nameT.Value, REG_IFACE, nameT.Pos) {
        ret false
    }
    x.ifaceName = nameT.Value
    x.l.skipTerminators()
    if !TypeBlock.parseInterfaceBody(r, x) {
        ret false
    }
    x.decls = x.decls + 1
    ret true
}

