// for.cute —— for 三种形态 + range。
// 加载顺序：依赖 call.cute、exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

// scanForKind 多 token 前瞻判断 for 的三种形态（3=普通 / 2=:= / 1=range）。
// 用 x.l.prefetch() 把前瞻 token 扫入 lexer 预取环、不弹出——
// 决定 kind 之后，后续 Peek/next 按原序弹出这些 token，无需 pushBack 重放。
// 退出条件：遇到 ; { NONE 或扫满 12 个。
// scanForOneAhead 单步预取并扫到 for 头：命中就升级 kind；只决定，不消费环。
fn ForBlock.scanForOneAhead(  x *Parser, kind int) int {
    var t: *lex.Token = x.l.prefetch()
    if t.Type == lex.NONE {
        ret 0
    }
    if t.Type == lex.DELIMITER {
        if strings.eq(t.Value, ";") || strings.eq(t.Value, "{") {
            ret 0
        }
        if strings.eq(t.Value, ":=") && kind == 3 {
            ret 2
        }
        ret kind
    }
    if t.Type == lex.KEYWORD && strings.eq(t.Value, "range") {
        ret 1
    }
    ret kind
}
fn ForBlock.scanForKind(x *Parser) int {
    var kind: int = 3
    var n: int = 0
    for ; n < 12; {
        var newKind: int = ForBlock.scanForOneAhead( x, kind)
        if newKind == 0 {
            break
        }
        if newKind == 1 {
            kind = 1
            break
        }
        if newKind == 2 {
            kind = 2
        }
        n = n + 1
    }
    ret kind
}

// consumeToBrace 消费直到遇到 '{'（post 子句用）；遇 NONE 报错。
fn ForBlock.consumeToBrace(  x *Parser) bool {
    var fileBlock: FileBlock
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if t.is( lex.DELIMITER, "{") {
            ret true
        }
        if t == nil || t.Type == lex.NONE {
            fileBlock.fail( x, ESTMT, 0)
            ret false
        }
        x.l.next()
    }
}

// parseForSemicolonCond 处理 for ; cond ; post { }：cond/post 均可为空。
fn ForBlock.parseForSemicolonCond(x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    x.l.next()
    var tpeek: *lex.Token = x.l.peek()
    if !tpeek.is(lex.DELIMITER, ";") {
        var eb: ExpBlock
        if !eb.parseExpr( x) {
            ret false
        }
    }
    if !fileBlock.expect( x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !ForBlock.consumeToBrace( x) {
        ret false
    }
    ret stmtBlock.parseBlock( x)
}

// parseForInitVarTyped 处理 `for var name: Type` 头部。
fn ForBlock.parseForInitVarTyped(  x *Parser) bool {
    var fileBlock: FileBlock
    var typeBlock: TypeBlock
    x.l.next()
    var nameT: *lex.Token = fileBlock.expectName( x, ESTMT)
    if nameT == nil {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    if !typeBlock.skipType( x) {
        ret false
    }
    ret fileBlock.expect( x, lex.DELIMITER, "=", ESTMT)
}

// parseForInitCondPost 处理 `= expr ; cond ; post { }`。
fn ForBlock.parseForInitCondPost(x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !ForBlock.consumeToBrace( x) {
        ret false
    }
    ret stmtBlock.parseBlock( x)
}

// parseForVarInit 处理 for var name: T = expr; cond ; post { }。
fn ForBlock.parseForVarInit(x *Parser) bool {
    if !ForBlock.parseForInitVarTyped( x) {
        ret false
    }
    ret ForBlock.parseForInitCondPost( x)
}

// parseForRangeStmt 处理 range 形式 for i, v := range xs { }。
fn ForBlock.parseForRangeStmt(  x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    for ; ; {
        var nt: *lex.Token = fileBlock.expectName( x, ESTMT)
        if nt == nil {
            ret false
        }
        var tpeek: *lex.Token = x.l.peek()
        if !tpeek.is(lex.DELIMITER, ",") {
            break
        }
        x.l.next()
    }
    if !fileBlock.expect( x, lex.DELIMITER, ":=", ESTMT) {
        ret false
    }
    if !fileBlock.expectKeyword( x, "range", ESTMT) {
        ret false
    }
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    ret stmtBlock.parseBlock( x)
}

// parseForClassicInit 处理 classic init 段（可带 var 声明或表达式 := 形式）。
fn ForBlock.parseForClassicInit(  x *Parser) bool {
    var fileBlock: FileBlock
    var varBlock: VarBlock
    var tInit: *lex.Token = x.l.peek()
    if tInit.is( lex.KEYWORD, "var") {
        x.l.next()
        ret varBlock.parseVarConst( x, "var", 0)
    }
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ":=", ESTMT) {
        ret false
    }
    var eb: ExpBlock
    ret eb.parseExpr( x)
}

// parseForClassicStmt 处理 kind==2 for init ; cond ; post { }。
fn ForBlock.parseForClassicStmt(x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    if !ForBlock.parseForClassicInit( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !ForBlock.consumeToBrace( x) {
        ret false
    }
    ret stmtBlock.parseBlock( x)
}
fn ForBlock.parseForStmt(x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    var kw: string = "for"
    var t: *lex.Token = x.l.peek()
    if t.is( lex.KEYWORD, "while") {
        kw = "while"
    }
    if !fileBlock.expectKeyword( x, kw, ESTMT) {
        ret false
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, ";") {
        ret ForBlock.parseForSemicolonCond( x)
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.KEYWORD, "var") {
        ret ForBlock.parseForVarInit( x)
    }
    var kind: int = ForBlock.scanForKind( x)
    if kind == 1 {
        ret ForBlock.parseForRangeStmt( x)
    }
    if kind == 2 {
        ret ForBlock.parseForClassicStmt( x)
    }
    if stmtBlock.atOpen( x) {
        ret stmtBlock.parseBlock( x)
    }
    var eb: ExpBlock
    if !eb.parseExpr( x) {
        ret false
    }
    ret stmtBlock.parseBlock( x)
}

