// for.cute —— for 三种形态 + range。
// 加载顺序：依赖 call.cute、exp.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

// scanForKind 多 token 前瞻判断 for 的三种形态（3=普通 / 2=:= / 1=range）。
// 用 x.l.prefetch() 把前瞻 token 扫入 lexer 预取环、不弹出——
// 决定 kind 之后，后续 Peek/next 按原序弹出这些 token，无需 pushBack 重放。
// 退出条件：遇到 ; { NONE 或扫满 12 个。
// scanForOneAhead 单步预取并扫到 for 头：命中就升级 kind；只决定，不消费环。
fn scanForOneAhead(x *Parser, kind int) int {
    var t: *lex.Token = x.l.prefetch()
    if t.Type == lex.NONE {
        ret 0
    }
    if t.Type == lex.DELIMITER {
        if strings.eq(t.Value, ";") || strings.eq(t.Value, "{") {
            ret 0
        }
        if strings.eq(t.Value, ":=") && kind == 3 {
            ret 2
        }
        ret kind
    }
    if t.Type == lex.KEYWORD && strings.eq(t.Value, "range") {
        ret 1
    }
    ret kind
}

fn scanForKind(x *Parser) int {
    var kind: int = 3
    var n: int = 0
    for ; n < 12; {
        var newKind: int = scanForOneAhead(x, kind)
        if newKind == 0 {
            break
        }
        if newKind == 1 {
            kind = 1
            break
        }
        if newKind == 2 {
            kind = 2
        }
        n = n + 1
    }
    ret kind
}

// consumeToBrace 消费直到遇到 '{'（post 子句用）；遇 NONE 报错。
fn consumeToBrace(x *Parser) bool {
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, "{") {
            ret true
        }
        if t == nil || t.Type == lex.NONE {
            fail(x, ESTMT, 0)
            ret false
        }
        x.l.next()
    }
}

// parseForSemicolonCond 处理 for ; cond ; post { }：cond/post 均可为空。
fn parseForSemicolonCond(x *Parser) bool {
    x.l.next()
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, ";") {
        if !parseExpr(x) {
            ret false
        }
    }
    if !expect(x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !consumeToBrace(x) {
        ret false
    }
    ret parseBlock(x)
}

// parseForInitVarTyped 处理 `for var name: Type` 头部。
fn parseForInitVarTyped(x *Parser) bool {
    x.l.next()
    var nameT: *lex.Token = expectName(x, ESTMT)
    if nameT == nil {
        ret false
    }
    if !expect(x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    if !skipType(x) {
        ret false
    }
    ret expect(x, lex.DELIMITER, "=", ESTMT)
}

// parseForInitCondPost 处理 `= expr ; cond ; post { }`。
fn parseForInitCondPost(x *Parser) bool {
    if !parseExpr(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !parseExpr(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !consumeToBrace(x) {
        ret false
    }
    ret parseBlock(x)
}

// parseForVarInit 处理 for var name: T = expr; cond ; post { }。
fn parseForVarInit(x *Parser) bool {
    if !parseForInitVarTyped(x) {
        ret false
    }
    ret parseForInitCondPost(x)
}

// parseForRangeStmt 处理 range 形式 for i, v := range xs { }。
fn parseForRangeStmt(x *Parser) bool {
    for ; ; {
        var nt: *lex.Token = expectName(x, ESTMT)
        if nt == nil {
            ret false
        }
        if !lex.Token.is(x.l.peek(), lex.DELIMITER, ",") {
            break
        }
        x.l.next()
    }
    if !expect(x, lex.DELIMITER, ":=", ESTMT) {
        ret false
    }
    if !expectKeyword(x, "range", ESTMT) {
        ret false
    }
    if !parseExpr(x) {
        ret false
    }
    ret parseBlock(x)
}

// parseForClassicInit 处理 classic init 段（可带 var 声明或表达式 := 形式）。
fn parseForClassicInit(x *Parser) bool {
    var tInit: *lex.Token = x.l.peek()
    if lex.Token.is(tInit, lex.KEYWORD, "var") {
        x.l.next()
        ret parseVarConst(x, "var")
    }
    if !parseExpr(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, ":=", ESTMT) {
        ret false
    }
    ret parseExpr(x)
}

// parseForClassicStmt 处理 kind==2 for init ; cond ; post { }。
fn parseForClassicStmt(x *Parser) bool {
    if !parseForClassicInit(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !parseExpr(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, ";", ESTMT) {
        ret false
    }
    if !consumeToBrace(x) {
        ret false
    }
    ret parseBlock(x)
}

fn parseForStmt(x *Parser) bool {
    var kw: string = "for"
    var t: *lex.Token = x.l.peek()
    if lex.Token.is(t, lex.KEYWORD, "while") {
        kw = "while"
    }
    if !expectKeyword(x, kw, ESTMT) {
        ret false
    }
    if lex.Token.is(x.l.peek(), lex.DELIMITER, ";") {
        ret parseForSemicolonCond(x)
    }
    if lex.Token.is(x.l.peek(), lex.KEYWORD, "var") {
        ret parseForVarInit(x)
    }
    var kind: int = scanForKind(x)
    if kind == 1 {
        ret parseForRangeStmt(x)
    }
    if kind == 2 {
        ret parseForClassicStmt(x)
    }
    if atOpen(x) {
        ret parseBlock(x)
    }
    if !parseExpr(x) {
        ret false
    }
    ret parseBlock(x)
}

