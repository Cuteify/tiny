// S3 AST 对拍：常量折叠（整数/布尔/字符串/浮点一元负号）。
fn fold() int {
    var a: int = -1
    var b: int = -0x10
    var c: int = ~5
    var d: int = 2 + 3 * 4
    var e: int = 7 / 2
    var g: int = 7 % 2
    var h: int = 1 << 3
    var i: int = 5 & 3
    var j: int = 5 | 2
    var k: int = 5 ^ 3
    var l: bool = 1 < 2
    var m: bool = 1 == 1
    var n: bool = true && false
    var o: bool = !true
    var p: string = "a" + "b"
    var q: string = "ab" * 2
    var r: f64 = -2.5
    ret 0
}
