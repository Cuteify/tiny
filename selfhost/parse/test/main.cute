// selfhost parser（M1）自测 + 命令行工具。
//
// 无参数：运行内嵌的 M1 用例套件（声明计数为主），全过返回 42；
//         失败返回用例组编号，便于定位。
// 一个参数：解析该文件并打印 PARSE_OK|计数（调试方便）；错误返回 1。
import "std:console"
import "std:strings"
import parse "../"
import util "../../testutil"

fn parsed(src string) *parse.Parser {
    var r: parse.FileBlock
    var p: *parse.Parser = parse.FileBlock.mk(r, src)
    parse.FileBlock.file(r, p)
    ret p
}

fn bad(src string, want int) bool {
    var r: parse.FileBlock
    var p: *parse.Parser = parsed(src)
    if parse.FileBlock.err(r, p) != want {
        ret false
    }
    if parse.FileBlock.errPos(r, p) > strings.len(src) {
        ret false
    }
    ret true
}

// caseEmpty：空输入合法，所有计数为 0。
fn caseEmpty() int {
    var r: parse.FileBlock
    var p: *parse.Parser = parsed("")
    if parse.FileBlock.err(r, p) != parse.OK { ret 1 }
    if parse.FileBlock.declCount(r, p) != 0 { ret 2 }
    if parse.FileBlock.importCount(r, p) != 0 { ret 3 }
    if parse.FileBlock.buildCount(r, p) != 0 { ret 4 }
    if parse.FileBlock.enumCount(r, p) != 0 { ret 5 }
    if parse.FileBlock.structCount(r, p) != 0 { ret 6 }
    if parse.FileBlock.constCount(r, p) != 0 { ret 7 }
    if parse.FileBlock.varCount(r, p) != 0 { ret 8 }
    if parse.FileBlock.fnCount(r, p) != 0 { ret 9 }
    if parse.FileBlock.stmtCount(r, p) != 0 { ret 10 }
    if parse.FileBlock.exprCount(r, p) != 0 { ret 11 }
    ret 0
}

// caseDecls：import 分组、build、enum、struct、interface、别名、函数类型、
// map、旧式 struct、const/var、方法接收者（函数体按平衡跳过）。
fn caseDecls() int {
    var r: parse.FileBlock
    var src: string = ""
    src = src + `import "std:strings"` + "\n"
    src = src + `import mem "std:memory"` + "\n"
    src = src + "import (\n"
    src = src + `    "std:syscall"` + "\n"
    src = src + `    _ "std:os"` + "\n"
    src = src + ")\n"
    src = src + "build os(linux)\n"
    src = src + "enum Color {\n"
    src = src + "    RED\n"
    src = src + "    GREEN = 2\n"
    src = src + "}\n"
    src = src + "type Point struct {\n"
    src = src + "    x: int\n"
    src = src + "    y: int = 3\n"
    src = src + "}\n"
    src = src + "type Reader interface {\n"
    src = src + "    read(buf: string) int\n"
    src = src + "}\n"
    src = src + "type Alias = []int\n"
    src = src + "type Handler = fn(int) string\n"
    src = src + "type Table = map[string][]int\n"
    src = src + "struct Legacy : Base {\n"
    src = src + "    age: int\n"
    src = src + "}\n"
    src = src + "const MAX: int = 10\n"
    src = src + "var total: int = 0\n"
    src = src + "var count: int = 1\n"
    src = src + "fn Point.set(v: int) {\n"
    src = src + "    self.x = v\n"
    src = src + "}\n"
    src = src + "fn Point.get() int {\n"
    src = src + "    ret self.x\n"
    src = src + "}\n"
    var p: *parse.Parser = parsed(src)
    if parse.FileBlock.err(r, p) != parse.OK { ret 1 }
    if parse.FileBlock.declCount(r, p) != 16 { ret 2 }
    if parse.FileBlock.importCount(r, p) != 3 { ret 3 }
    if parse.FileBlock.buildCount(r, p) != 1 { ret 4 }
    if parse.FileBlock.enumCount(r, p) != 1 { ret 5 }
    if parse.FileBlock.structCount(r, p) != 2 { ret 6 }
    if parse.FileBlock.constCount(r, p) != 1 { ret 7 }
    if parse.FileBlock.varCount(r, p) != 2 { ret 8 }
    if parse.FileBlock.fnCount(r, p) != 2 { ret 9 }
    ret 0
}

// caseGrouped：分组 var/const/type 声明。
fn caseGrouped() int {
    var r: parse.FileBlock
    var src: string = ""
    src = src + "var (\n"
    src = src + "    a: int = 1\n"
    src = src + "    b: int = 2\n"
    src = src + ")\n"
    src = src + "const (\n"
    src = src + "    C: int = 1\n"
    src = src + "    D: int = 2\n"
    src = src + ")\n"
    src = src + "type (\n"
    src = src + "    P struct {\n"
    src = src + "        x: int\n"
    src = src + "    }\n"
    src = src + "    Q = []int\n"
    src = src + ")\n"
    var p: *parse.Parser = parsed(src)
    if parse.FileBlock.err(r, p) != parse.OK { ret 1 }
    if parse.FileBlock.varCount(r, p) != 2 { ret 2 }
    if parse.FileBlock.constCount(r, p) != 2 { ret 3 }
    if parse.FileBlock.structCount(r, p) != 1 { ret 4 }
    return 0
}

// caseNegative：各类语法错误必须返回对应错误码。
fn caseNegative() int {
    var brace: string = "fn f() {\n    ret 0\n"
    if !bad(brace, parse.ESTMT) { ret 1 }

    if !bad("var x: = 1\n", parse.ETYPE) { ret 2 }

    if !bad("@foo\n", parse.EDECL) { ret 3 }

    var field: string = "type P struct {\n    a:\n}\n"
    if !bad(field, parse.ETYPE) { ret 4 }

    var imp: string = "import (\n    \"std:strings\"\n"
    if !bad(imp, parse.EDECL) { ret 5 }

    if !bad("type P struct { } garbage\n", parse.EDECL) { ret 6 }

    ret 0
}

fn printCounter(name string, n int) {
    console.print("|")
    console.print(name)
    console.print("=")
    console.print(strings.itoa(n))
}

fn fileMain(path string) int {
    var r: parse.FileBlock
    // 解析 argv[1]：打印 PARSE_OK | 计数，退出码 42 / 1
    var sf: *util.SourceFile = util.loadSourceFile(path)
    if !sf.Ok {
        console.println("PARSE_TEST|READ_FAIL|")
        ret 2
    }
    var src: string = sf.Src

    var p: *parse.Parser = parse.FileBlock.mk(r, src)
    parse.FileBlock.file(r, p)
    if parse.FileBlock.err(r, p) != parse.OK {
        console.println("PARSER_SELFTEST|WRONG")
        ret 1
    }
    console.print("PARSE_OK")
    printCounter("decls", parse.FileBlock.declCount(r, p))
    printCounter("imports", parse.FileBlock.importCount(r, p))
    printCounter("builds", parse.FileBlock.buildCount(r, p))
    printCounter("enums", parse.FileBlock.enumCount(r, p))
    printCounter("structs", parse.FileBlock.structCount(r, p))
    printCounter("consts", parse.FileBlock.constCount(r, p))
    printCounter("vars", parse.FileBlock.varCount(r, p))
    printCounter("fns", parse.FileBlock.fnCount(r, p))
    printCounter("stmts", parse.FileBlock.stmtCount(r, p))
    printCounter("exprs", parse.FileBlock.exprCount(r, p))
    console.println("")
    ret 42
}

fn main() int {
    var path: string = util.arg1()
    if len(path) != 0 {
        ret fileMain(path)
    }
    var r: int = caseEmpty()
    if r != 0 { ret 1 }
    r = caseDecls()
    if r != 0 { ret 2 }
    r = caseGrouped()
    if r != 0 { ret 3 }
    r = caseNegative()
    if r != 0 { ret 4 }
    ret 42
}
