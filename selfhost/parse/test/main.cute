// selfhost parser（M1）自测 + 命令行工具。
//
// 无参数：运行内嵌的 M1 用例套件（声明计数为主），全过返回 42；
//         失败返回用例组编号，便于定位。
// 一个参数：解析该文件并打印 PARSE_OK|计数（调试方便）；错误返回 1。
import "std:memory"
import "std:console"
import "std:strings"
import "std:syscall"
import parse "../"

fn parsed(src string) *parse.Parser {
    var p: *parse.Parser = parse.mk(src)
    parse.file(p)
    ret p
}

fn bad(src string, want int) bool {
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != want {
        ret false
    }
    if parse.errPos(p) > strings.len(src) {
        ret false
    }
    ret true
}

// caseEmpty：空输入合法，所有计数为 0。
fn caseEmpty() int {
    var p: *parse.Parser = parsed("")
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 0 { ret 2 }
    if parse.importCount(p) != 0 { ret 3 }
    if parse.buildCount(p) != 0 { ret 4 }
    if parse.enumCount(p) != 0 { ret 5 }
    if parse.structCount(p) != 0 { ret 6 }
    if parse.constCount(p) != 0 { ret 7 }
    if parse.varCount(p) != 0 { ret 8 }
    if parse.fnCount(p) != 0 { ret 9 }
    if parse.stmtCount(p) != 0 { ret 10 }
    if parse.exprCount(p) != 0 { ret 11 }
    ret 0
}

// caseDecls：import 分组、build、enum、struct、interface、别名、函数类型、
// map、旧式 struct、const/var、方法接收者（函数体按平衡跳过）。
fn caseDecls() int {
    var src: string = ""
    src = src + `import "std:strings"` + "\n"
    src = src + `import mem "std:memory"` + "\n"
    src = src + "import (\n"
    src = src + `    "std:syscall"` + "\n"
    src = src + `    _ "std:os"` + "\n"
    src = src + ")\n"
    src = src + "build os(linux)\n"
    src = src + "enum Color {\n"
    src = src + "    RED\n"
    src = src + "    GREEN = 2\n"
    src = src + "}\n"
    src = src + "type Point struct {\n"
    src = src + "    x: int\n"
    src = src + "    y: int = 3\n"
    src = src + "}\n"
    src = src + "type Reader interface {\n"
    src = src + "    read(buf: string) int\n"
    src = src + "}\n"
    src = src + "type Alias = []int\n"
    src = src + "type Handler = fn(int) string\n"
    src = src + "type Table = map[string][]int\n"
    src = src + "struct Legacy : Base {\n"
    src = src + "    age: int\n"
    src = src + "}\n"
    src = src + "const MAX: int = 10\n"
    src = src + "var total: int = 0\n"
    src = src + "var count: int = 1\n"
    src = src + "fn Point.set(v: int) {\n"
    src = src + "    self.x = v\n"
    src = src + "}\n"
    src = src + "fn Point.get() int {\n"
    src = src + "    ret self.x\n"
    src = src + "}\n"
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 16 { ret 2 }
    if parse.importCount(p) != 3 { ret 3 }
    if parse.buildCount(p) != 1 { ret 4 }
    if parse.enumCount(p) != 1 { ret 5 }
    if parse.structCount(p) != 2 { ret 6 }
    if parse.constCount(p) != 1 { ret 7 }
    if parse.varCount(p) != 2 { ret 8 }
    if parse.fnCount(p) != 2 { ret 9 }
    ret 0
}

// caseGrouped：分组 var/const/type 声明。
fn caseGrouped() int {
    var src: string = ""
    src = src + "var (\n"
    src = src + "    a: int = 1\n"
    src = src + "    b: int = 2\n"
    src = src + ")\n"
    src = src + "const (\n"
    src = src + "    C: int = 1\n"
    src = src + "    D: int = 2\n"
    src = src + ")\n"
    src = src + "type (\n"
    src = src + "    P struct {\n"
    src = src + "        x: int\n"
    src = src + "    }\n"
    src = src + "    Q = []int\n"
    src = src + ")\n"
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != parse.OK { ret 1 }
    if parse.varCount(p) != 2 { ret 2 }
    if parse.constCount(p) != 2 { ret 3 }
    if parse.structCount(p) != 1 { ret 4 }
    return 0
}

// caseNegative：各类语法错误必须返回对应错误码。
fn caseNegative() int {
    var brace: string = "fn f() {\n    ret 0\n"
    if !bad(brace, parse.ESTMT) { ret 1 }

    if !bad("var x: = 1\n", parse.ETYPE) { ret 2 }

    if !bad("@foo\n", parse.EDECL) { ret 3 }

    var field: string = "type P struct {\n    a:\n}\n"
    if !bad(field, parse.ETYPE) { ret 4 }

    var imp: string = "import (\n    \"std:strings\"\n"
    if !bad(imp, parse.EDECL) { ret 5 }

    if !bad("type P struct { } garbage\n", parse.EDECL) { ret 6 }

    ret 0
}

fn printCounter(name string, n int) {
    console.print("|")
    console.print(name)
    console.print("=")
    console.print(strings.itoa(n))
}

fn fileMain() int {
    // 解析 argv[1]：打印 PARSE_OK | 计数，退出码 42 / 1
    var argbuf: ptr = memory.malloc(65536)
    var tfd: i32 = syscall.open(strings.toCstring("/proc/self/cmdline"), 0, 0)
    var total: u64 = 0
    if tfd >= 0 {
        var n: i32 = syscall.read(tfd, argbuf, 65536)
        if n > 0 {
            total = u64(n)
        }
        syscall.close(tfd)
    }
    var i: u64 = 0
    for ; i < total; {
        var p1: *u8 = argbuf + i
        if *p1 == 0 {
            i = i + 1
            break
        }
        i = i + 1
    }
    if i >= total {
        memory.free(argbuf)
        console.println("PARSE_TEST|USAGE: 需要一个 .cute 源文件参数")
        ret 2
    }
    var argStart: u64 = i
    var argEnd: u64 = i
    for ; argEnd < total; {
        var p2: *u8 = argbuf + argEnd
        if *p2 == 0 {
            break
        }
        argEnd = argEnd + 1
    }
    var path: string = strings.view(argbuf + argStart, argEnd - argStart, argEnd - argStart)

    // 读源文件（同 M0 已验证的 u64 原始返回值绕过 i32 零扩展比较的问题）
    var rawfd: u64 = syscall.syscall64(2, strings.toCstring(path), 0, 0, 0, 0)
    if rawfd > 9223372036854775807 {
        memory.free(argbuf)
        console.println("PARSE_TEST|READ_FAIL|")
        ret 2
    }
    var srcfd: i32 = unsafe.cast[i32](rawfd)
    var scr: string = new(string, 65536)
    var sp: *u8 = unsafe.cast[*u8](scr)
    var pos: uint = 0
    for ; pos < 65536; {
        var n: i32 = syscall.read(srcfd, unsafe.cast[ptr](sp) + pos, 65536 - pos)
        if n <= 0 {
            break
        }
        pos = pos + unsafe.cast[uint](n)
    }
    syscall.close(srcfd)
    memory.free(argbuf)
    var src: string = strings.view(unsafe.cast[ptr](sp), pos, pos)

    var p: *parse.Parser = parse.mk(src)
    parse.file(p)
    if parse.err(p) != parse.OK {
        console.println("PARSER_SELFTEST|WRONG")
        ret 1
    }
    console.print("PARSE_OK")
    printCounter("decls", parse.declCount(p))
    printCounter("imports", parse.importCount(p))
    printCounter("builds", parse.buildCount(p))
    printCounter("enums", parse.enumCount(p))
    printCounter("structs", parse.structCount(p))
    printCounter("consts", parse.constCount(p))
    printCounter("vars", parse.varCount(p))
    printCounter("fns", parse.fnCount(p))
    printCounter("stmts", parse.stmtCount(p))
    printCounter("exprs", parse.exprCount(p))
    console.println("")
    ret 42
}

fn hasArg() bool {
    var argbuf: ptr = memory.malloc(65536)
    var tfd: i32 = syscall.open(strings.toCstring("/proc/self/cmdline"), 0, 0)
    var total: u64 = 0
    if tfd >= 0 {
        var n: i32 = syscall.read(tfd, argbuf, 65536)
        if n > 0 {
            total = u64(n)
        }
        syscall.close(tfd)
    }
    var i: u64 = 0
    for ; i < total; {
        var p1: *u8 = argbuf + i
        if *p1 == 0 {
            i = i + 1
            break
        }
        i = i + 1
    }
    memory.free(argbuf)
    ret i < total
}

fn main() int {
    if hasArg() {
        ret fileMain()
    }
    var r: int = caseEmpty()
    if r != 0 { ret 1 }
    r = caseDecls()
    if r != 0 { ret 2 }
    r = caseGrouped()
    if r != 0 { ret 3 }
    r = caseNegative()
    if r != 0 { ret 4 }
    ret 42
}
