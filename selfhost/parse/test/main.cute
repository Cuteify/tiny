// selfhost parser M0 骨架驱动：能编译、能解析、能报告计数。
// 参考 selfhost/lexer/test/main.cute 的参数与文件读取方式。
import "std:memory"
import "std:console"
import "std:strings"
import "std:syscall"
import parse "../"

fn main() int {
    // 命令行：/proc/self/cmdline 格式为 "argv[0]\0argv[1]\0..."
    var argbuf: ptr = memory.malloc(65536)
    var tfd: i32 = syscall.open(strings.toCstring("/proc/self/cmdline"), 0, 0)
    var total: u64 = 0
    if tfd >= 0 {
        var n: i32 = syscall.read(tfd, argbuf, 65536)
        if n > 0 {
            total = u64(n)
        }
        syscall.close(tfd)
    }
    // 跳过 argv[0]（到第一个 '\0'）
    var i: u64 = 0
    for ; i < total; {
        var p1: *u8 = argbuf + i
        if *p1 == 0 {
            i = i + 1
            break
        }
        i = i + 1
    }
    if i >= total {
        memory.free(argbuf)
        console.println("PARSER_SELFTEST|USAGE: 需要一个源文件参数")
        ret 2
    }
    var argStart: u64 = i
    var argEnd: u64 = i
    for ; argEnd < total; {
        var p2: *u8 = argbuf + argEnd
        if *p2 == 0 {
            break
        }
        argEnd = argEnd + 1
    }
    var path: string = strings.view(argbuf + argStart, argEnd - argStart, argEnd - argStart)

    // 读源文件
    // 注意：syscall 系的 i32 返回值经内存读回后高 32 位零扩展，负错误码
    // 会被判为正数（cuteify codegen 通用 bug）。这里直接读 u64 原始返回值：
    // bit 63 = 1 表示内核返回了负错误码。
    var rawfd: u64 = syscall.syscall64(2, strings.toCstring(path), 0, 0, 0, 0)
    if rawfd > 9223372036854775807 {
        memory.free(argbuf)
        console.println("PARSER_SELFTEST|READ_FAIL|")
        ret 2
    }
    var srcfd: i32 = unsafe.cast[i32](rawfd)
    var scr: string = new(string, 65536)
    var sp: *u8 = unsafe.cast[*u8](scr)
    var pos: uint = 0
    for ; pos < 65536; {
        var n: i32 = syscall.read(srcfd, unsafe.cast[ptr](sp) + pos, 65536 - pos)
        if n <= 0 {
            break
        }
        pos = pos + unsafe.cast[uint](n)
    }
    syscall.close(srcfd)
    memory.free(argbuf)
    var src: string = strings.view(unsafe.cast[ptr](sp), pos, pos)

    // 解析
    var p: *parse.Parser = parse.mk(src)
    parse.file(p)
    if parse.err(p) != parse.OK {
        console.println("WRONG")
        ret 1
    }
    console.println("OK")
    ret 42
}
