// Cuteify 自举 parser 行为测试（S2）。
//
// 运行（仓库根目录）：
//   scripts/selfhost_parse.sh x86_64
// 或已构建 parsedump 时：
//   parsedump < selfhost/parse/test/main.cute
//
// 约定：返回 42 表示全部通过；其它值表示失败用例编号。
// 换行直接用 "\n"（双引号字符串支持转义）。
import "std:memory"
import "std:strings"
import parse "../"

// parsed 解析一段源码并返回 parser（无论成功还是失败）。
fn parsed(src string) *parse.Parser {
    var p: *parse.Parser = parse.mk(src)
    parse.file(p)
    ret p
}

// bad 断言源码报指定错误码，且错误位置落在源码范围内。
fn bad(src string, want int) bool {
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != want {
        ret false
    }
    if parse.errPos(p) > strings.len(src) {
        ret false
    }
    ret true
}

// caseEmpty：空输入合法，所有计数为 0。
fn caseEmpty() int {
    var p: *parse.Parser = parsed("")
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 0 { ret 2 }
    if parse.importCount(p) != 0 { ret 3 }
    if parse.buildCount(p) != 0 { ret 4 }
    if parse.enumCount(p) != 0 { ret 5 }
    if parse.structCount(p) != 0 { ret 6 }
    if parse.constCount(p) != 0 { ret 7 }
    if parse.varCount(p) != 0 { ret 8 }
    if parse.fnCount(p) != 0 { ret 9 }
    if parse.stmtCount(p) != 0 { ret 10 }
    if parse.exprCount(p) != 0 { ret 11 }
    ret 0
}

// caseLexErr：未闭合字符串必须作为词法错误上报，不能被当成 EOF。
fn caseLexErr() int {
    var src: string = ""
    src = src + "fn f() {" + "\n"
    src = src + `    var s: string = "abc` + "\n"
    src = src + "}" + "\n"
    if !bad(src, parse.ETOK) { ret 1 }
    ret 0
}

// caseNewline：换行保留为语句边界；行首 `*q` 必须是解引用而不是乘法。
fn caseNewline() int {
    var src: string = ""
    src = src + "fn f() int {" + "\n"
    src = src + "    var q: *int = 0" + "\n"
    src = src + "    var x: int = 1" + "\n"
    src = src + "    x = x + 2" + "\n"
    src = src + "    *q = x" + "\n"
    src = src + "    ret x" + "\n"
    src = src + "}" + "\n"
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 1 { ret 2 }
    if parse.varCount(p) != 2 { ret 3 }
    if parse.fnCount(p) != 1 { ret 4 }
    if parse.stmtCount(p) != 5 { ret 5 }
    if parse.exprCount(p) != 8 { ret 6 }
    ret 0
}

// caseDecls：import 分组、build、enum、struct、interface、别名、
// 函数类型、map、旧式 struct、const/var、两种方法接收者。
fn caseDecls() int {
    var src: string = ""
    src = src + `import "std:strings"` + "\n"
    src = src + `import mem "std:memory"` + "\n"
    src = src + "import (" + "\n"
    src = src + `    "std:syscall"` + "\n"
    src = src + `    _ "std:os"` + "\n"
    src = src + ")" + "\n"
    src = src + "build os(linux)" + "\n"
    src = src + "enum Color {" + "\n"
    src = src + "    RED" + "\n"
    src = src + "    GREEN = 2" + "\n"
    src = src + "}" + "\n"
    src = src + "type Point struct {" + "\n"
    src = src + "    pub x: int" + "\n"
    src = src + "    y: int = 3" + "\n"
    src = src + "    @Extra" + "\n"
    src = src + "}" + "\n"
    src = src + "type Reader interface {" + "\n"
    src = src + "    read(buf: string) int" + "\n"
    src = src + "}" + "\n"
    src = src + "type Alias = []int" + "\n"
    src = src + "type Handler = fn(int) string" + "\n"
    src = src + "type Table = map[string][]int" + "\n"
    src = src + "struct Legacy : Base {" + "\n"
    src = src + "    priv age: int" + "\n"
    src = src + "}" + "\n"
    src = src + "const MAX: int = 10" + "\n"
    src = src + "var total: int = 0" + "\n"
    src = src + "var count: int = 1" + "\n"
    src = src + "fn (self Point) get() int {" + "\n"
    src = src + "    ret self.x" + "\n"
    src = src + "}" + "\n"
    src = src + "fn Point.set(v int) {" + "\n"
    src = src + "    self.x = v" + "\n"
    src = src + "}" + "\n"
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 16 { ret 2 }
    if parse.importCount(p) != 3 { ret 3 }
    if parse.buildCount(p) != 1 { ret 4 }
    if parse.enumCount(p) != 1 { ret 5 }
    if parse.structCount(p) != 2 { ret 6 }
    if parse.constCount(p) != 1 { ret 7 }
    if parse.varCount(p) != 2 { ret 8 }
    if parse.fnCount(p) != 2 { ret 9 }
    if parse.stmtCount(p) != 2 { ret 10 }
    if parse.exprCount(p) != 10 { ret 11 }
    ret 0
}

// caseStmts：if/else-if/else、switch、range、三种 for、defer、多左值。
fn caseStmts() int {
    var src: string = ""
    src = src + "fn f(xs: []int) int {" + "\n"
    src = src + "    var total: int = 0" + "\n"
    src = src + "    var q: int = 0" + "\n"
    src = src + "    var r: int = 0" + "\n"
    src = src + "    q, r := pair()" + "\n"
    src = src + "    for i, v := range xs {" + "\n"
    src = src + "        if i > 3 {" + "\n"
    src = src + "            total = total + v" + "\n"
    src = src + "        } else if i == 0 {" + "\n"
    src = src + "            total = total - 1" + "\n"
    src = src + "        } else {" + "\n"
    src = src + "            total = total + 1" + "\n"
    src = src + "        }" + "\n"
    src = src + "    }" + "\n"
    src = src + "    switch total {" + "\n"
    src = src + "    case 0, 1:" + "\n"
    src = src + "        total = 2" + "\n"
    src = src + "    default:" + "\n"
    src = src + "        total = total + 3" + "\n"
    src = src + "    }" + "\n"
    src = src + "    for j := 0; j < 3; j++ {" + "\n"
    src = src + "        total += j" + "\n"
    src = src + "    }" + "\n"
    src = src + "    for total > 0 {" + "\n"
    src = src + "        break" + "\n"
    src = src + "    }" + "\n"
    src = src + "    defer cleanup(total)" + "\n"
    src = src + "    ret total" + "\n"
    src = src + "}" + "\n"
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 1 { ret 2 }
    if parse.varCount(p) != 3 { ret 3 }
    if parse.fnCount(p) != 1 { ret 4 }
    if parse.stmtCount(p) != 18 { ret 5 }
    if parse.exprCount(p) != 42 { ret 6 }
    ret 0
}

// caseExprs：优先级、一元、复合字面量、索引/切片/选择器、字符字面量。
fn caseExprs() int {
    var src: string = ""
    src = src + "fn f(a int, b int) int {" + "\n"
    src = src + "    var m: int = (a + b) * 2 - a / b % 3" + "\n"
    src = src + "    var ok: bool = a < b && b >= 0 || !false" + "\n"
    src = src + "    var bits: int = (a << 2) | (b & 7) ^ 1" + "\n"
    src = src + "    var s: []int = []int{1, 2 + 3, 4}" + "\n"
    src = src + "    var fixed: [3]int = [3]int{5, 6, 7}" + "\n"
    src = src + "    var p: *int = new(int)" + "\n"
    src = src + "    var v: int = s[0] + s[1:2][0] + p.x" + "\n"
    src = src + "    var c: int = 'x'" + "\n"
    src = src + "    if ok {" + "\n"
    src = src + "        ret bits" + "\n"
    src = src + "    }" + "\n"
    src = src + "    ret m + v + c" + "\n"
    src = src + "}" + "\n"
    var p: *parse.Parser = parsed(src)
    if parse.err(p) != parse.OK { ret 1 }
    if parse.declCount(p) != 1 { ret 2 }
    if parse.varCount(p) != 8 { ret 3 }
    if parse.fnCount(p) != 1 { ret 4 }
    if parse.stmtCount(p) != 11 { ret 5 }
    // new(int) 的类型实参存入 NewType，不按表达式计数（Go canonical
    // AST 的 CALL name=new 也没有 ARG），因此这里是 42 而不是 43。
    if parse.exprCount(p) != 42 { ret 6 }
    ret 0
}

// caseNegative：各类语法错误必须返回对应错误码。
fn caseNegative() int {
    var brace: string = "fn f() {" + "\n" + "    ret 0" + "\n"
    if !bad(brace, parse.ESTMT) { ret 1 }

    if !bad("var x: = 1" + "\n", parse.ETYPE) { ret 2 }

    var expr: string = "fn f() {" + "\n" + "    ret 1 +" + "\n" + "}" + "\n"
    if !bad(expr, parse.EEXPR) { ret 3 }

    if !bad("@foo" + "\n", parse.EDECL) { ret 4 }

    var field: string = "type P struct {" + "\n" + "    a:" + "\n" + "}" + "\n"
    if !bad(field, parse.ETYPE) { ret 5 }

    var imp: string = "import (" + "\n" + `    "std:strings"` + "\n"
    if !bad(imp, parse.EDECL) { ret 6 }
    ret 0
}

fn main() int {
    var r: int = caseEmpty()
    if r != 0 { ret 1 }
    r = caseLexErr()
    if r != 0 { ret 2 }
    r = caseNewline()
    if r != 0 { ret 3 }
    r = caseDecls()
    if r != 0 { ret 4 }
    r = caseStmts()
    if r != 0 { ret 5 }
    r = caseExprs()
    if r != 0 { ret 6 }
    r = caseNegative()
    if r != 0 { ret 7 }
    ret 42
}
