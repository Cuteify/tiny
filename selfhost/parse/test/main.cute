// selfhost parser（M1）自测 + 命令行工具。
//
// 无参数：运行内嵌的 M1 用例套件（声明计数为主），全过返回 42；
//         失败返回用例组编号，便于定位。
// 一个参数：解析该文件并打印 PARSE_OK|计数（调试方便）；错误返回 1。
import "std:console"
import "std:strings"
import parse "../"
import util "../../testutil"

fn parsed(src string) *parse.Parser {
    var r: parse.FileBlock
    var p: *parse.Parser = r.mk( src)
    r.file( p)
    ret p
}

fn bad(src string, want int) bool {
    var r: parse.FileBlock
    var p: *parse.Parser = parsed(src)
    if r.err( p) != want {
        ret false
    }
    if r.errPos( p) > strings.len(src) {
        ret false
    }
    ret true
}

// ok 合法源返回 true（err 为 OK）。
fn ok(src string) bool {
    var r: parse.FileBlock
    var p: *parse.Parser = parsed(src)
    ret r.err( p) == parse.OK
}

// caseEmpty：空输入合法，所有计数为 0。
fn caseEmpty() int {
    var r: parse.FileBlock
    var p: *parse.Parser = parsed("")
    if r.err( p) != parse.OK { ret 1 }
    if r.declCount( p) != 0 { ret 2 }
    if r.importCount( p) != 0 { ret 3 }
    if r.buildCount( p) != 0 { ret 4 }
    if r.enumCount( p) != 0 { ret 5 }
    if r.structCount( p) != 0 { ret 6 }
    if r.constCount( p) != 0 { ret 7 }
    if r.varCount( p) != 0 { ret 8 }
    if r.fnCount( p) != 0 { ret 9 }
    if r.stmtCount( p) != 0 { ret 10 }
    if r.exprCount( p) != 0 { ret 11 }
    ret 0
}

// caseDecls：import 分组、build、enum、struct、interface、别名、函数类型、
// map、旧式 struct、const/var、方法接收者（函数体按平衡跳过）。
fn caseDecls() int {
    var r: parse.FileBlock
    var src: string = ""
    src = src + `import "std:strings"` + "\n"
    src = src + `import mem "std:memory"` + "\n"
    src = src + "import (\n"
    src = src + `    "std:syscall"` + "\n"
    src = src + `    _ "std:os"` + "\n"
    src = src + ")\n"
    src = src + "build os(linux)\n"
    src = src + "enum Color {\n"
    src = src + "    RED\n"
    src = src + "    GREEN = 2\n"
    src = src + "}\n"
    src = src + "type Point struct {\n"
    src = src + "    x: int\n"
    src = src + "    y: int = 3\n"
    src = src + "}\n"
    src = src + "type Reader interface {\n"
    src = src + "    read(buf: string) int\n"
    src = src + "}\n"
    src = src + "type Alias = []int\n"
    src = src + "type Handler = fn(int) string\n"
    src = src + "type Table = map[string][]int\n"
    src = src + "struct Legacy : Base {\n"
    src = src + "    age: int\n"
    src = src + "}\n"
    src = src + "const MAX: int = 10\n"
    src = src + "var total: int = 0\n"
    src = src + "var count: int = 1\n"
    src = src + "fn Point.set(self, v: int) {\n"
    src = src + "    self.x = v\n"
    src = src + "}\n"
    src = src + "fn Point.get(self) int {\n"
    src = src + "    ret self.x\n"
    src = src + "}\n"
    var p: *parse.Parser = parsed(src)
    if r.err( p) != parse.OK { ret 1 }
    if r.declCount( p) != 16 { ret 2 }
    if r.importCount( p) != 3 { ret 3 }
    if r.buildCount( p) != 1 { ret 4 }
    if r.enumCount( p) != 1 { ret 5 }
    if r.structCount( p) != 2 { ret 6 }
    if r.constCount( p) != 1 { ret 7 }
    if r.varCount( p) != 2 { ret 8 }
    if r.fnCount( p) != 2 { ret 9 }
    ret 0
}

// caseGrouped：分组 var/const/type 声明。
fn caseGrouped() int {
    var r: parse.FileBlock
    var src: string = ""
    src = src + "var (\n"
    src = src + "    a: int = 1\n"
    src = src + "    b: int = 2\n"
    src = src + ")\n"
    src = src + "const (\n"
    src = src + "    C: int = 1\n"
    src = src + "    D: int = 2\n"
    src = src + ")\n"
    src = src + "type (\n"
    src = src + "    P struct {\n"
    src = src + "        x: int\n"
    src = src + "    }\n"
    src = src + "    Q = []int\n"
    src = src + ")\n"
    var p: *parse.Parser = parsed(src)
    if r.err( p) != parse.OK { ret 1 }
    if r.varCount( p) != 2 { ret 2 }
    if r.constCount( p) != 2 { ret 3 }
    if r.structCount( p) != 1 { ret 4 }
    return 0
}

// caseNegative：各类语法错误必须返回对应错误码。
fn caseNegative() int {
    var brace: string = "fn f() {\n    ret 0\n"
    if !bad(brace, parse.ESTMT) { ret 1 }

    if !bad("var x: = 1\n", parse.ETYPE) { ret 2 }

    if !bad("@foo\n", parse.EDECL) { ret 3 }

    var field: string = "type P struct {\n    a:\n}\n"
    if !bad(field, parse.ETYPE) { ret 4 }

    var imp: string = "import (\n    \"std:strings\"\n"
    if !bad(imp, parse.EDECL) { ret 5 }

    if !bad("type P struct { } garbage\n", parse.EDECL) { ret 6 }

    ret 0
}

// caseCheck：S4 Check 阶段登记验证（重复声明 / Useful / 接口登记 / 登记计数）。
fn caseCheck() int {
    // 1) 同名 fn 重复声明 → EDECL。
    var dup: string = "fn f() {\n    ret 0\n}\nfn f() {\n    ret 1\n}\n"
    if !bad(dup, parse.EDECL) { ret 1 }

    // 2) 不同 receiver 的同名方法不误报（P.get 与 Q.get）。
    var msrc: string = "type P int\ntype Q int\nfn P.get() int {\n    ret 1\n}\nfn Q.get() int {\n    ret 2\n}\nfn main() int {\n    ret 0\n}\n"
    if !ok(msrc) { ret 2 }

    // 3) 接口登记：两条接口、方法顺序保序、方法名带尾逗号。
    var isrc: string = "type Stringer interface {\n    stringify() string\n}\ntype R interface {\n    read(buf: string) int\n    size() int\n    reset()\n}\nfn main() int {\n    ret 0\n}\n"
    var r: parse.FileBlock
    var p: *parse.Parser = parsed(isrc)
    if r.err( p) != parse.OK { ret 3 }
    if r.ifaceDefCount( p) != 2 { ret 4 }
    if !strings.eq(r.ifaceDefAt( p, 0), "Stringer:stringify,") { ret 5 }
    if !strings.eq(r.ifaceDefAt( p, 1), "R:read,size,reset,") { ret 6 }

    // 4) unusedFnCount：未引用的 fn 计为未 Useful，main 与被引用的计入。
    var us: string = "fn usedFn() int {\n    ret 1\n}\nfn unusedFn() int {\n    ret 2\n}\nfn main() int {\n    ret usedFn()\n}\n"
    var p4: *parse.Parser = parsed(us)
    if r.err( p4) != parse.OK { ret 7 }
    if r.unusedFnCount( p4) != 1 { ret 8 }

    // 5) registeredDeclCount：us 源恰 3 个 fn。
    if r.registeredDeclCount( p4) != 3 { ret 9 }

    // 6) main 恒为 Useful：us 源没有 main → unused = 0 的反例场景。
    var nm: string = "fn main() int {\n    ret 0\n}\n"
    var p5: *parse.Parser = parsed(nm)
    if r.unusedFnCount( p5) != 0 { ret 10 }

    ret 0
}

fn printCounter(name string, n int) {
    console.print("|")
    console.print(name)
    console.print("=")
    console.print(strings.itoa(n))
}

fn fileMain(path string) int {
    var r: parse.FileBlock
    // 解析 argv[1]：打印 PARSE_OK | 计数，退出码 42 / 1
    var sf: *util.SourceFile = util.loadSourceFile(path)
    if !sf.Ok {
        console.println("PARSE_TEST|READ_FAIL|")
        ret 2
    }
    var src: string = sf.Src

    var p: *parse.Parser = r.mk( src)
    r.file( p)
    if r.err( p) != parse.OK {
        console.println("PARSER_SELFTEST|WRONG")
        ret 1
    }
    console.print("PARSE_OK")
    printCounter("decls", r.declCount( p))
    printCounter("imports", r.importCount( p))
    printCounter("builds", r.buildCount( p))
    printCounter("enums", r.enumCount( p))
    printCounter("structs", r.structCount( p))
    printCounter("consts", r.constCount( p))
    printCounter("vars", r.varCount( p))
    printCounter("fns", r.fnCount( p))
    printCounter("stmts", r.stmtCount( p))
    printCounter("exprs", r.exprCount( p))
    console.println("")
    ret 42
}

fn main() int {
    var path: string = util.arg1()
    if len(path) != 0 {
        ret fileMain(path)
    }
    var r: int = caseEmpty()
    if r != 0 { ret 1 }
    r = caseDecls()
    if r != 0 { ret 2 }
    r = caseGrouped()
    if r != 0 { ret 3 }
    r = caseNegative()
    if r != 0 { ret 4 }
    r = caseCheck()
    if r != 0 { ret 5 }
    ret 42
}
