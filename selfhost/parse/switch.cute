// switch.cute —— switch/case/default；fallthrough 由上游 case 注入。
// 加载顺序：依赖 helpers.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

fn atCaseOrClose(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if lex.Token.is(t, lex.KEYWORD, "case") || lex.Token.is(t, lex.KEYWORD, "default") {
        ret true
    }
    ret lex.Token.is(t, lex.DELIMITER, "}")
}

// parseCaseBody 解析 case/default 分支的语句（直到 case/default/}）。
fn parseCaseBody(x *Parser) bool {
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil || t.Type == lex.NONE {
            fail(x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.KEYWORD, "case") || lex.Token.is(t, lex.KEYWORD, "default") {
            ret true
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            ret true
        }
        if !parseStmt(x) {
            ret false
        }
    }
}

// parseSwitchStmt 解析 switch 语句（无目标 switch / 带目标）。
fn parseSwitchStmt(x *Parser) bool {
    if !expectKeyword(x, "switch", ESTMT) {
        ret false
    }
    var t: *lex.Token = x.l.peek()
    if !lex.Token.is(t, lex.DELIMITER, "{") {
        if !parseExpr(x) {
            ret false
        }
    }
    if !expect(x, lex.DELIMITER, "{", ESTMT) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t2: *lex.Token = x.l.peek()
        if lex.Token.is(t2, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if lex.Token.is(t2, lex.KEYWORD, "case") {
            x.l.next()
            for ; ; {
                if !parseExpr(x) {
                    ret false
                }
                if lex.Token.is(x.l.peek(), lex.DELIMITER, ",") {
                    x.l.next()
                    continue
                }
                break
            }
            if !expect(x, lex.DELIMITER, ":", ESTMT) {
                ret false
            }
            if !parseCaseBody(x) {
                ret false
            }
            continue
        }
        if lex.Token.is(t2, lex.KEYWORD, "default") {
            x.l.next()
            if !expect(x, lex.DELIMITER, ":", ESTMT) {
                ret false
            }
            if !parseCaseBody(x) {
                ret false
            }
            continue
        }
        fail(x, ESTMT, t2.Pos)
        ret false
    }
}
