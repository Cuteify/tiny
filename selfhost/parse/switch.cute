// switch.cute —— switch/case/default；fallthrough 由上游 case 注入。
// 加载顺序：依赖 helpers.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

// isCaseClauseKeyword case 或 default。
fn SwitchBlock.isCaseClauseKeyword(r SwitchBlock, kw string) bool {
    ret strings.eq(kw, "case") || strings.eq(kw, "default")
}

// atClauseBoundary 是否到了 case 端尾部（case/default/}/EOF/NONE）。
fn SwitchBlock.atClauseBoundary(r SwitchBlock, t *lex.Token) bool {
    if t == nil || t.Type == lex.NONE {
        ret true
    }
    if SwitchBlock.isCaseClauseKeyword(r, t.Value) {
        ret true
    }
    ret lex.Token.is(t, lex.DELIMITER, "}")
}

// parseCaseBody 解析 case/default 分支的语句（直到 case/default/}）。
fn SwitchBlock.parseCaseBody(r SwitchBlock, x *Parser) bool {
    var stmtBlock: StmtBlock
    for ; ; {
        x.l.skipTerminators()
        if SwitchBlock.atClauseBoundary(r, x.l.peek()) {
            ret true
        }
        if !StmtBlock.parseStmt(stmtBlock, x) {
            ret false
        }
    }
}

// parseCaseValues 解析一个 case 后的表达式列表，逗号分隔。
fn SwitchBlock.parseCaseValues(r SwitchBlock, x *Parser) bool {
    for ; ; {
        var eb: ExpBlock
        if !ExpBlock.parseExpr(eb, x) {
            ret false
        }
        if !lex.Token.is(x.l.peek(), lex.DELIMITER, ",") {
            ret true
        }
        x.l.next()
    }
}

// parseOneCase 解析 `case a, b, ...: body`。
fn SwitchBlock.parseOneCase(r SwitchBlock, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    if !SwitchBlock.parseCaseValues(r, x) {
        ret false
    }
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    ret SwitchBlock.parseCaseBody(r, x)
}

// parseDefaultClause 解析 `default: body`。
fn SwitchBlock.parseDefaultClause(r SwitchBlock, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    ret SwitchBlock.parseCaseBody(r, x)
}

// parseSwitchClause 解析一个 case/default 从句。
fn SwitchBlock.parseSwitchClause(r SwitchBlock, x *Parser) bool {
    if lex.Token.is(x.l.peek(), lex.KEYWORD, "case") {
        ret SwitchBlock.parseOneCase(r, x)
    }
    if lex.Token.is(x.l.peek(), lex.KEYWORD, "default") {
        ret SwitchBlock.parseDefaultClause(r, x)
    }
    ret false
}

fn SwitchBlock.parseSwitchStmt(r SwitchBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if !FileBlock.expectKeyword(fileBlock, x, "switch", ESTMT) {
        ret false
    }
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, "{") {
        var eb: ExpBlock
        if !ExpBlock.parseExpr(eb, x) {
            ret false
        }
    }
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", ESTMT) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t2: *lex.Token = x.l.peek()
        if lex.Token.is(t2, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if SwitchBlock.isCaseClauseKeyword(r, t2.Value) {
            if !SwitchBlock.parseSwitchClause(r, x) {
                ret false
            }
            continue
        }
        FileBlock.fail(fileBlock, x, ESTMT, t2.Pos)
        ret false
    }
}