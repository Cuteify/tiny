// switch.cute —— switch/case/default；fallthrough 由上游 case 注入。
// 加载顺序：依赖 helpers.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

// isCaseClauseKeyword case 或 default。
fn isCaseClauseKeyword(kw string) bool {
    ret strings.eq(kw, "case") || strings.eq(kw, "default")
}

// atClauseBoundary 是否到了 case 端尾部（case/default/}/EOF/NONE）。
fn atClauseBoundary(t *lex.Token) bool {
    if t == nil || t.Type == lex.NONE {
        ret true
    }
    if isCaseClauseKeyword(t.Value) {
        ret true
    }
    ret lex.Token.is(t, lex.DELIMITER, "}")
}

// parseCaseBody 解析 case/default 分支的语句（直到 case/default/}）。
fn parseCaseBody(x *Parser) bool {
    for ; ; {
        x.l.skipTerminators()
        if atClauseBoundary(x.l.peek()) {
            ret true
        }
        if !parseStmt(x) {
            ret false
        }
    }
}

// parseCaseValues 解析一个 case 后的表达式列表，逗号分隔。
fn parseCaseValues(x *Parser) bool {
    for ; ; {
        if !parseExpr(x) {
            ret false
        }
        if !lex.Token.is(x.l.peek(), lex.DELIMITER, ",") {
            ret true
        }
        x.l.next()
    }
}

// parseOneCase 解析 `case a, b, ...: body`。
fn parseOneCase(x *Parser) bool {
    x.l.next()
    if !parseCaseValues(x) {
        ret false
    }
    if !expect(x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    ret parseCaseBody(x)
}

// parseDefaultClause 解析 `default: body`。
fn parseDefaultClause(x *Parser) bool {
    x.l.next()
    if !expect(x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    ret parseCaseBody(x)
}

// parseSwitchClause 解析一个 case/default 从句。
fn parseSwitchClause(x *Parser) bool {
    if lex.Token.is(x.l.peek(), lex.KEYWORD, "case") {
        ret parseOneCase(x)
    }
    if lex.Token.is(x.l.peek(), lex.KEYWORD, "default") {
        ret parseDefaultClause(x)
    }
    ret false
}

fn parseSwitchStmt(x *Parser) bool {
    if !expectKeyword(x, "switch", ESTMT) {
        ret false
    }
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, "{") {
        if !parseExpr(x) {
            ret false
        }
    }
    if !expect(x, lex.DELIMITER, "{", ESTMT) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t2: *lex.Token = x.l.peek()
        if lex.Token.is(t2, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if isCaseClauseKeyword(t2.Value) {
            if !parseSwitchClause(x) {
                ret false
            }
            continue
        }
        fail(x, ESTMT, t2.Pos)
        ret false
    }
}