// switch.cute —— switch/case/default；fallthrough 由上游 case 注入。
// 加载顺序：依赖 helpers.cute、stmt.cute。
import "std:strings"
import lex "../lexer"

// isCaseClauseKeyword case 或 default。
fn SwitchBlock.isCaseClauseKeyword(  kw string) bool {
    ret (kw) == ("case") || (kw) == ("default")
}

// atClauseBoundary 是否到了 case 端尾部（case/default/}/EOF/NONE）。
fn SwitchBlock.atClauseBoundary(t *lex.Token) bool {
    if t == nil || t.Type == lex.NONE {
        ret true
    }
    if SwitchBlock.isCaseClauseKeyword( t.Value) {
        ret true
    }
    ret t.is( lex.DELIMITER, "}")
}

// parseCaseBody 解析 case/default 分支的语句（直到 case/default/}）。
fn SwitchBlock.parseCaseBody(x *Parser) bool {
    var stmtBlock: StmtBlock
    for ; ; {
        x.l.skipTerminators()
        if SwitchBlock.atClauseBoundary( x.l.peek()) {
            ret true
        }
        if !stmtBlock.parseStmt( x) {
            ret false
        }
    }
}

// parseCaseValues 解析一个 case 后的表达式列表，逗号分隔。
fn SwitchBlock.parseCaseValues(  x *Parser) bool {
    for ; ; {
        var eb: ExpBlock
        if !eb.parseExpr( x) {
            ret false
        }
        var tpeek: *lex.Token = x.l.peek()
        if !tpeek.is(lex.DELIMITER, ",") {
            ret true
        }
        x.l.next()
    }
}

// parseOneCase 解析 `case a, b, ...: body`。
fn SwitchBlock.parseOneCase(x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    if !SwitchBlock.parseCaseValues( x) {
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    ret SwitchBlock.parseCaseBody( x)
}

// parseDefaultClause 解析 `default: body`。
fn SwitchBlock.parseDefaultClause(x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    if !fileBlock.expect( x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    ret SwitchBlock.parseCaseBody( x)
}

// parseSwitchClause 解析一个 case/default 从句。
fn SwitchBlock.parseSwitchClause(x *Parser) bool {
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.KEYWORD, "case") {
        ret SwitchBlock.parseOneCase( x)
    }
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.KEYWORD, "default") {
        ret SwitchBlock.parseDefaultClause( x)
    }
    ret false
}
fn SwitchBlock.parseSwitchStmt(x *Parser) bool {
    var fileBlock: FileBlock
    if !fileBlock.expectKeyword( x, "switch", ESTMT) {
        ret false
    }
    var tpeek: *lex.Token = x.l.peek()
    if !tpeek.is(lex.DELIMITER, "{") {
        var eb: ExpBlock
        if !eb.parseExpr( x) {
            ret false
        }
    }
    if !fileBlock.expect( x, lex.DELIMITER, "{", ESTMT) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t2: *lex.Token = x.l.peek()
        if t2.is( lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if SwitchBlock.isCaseClauseKeyword( t2.Value) {
            if !SwitchBlock.parseSwitchClause( x) {
                ret false
            }
            continue
        }
        fileBlock.fail( x, ESTMT, t2.Pos)
        ret false
    }
}