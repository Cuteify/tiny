// helpers.cute —— parser 的 token 辅助（token 取/回退全部在 lexer 里）。
//   取/消费：x.l.next() / x.l.peek()（lexer 管理的预取环）
//   行尾/语句终符：lex.Token.IsLineEnd / lex.Token.IsSemiOrNewline
//   行尾跳过：x.l.skipLineEnds() / x.l.skipTerminators()
//   记账原语：expect / expectName / expectKeyword（parser 的错误码记账）
// 加载顺序：依赖 blocks.cute。
import "std:strings"
import lex "../lexer"

// expect 期望一个指定种类+值的 token（跳过行尾）；失败记错。
fn FileBlock.expect(x *Parser, kind: lex.TokenType, value string, e int) bool {
    x.l.skipLineEnds()
    var t: *lex.Token = x.l.next()
    if t == nil || t.Type == lex.NONE {
        FileBlock.fail( x, e, 0)
        ret false
    }
    if !t.is( kind, value) {
        FileBlock.fail( x, e, t.Pos)
        ret false
    }
    ret true
}

// expectName 期望一个 NAME；失败记错并返回零指针。
fn FileBlock.expectName(x *Parser, e int) *lex.Token {
    x.l.skipLineEnds()
    var t: *lex.Token = x.l.next()
    if t == nil || t.Type == lex.NONE {
        FileBlock.fail( x, e, 0)
        ret 0
    }
    if t.Type != lex.NAME {
        FileBlock.fail( x, e, t.Pos)
        ret 0
    }
    ret t
}

// expectKeyword 期望一个关键字；失败记错。
fn FileBlock.expectKeyword(x *Parser, kw string, e int) bool {
    x.l.skipLineEnds()
    var t: *lex.Token = x.l.next()
    if t == nil || t.Type == lex.NONE {
        FileBlock.fail( x, e, 0)
        ret false
    }
    if !t.is( lex.KEYWORD, kw) {
        FileBlock.fail( x, e, t.Pos)
        ret false
    }
    ret true
}

// consumeBalanced 已吃进起始符后消费至配平；用于函数体/asm 块。
// 遇到不平衡 EOF 记 e；返回 false。
fn FileBlock.consumeBalanced(x *Parser, open string, close string, e int) bool {
    var depth: int = 1
    for ; depth > 0; {
        var t: *lex.Token = x.l.next()
        if t == nil || t.Type == lex.NONE {
            FileBlock.fail( x, e, 0)
            ret false
        }
        if t.Type == lex.DELIMITER {
            if strings.eq(t.Value, open) {
                depth = depth + 1
                continue
            }
            if strings.eq(t.Value, close) {
                depth = depth - 1
                continue
            }
        }
    }
    ret true
}

// restOfLineAtDepth0 跳到行尾/回车/EOF；括号/列表/花括号深度内逗号保留。
// 用于 var/const 初值与字段默认值（精确解析前）。
fn FileBlock.restOfLineAtDepth0(  x *Parser) {
    var depth: int = 0
    for ; ; {
        var t: *lex.Token = x.l.peek()
        if t == nil {
            ret
        }
        if t.Type == lex.NONE {
            ret
        }
        if t.Type == lex.DELIMITER {
            if strings.eq(t.Value, "(") || strings.eq(t.Value, "[") || strings.eq(t.Value, "{") {
                depth = depth + 1
            } else if strings.eq(t.Value, ")") || strings.eq(t.Value, "]") || strings.eq(t.Value, "}") {
                if depth == 0 {
                    ret
                }
                depth = depth - 1
            } else if depth == 0 && t.isLineEnd() {
                ret
            }
        }
        x.l.next()
    }
}
