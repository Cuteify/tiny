// blocks.cute —— 自举 parser 的块声明（Go 参考 node.go 的 Block interface 形态）。
// Node 是统一的语法树节点，Block 是其子类 interface；具体 *Block 见各目标文件。
// 错误码、Tag 常量、节点结构、Parser 类型集中于此。
//
// 加载顺序：仅依赖 lex。
import "std:strings"
import lex "../lexer"

// 错误码：0 表示成功；其余为语义类别。
const OK: int = 0
const ETOK: int = 1
const EDECL: int = 2
const ETYPE: int = 3
const ESTMT: int = 4
const EEXPR: int = 5

// Block 是语法树节点的抽象接口（Go 参考形态：空 marker）。
// 派发按 ``n.Value`` 的具体类型进行，不需要也不存在 Tag() 方法。
type Block interface {
}

// Node 是任意语法节点的统一表示。Father/Children 与 Go 参考一致。
type Node struct {
    Value: Block
    Father: *Node
    Children: []*Node
}

// RegNode 一条顶层声明登记（check.cute 的链表节点）。
type RegNode struct {
    Name: string
    Kind: int
    Useful: bool
    Next: *RegNode
}

// StrNode 一条接口登记（"name:m1,m2,…"，check.cute 用）。
type StrNode struct {
    Value: string
    Next: *StrNode
}

// Parser 把 lexer 流向上包成语法结构。
type Parser struct {
    l: *lex.Lexer
    root: *Node
    e: int
    ep: uint
    decls: int
    imports: int
    builds: int
    structs: int
    enums: int
    consts: int
    vars: int
    fns: int
    stmts: int
    exprs: int

    // S4 Check 登记（check.cute）：顶层声明名/种类/Useful 标记与接口登记。
    // 按名字线性登记（链表，顺序即插入序），重复声明记为 EDECL。
    regHead: *RegNode
    regCount: int
    ifaceDefs: *StrNode
    ifaceCount: int
    ifaceBuf: string
    unusedFns: int
    // 当前所在接口的名字（由 iface 声明入口设置）；用于 registerIface。
    ifaceName: string
    // 最近一个裸 NAME token / 选择器链（parsePostfix 用来拼 Useful 限定名）。
    lastName: string
}

// 各解析产物的所有者块类型（集中声明，供各 .cute 文件引用）。
// 空 struct 按 8B 槽参与 ABI，勿删除。
type BuildBlock struct {
}

type ExpBlock struct {
}

type CallBlock struct {
}

type EnumBlock struct {
    Name: string
}

type FuncBlock struct {
    Name: string
}

type ImportBlock struct {
    Path: string
    Alias: string
}

type FileBlock struct {
}

type TypeBlock struct {
    Name: string
}

type ConstBlock struct {
    Name: string
}

type VarBlock struct {
    Name: string
}

type ForBlock struct {
}

type IfBlock struct {
}

type StmtBlock struct {
}

type StructBlock struct {
}

type SwitchBlock struct {
}









