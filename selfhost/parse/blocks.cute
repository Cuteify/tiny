// blocks.cute —— 自举 parser 的块声明（Go 参考 node.go 的 Block interface 形态）。
// Node 是统一的语法树节点，Block 是其子类 interface；具体 *Block 见各目标文件。
// 错误码、Tag 常量、节点结构、Parser 类型集中于此。
//
// 加载顺序：仅依赖 lex。
import "std:strings"
import lex "../lexer"

// 错误码：0 表示成功；其余为语义类别。
const OK: int = 0
const ETOK: int = 1
const EDECL: int = 2
const ETYPE: int = 3
const ESTMT: int = 4
const EEXPR: int = 5

// Block 是语法树节点的抽象接口（Go 参考形态：空 marker）。
// 派发按 ``n.Value`` 的具体类型进行，不需要也不存在 Tag() 方法。
type Block interface {
}

// Node 是任意语法节点的统一表示。Father/Children 与 Go 参考一致。
type Node struct {
    Value: Block
    Father: *Node
    Children: []*Node
}

// Parser 把 lexer 流向上包成语法结构。
type Parser struct {
    l: *lex.Lexer
    peekTok: *lex.Token
    pushBack: []*lex.Token
    pushBackPos: int
    root: *Node
    e: int
    ep: uint
    decls: int
    imports: int
    builds: int
    structs: int
    enums: int
    consts: int
    vars: int
    fns: int
    stmts: int
    exprs: int
}
