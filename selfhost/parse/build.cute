// build.cute —— build os/arch/bits/asm/link/ext/extret/align/noalign。
import "std:strings"
import lex "../lexer"

type BuildBlock struct {
    Key: string
}

fn parseBuildFromKeyword(x *Parser) bool {
    var kindT: *lex.Token = expectName(x, EDECL)
    if kindT == nil {
        ret false
    }
    var kind: string = kindT.Value
    if strings.eq(kind, "os") || strings.eq(kind, "arch") {
        if !expect(x, lex.DELIMITER, "(", EDECL) {
            ret false
        }
        for ; ; {
            x.l.skipTerminators()
            var t: *lex.Token = x.l.peek()
            if lex.Token.is(t, lex.DELIMITER, ")") {
                x.l.next()
                x.builds = x.builds + 1
                x.decls = x.decls + 1
                ret true
            }
            if t != nil && (t.Type == lex.NAME || t.Type == lex.STRING || t.Type == lex.KEYWORD) {
                x.l.next()
                continue
            }
            if lex.Token.is(t, lex.DELIMITER, ",") {
                x.l.next()
                continue
            }
            fail(x, EDECL, t.Pos)
            ret false
        }
    }
    if strings.eq(kind, "bits") {
        if !expect(x, lex.DELIMITER, "(", EDECL) {
            ret false
        }
        for ; ; {
            x.l.skipTerminators()
            var t: *lex.Token = x.l.peek()
            if lex.Token.is(t, lex.DELIMITER, ")") {
                x.l.next()
                x.builds = x.builds + 1
                x.decls = x.decls + 1
                ret true
            }
            if t != nil && t.Type == lex.NUMBER {
                x.l.next()
                continue
            }
            if lex.Token.is(t, lex.DELIMITER, ",") {
                x.l.next()
                continue
            }
            fail(x, EDECL, t.Pos)
            ret false
        }
    }
    if strings.eq(kind, "asm") {
        if !expect(x, lex.DELIMITER, "{", EDECL) {
            ret false
        }
        if !consumeBalanced(x, "{", "}", EDECL) {
            ret false
        }
        x.builds = x.builds + 1
        x.decls = x.decls + 1
        ret true
    }
    if strings.eq(kind, "link") || strings.eq(kind, "ext") || strings.eq(kind, "extret") || strings.eq(kind, "export") {
        if !expect(x, lex.DELIMITER, "(", EDECL) {
            ret false
        }
        var t: *lex.Token = x.l.next()
        if t == nil || (t.Type != lex.STRING && t.Type != lex.NAME) {
            if (t) {
                fail(x, EDECL, t.Pos)
            } else {
                fail(x, EDECL, 0)
            }
            ret false
        }
        if !expect(x, lex.DELIMITER, ")", EDECL) {
            ret false
        }
        x.builds = x.builds + 1
        x.decls = x.decls + 1
        ret true
    }
    if strings.eq(kind, "align") {
        if !expect(x, lex.DELIMITER, "(", EDECL) {
            ret false
        }
        var t: *lex.Token = x.l.next()
        if t == nil || t.Type != lex.NUMBER {
            if (t) {
                fail(x, EDECL, t.Pos)
            } else {
                fail(x, EDECL, 0)
            }
            ret false
        }
        if !expect(x, lex.DELIMITER, ")", EDECL) {
            ret false
        }
        x.builds = x.builds + 1
        x.decls = x.decls + 1
        ret true
    }
    if strings.eq(kind, "noalign") {
        x.builds = x.builds + 1
        x.decls = x.decls + 1
        ret true
    }
    fail(x, EDECL, kindT.Pos)
    ret false
}
