// build.cute —— build os/arch/bits/asm/link/ext/extret/align/noalign。
import "std:strings"
import lex "../lexer"


// isAcceptToken 按 kind 判断 t 是否是被接受的成员：
//   kind=1：os/arch（NAME|STRING|KEYWORD）
//   kind=2：bits（NUMBER）
//   kind=3：link（NAME|STRING）
//   kind=4：align（NUMBER）
fn BuildBlock.isAcceptToken(b *BuildBlock, t *lex.Token, kind int) bool {
    if t == nil {
        ret false
    }
    if kind == 1 {
        ret t.Type == lex.NAME || t.Type == lex.STRING || t.Type == lex.KEYWORD
    }
    if kind == 2 {
        ret t.Type == lex.NUMBER
    }
    if kind == 3 {
        ret t.Type == lex.STRING || t.Type == lex.NAME
    }
    ret t.Type == lex.NUMBER
}

// parseBuildList 通用循环：消费 ')' 结束；接受的 token 一律 next 即可。
fn BuildBlock.parseBuildList(b *BuildBlock, x *Parser, kind int) bool {
    var fileBlock: FileBlock
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "(", EDECL) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, ")") {
            x.l.next()
            ret true
        }
        if lex.Token.is(t, lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
        if BuildBlock.isAcceptToken(b, t, kind) {
            x.l.next()
            continue
        }
        if (t) {
            FileBlock.fail(fileBlock, x, EDECL, t.Pos)
        } else {
            FileBlock.fail(fileBlock, x, EDECL, 0)
        }
        ret false
    }
}

// parseBuildCountedToken 通用：expect('(', 接受一个 t, expect(')'), 记 build。
fn BuildBlock.parseBuildCountedToken(b *BuildBlock, x *Parser, kind int) bool {
    var fileBlock: FileBlock
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "(", EDECL) {
        ret false
    }
    var t: *lex.Token = x.l.next()
    if !BuildBlock.isAcceptToken(b, t, kind) {
        if (t) {
            FileBlock.fail(fileBlock, x, EDECL, t.Pos)
        } else {
            FileBlock.fail(fileBlock, x, EDECL, 0)
        }
        ret false
    }
    ret FileBlock.expect(fileBlock, x, lex.DELIMITER, ")", EDECL)
}

// isBuildLinkKind 判断 kind 是否属于 link 类（string/name 参数）。
fn BuildBlock.isBuildLinkKind(b *BuildBlock, k string) bool {
    ret strings.eq(k, "link") || strings.eq(k, "ext") || strings.eq(k, "extret") || strings.eq(k, "export")
}

// finishParseCountedBuilds 统一计数：成功的 build 都把 builds/decls +1。
fn BuildBlock.finishParseCountedBuilds(b *BuildBlock, x *Parser) {
    x.builds = x.builds + 1
    x.decls = x.decls + 1
}

// parseBuildOsArch 处理 build os(linux,...) / build arch(x86_64,...)。
fn BuildBlock.parseBuildOsArch(b *BuildBlock, x *Parser) bool {
    if !BuildBlock.parseBuildList(b, x, 1) {
        ret false
    }
    BuildBlock.finishParseCountedBuilds(b, x)
    ret true
}

// parseBuildBits 处理 build bits(32|64)。
fn BuildBlock.parseBuildBits(b *BuildBlock, x *Parser) bool {
    if !BuildBlock.parseBuildList(b, x, 2) {
        ret false
    }
    BuildBlock.finishParseCountedBuilds(b, x)
    ret true
}

// parseBuildAsm 处理 build asm { ... }。
fn BuildBlock.parseBuildAsm(b *BuildBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", EDECL) {
        ret false
    }
    if !FileBlock.consumeBalanced(fileBlock, x, "{", "}", EDECL) {
        ret false
    }
    BuildBlock.finishParseCountedBuilds(b, x)
    ret true
}

// parseBuildLink 处理 build link/ext/extret/export("name" / name)。
fn BuildBlock.parseBuildLink(b *BuildBlock, x *Parser) bool {
    if !BuildBlock.parseBuildCountedToken(b, x, 3) {
        ret false
    }
    BuildBlock.finishParseCountedBuilds(b, x)
    ret true
}

// parseBuildAlign 处理 build align(N)（N 为数字）。
fn BuildBlock.parseBuildAlign(b *BuildBlock, x *Parser) bool {
    if !BuildBlock.parseBuildCountedToken(b, x, 4) {
        ret false
    }
    BuildBlock.finishParseCountedBuilds(b, x)
    ret true
}

// parseBuildNoAlign 处理 build noalign。
fn BuildBlock.parseBuildNoAlign(b *BuildBlock, x *Parser) bool {
    BuildBlock.finishParseCountedBuilds(b, x)
    ret true
}

// dispatchBuildKind 按 kind 分派到对应裸 build 的 handler。
// 成功返回 true（并已计数）；未知 kind 返回 false（不计数，由调用方报错）。
fn BuildBlock.dispatchBuildKind(b *BuildBlock, x *Parser, kind string) bool {
    if strings.eq(kind, "os") || strings.eq(kind, "arch") {
        ret BuildBlock.parseBuildOsArch(b, x)
    }
    if strings.eq(kind, "bits") {
        ret BuildBlock.parseBuildBits(b, x)
    }
    if strings.eq(kind, "asm") {
        ret BuildBlock.parseBuildAsm(b, x)
    }
    if BuildBlock.isBuildLinkKind(b, kind) {
        ret BuildBlock.parseBuildLink(b, x)
    }
    if strings.eq(kind, "align") {
        ret BuildBlock.parseBuildAlign(b, x)
    }
    if strings.eq(kind, "noalign") {
        ret BuildBlock.parseBuildNoAlign(b, x)
    }
    ret false
}

fn BuildBlock.parse(b *BuildBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var kindT: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
    if kindT == nil {
        ret false
    }
    if BuildBlock.dispatchBuildKind(b, x, kindT.Value) {
        ret true
    }
    FileBlock.fail(fileBlock, x, EDECL, kindT.Pos)
    ret false
}
