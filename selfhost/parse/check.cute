// check.cute —— S4 Check 阶段（最小可用：docs/INTERFACES.md §5-5）。
//
// 职责：
//   - 结构登记：顶层声明按名字登记（fn=REG_FN / struct / interface / enum /
//     别名 / type / var / const），顺带做重复声明检测（EDECL）。
//   - Useful 入：引用点（调用/类型引用）把对应登记置 Useful。
//   - *InterfaceType 入：记录接口名与方法名集合（codegen 的 vtable / 方法解析用）。
//
// 明确不做（S4-完整推导再说）：参数类型检查、跨包符号解析、类型推导。
// 标记口径：
//   - 自由函数登记为裸名，方法登记为 "Type.method" 限定名。
//   - Useful 只对自由函数/全局值记账：方法调用按限定名标记；main 定义处天然记为 Useful。
//   - 裸名引用只标记首段（不展开点链）；限定类型引用不回溯末段。
// 登记载体：链表节点（RegNode/StrNode），避免 std:slices 的字符串读取路径
// （pkg/slices 的 copyOut/index 在 []string 上不按 16B 处理，实测失效）。
// 加载顺序：仅依赖 blocks.cute / helpers.cute。
import "std:strings"
import lex "../lexer"

const REG_FN: int = 1
const REG_STRUCT: int = 2
const REG_IFACE: int = 3
const REG_ENUM: int = 4
const REG_ALIAS: int = 5
const REG_TYPE: int = 6
const REG_VAR: int = 7
const REG_CONST: int = 8

// regFind 找到 name 节点，nil = 未登记。
fn FileBlock.regFind(  x *Parser, name string) *RegNode {
    var cur: *RegNode = x.regHead
    for ; cur != nil; {
        if (cur.Name) == (name) {
            ret cur
        }
        cur = cur.Next
    }
    ret nil
}

// markUse 把 name 对应的全局登记标记为 Useful。未命中静默忽略。
fn FileBlock.markUse(x *Parser, name string) {
    var n: *RegNode = FileBlock.regFind( x, name)
    if n != nil {
        n.Useful = true
    }
}

// registerDecl 登记一处顶层声明；重复声明记 EDECL 并返回 false（调用方停 parse）。
fn FileBlock.registerDecl(x *Parser, name string, kind int, pos int) bool {
    var dup: *RegNode = FileBlock.regFind( x, name)
    if dup != nil {
        FileBlock.fail( x, EDECL, pos)
        ret false
    }
    var item: *RegNode = new(RegNode)
    item.Name = name
    item.Kind = kind
    item.Useful = kind == REG_FN && (name) == ("main")
    item.Next = x.regHead
    x.regHead = item
    x.regCount = x.regCount + 1
    ret true
}

// registerTypeDecl 按 type 声明的引导 token 分派登记 kind。
fn FileBlock.registerTypeDecl(x *Parser, name string, q *lex.Token, pos int) bool {
    var kind: int = REG_TYPE
    if q != nil {
        if q.is( lex.KEYWORD, "struct") {
            kind = REG_STRUCT
        } else if q.is( lex.KEYWORD, "interface") {
            kind = REG_IFACE
        } else if q.is( lex.DELIMITER, "=") {
            kind = REG_ALIAS
        }
    }
    ret FileBlock.registerDecl( x, name, kind, pos)
}

// registerIface 把接口 name 及其方法集合入登记（*InterfaceType 入）。
// 约定：调用方（type/struct 声明路径）已在 REG_IFACE 登记同名接口；
// 这里只追加 "name:m1,m2,…" 登记条目，不重复登记。
fn FileBlock.registerIface(  x *Parser, name string) bool {
    // 编译器 bug：左操作数为空/短串拼接堆字段易丢失，落局部变量再拼。
    var ibuf: string = x.ifaceBuf
    var item: *StrNode = new(StrNode)
    item.Value = name + ":" + ibuf
    item.Next = x.ifaceDefs
    x.ifaceDefs = item
    x.ifaceCount = x.ifaceCount + 1
    ret true
}

// ifaceDefAt 取第 i 条接口登记（插入序，从 0 数），越界返回空。
// 存储是头插栈 → 顺序反转；按 反向步进取第 i 个。
fn FileBlock.ifaceDefAt(  x *Parser, i int) string {
    var n: int = x.ifaceCount
    if i < 0 || i >= n {
        ret ""
    }
    var target: int = n - 1 - i
    var cur: *StrNode = x.ifaceDefs
    var j: int = 0
    for ; j < target; {
        cur = cur.Next
        j = j + 1
    }
    ret cur.Value
}

// registeredDeclCount 已登记的顶层声明数（import/build 不登记）。
fn FileBlock.registeredDeclCount(  x *Parser) int {
    ret x.regCount
}

// ifaceDefCount 已登记的接口数。
fn FileBlock.ifaceDefCount(  x *Parser) int {
    ret x.ifaceCount
}

// unusedFnCount 未被标记 Useful 的自由函数数（方法豁免：口径见文件头）。
fn FileBlock.unusedFnCount(  x *Parser) int {
    ret x.unusedFns
}

// finalizeCheck 文件解析完毕后收敛：
//   1) 计数未 Useful 的自由函数（方法限定名带点 → 豁免）；
//   2) 把 ifaceBuf/ifaceName 重置（一文件一 parser，给调用方复用留口子）。
fn FileBlock.finalizeCheck(  x *Parser) {
    var cur: *RegNode = x.regHead
    var count: int = 0
    for ; cur != nil; {
        var isMethod: bool = strings.contains(cur.Name, ".")
        if cur.Kind == REG_FN && !cur.Useful && !isMethod {
            count = count + 1
        }
        cur = cur.Next
    }
    x.unusedFns = count
    x.ifaceBuf = ""
    x.ifaceName = ""
}
