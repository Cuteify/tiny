// stmt.cute —— 语句分派与顶层入口 parseStmt；所有 block 经过这里。
// 加载顺序：依赖 exp.cute、call.cute、for.cute、ifelse.cute、switch.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

fn StmtBlock.isAssignOp(r StmtBlock, t *lex.Token) bool {
    if t == nil || t.Type != lex.DELIMITER {
        ret false
    }
    ret StmtBlock.isAssignOpValue(r, t.Value)
}

// isAssignOpValue 复合赋值运算符表：=, :=, +=, -=, *=, /=, %=, ^=, &=, |=, <<=, >>=。
fn StmtBlock.isAssignOpValue(r StmtBlock, v string) bool {
    ret strings.eq(v, "=") || strings.eq(v, ":=") || strings.eq(v, "+=") || strings.eq(v, "-=") || strings.eq(v, "*=") || strings.eq(v, "/=") || strings.eq(v, "%=") || strings.eq(v, "^=") || strings.eq(v, "&=") || strings.eq(v, "|=") || strings.eq(v, "<<=") || strings.eq(v, ">>=")
}

// scanForKind 有界向前感知 for 头的种类：1=range，2=classic（含 :=），3=其它。
// 顺序消费并推回 ring buffer，保持源序；不消耗 "{" ";" "range"（留给后续）。
fn StmtBlock.parseBlock(r StmtBlock, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.skipTerminators()
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", ESTMT) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t.Type == lex.NONE {
            FileBlock.fail(fileBlock, x, ESTMT, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        if !StmtBlock.parseStmt(r, x) {
            ret false
        }
    }
}

// consumeTupleTargetExprs 消费 `a, b, c := f()` 的多目标模式（每个 `,` 跟一个 expr）。
fn StmtBlock.consumeTupleTargetExprs(r StmtBlock, x *Parser) bool {
    for ; ; {
        if !lex.Token.is(x.l.peek(), lex.DELIMITER, ",") {
            ret true
        }
        x.l.next()
        var eb: ExpBlock
        if !ExpBlock.parseExpr(eb, x) {
            ret false
        }
    }
}

// isStatementPostfixEnd 检测非赋值语句的合法收尾（NL / ';' / '}' / EOF/NONE）。
fn StmtBlock.isStatementPostfixEnd(r StmtBlock, t *lex.Token) bool {
    if t == nil {
        ret true
    }
    if lex.Token.is(t, lex.DELIMITER, "++") || lex.Token.is(t, lex.DELIMITER, "--") {
        ret true
    }
    if lex.Token.isLineEnd(t) || t.Type == lex.NONE {
        ret true
    }
    if t.Type == lex.DELIMITER {
        ret strings.eq(t.Value, "}") || strings.eq(t.Value, ";") || unsafe.cast[int](t.Value[0]) == 10 || unsafe.cast[int](t.Value[0]) == 13
    }
    ret false
}

// parseSimpleStmt 整形最常见的语句：赋值/自增自减/纯表达式（仅调用语句）。
// 支持多目标形式：a, b := f()（tuple 目标）。
fn StmtBlock.parseSimpleStmt(r StmtBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var eb: ExpBlock
    if !ExpBlock.parseExpr(eb, x) {
        ret false
    }
    if !StmtBlock.consumeTupleTargetExprs(r, x) {
        ret false
    }
    var t: *lex.Token = x.l.peek()
    if StmtBlock.isAssignOp(r, t) {
        x.l.next()
        var eb: ExpBlock
        ret ExpBlock.parseExpr(eb, x)
    }
    if lex.Token.is(t, lex.DELIMITER, "++") || lex.Token.is(t, lex.DELIMITER, "--") {
        x.l.next()
        ret true
    }
    if StmtBlock.isStatementPostfixEnd(r, t) {
        ret true
    }
    FileBlock.fail(fileBlock, x, ESTMT, t.Pos)
    ret false
}
// atCase 判断当前是否 case/default/}。
fn StmtBlock.parseRetStmt(r StmtBlock, x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if lex.Token.is(t, lex.KEYWORD, "ret") {
        x.l.next()
    } else {
        x.l.next()
    }
    var p: *lex.Token = x.l.peek()
    if lex.Token.isLineEnd(p) {
        ret true
    }
    if lex.Token.is(p, lex.DELIMITER, "}") {
        ret true
    }
    var eb: ExpBlock
    if !ExpBlock.parseExpr(eb, x) {
        ret false
    }
    for ; ; {
        if lex.Token.is(x.l.peek(), lex.DELIMITER, ",") {
            x.l.next()
            var eb: ExpBlock
            if !ExpBlock.parseExpr(eb, x) {
                ret false
            }
            continue
        }
        break
    }
    ret true
}

// parseDeferStmt 解析 defer 语句（仅调用形态）。
fn StmtBlock.parseDeferStmt(r StmtBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if !FileBlock.expectKeyword(fileBlock, x, "defer", ESTMT) {
        ret false
    }
    // defer 后必须是调用式表达式
    var eb: ExpBlock
    if !ExpBlock.parseExpr(eb, x) {
        ret false
    }
    ret true
}

// parseBreakContinue 解析 break/continue 语句。
fn StmtBlock.parseBreakContinue(r StmtBlock, x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if lex.Token.is(t, lex.KEYWORD, "break") {
        x.l.next()
        ret true
    }
    if lex.Token.is(t, lex.KEYWORD, "continue") {
        x.l.next()
        ret true
    }
    ret false
}

// isStmtKeywordLocalDecl 局部声明类关键字（带 kw 形式）。
fn StmtBlock.isStmtKeywordLocalDecl(r StmtBlock, kw string) bool {
    ret strings.eq(kw, "var") || strings.eq(kw, "const") || strings.eq(kw, "let")
}

// isStmtKeywordReturn 返回类关键字（值可带 ret/return 两种拼写）。
fn StmtBlock.isStmtKeywordReturn(r StmtBlock, kw string) bool {
    ret strings.eq(kw, "ret") || strings.eq(kw, "return")
}

// isStmtKeywordFinisher break/continue/fallthrough 等终止符关键字。
fn StmtBlock.isStmtKeywordFinisher(r StmtBlock, kw string) bool {
    ret strings.eq(kw, "break") || strings.eq(kw, "continue") || strings.eq(kw, "fallthrough")
}

// parseImplicitVarStmt 处理 name: T = v（无 var/const/let 关键字的隐式声明）。
// nameTok 不消费：x.l.prefetch() 把后继 token 扫入环（不弹出）；
// 命中 ":" 分支时显式弹出 nameTok；其它形态 nameTok 仍在环首。
fn StmtBlock.parseImplicitVarStmt(r StmtBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var typeBlock: TypeBlock
    var p2: *lex.Token = x.l.prefetch()
    if !lex.Token.is(p2, lex.DELIMITER, ":") {
        ret false
    }
    x.l.next()
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, ":", ESTMT) {
        ret false
    }
    if !TypeBlock.skipType(typeBlock, x) {
        ret false
    }
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "=", ESTMT) {
        ret false
    }
    FileBlock.restOfLineAtDepth0(fileBlock, x)
    x.vars = x.vars + 1
    x.decls = x.decls + 1
    x.stmts = x.stmts + 1
    ret true
}

fn StmtBlock.dispatchControlClause(r StmtBlock, x *Parser, kw string) bool {
    var forBlock: ForBlock
    var ifBlock: IfBlock
    var switchBlock: SwitchBlock
    if strings.eq(kw, "if") {
        if !IfBlock.parseIfStmt(ifBlock, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    if strings.eq(kw, "for") || strings.eq(kw, "while") {
        if !ForBlock.parseForStmt(forBlock, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    if strings.eq(kw, "switch") {
        if !SwitchBlock.parseSwitchStmt(switchBlock, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    ret false
}

fn StmtBlock.dispatchTerminalClause(r StmtBlock, x *Parser, kw string) bool {
    if StmtBlock.isStmtKeywordReturn(r, kw) {
        if !StmtBlock.parseRetStmt(r, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    if strings.eq(kw, "defer") {
        if !StmtBlock.parseDeferStmt(r, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    if strings.eq(kw, "break") || strings.eq(kw, "continue") {
        if !StmtBlock.parseBreakContinue(r, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    if strings.eq(kw, "fallthrough") {
        x.l.next()
        x.stmts = x.stmts + 1
        ret true
    }
    ret false
}

fn StmtBlock.dispatchBuildClause(r StmtBlock, x *Parser) bool {
    x.l.next()
    var bb: BuildBlock
    if !BuildBlock.parse(bb, x) {
        ret false
    }
    x.stmts = x.stmts + 1
    ret true
}

fn StmtBlock.dispatchStmtBody(r StmtBlock, x *Parser, kw string) bool {
    if StmtBlock.dispatchControlClause(r, x, kw) {
        ret true
    }
    if StmtBlock.dispatchTerminalClause(r, x, kw) {
        ret true
    }
    if strings.eq(kw, "build") {
        ret StmtBlock.dispatchBuildClause(r, x)
    }
    ret false
}

// dispatchStmtKeyword 按 keyword 分派到对应语句解析器并记 stmts；未知返回 false。
fn StmtBlock.dispatchStmtKeyword(r StmtBlock, x *Parser, kw string) bool {
    var varBlock: VarBlock
    if StmtBlock.isStmtKeywordLocalDecl(r, kw) {
        x.l.next()
        if !VarBlock.parseVarConstDispatch(varBlock, x, kw, 0) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    ret StmtBlock.dispatchStmtBody(r, x, kw)
}

// isStmtCandidateKeywordValue NAME 开头是语句、KEYWORD 开头也是语句：两条路。
fn StmtBlock.isStmtCandidateFinisher(r StmtBlock, v string) bool {
    ret strings.eq(v, "break") || strings.eq(v, "continue") || strings.eq(v, "fallthrough") || strings.eq(v, "defer") || strings.eq(v, "build")
}

fn StmtBlock.parseStmt(r StmtBlock, x *Parser) bool {
    x.l.skipTerminators()
    var t: *lex.Token = x.l.peek()
    if t == nil || t.Type == lex.NONE {
        ret true
    }
    if t.Type == lex.NAME && StmtBlock.parseImplicitVarStmt(r, x) {
        ret true
    }
    if t.Type == lex.KEYWORD && StmtBlock.dispatchStmtKeyword(r, x, t.Value) {
        ret true
    }
    if lex.Token.is(t, lex.DELIMITER, "{") {
        if !StmtBlock.parseBlock(r, x) {
            ret false
        }
        x.stmts = x.stmts + 1
        ret true
    }
    if !StmtBlock.parseSimpleStmt(r, x) {
        ret false
    }
    x.stmts = x.stmts + 1
    ret true
}

// atOpen 判别当前 token 是否为 { 。
fn StmtBlock.atOpen(r StmtBlock, x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    ret lex.Token.is(t, lex.DELIMITER, "{")
}
