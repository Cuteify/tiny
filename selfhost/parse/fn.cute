// fn.cute —— 函数声明：fn f[T]() 与 fn P.m()（方法声明），FuncBlock 定义。
// 加载顺序：依赖 call.cute、stmt.cute、helpers.cute；Block/Node 来自 blocks.cute。
import "std:strings"
import lex "../lexer"





// parseGenericParams 解析泛型参数列表 [T[, U....]]。
fn FuncBlock.parseGenericParams(f FuncBlock, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.skipTerminators()
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, "[") {
        ret true
    }
    x.l.next()
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, "]") {
            x.l.next()
            ret true
        }
        var tp: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
        if tp == nil {
            ret false
        }
        var p3: *lex.Token = x.l.peek()
        if lex.Token.is(p3, lex.DELIMITER, "]") {
            x.l.next()
            ret true
        }
        if lex.Token.is(p3, lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
        ret false
    }
}

// parse 解析 `fn f[T]()` 或方法 `fn T.m()`。
fn FuncBlock.parse(f FuncBlock, x *Parser) bool {
    var fileBlock: FileBlock
    var stmtBlock: StmtBlock
    var nameT: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
    if nameT == nil {
        ret false
    }
    f.Name = nameT.Value
    x.l.skipTerminators()
    // 可选的 `.name` 后缀（方法声明中的接收者名）；合成限定注册名 P.m。
    var methodSuffixT: *lex.Token = nil
    if lex.Token.is(x.l.peek(), lex.DELIMITER, ".") {
        x.l.next()
        methodSuffixT = FileBlock.expectName(fileBlock, x, EDECL)
        if methodSuffixT == nil {
            ret false
        }
    }
    // S4 Check：fn 登记（方法用限定名 "Type.method"）。
    var fnName: string = f.Name
    if methodSuffixT != nil {
        var nv: string = methodSuffixT.Value
        var fnPrefix: string = f.Name
        fnName = fnPrefix + "." + nv
    }
    if !FileBlock.registerDecl(fileBlock, x, fnName, REG_FN, nameT.Pos) {
        ret false
    }
    if !FuncBlock.parseGenericParams(f, x) {
        ret false
    }
    x.l.skipTerminators()
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "(", EDECL) {
        ret false
    }
    var cb: CallBlock
    if !CallBlock.parseFuncParams(cb, x) {
        ret false
    }
    if !CallBlock.parseRetTypes(cb, x) {
        ret false
    }
    if !StmtBlock.parseBlock(stmtBlock, x) {
        ret false
    }
    x.fns = x.fns + 1
    x.decls = x.decls + 1
    ret true
}
