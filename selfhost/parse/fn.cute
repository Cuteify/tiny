// fn.cute —— 函数声明：fn f[T]() 与 fn P.m()（方法声明），FuncBlock 定义。
// 加载顺序：依赖 call.cute、stmt.cute、helpers.cute；Block/Node 来自 blocks.cute。
import "std:strings"
import lex "../lexer"

type FuncBlock struct {
    Name: string
}

// parseDotNameSuffix 可选的 `.name` 后缀（方法声明中的接收者名）。
fn parseDotNameSuffix(x *Parser) bool {
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, ".") {
        ret true
    }
    x.l.next()
    ret expectName(x, EDECL) != nil
}

// parseGenericParams 解析泛型参数列表 [T[, U....]]。
fn parseGenericParams(x *Parser) bool {
    x.l.skipTerminators()
    if !lex.Token.is(x.l.peek(), lex.DELIMITER, "[") {
        ret true
    }
    x.l.next()
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, "]") {
            x.l.next()
            ret true
        }
        var tp: *lex.Token = expectName(x, EDECL)
        if tp == nil {
            ret false
        }
        var p3: *lex.Token = x.l.peek()
        if lex.Token.is(p3, lex.DELIMITER, "]") {
            x.l.next()
            ret true
        }
        if lex.Token.is(p3, lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
        ret false
    }
}

fn parseFnFromKeyword(x *Parser) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    x.l.skipTerminators()
    if !parseDotNameSuffix(x) {
        ret false
    }
    if !parseGenericParams(x) {
        ret false
    }
    x.l.skipTerminators()
    if !expect(x, lex.DELIMITER, "(", EDECL) {
        ret false
    }
    if !parseFuncParams(x) {
        ret false
    }
    if !parseRetTypes(x) {
        ret false
    }
    if !parseBlock(x) {
        ret false
    }
    x.fns = x.fns + 1
    x.decls = x.decls + 1
    ret true
}