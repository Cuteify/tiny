import (
    "std:console"
    "../lexer"
)
type FnBlock struct {
    name:string   
}

fn FnBlock.parse(&self, p:*Parser) {
    // 消费fn关键字
    
    p.Lexer.skipToken("fn")

    // 获取函数名称
    t := p.Lexer.next()
    console.println("h"+t.string())
    if t.Type != lexer.NAME {
        panic("function need name")
    }
    self.name = t.Value

    console.println(self.name)
}