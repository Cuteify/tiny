// fn.cute —— 函数声明：fn f[T]() 与 fn P.m()（方法声明），FuncBlock 定义。
// 加载顺序：依赖 call.cute、stmt.cute、helpers.cute；Block/Node 来自 blocks.cute。
import "std:strings"
import lex "../lexer"

type FuncBlock struct {
    Name: string
}

fn parseFnFromKeyword(x *Parser) bool {
    // fn 关键字已被消费
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    skipTerminators(x)
    var p: *lex.Token = peek(x)
    if isTok(p, lex.DELIMITER, ".") {
        next(x)
        var m: *lex.Token = expectName(x, EDECL)
        if m == nil {
            ret false
        }
    }
    skipTerminators(x)
    var p2: *lex.Token = peek(x)
    if isTok(p2, lex.DELIMITER, "[") {
        next(x)
        for ; ; {
            skipTerminators(x)
            var t: *lex.Token = peek(x)
            if isTok(t, lex.DELIMITER, "]") {
                next(x)
                break
            }
            var tp: *lex.Token = expectName(x, EDECL)
            if tp == nil {
                ret false
            }
            var p3: *lex.Token = peek(x)
            if isTok(p3, lex.DELIMITER, "]") {
                next(x)
                break
            }
            if isTok(p3, lex.DELIMITER, ",") {
                next(x)
                continue
            }
            break
        }
    }
    skipTerminators(x)
    if !expect(x, lex.DELIMITER, "(", EDECL) {
        ret false
    }
    if !parseFuncParams(x) {
        ret false
    }
    if !parseRetTypes(x) {
        ret false
    }
    if !parseBlock(x) {
        ret false
    }
    x.fns = x.fns + 1
    x.decls = x.decls + 1
    ret true
}
