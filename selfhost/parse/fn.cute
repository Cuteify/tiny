import (
    "std:console"
    "std:slices"
    "../lexer"
)
type FnBlock struct {
    name:string
    args:[]*Arg
}

// Arg 函数参数结构体
type Arg struct {
	name       :string         // 参数名
	typ       :string // 参数类型
	defaultVal    :*Expression  // 默认值表达式
}


fn FnBlock.parse(&self, p:*Parser) {
    // 消费fn关键字
    
    p.Lexer.skipToken("fn")

    // 获取函数名称
    tok := p.Lexer.next()
    if tok.Type != lexer.NAME {
        panic("function need name")
    }
    
    self.name = tok.Value

    // 处理泛型
    tok = p.Lexer.prefetch()
    if tok.is(lexer.DELIMITER, "[") {
        // TODO:
        tok = p.Lexer.prefetch()
    }

    // 处理参数
    if tok.is(lexer.DELIMITER, "(") {
        self.parseArgs(p)
    }

    console.print("Parse Function：" + self.name + ", Args:")
    for i:=0; i < slices.len(&self.args); i++ {
        a := self.args[i]
        console.print(a.name + "[" + a.typ + "] ")
    }
    console.println("")
}

fn FnBlock.parseArgs(&self, p:*Parser) {
    // 初始哈
    self.args = []*Arg{}

    // 跳过开始的(
    p.Lexer.skipToken("(")
	bracketCount := 1

    var tok: *lexer.Token

    // 处理第一个参数
    tok = p.Lexer.next()
    if tok.Type != lexer.NAME {
        if tok.is(lexer.DELIMITER, ")") {
            ret
        } else {
            panic("故障")
        }
    }
    newArg := &Arg{name: tok.Value}
    slices.push(&self.args, newArg)

    // 处理剩余部分
    for bracketCount != 0 {
        tok = p.Lexer.next()
        if tok.isSemiOrNewline() {
            panic("故障！")
        }
        switch tok.Value {
            case "(":
                bracketCount++
            case ")":
                bracketCount--
            case ",":
                tok = p.Lexer.next()
                if tok.Type != lexer.NAME {
                    panic("故障")
                }
                newArg := &Arg{name: tok.Value}
                slices.push(&self.args, newArg)
            case ":":
                tok = p.Lexer.next()
                if tok.Value == "*" {
                    // TODO:
                    continue
                }
                if tok.Type != lexer.NAME {
                    panic("故障")
                }

                // 反向遍历args，找到最后一个 typ == "" 的参数
                for i := slices.len(&self.args) - 1; i >= 0; i-- {
                    a := self.args[i]
                    if a.typ != "" {
                        break
                    }
                    a.typ = tok.Value
                }
        }
    }

    // 检查不完善的部分
    var err:bool
    for i := slices.len(&self.args) - 1; i >= 0; i-- {
        a := self.args[i]
        if a.typ != "" {
            break
        }
        err = true
        console.println("Function:" + self.name + "Arg:"+ a.name +" need type")
    }
    if err == true {
        panic("")
    }
}