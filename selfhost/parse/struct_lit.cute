// struct_lit.cute —— 结构体字面量 `Type{field: value, ...}` 的 AST 构造。
// 加载顺序：依赖 call.cute、helpers.cute。
import "std:strings"
import lex "../lexer"

fn ExpBlock.parseStructLit(r ExpBlock, x *Parser) bool {
    var fileBlock: FileBlock
    if !FileBlock.expect(fileBlock, x, lex.DELIMITER, "{", ESTMT) {
        ret false
    }
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if lex.Token.is(t, lex.DELIMITER, "}") {
            x.l.next()
            ret true
        }
        var nameT: *lex.Token = x.l.peek()
        if nameT.Type != lex.NAME {
            FileBlock.fail(fileBlock, x, ESTMT, nameT.Pos)
            ret false
        }
        x.l.next()
        if !FileBlock.expect(fileBlock, x, lex.DELIMITER, ":", ESTMT) {
            ret false
        }
        var eb: ExpBlock
        if !ExpBlock.parseExpr(eb, x) {
            ret false
        }
        var t2: *lex.Token = x.l.peek()
        if lex.Token.is(t2, lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
        if lex.Token.is(t2, lex.DELIMITER, "}") {
            continue
        }
        FileBlock.fail(fileBlock, x, ESTMT, t2.Pos)
        ret false
    }
}
