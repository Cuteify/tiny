// type.cute —— 类型引用（skipType / parseTypeRef）与 type 声明。
import "std:strings"
import lex "../lexer"
fn TypeBlock.skipListTypeAfterBracket(&self, x *Parser) bool {
    var fileBlock: FileBlock
    var p: *lex.Token = x.l.peek()
    if p.is( lex.DELIMITER, "]") {
        x.l.next()
        ret self.skipType( x)
    }
    var num: *lex.Token = x.l.next()
    if num == nil || num.Type != lex.NUMBER {
        if (num) {
            fileBlock.fail( x, ETYPE, num.Pos)
        } else {
            fileBlock.fail( x, ETYPE, 0)
        }
        ret false
    }
    if !fileBlock.expect( x, lex.DELIMITER, "]", ETYPE) {
        ret false
    }
    ret self.skipType( x)
}

// skipFnTypeArgs 消费 fn 类型参数列表；允许变参 ...T。
fn TypeBlock.skipFnTypeArgs(&self, x *Parser) bool {
    var fileBlock: FileBlock
    if !fileBlock.expect( x, lex.DELIMITER, "(", ETYPE) {
        ret false
    }
    for ; ; {
        var p: *lex.Token = x.l.peek()
        if p.is( lex.DELIMITER, ")") {
            x.l.next()
            ret true
        }
        if p.is( lex.DELIMITER, "...") {
            x.l.next()
        }
        if !self.skipType( x) {
            ret false
        }
        var tpeek: *lex.Token = x.l.peek()
        if tpeek.is(lex.DELIMITER, ",") {
            x.l.next()
            continue
        }
    }
}

// skipMaybeTypeReturnTail fn 类型的返回值：可能是括号括起来的多返回值、单类型或无。
fn TypeBlock.skipMaybeTypeReturnTail(&self, x *Parser) bool {
    var fileBlock: FileBlock
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "(") {
        ret fileBlock.consumeBalanced( x, "(", ")", ETYPE)
    }
    var p4: *lex.Token = x.l.peek()
    if p4 == nil {
        ret true
    }
    if p4.Type == lex.KEYWORD || p4.Type == lex.NAME || p4.Type == lex.DELIMITER {
        if p4.is( lex.DELIMITER, "*") || p4.is( lex.DELIMITER, "[") || p4.Type != lex.DELIMITER {
            ret self.skipType( x)
        }
    }
    ret true
}

// skipFnType fn 类型：... [fn] ( T1, T2, ... ) R
fn TypeBlock.skipFnType(&self, x *Parser) bool {
    if !self.skipFnTypeArgs( x) {
        ret false
    }
    ret self.skipMaybeTypeReturnTail( x)
}

// skipDotQualified 消费 `.NAME` 序列；t 已包含首段。
fn TypeBlock.skipDotQualified(  x *Parser) bool {
    var fileBlock: FileBlock
    for ; ; {
        var tpeek: *lex.Token = x.l.peek()
        if !tpeek.is(lex.DELIMITER, ".") {
            ret true
        }
        x.l.next()
        var part: *lex.Token = fileBlock.expectName( x, ETYPE)
        if part == nil {
            ret false
        }
    }
}

// skipNamedType 处理 `NAME` 或 `NAME.NAME...`（含 map[K]V 泛型形式）。
fn TypeBlock.skipNamedType(&self, x *Parser, t *lex.Token) bool {
    var fileBlock: FileBlock
    // S4 Useful：类型引用记限定/裸名（裸名同登记命中；点链限定名不展开，见 check.cute 口径）。
    fileBlock.markUse( x, t.Value)
    if !TypeBlock.skipDotQualified( x) {
        ret false
    }
    var tpeek: *lex.Token = x.l.peek()
    if (t.Value) == ("map") && tpeek.is(lex.DELIMITER, "[") {
        x.l.next()
        if !self.skipType( x) {
            ret false
        }
        if !fileBlock.expect( x, lex.DELIMITER, "]", ETYPE) {
            ret false
        }
        ret self.skipType( x)
    }
    ret true
}
fn TypeBlock.skipType(&self, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.skipTerminators()
    var t: *lex.Token = x.l.next()
    if t == nil {
        fileBlock.fail( x, ETYPE, 0)
        ret false
    }
    if t.Type == lex.DELIMITER {
        if (t.Value) == ("*") {
            ret self.skipType( x)
        }
        if (t.Value) == ("[") {
            ret self.skipListTypeAfterBracket( x)
        }
        fileBlock.fail( x, ETYPE, t.Pos)
        ret false
    }
    if t.Type == lex.KEYWORD {
        if (t.Value) == ("fn") {
            ret self.skipFnType( x)
        }
        fileBlock.fail( x, ETYPE, t.Pos)
        ret false
    }
    if t.Type == lex.NAME {
        ret self.skipNamedType( x, t)
    }
    fileBlock.fail( x, ETYPE, t.Pos)
    ret false
}


// parseTypeGroupEntry 解析 `type (` 分组中的一条目（struct/interface/alias/N T 裸类型）。
fn TypeBlock.parseTypeGroupEntry(&self, x *Parser) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = x.l.next()
    if nameT == nil || nameT.Type != lex.NAME {
        if (nameT) {
            fileBlock.fail( x, EDECL, nameT.Pos)
        } else {
            fileBlock.fail( x, EDECL, 0)
        }
        ret false
    }
    x.l.skipTerminators()
    var q: *lex.Token = x.l.peek()
    // S4 Check：type 登记（struct/interface/alias/其他）。
    if !fileBlock.registerTypeDecl( x, nameT.Value, q, nameT.Pos) {
        ret false
    }
    if q.is( lex.KEYWORD, "struct") {
        ret TypeBlock.parseTypeStructDecl( x)
    }
    if q.is( lex.KEYWORD, "interface") {
        ret self.parseTypeInterfaceDecl( x, nameT.Value)
    }
    if q.is( lex.DELIMITER, "=") {
        ret self.parseTypeAliasDecl( x)
    }
    // 裸新类型：N int / N []string / ...
    if !self.skipType( x) {
        ret false
    }
    x.decls = x.decls + 1
    ret true
}

// parseGroupedBody 消费分组体直到 ')'：按 kind 在 type 与 var/const/let 间分派。
fn TypeBlock.parseGroupedBody(&self, x *Parser, kind string) bool {
    var fileBlock: FileBlock
    var varBlock: VarBlock
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fileBlock.fail( x, ESTMT, 0)
            ret false
        }
        if t.is( lex.DELIMITER, ")") {
            x.l.next()
            ret true
        }
        if !TypeBlock.isDeclKindType( kind) {
            if !varBlock.parseVarConst( x, kind, 1) {
                ret false
            }
            continue
        }
        if !self.parseTypeGroupEntry( x) {
            ret false
        }
    }
}

// isDeclKindType group kind 判断。
fn TypeBlock.isDeclKindType(  kind string) bool {
    ret (kind) == ("type")
}

// parseGroupedDecl 解析分组声明 var/const/let/type ( ... )。
fn TypeBlock.parseGroupedDecl(&self, x *Parser, kind string) bool {
    var p: *lex.Token = x.l.peek()
    if !p.is( lex.DELIMITER, "(") {
        ret false
    }
    x.l.next()
    ret self.parseGroupedBody( x, kind)
}

// parseVarConst 解析单条 var/const/let 声明：[var|const] name[: Type] = v。
// parseTypeStructDecl 处理 `type X struct {...}` 形式（struct body + 计数）。
fn TypeBlock.parseTypeStructDecl(  x *Parser) bool {
    var structBlock: StructBlock
    x.l.next()
    if !structBlock.parseStructBody( x) {
        ret false
    }
    x.structs = x.structs + 1
    x.decls = x.decls + 1
    ret true
}

// parseTypeInterfaceDecl 处理 `type X interface { ... }` 形式。
fn TypeBlock.parseTypeInterfaceDecl(&self, x *Parser, ifaceName: string) bool {
    x.l.next()
    x.ifaceName = ifaceName
    if !self.parseInterfaceBody( x) {
        ret false
    }
    x.decls = x.decls + 1
    ret true
}

// parseTypeAliasDecl 处理 `type X = Type` 真别名形式。
fn TypeBlock.parseTypeAliasDecl(&self, x *Parser) bool {
    x.l.next()
    if !self.skipType( x) {
        ret false
    }
    x.decls = x.decls + 1
    ret true
}

// parseTypeParentDecl 处理遗留的 `type X : Parent struct { ... }` 父类型语法。
fn TypeBlock.parseTypeParentDecl(  x *Parser) bool {
    var fileBlock: FileBlock
    var structBlock: StructBlock
    x.l.next()
    var parentN: *lex.Token = fileBlock.expectName( x, EDECL)
    if parentN == nil {
        ret false
    }
    if !fileBlock.expectKeyword( x, "struct", EDECL) {
        ret false
    }
    if !structBlock.parseStructBody( x) {
        ret false
    }
    x.structs = x.structs + 1
    x.decls = x.decls + 1
    ret true
}
fn TypeBlock.parseTypeFromKeyword(&self, x *Parser, t *lex.Token) bool {
    var fileBlock: FileBlock
    var nameT: *lex.Token = fileBlock.expectName( x, EDECL)
    if nameT == nil {
        ret false
    }
    x.l.skipTerminators()
    var q: *lex.Token = x.l.peek()
    // S4 Check：type 登记（struct/interface/alias/其他）。
    if !fileBlock.registerTypeDecl( x, nameT.Value, q, nameT.Pos) {
        ret false
    }
    if q.is( lex.KEYWORD, "struct") {
        ret TypeBlock.parseTypeStructDecl( x)
    }
    if q.is( lex.KEYWORD, "interface") {
        ret self.parseTypeInterfaceDecl( x, nameT.Value)
    }
    if q.is( lex.DELIMITER, "=") {
        ret self.parseTypeAliasDecl( x)
    }
    if q.is( lex.DELIMITER, ":") {
        ret TypeBlock.parseTypeParentDecl( x)
    }
    // type X T —— 新类型定义（docs/LANGUAGE.md §5.1：type MyInt2 int）
    ret self.skipType( x)
}