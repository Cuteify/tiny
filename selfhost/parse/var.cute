// var.cute —— var/const/let 声明与分组。
import "std:strings"
import lex "../lexer"
fn VarBlock.parseVarConst(  x *Parser, kind string, global int) bool {
    var fileBlock: FileBlock
    var typeBlock: TypeBlock
    var nameT: *lex.Token = fileBlock.expectName( x, EDECL)
    if nameT == nil {
        ret false
    }
    // S4 Check：var/const 登记（仅全局声明；函数体局部 var 不登记）。
    if global != 0 {
        var k0: int = REG_VAR
        if strings.eq(kind, "const") {
            k0 = REG_CONST
        }
        if !fileBlock.registerDecl( x, nameT.Value, k0, nameT.Pos) {
            ret false
        }
    }
    var t: *lex.Token = x.l.peek()
    var hasType: bool = t.is( lex.DELIMITER, ":")
    if hasType {
        x.l.next()
        if !typeBlock.skipType( x) {
            ret false
        }
    }
    var eqT: *lex.Token = x.l.peek()
    if eqT.is( lex.DELIMITER, "=") {
        x.l.next()
        fileBlock.restOfLineAtDepth0( x)
    } else if !hasType {
        // var x 无类型也无初值：声明但零值（允许）
    }
    if strings.eq(kind, "const") {
        x.consts = x.consts + 1
    } else {
        x.vars = x.vars + 1
    }
    x.decls = x.decls + 1
    ret true
}
fn VarBlock.parseVarConstDispatch(&self, x *Parser, kind string, global int) bool {
    var typeBlock: TypeBlock
    x.l.skipTerminators()
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "(") {
        ret typeBlock.parseGroupedDecl( x, kind)
    }
    if !VarBlock.parseVarConst( x, kind, global) {
        ret false
    }
    ret true
}
