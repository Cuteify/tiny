// var.cute —— var/const/let 声明与分组。
import "std:strings"
import lex "../lexer"







fn VarBlock.parseVarConst(r VarBlock, x *Parser, kind string) bool {
    var fileBlock: FileBlock
    var typeBlock: TypeBlock
    var nameT: *lex.Token = FileBlock.expectName(fileBlock, x, EDECL)
    if nameT == nil {
        ret false
    }
    var t: *lex.Token = x.l.peek()
    var hasType: bool = lex.Token.is(t, lex.DELIMITER, ":")
    if hasType {
        x.l.next()
        if !TypeBlock.skipType(typeBlock, x) {
            ret false
        }
    }
    var eqT: *lex.Token = x.l.peek()
    if lex.Token.is(eqT, lex.DELIMITER, "=") {
        x.l.next()
        FileBlock.restOfLineAtDepth0(fileBlock, x)
    } else if !hasType {
        // var x 无类型也无初值：声明但零值（允许）
    }
    if strings.eq(kind, "const") {
        x.consts = x.consts + 1
    } else {
        x.vars = x.vars + 1
    }
    x.decls = x.decls + 1
    ret true
}

fn VarBlock.parseVarConstDispatch(r VarBlock, x *Parser, kind string) bool {
    var typeBlock: TypeBlock
    x.l.skipTerminators()
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "(") {
        ret TypeBlock.parseGroupedDecl(typeBlock, x, kind)
    }
    ret VarBlock.parseVarConst(r, x, kind)
}
