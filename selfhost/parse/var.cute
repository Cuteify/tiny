// var.cute —— var/const/let 声明与分组。
import "std:strings"
import lex "../lexer"

type VarBlock struct {
    Name: string
}

type ConstBlock struct {
    Name: string
}

fn parseVarConst(x *Parser, kind string) bool {
    var nameT: *lex.Token = expectName(x, EDECL)
    if nameT == nil {
        ret false
    }
    var t: *lex.Token = x.l.Peek()
    var hasType: bool = lex.Token.Is(t, lex.DELIMITER, ":")
    if hasType {
        x.l.Next()
        if !skipType(x) {
            ret false
        }
    }
    var eqT: *lex.Token = x.l.Peek()
    if lex.Token.Is(eqT, lex.DELIMITER, "=") {
        x.l.Next()
        restOfLineAtDepth0(x)
    } else if !hasType {
        // var x 无类型也无初值：声明但零值（允许）
    }
    if strings.eq(kind, "const") {
        x.consts = x.consts + 1
    } else {
        x.vars = x.vars + 1
    }
    x.decls = x.decls + 1
    ret true
}

fn parseVarConstDispatch(x *Parser, kind string) bool {
    x.l.SkipTerminators()
    if lex.Token.Is(x.l.Peek(), lex.DELIMITER, "(") {
        ret parseGroupedDecl(x, kind)
    }
    ret parseVarConst(x, kind)
}
