// import.cute —— import "path" / import alias / import ( group )。
import "std:strings"
import lex "../lexer"

type ImportBlock struct {
    Path: string
    Alias: string
}

fn parseImportFromKeyword(x *Parser) bool {
    var saved: *lex.Token = x.l.Peek()
    if lex.Token.Is(saved, lex.DELIMITER, "(") {
        x.l.Next()
        for ; ; {
            x.l.SkipTerminators()
            var t: *lex.Token = x.l.Peek()
            if t == nil {
                fail(x, EDECL, 0)
                ret false
            }
            if lex.Token.Is(t, lex.DELIMITER, ")") {
                x.l.Next()
                x.imports = x.imports + 1
                x.decls = x.decls + 1
                ret true
            }
            if t.Type == lex.STRING {
                x.l.Next()
                continue
            }
            if t.Type == lex.NAME {
                x.l.Next()
                var strT: *lex.Token = x.l.Next()
                if strT == nil || strT.Type != lex.STRING {
                    if (strT) {
                        fail(x, EDECL, strT.Pos)
                    } else {
                        fail(x, EDECL, 0)
                    }
                    ret false
                }
                continue
            }
            if lex.Token.Is(t, lex.DELIMITER, ",") {
                x.l.Next()
                continue
            }
            fail(x, EDECL, t.Pos)
            ret false
        }
    }
    var t: *lex.Token = x.l.Peek()
    if t != nil && t.Type == lex.NAME {
        x.l.Next()
    }
    var strT: *lex.Token = x.l.Next()
    if strT == nil || strT.Type != lex.STRING {
        if (strT) {
            fail(x, EDECL, strT.Pos)
        } else {
            fail(x, EDECL, 0)
        }
        ret false
    }
    x.imports = x.imports + 1
    x.decls = x.decls + 1
    ret true
}
