// import.cute —— import "path" / import alias / import ( group )。
import "std:strings"
import lex "../lexer"




// expectImportString 消费一个 STRING 并期望失败记错；用于 import 路径。
fn ImportBlock.expectImportString(  x *Parser) bool {
    var fileBlock: FileBlock
    var strT: *lex.Token = x.l.next()
    if strT == nil || strT.Type != lex.STRING {
        if (strT) {
            fileBlock.fail( x, EDECL, strT.Pos)
        } else {
            fileBlock.fail( x, EDECL, 0)
        }
        ret false
    }
    ret true
}

// parseImportOneItem 解析 import 分组里的一行（STRING / alias STRING / `,`）。
fn ImportBlock.parseImportOneItem(&self, x *Parser) bool {
    var fileBlock: FileBlock
    var t: *lex.Token = x.l.peek()
    if t.Type == lex.STRING {
        x.l.next()
        ret true
    }
    if t.Type == lex.NAME {
        x.l.next()
        ret ImportBlock.expectImportString( x)
    }
    if t.is( lex.DELIMITER, ",") {
        x.l.next()
        ret true
    }
    fileBlock.fail( x, EDECL, t.Pos)
    ret false
}

// parseImportGroup 解析分组 `import ( ... )`：每行一个，可带 alias。
fn ImportBlock.parseImportGroup(&self, x *Parser) bool {
    var fileBlock: FileBlock
    x.l.next()
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fileBlock.fail( x, EDECL, 0)
            ret false
        }
        if t.is( lex.DELIMITER, ")") {
            x.l.next()
            x.imports = x.imports + 1
            x.decls = x.decls + 1
            ret true
        }
        if !self.parseImportOneItem( x) {
            ret false
        }
    }
}

// parseImportSingle 解析单条 `import alias "path"`（含 alias="_" 形式）。
fn ImportBlock.parseImportSingle(&self, x *Parser) bool {
    var maybeName: *lex.Token = x.l.peek()
    if maybeName != nil && maybeName.Type == lex.NAME {
        x.l.next()
    }
    if !ImportBlock.expectImportString( x) {
        ret false
    }
    x.imports = x.imports + 1
    x.decls = x.decls + 1
    ret true
}
fn ImportBlock.parseImportFromKeyword(&self, x *Parser) bool {
    var tpeek: *lex.Token = x.l.peek()
    if tpeek.is(lex.DELIMITER, "(") {
        ret self.parseImportGroup( x)
    }
    ret self.parseImportSingle( x)
}