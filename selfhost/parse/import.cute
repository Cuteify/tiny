// import.cute —— import "path" / import alias / import ( group )。
import "std:strings"
import lex "../lexer"

type ImportBlock struct {
    Path: string
    Alias: string
}

// expectImportString 消费一个 STRING 并期望失败记错；用于 import 路径。
fn expectImportString(x *Parser) bool {
    var strT: *lex.Token = x.l.next()
    if strT == nil || strT.Type != lex.STRING {
        if (strT) {
            fail(x, EDECL, strT.Pos)
        } else {
            fail(x, EDECL, 0)
        }
        ret false
    }
    ret true
}

// parseImportOneItem 解析 import 分组里的一行（STRING / alias STRING / `,`）。
fn parseImportOneItem(x *Parser) bool {
    var t: *lex.Token = x.l.peek()
    if t.Type == lex.STRING {
        x.l.next()
        ret true
    }
    if t.Type == lex.NAME {
        x.l.next()
        ret expectImportString(x)
    }
    if lex.Token.is(t, lex.DELIMITER, ",") {
        x.l.next()
        ret true
    }
    fail(x, EDECL, t.Pos)
    ret false
}

// parseImportGroup 解析分组 `import ( ... )`：每行一个，可带 alias。
fn parseImportGroup(x *Parser) bool {
    x.l.next()
    for ; ; {
        x.l.skipTerminators()
        var t: *lex.Token = x.l.peek()
        if t == nil {
            fail(x, EDECL, 0)
            ret false
        }
        if lex.Token.is(t, lex.DELIMITER, ")") {
            x.l.next()
            x.imports = x.imports + 1
            x.decls = x.decls + 1
            ret true
        }
        if !parseImportOneItem(x) {
            ret false
        }
    }
}

// parseImportSingle 解析单条 `import alias "path"`（含 alias="_" 形式）。
fn parseImportSingle(x *Parser) bool {
    var maybeName: *lex.Token = x.l.peek()
    if maybeName != nil && maybeName.Type == lex.NAME {
        x.l.next()
    }
    if !expectImportString(x) {
        ret false
    }
    x.imports = x.imports + 1
    x.decls = x.decls + 1
    ret true
}

fn parseImportFromKeyword(x *Parser) bool {
    if lex.Token.is(x.l.peek(), lex.DELIMITER, "(") {
        ret parseImportGroup(x)
    }
    ret parseImportSingle(x)
}