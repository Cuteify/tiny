// buf.cute —— /home/gx/Downloads/dev/lexer/{token.go,buf.go} 的移植（两个文件合并）。
//
// Cute 编译器按文件名字母序逐文件解析，先声明先可见：buf.cute 需要先于
// lexer.cute 解析并提供 Token + RingBuffer，因此把 token.go 的类型与函数
// 整体搬进本文件（buf.go 的所有内容保持在本文件末尾，紧随 token.go 之后）。
// 关键字/分隔符表与 isKeyword/isDelimiter 移入 keywords.cute（见该文件）。
// Go 侧参考实现的关键点全部照抄；与 Go 的差异仅在 Cute 必要处。
//
// 与 Go 的差异：
//   1. Token/error 按 *Token/*error 传递/缓存：本编译器不支持多字段结构体
//      按值返回（docs §15 “结构体按值/多返回值”限制都适用）；
//   2. 关键字/分隔符表 presort 为字面量，isKeyword/isDelimiter 内做二分查找；
//      Go 侧的 init() sort.Strings 折叠进作者化排序，顺序与 Go 运行结果一致；
//   3. 泛型 [T any] 单态化为 Token：本编译器不支持泛型结构体（docs §15 已登记）。

import "std:strings"

// TokenType 词法单元类型：NONE（EOF / 出错哨兵）、STRING、KEYWORD、
// DELIMITER（分隔符 / 运算符）、NUMBER（数字字面量）、NAME（其余词素）。
enum TokenType {
    NONE
    STRING
    KEYWORD                    // 关键字（cute 全量关键字表）
    DELIMITER                  // 分隔符 / 运算符（1~3 个字节）
    NUMBER                     // 数字字面量（整数/浮点统一，见 handleNumber）
    NAME                       // 标识符、字符串、字符、原始字符串
}

type Token struct {
    Type: TokenType
    Value: string
    Number: f64
    Pos: int
    EndPos: int
    Line: int
    Col: int
    EndLine: int
    EndCol: int
}

fn TokenType.string(t TokenType) string {
    switch t {
    case NONE:
        ret "NONE"
    case STRING:
        ret "STRING"
    case KEYWORD:
        ret "KEYWORD"
    case DELIMITER:
        ret "DELIMITER"
    case NUMBER:
        ret "NUMBER"
    case NAME:
        ret "NAME"
    default:
        ret "NONE"
    }
}

fn Token.string(t *Token) string {
    var sb: string = "[" + TokenType.string(t.Type) + "]" + renderVisible(t.Value)
    ret sb
}

fn Token.len(t *Token) int {
    ret unsafe.cast[int](strings.len(t.Value))
}

// IsLineEnd 行尾判定：LF 与 CR 的一字节 DELIMITER token。
// nil / NONE / 其它类型一律返回 false（parser 的行尾跳循环靠它终止）。
fn Token.isLineEnd(t *Token) bool {
    if unsafe.cast[uint](t) == 0 {
        ret false
    }
    if t.Type != DELIMITER {
        ret false
    }
    if len(t.Value) != 1 {
        ret false
    }
    var b: byte = t.Value[0]
    var bi: int = unsafe.cast[int](b)
    ret bi == 10 || bi == 13
}

// IsSemiOrNewline 语句终结符判定：DELIMITER ";" 或 IsLineEnd(t)。
// nil / NONE / 其它类型返回 false。
fn Token.isSemiOrNewline(t *Token) bool {
    if unsafe.cast[uint](t) == 0 {
        ret false
    }
    if t.Type != DELIMITER {
        ret false
    }
    if strings.eq(t.Value, ";") {
        ret true
    }
    ret Token.isLineEnd(t)
}

// Is 按种类+值判断 token（类型安全的 kind/value 匹配，调用方不必各自 nil/Type/eq）。
fn Token.is(t *Token, kind: TokenType, value string) bool {
    if unsafe.cast[uint](t) == 0 {
        ret false
    }
    if t.Type != kind {
        ret false
    }
    ret strings.eq(t.Value, value)
}

// renderVisible 把 LF/CR/TAB 渲染为可见两字符转义（\n \r \t），其余原样返回。
// 与 Go 参考 token.go 的 renderVisible 逐字节一致（一行一 token 输出不被破坏）。
// 单缓冲 O(n)：最坏情况下每个输入字节产出 2 个输出字节，按 2n+1 预分配；
// 原实现每字符 malloc(2)+字符串拼接 O(n²) 行为已废弃。
fn renderVisible(s string) string {
    var n: uint = strings.len(s)
    if n == 0 {
        ret s
    }
    var pU8: *u8 = strings.toCstring(s)
    var buf: string = new(string, unsafe.cast[int](2 * n + 1))
    var bufu8: *u8 = unsafe.cast[*u8](buf)
    var w: uint = 0
    var i: uint = 0
    for ; i < n; {
        var b: u8 = *(pU8 + i)
        var bi: int = unsafe.cast[int](b)
        if bi == 10 {
            *(bufu8 + w) = 92
            *(bufu8 + w + 1) = 110
            w = w + 2
        } else if bi == 13 {
            *(bufu8 + w) = 92
            *(bufu8 + w + 1) = 114
            w = w + 2
        } else if bi == 9 {
            *(bufu8 + w) = 92
            *(bufu8 + w + 1) = 116
            w = w + 2
        } else {
            *(bufu8 + w) = b
            w = w + 1
        }
        i = i + 1
    }
    *(bufu8 + w) = 0
    ret buf[:w]
}

// RingBuffer 环形缓冲区（预取 FIFO 用）：固定容量，满后 write 返回 false。
type RingBuffer struct {
    buf: []*Token
    ReadPos: int
    WritePos: int
    f: bool // f=true 代表缓冲区已满
}

fn newRingBuffer(size int) *RingBuffer {
    if size <= 0 {
        // Go panic("size must > 0")
        panic("size must > 0")
    }
    var r: *RingBuffer = new(RingBuffer)
    var arr: []*Token = new([]*Token, size, size)
    r.buf = arr
    ret r
}

// IsFull 是否满
fn RingBuffer.isFull(r *RingBuffer) bool {
    ret r.f
}

// IsEmpty 是否空
fn RingBuffer.isEmpty(r *RingBuffer) bool {
    ret !r.f && r.ReadPos == r.WritePos
}

// write 写入元素，成功返回true，满了返回false
fn RingBuffer.write(r *RingBuffer, c *Token) bool {
    if r.isFull() {
        ret false
    }

    // 先写当前位置
    r.buf[r.WritePos] = c
    // 移动写指针，取模环绕
    r.WritePos = (r.WritePos + 1) % len(r.buf)

    // 写完之后，如果写指针追上读指针 → 变满
    if r.WritePos == r.ReadPos {
        r.f = true
    }
    ret true
}

// read 读出一个元素；空时返回零指针（0）。
// Go 的第二返回值（false/true）映射为 "返回零指针时表示空"。
fn RingBuffer.read(r *RingBuffer) *Token {
    if r.isEmpty() {
        ret 0
    }

    var val: *Token = r.buf[r.ReadPos]
    // 移动读指针
    r.ReadPos = (r.ReadPos + 1) % len(r.buf)

    // 读完之后，肯定不再是满状态
    r.f = false
    ret val
}

// Clear 重置读写下标与满标记（不动槽位，也不释放已写入的 *Token）。
// 用于位置回卷后丢弃预取残留——buffer 直接复用，零分配。
fn RingBuffer.clear(r *RingBuffer) {
    r.ReadPos = 0
    r.WritePos = 0
    r.f = false
}

// front 只读地查看环首元素；空时返回零指针（不弹出）。
// parser 的 peek 语义直接由这里经 lex.Prefetch 承接，不进环也不消费。
fn RingBuffer.front(r *RingBuffer) *Token {
    if r.isEmpty() {
        ret 0
    }
    ret r.buf[r.ReadPos]
}

// Resize 扩容：把现有有效数据迁移到新buffer
// 注意：Resize 环形buffer比较麻烦，不能直接copy底层数组
fn RingBuffer.resize(r *RingBuffer, newSize int) {
    if newSize <= len(r.buf) {
        // 简化：这里只支持扩容，缩容不处理，或者你自己扩展
        ret
    }
    var newBuf: []*Token = new([]*Token, newSize, newSize)

    // 把所有有效数据依次读出写入新buf
    var idx: int = 0
    for ; !r.isEmpty(); {
        var v: *Token = r.read()
        newBuf[idx] = v
        idx = idx + 1
    }

    r.buf = newBuf
    r.ReadPos = 0
    r.WritePos = idx
    r.f = false
}
