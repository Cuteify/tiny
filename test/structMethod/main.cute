// 结构体方法测试

type Point struct {
    x: int
    y: int
}

fn Point.move(p: *Point, dx int, dy int) {
    p.x += dx
    p.y += dy
}

fn Point.getX(p: Point) int {
    ret p.x
}

fn Point.getY(p: Point) int {
    ret p.y
}

fn main() int {
    var p: Point
    p.x = 10
    p.y = 20
    p.move(5, 10)
    ret p.getX() + p.getY()
}
