// 结构体方法测试

type Point struct {
    pub x: int
    pub y: int
}

fn (self Point) move(dx int, dy int) {
    self.x += dx
    self.y += dy
}

fn (self Point) getX() int {
    ret self.x
}

fn (self Point) getY() int {
    ret self.y
}

fn main() int {
    var p: Point
    p.x = 10
    p.y = 20
    p.move(5, 10)
    ret p.getX() + p.getY()
}
