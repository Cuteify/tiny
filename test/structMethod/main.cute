// 结构体方法测试

type Point struct {
    x: int
    y: int
}
fn Point.move(&self, dx int, dy int) {
    self.x += dx
    self.y += dy
}
fn Point.getX(&self) int {
    ret self.x
}
fn Point.getY(&self) int {
    ret self.y
}

fn main() int {
    var p: Point
    p.x = 10
    p.y = 20
    p.move(5, 10)
    ret p.getX() + p.getY()
}
