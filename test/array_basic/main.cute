fn main() i32 {
    // 数组声明 + 字面量初始化
    var arr: [3]int = [3]int{10, 20, 30}

    // 索引访问
    var first: int = arr[0]
    var second: int = arr[1]
    var third: int = arr[2]

    if (first != 10) {
        println("FAIL: arr[0] != 10")
        println(", want 10")
        ret 1
    }
    if (second != 20) {
        println("FAIL: arr[1] != 20")
        println(", want 20")
        ret 1
    }
    if (third != 30) {
        println("FAIL: arr[2] != 30")
        println(", want 30")
        ret 1
    }

    // 索引赋值
    arr[1] = 99
    if (arr[1] != 99) {
        println("FAIL: arr[1] after assign != 99")
        println(", want 99")
        ret 1
    }

    // len 函数（len 仅支持切片/字符串，不支持定长数组）
    var sl: []int = []int{55, 66, 77}
    var n: int = len(sl)
    if (n != 3) {
        println("FAIL: len(sl) != 3")
        ret 1
    }

    // 未初始化数组（零值）
    var zeros: [5]int
    var z: int = zeros[0]
    if (z != 0) {
        println("FAIL: zeros[0] != 0")
        ret 1
    }

    println("PASS: ALL")
    ret 0
}
