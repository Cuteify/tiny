import "std:memory"
import "std:strings"

// 只读比较：参数 EscNone，返回标量（RetNone）
fn cmpLen(a: string, b: string) int {
    var la: int = len(a)
    var lb: int = len(b)
    ret la - lb
}

// 两个嵌套 owning call 作为外层实参：外层返回后两个临时都可释放
fn twoTemps() int {
    ret cmpLen(strings.repeatN("ab", 2), strings.repeatN("cd", 2))
}

// 单个嵌套 owning call + 一个借用返回 call：只释放 owning 临时
fn oneTemp() int {
    ret cmpLen(strings.repeatN("ab", 2), strings.trimPrefix("abcd", "zzz"))
}

// 别名风险：trimPrefix 可能原样返回实参，内层 owning 临时不得释放
fn aliasRisk() int {
    ret cmpLen(strings.trimPrefix(strings.repeatN("abc", 1), "zzz"), strings.trimPrefix("abc", "zzz"))
}

fn main() int {
    if twoTemps() != 0 {
        ret 1
    }
    if oneTemp() != 0 {
        ret 2
    }
    if aliasRisk() != 0 {
        ret 3
    }
    var i: int = 0
    for i < 2000 {
        if twoTemps() != 0 {
            ret 4
        }
        if oneTemp() != 0 {
            ret 5
        }
        if aliasRisk() != 0 {
            ret 6
        }
        i = i + 1
    }
    ret 0
}
