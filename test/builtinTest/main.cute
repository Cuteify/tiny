// 零 import 测试：
// - print/println 来自内置包 std:builtin（自动导入，裸调用）
// - len/cap/copy/new 为编译器内建（类型分派）
fn main() int {
    // 内置包函数裸调用
    print("builtin: ")

    // len/cap: string
    var s: string = "hello"
    if len(s) != 5 {
        ret 1
    }
    if cap(s) != 5 {
        ret 2
    }

    // new 创建列表：new([]int, len, cap)
    var a: []int = new([]int, 3, 8)
    if len(a) != 3 {
        ret 3
    }
    if cap(a) != 8 {
        ret 4
    }

    a[0] = 10
    a[1] = 20
    a[2] = 30

    // copy 列表拷贝：min(len) 个元素，返回计数
    var b: []int = new([]int, 2, 2)
    var n: int = copy(b, a)
    if n != 2 {
        ret 5
    }
    if b[0] != 10 {
        ret 6
    }
    if b[1] != 20 {
        ret 7
    }

    // new 单参数形式（cap = len）
    var c: []int = new([]int, 4)
    if len(c) != 4 {
        ret 8
    }
    if cap(c) != 4 {
        ret 9
    }

    println("ok")
    ret 0
}
