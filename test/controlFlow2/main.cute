// P8 控制流测试：while / continue / 多级 break/continue / fallthrough
// 返回 42 表示全部通过。

fn testWhile() int {
    var i: int = 5
    var sum: int = 0
    while i > 0 {
        sum += i
        i -= 1
    }
    if sum != 15 {
        ret 1
    }
    ret 0
}

fn testWhileContinueBreak() int {
    var i: int = 0
    var sum: int = 0
    while true {
        i += 1
        if i == 2 {
            continue
        }
        if i == 5 {
            break
        }
        sum += i
    }
    // i = 3, 4 累加；1 被跳过，2 continue，5 break
    if sum != 8 {
        ret 1
    }
    ret 0
}

fn testContinue() int {
    var sum: int = 0
    for i := 0; i < 5; i++ {
        if i == 2 {
            continue
        }
        sum += i
    }
    if sum != 8 {
        ret 1
    }
    ret 0
}

fn testBreak2() int {
    var count: int = 0
    for i := 0; i < 3; i++ {
        for j := 0; j < 3; j++ {
            if j == 1 {
                break 2
            }
            count += 1
        }
        count += 100
    }
    if count != 1 {
        ret 1
    }
    ret 0
}

fn testContinue2() int {
    var sum: int = 0
    for i := 0; i < 3; i++ {
        for j := 0; j < 3; j++ {
            if j == 1 {
                continue 2
            }
            sum += 1
        }
        sum += 100
    }
    if sum != 3 {
        ret 1
    }
    ret 0
}

fn testSwitchBreak() int {
    var x: int = 2
    var r: int = 0
    switch x {
    case 1:
        r = 10
    case 2:
        r = 20
        break
        r = 30
    case 3:
        r = 40
    }
    if r != 20 {
        ret 1
    }
    ret 0
}

fn testSwitchContinue() int {
    var sum: int = 0
    for i := 0; i < 4; i++ {
        switch i {
        case 1:
            continue
        }
        sum += i
    }
    if sum != 5 {
        ret 1
    }
    ret 0
}

fn testBreakOutOfSwitchLoop() int {
    var count: int = 0
    for i := 0; i < 3; i++ {
        switch i {
        case 1:
            break 2
        }
        count += 1
    }
    if count != 1 {
        ret 1
    }
    ret 0
}

fn testFallthrough() int {
    var x: int = 1
    var sum: int = 0
    switch x {
    case 1:
        sum += 1
        fallthrough
    case 2:
        sum += 10
        fallthrough
    default:
        sum += 100
    }
    if sum != 111 {
        ret 1
    }
    ret 0
}

fn testFallthroughDefault() int {
    var x: int = 9
    var sum: int = 0
    switch x {
    case 1:
        sum += 1
    default:
        sum += 10
        fallthrough
    case 2:
        sum += 100
    }
    if sum != 110 {
        ret 1
    }
    ret 0
}

fn main() int {
    if testWhile() != 0 {
        ret 1
    }
    if testWhileContinueBreak() != 0 {
        ret 2
    }
    if testContinue() != 0 {
        ret 3
    }
    if testBreak2() != 0 {
        ret 4
    }
    if testContinue2() != 0 {
        ret 5
    }
    if testSwitchBreak() != 0 {
        ret 6
    }
    if testSwitchContinue() != 0 {
        ret 7
    }
    if testBreakOutOfSwitchLoop() != 0 {
        ret 8
    }
    if testFallthrough() != 0 {
        ret 9
    }
    if testFallthroughDefault() != 0 {
        ret 10
    }
    ret 42
}
