// 运算符优先级测试 - 覆盖各种运算符组合

fn test1() int {
    // 测试加减乘除优先级
    ret 2 + 3 * 4 - 6 / 2  // 2 + 12 - 3 = 11
}

fn test2() int {
    // 测试括号改变优先级
    ret (2 + 3) * (4 - 6) / 2  // 5 * (-2) / 2 = -5
}

fn test3() int {
    // 测试位运算和算术运算混合
    ret 10 + 5 & 3 | 1  // (10 + 5) & 3 | 1 = 15 & 3 | 1 = 3 | 1 = 3
}

fn test4() int {
    // 测试比较运算和逻辑运算
    ret 5 > 3 && 2 < 4  // true && true = 1
}

fn test5() int {
    // 测试复杂嵌套
    ret (10 + 5) * 2 - (8 / 2 + 3)  // 30 - 7 = 23
}

fn test6() int {
    // 测试一元运算符
    ret -5 + 3 * -2  // -5 + (-6) = -11
}

fn test7() int {
    // 测试位运算优先级
    ret 255 & 15 | 240  // (255 & 15) | 240 = 15 | 240 = 255
}

fn test8() int {
    // 测试移位运算
    ret 1 << 3 + 2  // 1 << 5 = 32
}

fn test9() int {
    // 测试取模运算
    ret 17 % 5 + 3 % 2  // 2 + 1 = 3
}

fn test10() int {
    // 测试复合表达式
    ret (100 / 10 + 5 * 2) % 7 - 1  // (10 + 10) % 7 - 1 = 20 % 7 - 1 = 6 - 1 = 5
}

fn main() int {
    var sum: int = test1() + test2() + test3() + test4() + test5() + test6() + test7() + test8() + test9() + test10()
    ret sum
}
