build os("linux")

type User struct {
    name: string
    age: int
    email: string
}

type Node struct {
    val: int
    left: *Node
    right: *Node
}

type Link struct {
    data: int
    next: *Link
}

fn makeUser(name: string, age: int, email: string) *User {
    var u: *User = new(User)
    u.name = name
    u.age = age
    u.email = email
    ret u
}

fn makeNode(val: int) *Node {
    var n: *Node = new(Node)
    n.val = val
    ret n
}

fn bstInsert(root: *Node, val: int) *Node {
    if root == nil {
        ret makeNode(val)
    }
    if val < root.val {
        root.left = bstInsert(root.left, val)
    } else {
        root.right = bstInsert(root.right, val)
    }
    ret root
}

fn bstSum(root: *Node) int {
    if root == nil {
        ret 0
    }
    ret root.val + bstSum(root.left) + bstSum(root.right)
}

fn linkPrepend(head: *Link, val: int) *Link {
    var n: *Link = new(Link)
    n.data = val
    n.next = head
    ret n
}

fn linkSum(head: *Link) int {
    var s: int = 0
    var c: *Link = head
    for ; c != nil; {
        s = s + c.data
        c = c.next
    }
    ret s
}

fn deepAlloc3() *User {
    ret makeUser("deep3", 99, "deep3@test.com")
}

fn deepAlloc2() *User {
    var u1: *User = makeUser("deep2a", 80, "d2a@test.com")
    var u2: *User = deepAlloc3()
    ret u2
}

fn deepAlloc1() *User {
    var u1: *User = makeUser("deep1a", 70, "d1a@test.com")
    var u2: *User = deepAlloc2()
    ret u2
}

fn buildStr(n int) string {
    var s: string = ""
    var i: int = 0
    for ; i < n; {
        s = s + "X"
        i = i + 1
    }
    ret s
}

fn branchPick(flag int) *User {
    if flag == 1 {
        ret makeUser("a", 10, "a@test.com")
    }
    if flag == 2 {
        ret makeUser("b", 20, "b@test.com")
    }
    if flag == 3 {
        ret makeUser("c", 30, "c@test.com")
    }
    ret makeUser("d", 40, "d@test.com")
}

fn main() int {
    var ok: int = 0

    // 1. 多个 User 堆分配
    var u1: *User = makeUser("alice", 25, "alice@test.com")
    var u2: *User = makeUser("bob", 30, "bob@test.com")
    var u3: *User = makeUser("carol", 35, "carol@test.com")
    if u1.age + u2.age + u3.age == 90 {
        ok = ok + 1
    }

    // 2. 二叉搜索树（10节点）
    var tree: *Node = nil
    tree = bstInsert(tree, 50)
    tree = bstInsert(tree, 30)
    tree = bstInsert(tree, 70)
    tree = bstInsert(tree, 20)
    tree = bstInsert(tree, 40)
    tree = bstInsert(tree, 60)
    tree = bstInsert(tree, 80)
    tree = bstInsert(tree, 10)
    tree = bstInsert(tree, 25)
    tree = bstInsert(tree, 55)
    if bstSum(tree) == 440 {
        ok = ok + 1
    }

    // 3. 链表（20节点）
    var head: *Link = nil
    var i: int = 0
    for ; i < 20; {
        head = linkPrepend(head, i)
        i = i + 1
    }
    if linkSum(head) == 190 {
        ok = ok + 1
    }

    // 4. 多层嵌套堆分配
    var deep: *User = deepAlloc1()
    if deep.age == 99 {
        ok = ok + 1
    }

    // 5. 字符串拼接（每次 + 可能分配新堆）
    var s1: string = buildStr(10)
    var s2: string = buildStr(20)
    var s3: string = buildStr(30)
    var totalLen: int = len(s1) + len(s2) + len(s3)
    if totalLen == 60 {
        ok = ok + 1
    }

    // 6. 分支分配
    var b1: *User = branchPick(1)
    var b2: *User = branchPick(2)
    var b3: *User = branchPick(3)
    var b4: *User = branchPick(4)
    if b1.age + b2.age + b3.age + b4.age == 100 {
        ok = ok + 1
    }

    // 7. 循环内分配50个
    var j: int = 0
    for ; j < 50; {
        var tmp: *User = makeUser("tmp", j, "tmp@test.com")
        j = j + 1
    }

    // 8. 依赖 ok 值的分支分配
    var c1: *User = branchPick(ok)
    var c2: *User = branchPick(ok + 1)
    if c1.age + c2.age == 30 {
        ok = ok + 1
    }

    // 9. 15节点大树
    var bigTree: *Node = nil
    var k: int = 0
    for ; k < 15; {
        bigTree = bstInsert(bigTree, k * 10)
        k = k + 1
    }
    if bstSum(bigTree) == 1050 {
        ok = ok + 1
    }

    // 10. 大字符串 100 次拼接
    var big: string = buildStr(100)
    if len(big) == 100 {
        ok = ok + 1
    }

    ret ok
}
