import "std:memory"
import "std:strings"

// GC 覆盖赋值释放回归探针：
// - 循环携带变量 cur = new(Node)：旧 cur 唯一/未共享，应在赋值点释放；
// - 链表 head = nd：旧 head 已存入 nd.next，必须保留；
// - 字段别名 holder.next = b 后覆盖 b：旧 b 必须保留；
// - 自引用 c = c.next：右值引用目标变量，必须保留；
// - x = nil：旧对象应释放。

type Node struct {
    val: int
    next: *Node
}

fn overwriteLoop(n: int) int {
    var sum: int = 0
    var cur: *Node = new(Node)
    cur.val = 0
    var i: int = 0
    for i < n {
        cur = new(Node)
        cur.val = i
        sum = sum + cur.val
        i = i + 1
    }
    ret sum
}

fn walk(head: *Node) int {
    var sum: int = 0
    var c: *Node = head
    for c != nil {
        sum = sum + c.val
        c = c.next
    }
    ret sum
}

fn listBuild(n: int) int {
    var head: *Node = nil
    var k: int = 5
    for k > 0 {
        var nd: *Node = new(Node)
        nd.val = k * 10
        nd.next = head
        head = nd
        k = k - 1
    }
    ret walk(head)
}

fn fieldAlias() int {
    var holder: *Node = new(Node)
    var b: *Node = new(Node)
    b.val = 7
    holder.next = b
    b = new(Node)
    b.val = 9
    ret holder.next.val
}

fn selfRef() int {
    var c: *Node = new(Node)
    c.val = 5
    var d: *Node = new(Node)
    d.val = 6
    c.next = d
    c = c.next
    ret c.val
}

fn nilDrop() int {
    var x: *Node = new(Node)
    x.val = 3
    x = nil
    if x != nil {
        ret 1
    }
    ret 0
}

fn main() int {
    if overwriteLoop(10000) != 49995000 {
        ret 1
    }
    if listBuild(5) != 150 {
        ret 2
    }
    if fieldAlias() != 7 {
        ret 3
    }
    if selfRef() != 6 {
        ret 4
    }
    if nilDrop() != 0 {
        ret 5
    }
    ret 0
}
