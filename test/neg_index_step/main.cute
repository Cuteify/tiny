// test/neg_index_step —— 负数索引 + 切片步长验收
// 覆盖：list/string/array 负索引（常量/动态）、负索引写、步长切片、
//       反向切片、负边界切片、字符串步长切片、[]string 元素复制。
// 输出 neg_index_step: ALL PASS 并退出 42。
import "std:console"
import "std:strings"
fn main() int {
    var pass: int = 0
    var fail: int = 0
    var firstFail: int = 0

    var a: []int = []int{10, 20, 30, 40, 50}

    // 1. list 常量负索引
    if a[-1] == 50 && a[-5] == 10 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 1
        }
        fail = fail + 1
    }

    // 2. list 动态负索引
    var i: int = -2
    if a[i] == 40 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 2
        }
        fail = fail + 1
    }

    // 3. list 动态正索引（回归）
    var j: int = 1
    if a[j] == 20 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 3
        }
        fail = fail + 1
    }

    // 4. list 负索引写
    a[-1] = 55
    var k: int = -1
    a[k] = 56
    if a[4] == 56 && a[-1] == 56 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 4
        }
        fail = fail + 1
    }

    // 5. 步长切片（正步长）
    var s1: []int = a[0:5:2]  // 10, 30, 56
    if len(s1) == 3 && s1[0] == 10 && s1[1] == 30 && s1[2] == 56 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 5
        }
        fail = fail + 1
    }

    // 6. 步长切片（偏移 + 正步长）
    var s2: []int = a[1:5:2]  // 20, 40
    if len(s2) == 2 && s2[0] == 20 && s2[1] == 40 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 6
        }
        fail = fail + 1
    }

    // 7. 反向切片 a[::-1]
    var rev: []int = a[::-1]  // 56, 40, 30, 20, 10
    if len(rev) == 5 && rev[0] == 56 && rev[4] == 10 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 7
        }
        fail = fail + 1
    }

    // 8. 指定区间的负步长切片
    var r2: []int = a[3:0:-1]  // a[3]=40, a[2]=30, a[1]=20
    if len(r2) == 3 && r2[0] == 40 && r2[1] == 30 && r2[2] == 20 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 8
        }
        fail = fail + 1
    }

    // 9. 负边界切片（无 step，视图路径归一化）
    var tail: []int = a[-2:]  // 40, 56
    if len(tail) == 2 && tail[0] == 40 && tail[1] == 56 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 9
        }
        fail = fail + 1
    }
    var noLast: []int = a[:-1]  // 10, 20, 30, 40
    if len(noLast) == 4 && noLast[0] == 10 && noLast[3] == 40 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 10
        }
        fail = fail + 1
    }

    // 10. 步长 > 长度 / 空区间
    var sparse: []int = a[0:5:9]  // 仅 10
    var empty: []int = a[2:2:2]
    if len(sparse) == 1 && sparse[0] == 10 && len(empty) == 0 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 11
        }
        fail = fail + 1
    }

    // 11. 字符串负索引（单字节）与负索引切片
    var s: string = "hello"
    var b: byte = s[-1]
    var lastOne: string = s[-1:]
    var lo2: string = s[-2:]
    if b == unsafe.cast[byte](111) {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 12
        }
        fail = fail + 1
    }
    if lastOne == "o" {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 13
        }
        fail = fail + 1
    }
    if lo2 == "lo" {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 14
        }
        fail = fail + 1
    }

    // 12. 字符串反向切片
    var rs: string = s[::-1]
    if rs == "olleh" {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 15
        }
        fail = fail + 1
    }

    // 13. 字符串正步长切片
    var every2: string = s[0:5:2]
    if every2 == "hlo" {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 16
        }
        fail = fail + 1
    }

    // 14. 定长数组常量负索引 + 写
    var arr: [3]int = [3]int{7, 8, 9}
    if arr[-1] == 9 && arr[-3] == 7 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 17
        }
        fail = fail + 1
    }
    arr[-1] = 90
    if arr[2] == 90 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 18
        }
        fail = fail + 1
    }

    // 15. 定长数组动态负索引
    var ai: int = -2
    if arr[ai] == 8 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 19
        }
        fail = fail + 1
    }

    // 16. []string 负索引读（多槽元素拷贝）
    var names: []string = []string{"aa", "bb", "cc"}
    var nm: string = names[-1]
    if nm == "cc" {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 20
        }
        fail = fail + 1
    }

    // 17. []string 步长切片（多槽元素跨步拷贝）
    var picked: []string = names[0:3:2]  // aa, cc
    if len(picked) == 2 && picked[0] == "aa" && picked[1] == "cc" {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 21
        }
        fail = fail + 1
    }

    // 18. 动态正步长
    var step: int = 2
    var dyn: []int = a[0:5:step]  // 10, 30, 56
    if len(dyn) == 3 && dyn[0] == 10 && dyn[1] == 30 && dyn[2] == 56 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 22
        }
        fail = fail + 1
    }

    // 19. 动态负步长（默认边界按方向推导）
    var negStep: int = -2
    var dynNeg: []int = a[::negStep]  // 56, 30, 10
    if len(dynNeg) == 3 && dynNeg[0] == 56 && dynNeg[1] == 30 && dynNeg[2] == 10 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 23
        }
        fail = fail + 1
    }

    // 20. 动态边界 + 步长
    var dlo: int = 1
    var dhi: int = 5
    var dynBounds: []int = a[dlo:dhi:2]  // 20, 40
    if len(dynBounds) == 2 && dynBounds[0] == 20 && dynBounds[1] == 40 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 24
        }
        fail = fail + 1
    }

    // 21. 负常量边界 + 步长
    var negBounds: []int = a[-4:-1:2]  // a[1], a[3] → 20, 40
    if len(negBounds) == 2 && negBounds[0] == 20 && negBounds[1] == 40 {
        pass = pass + 1
    } else {
        if firstFail == 0 {
            firstFail = 25
        }
        fail = fail + 1
    }

    if fail == 0 {
        println("neg_index_step: ALL PASS")
        ret 42
    }
    console.print("neg_index_step: FAIL firstFail=")
    console.println(strings.toString(firstFail, 10))
    ret 1
}
