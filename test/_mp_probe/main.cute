import "std:maps"
import "std:memory"
import "std:strings"
// test/_mp_probe —— Wave Mp 最小编译/运行探针(int 键 + string 键 + ptr 值)
fn main() int {
    var pass: int = 0
    var fail: int = 0

    // int 键 / int 值:new + set + get
    var m: ptr = maps.new[int](0, 8)
    var v: int = 42
    maps.set[int](m, 1, &v)
    var out: int = 0
    var ok: bool = maps.get[int](m, 1, &out)
    if ok && out == 42 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    // 缺失键:ok=false + 零值
    var ok2: bool = maps.get[int](m, 99, &out)
    if !ok2 && out == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    // len
    if maps.len(m) == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // string 键 / ptr 值(模板用形)
    var s: ptr = maps.new[string]("", 8)
    var boxed: int = 7
    maps.set[string](s, "alpha", &boxed)
    var bo: int = 0
    var sok: bool = maps.get[string](s, "alpha", &bo)
    if sok && bo == 7 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    var n: uint = maps.len(s)
    if n == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    ret pass * 10 + fail
}
