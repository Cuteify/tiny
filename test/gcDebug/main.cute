build os("linux")

type Node struct {
    val: int
    next: *Node
}

fn testLocalAlloc() int {
    var a: *Node = new(Node)
    a.val = 10
    var b: *Node = new(Node)
    b.val = 20
    var c: *Node = new(Node)
    c.val = 30
    ret a.val + b.val + c.val
}

fn testLoopAlloc() int {
    var sum: int = 0
    var i: int = 0
    for ; i < 10; {
        var tmp: *Node = new(Node)
        tmp.val = i
        sum = sum + tmp.val
        i = i + 1
    }
    ret sum
}

fn testFieldOrphan() int {
    var root: *Node = new(Node)
    root.val = 10
    var b1: *Node = new(Node)
    b1.val = 20
    root.next = b1
    var b2: *Node = new(Node)
    b2.val = 30
    root.next = b2
    ret root.val + root.next.val
}

fn main() int {
    var r1: int = testLocalAlloc()
    println("testLocalAlloc: ")
    println(r1)
    
    var r2: int = testLoopAlloc()
    println("testLoopAlloc: ")
    println(r2)
    
    var r3: int = testFieldOrphan()
    println("testFieldOrphan: ")
    println(r3)
    
    ret 0
}
