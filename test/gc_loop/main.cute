build os("linux")

type Node struct {
    val: int
    next: *Node
}

fn makeNode(val: int) *Node {
    var n: *Node = new(Node)
    n.val = val
    ret n
}

fn prepend(head: *Node, val: int) *Node {
    var n: *Node = new(Node)
    n.val = val
    n.next = head
    ret n
}

fn sum(head: *Node) int {
    var s: int = 0
    var c: *Node = head
    for ; c != nil; {
        s = s + c.val
        c = c.next
    }
    ret s
}

fn length(head: *Node) int {
    var n: int = 0
    var c: *Node = head
    for ; c != nil; {
        n = n + 1
        c = c.next
    }
    ret n
}

fn main() int {
    var ok: int = 0

    // 1. 构建链表 1→2→3→4→5
    var head: *Node = nil
    head = prepend(head, 5)
    head = prepend(head, 4)
    head = prepend(head, 3)
    head = prepend(head, 2)
    head = prepend(head, 1)
    if sum(head) == 15 {
        ok = ok + 1
    }
    if length(head) == 5 {
        ok = ok + 1
    }

    // 2. 重用 head，构建新链表 10→20
    head = nil
    head = prepend(head, 20)
    head = prepend(head, 10)
    if sum(head) == 30 {
        ok = ok + 1
    }
    if length(head) == 2 {
        ok = ok + 1
    }

    // 3. 循环构建 100 节点链表
    var big: *Node = nil
    var i: int = 0
    for ; i < 100; {
        big = prepend(big, i)
        i = i + 1
    }
    if length(big) == 100 {
        ok = ok + 1
    }

    ret ok
}
