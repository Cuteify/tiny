// 字符串测试 - 覆盖字符串操作的各种情况

fn string_length() int {
    var s: string = "hello"
    ret len(s)  // 5
}

fn string_concat() int {
    var s1: string = "hello"
    var s2: string = " world"
    var s3: string = s1 + s2
    ret len(s3)  // 11
}

fn string_empty() int {
    var s: string = ""
    ret len(s)  // 0
}

fn string_single_char() int {
    var s: string = "a"
    ret len(s)  // 1
}

fn string_unicode() int {
    var s: string = "你好世界"
    ret len(s)  // 12 (字节数：UTF-8 每字 3 字节)
}

fn string_with_numbers() int {
    var s: string = "test123"
    ret len(s)  // 7
}

fn string_with_special() int {
    var s: string = "hello\nworld"
    ret len(s)  // 12 (\n 按字面两字节，无转义处理)
}

fn string_comparison() int {
    var s1: string = "abc"
    var s2: string = "abc"
    var s3: string = "def"
    
    var result: int = 0
    if s1 == s2 {
        result = result + 1  // 相等
    }
    if s1 != s3 {
        result = result + 1  // 不相等
    }
    ret result  // 2
}

fn main() int {
    var sum: int = 0
    sum = sum + string_length()        // 5
    sum = sum + string_concat()        // 11
    sum = sum + string_empty()         // 0
    sum = sum + string_single_char()   // 1
    sum = sum + string_unicode()       // 12
    sum = sum + string_with_numbers()  // 7
    sum = sum + string_with_special()  // 12
    sum = sum + string_comparison()    // 2
    ret sum  // 5+11+0+1+12+7+12+2 = 50
}
