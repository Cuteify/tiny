build os("linux")

fn t_distinct() int {
    var p1: ptr = memory.malloc(16)
    var p2: ptr = memory.malloc(16)
    ret p1 != 0 && p2 != 0 && p1 != p2
}

fn t_align() int {
    var p: ptr = memory.malloc(1)
    ret p != 0 && (p - (p / 8) * 8) == 0
}

fn t_reuse() int {
    var p1: ptr = memory.malloc(16)
    memory.free(p1)
    var p2: ptr = memory.malloc(16)
    ret p1 == p2
}

fn t_write_read32() int {
    var p: ptr = memory.malloc(32)
    if p == 0 {
        ret 0
    }
    memory.store32(p, 287454020)
    ret memory.load32(p) == 287454020
}

fn t_write_read8() int {
    var p: ptr = memory.malloc(32)
    if p == 0 {
        ret 0
    }
    memory.store8(p, 200)
    memory.store8(p + 1, 55)
    ret memory.load8(p) == 200 && memory.load8(p + 1) == 55
}

fn t_deref64() int {
    var p: ptr = memory.malloc(64)
    if p == 0 {
        ret 0
    }
    memory.store32(p, 12345)
    memory.store32(p + 4, 67890)
    ret memory.load32(p) == 12345 && memory.load32(p + 4) == 67890
}

fn t_deref_bytes() int {
    var p: ptr = memory.malloc(64)
    if p == 0 {
        ret 0
    }
    var i: int = 0
    for ; i < 16; {
        memory.store8(p + i, 9)
        i = i + 1
    }
    ret memory.load8(p + 15) == 9 && memory.load8(p) == 9
}

fn t_large() int {
    var p: ptr = memory.malloc(2000)
    if p == 0 {
        ret 0
    }
    memory.store8(p, 7)
    memory.store8(p + 1999, 9)
    ret memory.load8(p) == 7 && memory.load8(p + 1999) == 9
}

fn t_many() int {
    var i: int = 0
    for ; i < 50; {
        var p: ptr = memory.malloc(8)
        if p == 0 {
            ret 0
        }
        memory.store32(p, 100)
        if memory.load32(p) != 100 {
            ret 0
        }
        memory.free(p)
        i = i + 1
    }
    ret 1
}

fn t_refill() int {
    // 连续分配 300 个 32 字节块，触发多次 refill（每块 4096 字节可切 128 块）
    var i: int = 0
    for ; i < 300; {
        var p: ptr = memory.malloc(32)
        if p == 0 {
            ret 0
        }
        memory.store32(p, 777)
        i = i + 1
    }
    ret 1
}

fn main() int {
    if t_distinct() == 0 {
        syscall.exit(1)
    }
    if t_align() == 0 {
        syscall.exit(2)
    }
    if t_reuse() == 0 {
        syscall.exit(3)
    }
    if t_write_read32() == 0 {
        syscall.exit(4)
    }
    if t_write_read8() == 0 {
        syscall.exit(5)
    }
    if t_deref64() == 0 {
        syscall.exit(6)
    }
    if t_deref_bytes() == 0 {
        syscall.exit(7)
    }
    if t_large() == 0 {
        syscall.exit(8)
    }
    if t_many() == 0 {
        syscall.exit(9)
    }
    if t_refill() == 0 {
        syscall.exit(10)
    }
    syscall.exit(7)
    ret 0
}