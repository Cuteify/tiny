build os("linux")

fn t_distinct() int {
    var p1: ptr = memory.malloc(16)
    var p2: ptr = memory.malloc(16)
    ret p1 != 0 && p2 != 0 && p1 != p2
}

fn t_align() int {
    var p: ptr = memory.malloc(1)
    ret p != 0 && (p - (p / 8) * 8) == 0
}

fn t_reuse() int {
    var p1: ptr = memory.malloc(16)
    memory.free(p1)
    var p2: ptr = memory.malloc(16)
    ret p1 == p2
}

fn t_write_read32() int {
    var p: ptr = memory.malloc(32)
    if p == 0 {
        ret 0
    }
    var _p1: *uint = p
    *_p1 = unsafe.cast[uint](287454020)
    var _p2: *uint = p
    ret *_p2 == 287454020
}

fn t_write_read8() int {
    var p: ptr = memory.malloc(32)
    if p == 0 {
        ret 0
    }
    var _p3: *u8 = p
    *_p3 = unsafe.cast[u8](200)
    var _p4: *u8 = p + 1
    *_p4 = unsafe.cast[u8](55)
    var _p5: *u8 = p
    var _p6: *u8 = p + 1
    ret *_p5 == 200 && *_p6 == 55
}

fn t_deref64() int {
    var p: ptr = memory.malloc(64)
    if p == 0 {
        ret 0
    }
    var _p7: *uint = p
    *_p7 = unsafe.cast[uint](12345)
    var _p8: *uint = p + 4
    *_p8 = unsafe.cast[uint](67890)
    var _p9: *uint = p
    var _p10: *uint = p + 4
    ret *_p9 == 12345 && *_p10 == 67890
}

fn t_deref_bytes() int {
    var p: ptr = memory.malloc(64)
    if p == 0 {
        ret 0
    }
    var i: int = 0
    for ; i < 16; {
        var _p11: *u8 = p + i
        *_p11 = unsafe.cast[u8](9)
        i = i + 1
    }
    var _p12: *u8 = p + 15
    var _p13: *u8 = p
    ret *_p12 == 9 && *_p13 == 9
}

fn t_large() int {
    var p: ptr = memory.malloc(2000)
    if p == 0 {
        ret 0
    }
    var _p14: *u8 = p
    *_p14 = unsafe.cast[u8](7)
    var _p15: *u8 = p + 1999
    *_p15 = unsafe.cast[u8](9)
    var _p16: *u8 = p
    var _p17: *u8 = p + 1999
    ret *_p16 == 7 && *_p17 == 9
}

fn t_many() int {
    var i: int = 0
    for ; i < 50; {
        var p: ptr = memory.malloc(8)
        if p == 0 {
            ret 0
        }
        var _p18: *uint = p
        *_p18 = unsafe.cast[uint](100)
        var _p19: *uint = p
        if *_p19 != 100 {
            ret 0
        }
        memory.free(p)
        i = i + 1
    }
    ret 1
}

fn t_refill() int {
    // 连续分配 300 个 32 字节块，触发多次 refill（每块 4096 字节可切 128 块）
    var i: int = 0
    for ; i < 300; {
        var p: ptr = memory.malloc(32)
        if p == 0 {
            ret 0
        }
        var _p20: *uint = p
        *_p20 = unsafe.cast[uint](777)
        i = i + 1
    }
    ret 1
}

fn main() int {
    if t_distinct() == 0 {
        syscall.exit(1)
    }
    if t_align() == 0 {
        syscall.exit(2)
    }
    if t_reuse() == 0 {
        syscall.exit(3)
    }
    if t_write_read32() == 0 {
        syscall.exit(4)
    }
    if t_write_read8() == 0 {
        syscall.exit(5)
    }
    if t_deref64() == 0 {
        syscall.exit(6)
    }
    if t_deref_bytes() == 0 {
        syscall.exit(7)
    }
    if t_large() == 0 {
        syscall.exit(8)
    }
    if t_many() == 0 {
        syscall.exit(9)
    }
    if t_refill() == 0 {
        syscall.exit(10)
    }
    syscall.exit(7)
    ret 0
}