// 超级复杂测试程序

// 基础结构体
type Vector2D struct {
    x: int
    y: int
}

fn Vector2D.length() int {
    ret self.x * self.x + self.y * self.y
}

fn Vector2D.scale(factor int) {
    self.x *= factor
    self.y *= factor
}

// 矩阵结构体
type Matrix struct {
    data: []int
    rows: int
    cols: int
}

fn Matrix.get(r int, c int) int {
    ret self.data[r * self.cols + c]
}

fn Matrix.set(r int, c int, val int) {
    self.data[r * self.cols + c] = val
}

// 递归函数
fn fibonacci(n int) int {
    if n <= 1 {
        ret n
    }
    ret fibonacci(n - 1) + fibonacci(n - 2)
}

fn factorial(n int) int {
    if n <= 1 {
        ret 1
    }
    ret n * factorial(n - 1)
}

fn power(base int, exp int) int {
    if exp == 0 {
        ret 1
    }
    if exp % 2 == 0 {
        var half: int = power(base, exp / 2)
        ret half * half
    }
    ret base * power(base, exp - 1)
}

// 整数求和
fn sum3(a int, b int, c int) int {
    ret a + b + c
}

// 整数最大值
fn max3(a int, b int, c int) int {
    var max: int = a
    if b > max {
        max = b
    }
    if c > max {
        max = c
    }
    ret max
}

// 字符串长度测试
fn stringLength(s string) int {
    ret len(s)
}

// 字符串重复
fn repeatString(s string, n int) string {
    var result: string = ""
    for i := 0; i < n; i++ {
        result = result + s
    }
    ret result
}

// 位运算
fn bitwiseOps(a int, b int) int {
    var andVal: int = a & b
    var orVal: int = a | b
    var xorVal: int = a ^ b
    var notVal: int = ~a
    var shiftL: int = a << 2
    var shiftR: int = a >> 2
    ret andVal + orVal + xorVal + notVal + shiftL + shiftR
}

// 复杂表达式
fn complexExpression(x int, y int, z int) int {
    ret (x + y) * (z - x) / (y + 1) % (z + 2) | (x & y) ^ (y | z)
}

// 多重条件
fn multiCondition(a int, b int, c int) int {
    if a > b && b > c {
        ret 1
    }
    if a < b && b < c {
        ret 2
    }
    if a == b || b == c {
        ret 3
    }
    ret 4
}

// 嵌套循环
fn nestedLoops(n int) int {
    var sum: int = 0
    for i := 0; i < n; i++ {
        for j := 0; j <= i; j++ {
            for k := 0; k <= j; k++ {
                sum += i + j + k
            }
        }
    }
    ret sum
}

// 列表操作
fn listOperations() int {
    var list: []int = []int{5, 2, 8, 1, 9, 3, 7, 4, 6}
    var first: int = list[0]
    var last: int = list[len(list) - 1]
    var slice1: []int = list[2:5]
    list[0] = 100
    list[len(list) - 1] = 200
    var sum: int = sum3(list[0], list[1], list[2])
    var max: int = max3(list[0], list[1], list[2])
    ret first + last + len(slice1) + sum + max
}

// 字符串操作
fn stringOperations() int {
    var s1: string = "Hello"
    var s2: string = "World"
    var s3: string = s1 + " " + s2
    var len1: int = stringLength(s1)
    var len3: int = stringLength(s3)
    var repeated: string = repeatString(s1, 3)
    var lenRep: int = stringLength(repeated)
    ret len1 + len3 + lenRep
}

// 结构体操作
fn structOperations() int {
    var v1: Vector2D
    v1.x = 3
    v1.y = 4
    var length: int = v1.length()
    v1.scale(2)
    ret length + v1.x + v1.y
}

// 矩阵操作
fn matrixOperations() int {
    var m: Matrix
    m.rows = 2
    m.cols = 3
    m.data = []int{1, 2, 3, 4, 5, 6}
    var val1: int = m.get(0, 0)
    var val2: int = m.get(1, 2)
    m.set(0, 1, 10)
    var val3: int = m.get(0, 1)
    ret val1 + val2 + val3
}

// 递归测试
fn recursiveTests() int {
    var fib10: int = fibonacci(10)
    var fact5: int = factorial(5)
    var pow2_10: int = power(2, 10)
    ret fib10 + fact5 + pow2_10
}

// 位运算测试
fn bitwiseTests() int {
    var a: int = 255
    var b: int = 15
    var result: int = bitwiseOps(a, b)
    ret result
}

// 表达式测试
fn expressionTests() int {
    var x: int = 10
    var y: int = 20
    var z: int = 30
    var result1: int = complexExpression(x, y, z)
    var result2: int = multiCondition(5, 10, 15)
    var result3: int = nestedLoops(5)
    ret result1 + result2 + result3
}

// 主函数
fn main() int {
    var listResult: int = listOperations()
    var stringResult: int = stringOperations()
    var structResult: int = structOperations()
    var matrixResult: int = matrixOperations()
    var recursiveResult: int = recursiveTests()
    var bitwiseResult: int = bitwiseTests()
    var expressionResult: int = expressionTests()
    var total: int = listResult + stringResult + structResult + matrixResult + recursiveResult + bitwiseResult + expressionResult
    ret total
}
