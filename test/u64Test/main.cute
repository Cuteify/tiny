// u64 寄存器对支持测试（x86 关键；x86_64 应同样全过）
// 返回失败数，0 = 全部通过

fn add64(a: u64, b: u64) u64 {
    ret a + b
}

fn mul64(a: u64, b: u64) u64 {
    ret a * b
}

fn div64(a: u64, b: u64) u64 {
    ret a / b
}

fn mod64(a: u64, b: u64) u64 {
    ret a % b
}

fn id64(a: u64) u64 {
    ret a
}

fn main() int {
    var fails: int = 0

    // 1. 大常量装载与相等比较（>32 位立即数拆半）
    var big: u64 = 1099511627776
    if big != 1099511627776 {
        fails = fails + 1
    }

    // 2. 加法进位：0xFFFFFFFF + 1 = 2^32
    var lo: u64 = 4294967295
    var one: u64 = 1
    var sum: u64 = add64(lo, one)
    if sum != 4294967296 {
        fails = fails + 1
    }

    // 3. 乘法交叉项：2^20 * 2^20 = 2^40
    var n: u64 = 1048576
    var m: u64 = mul64(n, n)
    if m != 1099511627776 {
        fails = fails + 1
    }

    // 4. 除法：2^40 / 3 = 366503875925
    var three: u64 = 3
    var d: u64 = div64(big, three)
    if d != 366503875925 {
        fails = fails + 1
    }

    // 5. 取模：2^40 % 1000 = 776
    var k: u64 = 1000
    var r: u64 = mod64(big, k)
    if r != 776 {
        fails = fails + 1
    }

    // 6. 高字不同的比较：2^32 > 2^32-1（b > a 恒假，不得触发）
    var a: u64 = 4294967296
    var b: u64 = 4294967295
    if b > a {
        fails = fails + 1
    }
    if a < b {
        fails = fails + 1
    }

    // 7. 传参往返：大值原样返回
    var back: u64 = id64(big)
    if back != big {
        fails = fails + 1
    }

    // 8. 全局大常量参与运算
    var g: u64 = 86400000000000
    var half: u64 = div64(g, 2)
    if half != 43200000000000 {
        fails = fails + 1
    }

    println("u64 ok")
    ret fails
}
