build os("linux")
build arch("x86")

fn toU64(n int) u64 {
    var p: ptr = &n
    var _p1: *uint = p
    ret *_p1
}

fn toString(n int, base uint) string {
    var neg: bool = false
    var num: uint = 0
    if n < 0 {
        neg = true
        num = toU64(0 - n)
    } else {
        num = toU64(n)
    }
    var digits: uint = 1
    var tmp: uint = num
    for tmp >= base {
        tmp = tmp / base
        digits = digits + 1
    }
    var total: uint = digits
    if neg {
        total = total + 1
    }
    var buf: ptr = memory.malloc(total + 1)
    var v: uint = num
    if v == 0 {
        var _p2: *u8 = buf
        *_p2 = unsafe.cast[u8](48)
    } else {
        var i: uint = 0
        for v > 0 {
            var digit: uint = v % base
            var ch: uint = 0
            if digit < 10 {
                ch = digit + 48
            } else if digit < 36 {
                ch = digit + 97 - 10
            } else {
                ch = digit + 65 - 36
            }
            var _p3: *u8 = buf + (digits - 1 - i)
            *_p3 = unsafe.cast[u8](ch)
            v = v / base
            i = i + 1
        }
    }
    if neg {
        var _p4: *u8 = buf
        *_p4 = unsafe.cast[u8](45)
    }
    var _p5: *u8 = buf + total
    *_p5 = unsafe.cast[u8](0)
    var s: string
    var p: ptr = &s
    var b: uint = buf
    var _p6: *uint = p
    *_p6 = unsafe.cast[uint](b)
    var _p7: *uint = p + 4
    *_p7 = unsafe.cast[uint](total)
    var _p8: *uint = p + 8
    *_p8 = unsafe.cast[uint](total)
    ret s
}

// parse 字符串转整数（2-62 进制，支持负号；非法字符停止解析）
