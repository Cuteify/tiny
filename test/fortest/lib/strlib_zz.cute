build os("linux")
build arch("x86")

fn toU64(n int) u64 {
    var p: ptr = &n
    ret memory.load32(p)
}

fn toString(n int, base uint) string {
    var neg: bool = false
    var num: uint = 0
    if n < 0 {
        neg = true
        num = toU64(0 - n)
    } else {
        num = toU64(n)
    }
    var digits: uint = 1
    var tmp: uint = num
    for tmp >= base {
        tmp = tmp / base
        digits = digits + 1
    }
    var total: uint = digits
    if neg {
        total = total + 1
    }
    var buf: ptr = memory.malloc(total + 1)
    var v: uint = num
    if v == 0 {
        memory.store8(buf, 48)
    } else {
        var i: uint = 0
        for v > 0 {
            var digit: uint = v % base
            var ch: uint = 0
            if digit < 10 {
                ch = digit + 48
            } else if digit < 36 {
                ch = digit + 97 - 10
            } else {
                ch = digit + 65 - 36
            }
            memory.store8(buf + (digits - 1 - i), ch)
            v = v / base
            i = i + 1
        }
    }
    if neg {
        memory.store8(buf, 45)
    }
    memory.store8(buf + total, 0)
    var s: string
    var p: ptr = &s
    var b: uint = buf
    memory.store32(p, b)
    memory.store32(p + 4, total)
    memory.store32(p + 8, total)
    ret s
}

// parse 字符串转整数（2-62 进制，支持负号；非法字符停止解析）
