build os(linux)
import "std:fs"

fn windowsFunc() int {
    ret 1
}

build os(linux)

fn linuxFunc() int {
    ret 2
}

build os(darwin, linux)

fn multiOSFunc() int {
    ret 3
}

fn main() int {
    if linuxFunc() != 2 {
        ret 1
    }
    if multiOSFunc() != 3 {
        ret 2
    }
    ret 0
}
