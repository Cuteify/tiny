// Full syntax test - tests all language features

// Type alias tests
type MyInt = int
type MyInt2 int
type MyList = []int
type MyAlias = MyInt

// Struct with methods
type Point struct {
    x int
    y int
}

fn Point.distance() int {
    ret self.x + self.y
}

fn Point.move(dx int, dy int) {
    self.x += dx
    self.y += dy
}

// List type struct
type Container struct {
    items []int
    count int
}

fn Container.add(self, item int) {
    self.items.len = self.items.len + 1
}

// Main function
fn main() {
    // Variable declarations
    var a int = 10
    var b int = 20
    
    // Type alias usage
    var c MyInt = 30
    var d MyInt2 = 40
    
    // Compound assignment operators
    a += 5
    b -= 3
    a *= 2
    b /= 2
    
    // Increment/decrement
    a++
    b--
    
    // List operations
    var list []int = [1, 2, 3, 4, 5]
    
    // Slice access
    var first int = list[0]
    var slice []int = list[1:3]
    var last int = list[len(list) - 1]
    
    // Nested access with slice
    var container Container
    container.count = 5
    
    // Struct method calls
    var p Point
    p.x = 3
    p.y = 4
    var dist int = p.distance()
    p.move(1, 2)
    
    // Comparison operators (numeric only)
    var result bool = a > b
    var eq bool = a == b
    
    // Logical operators
    var and bool = result && eq
    var or bool = result || eq
    
    // Bitwise operators
    var bit int = a & b
    var bor int = a | b
    var bxor int = a ^ b
    var shift int = a << 2
    var rshift int = a >> 1
    
    // String operations
    var s string = "hello"
    var s2 string = " world"
    var concat string = s + s2
    var repeated string = s * 3
    
    // Unary operators
    var neg int = -a
    var not bool = !result
    var bnot int = ~a
    
    // If/else
    if a > b {
        ret 1
    } else {
        ret 0
    }
    
    // For loop
    for i := 0; i < 10; i++ {
        a = a + i
    }
    
    // Function call
    var sum int = add(1, 2)
    
    ret 0
}

fn add(a int, b int) int {
    ret a + b
}
