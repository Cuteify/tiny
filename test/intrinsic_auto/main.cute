// P4 收窄自动导入后的验收：
// - string 的 == / != 仍由类型内建 lower（不需要 import）
// - strings/slices 的命名函数必须显式 import 才能使用
// 输出 intrinsic_auto: ALL PASS 并退出 42。
import "std:slices"
import "std:strings"

fn main() int {
    var passed: int = 0

    var s: []int = []int{1, 2, 3}
    var n: int = slices.len[int](&s)
    var c: int = slices.cap[int](&s)

    if n == 3 {
        passed = passed + 1
    }
    if c == 3 {
        passed = passed + 1
    }

    if strings.eq("abc", "abc") {
        passed = passed + 1
    }
    if strings.ne("abc", "abd") {
        passed = passed + 1
    }
    if "abc" == "abc" {
        passed = passed + 1
    }
    if "abc" != "abd" {
        passed = passed + 1
    }

    // 显式 import 的 std 调用与内建运算组合。
    var total: int = n + c
    if total == 6 {
        passed = passed + 1
    }

    if passed == 7 {
        println("intrinsic_auto: ALL PASS")
        ret 42
    }
    println("intrinsic_auto: FAIL")
    ret 1
}
