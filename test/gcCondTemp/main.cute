import "std:strings"

fn cmpLen(a: string, b: string) int {
    ret len(a) - len(b)
}

fn consume(s: string) int {
    ret len(s)
}

fn main() int {
    var ok: int = 0
    if len(strings.repeatN("ab", 3)) == 6 {
        ok = ok + 1
    }
    if cmpLen(strings.repeatN("ab", 2), "abab") == 0 {
        ok = ok + 1
    }
    var i: int = 0
    for i < len(strings.repeatN("x", 2)) {
        ok = ok + 1
        i = i + 1
    }
    for j := 0; j < 3; j = j + cmpLen(strings.repeatN("ab", 1), "a") {
        ok = ok + 1
    }
    ret ok
}
