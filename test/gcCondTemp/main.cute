build os("linux")
import "std:memory"
import "std:strings"

// 条件表达式临时对象释放回归：
// - if/for 条件中的 owning call 结果在 true/false 两条路径都要释放；
// - || 短路：左侧为真时右侧未求值，清理已清零的槽必须安全；
// - 条件结果本身不被后续使用，释放后不得再读。
// 注意：这里只验证条件临时对象生命周期；调用结果跨调用传参的 ABI
// 问题属于既有缺陷，不在本用例覆盖范围。

type Item struct {
    value: int
}

fn makeItem(v: int) *Item {
    var it: *Item = new(Item)
    it.value = v
    ret it
}

fn makeMaybe(flag: bool) *Item {
    if flag {
        ret makeItem(1)
    }
    var z: *Item
    ret z
}

fn ifTrue() int {
    var ok: int = 0
    if makeItem(5) {
        ok = ok + 1
    } else {
        ret 1
    }
    ret ok
}

fn ifBoth() int {
    var ok: int = 0
    if makeMaybe(true) {
        ok = ok + 1
    } else {
        ret 1
    }
    if makeMaybe(false) {
        ret 2
    } else {
        ok = ok + 1
    }
    ret ok
}

fn ifOr() int {
    var ok: int = 0
    if makeMaybe(false) != nil || makeMaybe(true) != nil {
        ok = ok + 1
    } else {
        ret 1
    }
    if makeMaybe(false) != nil || makeMaybe(false) != nil {
        ret 2
    } else {
        ok = ok + 1
    }
    ret ok
}

fn forCond() int {
    var i: int = 0
    var n: int = 0
    for makeMaybe(i < 3) != nil {
        n = n + 1
        i = i + 1
    }
    if n != 3 {
        ret 1
    }
    ret n - 2
}

fn main() int {
    var i: int = 0
    for i < 3000 {
        if ifTrue() != 1 {
            ret 3
        }
        if ifBoth() != 2 {
            ret 4
        }
        if ifOr() != 2 {
            ret 5
        }
        if forCond() != 1 {
            ret 6
        }
        i = i + 1
    }
    ret 0
}
