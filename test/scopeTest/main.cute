// 变量作用域测试

var globalVar: int = 100

fn modify_global() {
    globalVar = 200
}

fn read_global() int {
    ret globalVar
}

fn local_scope() int {
    var localVar: int = 50
    ret localVar
}

fn nested_scope() int {
    var outer: int = 5
    var result: int = 0
    for i := 0; i < 3; i++ {
        var inner: int = i * outer
        result += inner
    }
    ret result
}

fn parameter_scope(a int, b int) int {
    ret a + b
}

fn main() int {
    var sum: int = 0
    sum += read_global()
    modify_global()
    sum += read_global()
    sum += local_scope()
    sum += nested_scope()
    sum += parameter_scope(3, 7)
    ret sum
}
