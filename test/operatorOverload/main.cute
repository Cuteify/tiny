// 自定义类型运算符重载：[] / []= / [::] / eq / ne / 一元 / 二元 / 复合赋值

type Vec struct {
    data: []int
    n: int
}

fn Vec.get(recv: *Vec, i int) int {
    ret recv.data[i]
}

fn Vec.set(recv: *Vec, i int, v int) {
    recv.data[i] = v
}

// 返回 start/end/step 的编码，便于验证 lowering 与缺省边界
fn Vec.slice(recv: *Vec, start int, end int, step int) int {
    ret start * 10000 + end * 100 + step
}

type Val struct {
    v: int
}

fn Val.eq(recv: *Val, other Val) bool {
    ret recv.v == other.v
}

fn Val.ne(recv: *Val, other Val) bool {
    ret recv.v != other.v
}

fn Val.neg(recv: *Val) int {
    ret -recv.v
}

fn Val.not(recv: *Val) bool {
    ret recv.v == 0
}

fn Val.bnot(recv: *Val) int {
    ret ~recv.v
}

fn Val.add(recv: *Val, other Val) int {
    ret recv.v + other.v
}

fn main() int {
    var failures: int = 0

    var v: Vec
    v.data = []int{1, 2, 3}
    v.n = 3

    // get
    if v[1] != 2 {
        failures += 1
    }

    // set
    v[1] = 7
    if v[1] != 7 {
        failures += 1
    }

    // 复合赋值：set(1, get(1) + 5)
    v[1] += 5
    if v[1] != 12 {
        failures += 1
    }

    // slice：显式边界
    if v[0:3:2] != 302 {
        failures += 1
    }

    // slice：省略 start / end / step
    if v[:2] != 201 {
        failures += 1
    }
    if v[1:] != 9901 {
        failures += 1
    }
    if v[:] != -99 {
        failures += 1
    }

    // 相等 / 不等：走 eq/ne 方法
    var a: Val
    a.v = 5
    var b: Val
    b.v = 5
    var c: Val
    c.v = 6
    if !(a == b) {
        failures += 1
    }
    if !(a != c) {
        failures += 1
    }

    // 一元
    if -a != -5 {
        failures += 1
    }
    if c.not() {
        failures += 1
    }
    if ~a != -6 {
        failures += 1
    }

    // 二元
    if a + c != 11 {
        failures += 1
    }

    if failures == 0 {
        ret 42
    }
    ret failures
}
