// Cute enum 语法测试。
//
// 覆盖：自增、显式值、十六进制值、负值、后续成员继续自增、
// 枚举名作为 int 别名用于类型标注。
import "std:strings"

enum Color {
    RED
    GREEN
    BLUE = 10
    WHITE
    BLACK = -1
}

enum Small {
    A = 0x10
    B
}

fn main() int {
    var t: Color = GREEN
    if t != 1 { ret 1 }
    if RED != 0 { ret 2 }
    if BLUE != 10 { ret 3 }
    if WHITE != 11 { ret 4 }
    if BLACK != -1 { ret 5 }
    if A != 16 { ret 6 }
    if B != 17 { ret 7 }
    ret 42
}
