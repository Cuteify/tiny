build os("linux")

fn sys_exit(code: u64) {
    build asm {
        mov RAX, 60
        mov RDI, $code
        syscall
    }
}

fn sys_write(fd: u64, buf: u64, count: u64) i32 {
    build asm {
        mov RAX, 1
        mov RDI, $fd
        mov RSI, $buf
        mov RDX, $count
        syscall
    }
    ret 0
}

fn sys_read(fd: u64, buf: u64, count: u64) i32 {
    build asm {
        mov RAX, 0
        mov RDI, $fd
        mov RSI, $buf
        mov RDX, $count
        syscall
    }
    ret 0
}

fn sys_open(filename: u64, flags: u64, mode: u64) i32 {
    build asm {
        mov RAX, 2
        mov RDI, $filename
        mov RSI, $flags
        mov RDX, $mode
        syscall
    }
    ret 0
}

fn sys_close(fd: u64) i32 {
    build asm {
        mov RAX, 3
        mov RDI, $fd
        syscall
    }
    ret 0
}

fn sys_mmap(addr: u64, length: u64, prot: u64, flags: u64, fd: u64, offset: u64) u64 {
    build asm {
        mov RDI, $addr
        mov RSI, $length
        mov RDX, $prot
        mov R10, $flags
        mov R8, $fd
        mov R9, $offset
        mov RAX, 9
        syscall
    }
    ret 0
}

fn sys_munmap(addr: u64, length: u64) i32 {
    build asm {
        mov RAX, 11
        mov RDI, $addr
        mov RSI, $length
        syscall
    }
    ret 0
}

fn sys_brk(addr: u64) u64 {
    build asm {
        mov RAX, 12
        mov RDI, $addr
        syscall
    }
    ret 0
}

fn malloc(size: u64) u64 {
    ret sys_mmap(0, size, 3, 34, -1, 0)
}

fn free(ptr: u64) i32 {
    ret sys_munmap(ptr, 0)
}

fn main() i32 {
    sys_exit(0)
    ret 0
}
