// 解引用测试入口（x86，不含 64 位）
build os("linux")
build arch("x86")

fn main() int {
    if t_stack() == 0 {
        ret 1
    }
    if t_u8() == 0 {
        ret 2
    }
    if t_u16() == 0 {
        ret 3
    }
    if t_u32() == 0 {
        ret 4
    }
    if t_heap() == 0 {
        ret 6
    }
    if t_arith() == 0 {
        ret 7
    }
    if t_callarg() == 0 {
        ret 8
    }
    if t_deref_val() == 0 {
        ret 9
    }
    ret 7
}