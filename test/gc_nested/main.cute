build os("linux")

type Inner struct {
    val: int
    tag: string
}

type Outer struct {
    name: string
    data: *Inner
    score: int
}

fn makeInner(val: int, tag: string) *Inner {
    var p: *Inner = new(Inner)
    p.val = val
    p.tag = tag
    ret p
}

fn makeOuter(name: string, val: int, tag: string) *Outer {
    var o: *Outer = new(Outer)
    o.name = name
    o.data = makeInner(val, tag)
    o.score = val * 10
    ret o
}

fn getInnerVal(o: *Outer) int {
    ret o.data.val
}

fn main() int {
    var ok: int = 0

    // 1. 嵌套分配：Outer → Inner
    var o1: *Outer = makeOuter("first", 42, "alpha")
    if o1.score == 420 {
        ok = ok + 1
    }
    if getInnerVal(o1) == 42 {
        ok = ok + 1
    }

    // 2. 多个嵌套结构
    var o2: *Outer = makeOuter("second", 100, "beta")
    var o3: *Outer = makeOuter("third", 7, "gamma")
    if o2.score + o3.score == 1070 {
        ok = ok + 1
    }

    // 3. 替换内部结构（旧 Inner 应被释放）
    o1.data = makeInner(99, "replaced")
    if o1.data.val == 99 {
        ok = ok + 1
    }

    // 4. 链式嵌套 A → B → C
    var a: *Outer = makeOuter("a", 1, "a1")
    var b: *Outer = makeOuter("b", 2, "b1")
    var c: *Outer = makeOuter("c", 3, "c1")
    a.data = makeInner(10, "a2")
    b.data = a.data  // 共享
    if b.data.val == 10 {
        ok = ok + 1
    }

    ret ok
}
