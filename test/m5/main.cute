type Big struct {
    a: int
    b: int
    c: int
    d: int
    e: int
}

type Pair struct {
    x: int
    y: int
}

type Nest struct {
    p: Pair
    z: int
}

type Node struct {
    v: int
    next: *Node
}

fn sumBig(b: Big, extra: int) int {
    ret b.a + b.b + b.c + b.d + b.e + extra
}

fn makeBig() Big {
    var r: Big
    r.a = 1
    r.b = 2
    r.c = 3
    r.d = 4
    r.e = 5
    ret r
}

fn mkNode(v: int) *Pair {
    var p: *Pair = memory.malloc(8)
    p.x = v
    p.y = v + 1
    ret p
}

fn bump(p: *Pair) {
    p.x = p.x + 100
}

fn main() int {
    var ok: int = 0
    // 1. 5 槽 struct 赋值拷贝
    var s: Big
    s.a = 1
    s.b = 2
    s.c = 3
    s.d = 4
    s.e = 5
    var t: Big = s
    t.e = 50
    if s.a == 1 && t.e == 50 && t.a == 1 {
        ok = ok + 1
    }
    // 2. 5 槽 struct 传参（含第二参数）
    var r1: int = sumBig(s, 10)
    if r1 == 25 {
        ok = ok + 1
    }
    // 3. 5 槽 struct 返回
    var u: Big = makeBig()
    if u.a + u.b + u.c + u.d + u.e == 15 {
        ok = ok + 1
    }
    // 4. *T 返回值
    var np: *Pair = mkNode(7)
    if np.x == 7 && np.y == 8 {
        ok = ok + 1
    }
    // 5. *T 参数修改
    bump(np)
    if np.x == 107 {
        ok = ok + 1
    }
    // 6. 嵌套 struct 赋值与访问
    var n: Nest
    n.p.x = 3
    n.p.y = 4
    n.z = 5
    var m: Nest = n
    m.p.x = 30
    if n.p.x == 3 && m.p.x == 30 && m.p.y == 4 && m.z == 5 {
        ok = ok + 1
    }
    // 7. 指针链（链表）
    var head: *Node = memory.malloc(8)
    head.v = 1
    head.next = memory.malloc(8)
    head.next.v = 2
    head.next.next = memory.malloc(8)
    head.next.next.v = 3
    var sum: int = head.v + head.next.v + head.next.next.v
    if sum == 6 {
        ok = ok + 1
    }
    ret ok
}
