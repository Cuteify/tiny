fn divide(a int, b int) (int, int) {
    ret a / b, a % b
}

fn swap(a int, b int) (int, int) {
    ret b, a
}

fn main() int {
    q, r := divide(17, 5)
    if q != 3 {
        ret 1
    }
    if r != 2 {
        ret 2
    }

    x, y := swap(10, 20)
    if x != 20 {
        ret 3
    }
    if y != 10 {
        ret 4
    }

    ret 0
}
