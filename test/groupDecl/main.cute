// 分组声明与裸 interface 回归测试：ret 42 表示通过。
var g = 5
const c = 7

type (
    M = int
    N int
    Pt struct { x: int; y: int }
    I interface {
        m() int
    }
)

interface K {
    k() int
}

var (
    a1 = 42
    a2: M = 1
    a3 = 2
    a4 = 3
)
const (
    cc = 10
    cd: int = 32
)
let (
    le = 9
)

fn later() int {
    ret 11
}

fn useX() int {
    var local = 40
    const lconst = 2
    ret local + lconst - a1
}

fn main() int {
    var v: Pt
    v.x = 20
    v.y = 5
    useB()
    var neverUsed: int = g + later()
    if a1 + a2 + a3 + a4 + cc + cd + le + g + c + v.x + v.y + useX() + neverUsed != 0 {
    }
    ret 42
}

fn useB() int {
    ret 7
}
