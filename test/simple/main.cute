// 简单测试 - 基础功能验证

fn add(a int, b int) int {
    ret a + b
}

fn subtract(a int, b int) int {
    ret a - b
}

fn multiply(a int, b int) int {
    ret a * b
}

fn divide(a int, b int) int {
    if b == 0 {
        ret 0
    }
    ret a / b
}

fn max(a int, b int) int {
    if a > b {
        ret a
    }
    ret b
}

fn min(a int, b int) int {
    if a < b {
        ret a
    }
    ret b
}

// NOTE(W2): 原名 abs 与 NASM 保留一元运算符撞名(标签/call 都非法)，改名语义不变
fn absValue(x int) int {
    if x < 0 {
        ret -x
    }
    ret x
}

fn factorial(n int) int {
    if n <= 1 {
        ret 1
    }
    ret n * factorial(n - 1)
}

fn fibonacci(n int) int {
    if n <= 1 {
        ret n
    }
    ret fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() int {
    var sum: int = add(10, 20)
    var diff: int = subtract(30, 15)
    var prod: int = multiply(5, 6)
    var quot: int = divide(100, 4)
    var maximum: int = max(25, 30)
    var minimum: int = min(25, 30)
    var absolute: int = absValue(-42)
    var fact: int = factorial(5)
    var fib: int = fibonacci(10)
    
    ret sum + diff + prod + quot + maximum + minimum + absolute + fact + fib
}
