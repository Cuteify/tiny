// test/map_index —— Phase 3 map 类型内建验收
// 覆盖：nil map 读零值 / len(nil)=0 / 写自动初始化 / 缺失键 / 覆盖 /
//       int 键 / string 键 / string 值 / 局部 map 传参。
// 输出 map_index: ALL PASS 并退出 42。
fn fill(m: map[string]int) int {
    m["via"] = 5
    return len(m)
}

fn main() int {
    var pass: int = 0
    var fail: int = 0

    // 1. nil map: len == 0
    var m: map[string]int
    if len(m) == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 2. nil map: 读缺失键返回零值
    var z: int = m["missing"]
    if z == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 3. nil map: 写自动初始化
    m["one"] = 1
    if len(m) == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 4. 读回刚写入的值
    var one: int = m["one"]
    if one == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 5. 缺失键仍是零值
    var nope: int = m["nope"]
    if nope == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 6. 覆盖已有键不增加长度
    m["one"] = 11
    var one2: int = m["one"]
    if one2 == 11 && len(m) == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 7. 两个键
    m["two"] = 2
    var two: int = m["two"]
    if two == 2 && len(m) == 2 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 8. int 键 map
    var mi: map[int]int
    var k: int = 7
    mi[k] = 70
    var v7: int = mi[k]
    var v8: int = mi[8]
    if v7 == 70 && v8 == 0 && len(mi) == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 9. string 值 map
    var ms: map[int]string
    ms[1] = "hello"
    var s: string = ms[1]
    if len(s) == 5 && s == "hello" {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    var empty: string = ms[2]
    if len(empty) == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // 10. map 作为参数传递后写入对调用者可见
    var n: int = fill(m)
    var via: int = m["via"]
    if n == 3 && via == 5 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail == 0 {
        println("map_index: ALL PASS")
        ret 42
    }
    println("map_index: FAIL")
    ret 1
}
