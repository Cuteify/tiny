import "std:memory"
import "std:strings"

// GC 分支/循环块释放回归探针：
// - if/else/else-if 分支内声明的堆对象在块尾释放；
// - for 循环体每轮分配/释放，break 与零次迭代路径不能 free 垃圾槽；
// - range 循环体块释放与循环出口释放。

fn make(n: int) []int {
    var v: []int = new([]int, 2)
    v[0] = n
    v[1] = n + 1
    ret v
}

fn ifBranch(flag: bool) int {
    if flag {
        var a: []int = make(7)
        if a[0] != 7 {
            ret 1
        }
    } else {
        var b: []int = make(9)
        if b[1] != 10 {
            ret 2
        }
    }
    ret 0
}

fn elseIf(x: int) int {
    if x == 1 {
        var a: []int = make(3)
        if a[0] != 3 {
            ret 1
        }
    } else if x == 2 {
        var b: []int = make(4)
        if b[0] != 4 {
            ret 2
        }
    } else {
        var c: []int = make(5)
        if c[0] != 5 {
            ret 3
        }
    }
    ret 0
}

fn loopBody(n: int) int {
    var sum: int = 0
    var i: int = 0
    for i < n {
        var t: []int = make(i)
        sum = sum + t[0]
        i = i + 1
    }
    ret sum
}

fn breakPath(n: int) int {
    var sum: int = 0
    var i: int = 0
    for i < n {
        var t: []int = make(i)
        sum = sum + t[0]
        if i == 3 {
            break
        }
        i = i + 1
    }
    ret sum
}

fn zeroIter() int {
    var i: int = 10
    for i < 0 {
        var t: []int = make(1)
        i = i + t[0]
    }
    ret i
}

fn main() int {
    if ifBranch(true) != 0 {
        ret 1
    }
    if ifBranch(false) != 0 {
        ret 2
    }
    if elseIf(1) != 0 {
        ret 3
    }
    if elseIf(2) != 0 {
        ret 4
    }
    if elseIf(3) != 0 {
        ret 5
    }
    if loopBody(1000) != 499500 {
        ret 6
    }
    if breakPath(1000) != 6 {
        ret 7
    }
    if zeroIter() != 10 {
        ret 8
    }
    ret 0
}
