// runtime/memory.cute - 内存管理运行时库 (简化版)

// 静态堆：16MB BSS 数组，由 ELF 加载器分配真实内存，无需系统调用
var heap_buf: [16777216]u8
var heap_used: u64 = 0

// 初始化堆（保持接口兼容，静态堆无需初始化）
fn init_heap(start_addr: u64, size: u64) {
    heap_used = 0
}

// 简单的brk内存池模拟
fn sbrk(increment: i32) u64 {
    var old_brk: u64 = heap_used
    var base: u64 = &heap_buf

    if (increment > 0) {
        if (heap_used + increment > 16777216) {
            // 内存不足
            ret 0xFFFFFFFFFFFFFFFF  // 返回错误码
        }
        heap_used = heap_used + increment
    } else {
        // 不支持收缩
        ret 0xFFFFFFFFFFFFFFFF
    }

    ret base + old_brk
}

// 简单的内存分配器
var free_list_head: u64 = 0

// 内存块结构体 (大小 + 指向下一个空闲块的指针)
struct MemBlock {
    size: u32
    next: u64
}

// 分配指定大小的内存
fn malloc(size: u64) u64 {
    // 需要额外空间存储块元数据
    var alloc_size: u64 = size + 8  // 8字节用于存储大小信息
    if (alloc_size < 16) {
        alloc_size = 16  // 最小块大小
    }
    
    // 尝试从空闲列表中分配
    var prev_ptr: u64 = 0
    var current_ptr: u64 = free_list_head
    
    while (current_ptr != 0) {
        var block: MemBlock = *(MemBlock*)current_ptr
        if (block.size >= alloc_size) {
            // 找到合适的块
            if (prev_ptr == 0) {
                free_list_head = block.next
            } else {
                *(u64*)(prev_ptr + 4) = block.next
            }
            
            // 返回数据区域的指针
            ret current_ptr + 8
        }
        prev_ptr = current_ptr
        current_ptr = block.next
    }
    
    // 从堆中分配新内存
    var ptr: u64 = sbrk(alloc_size as i32)
    if (ptr == 0xFFFFFFFFFFFFFFFF) {
        ret 0  // 分配失败
    }
    
    // 存储块大小信息
    *(u64*)ptr = alloc_size
    ret ptr + 8
}

// 释放内存
fn free(ptr: u64) {
    if (ptr == 0) {
        ret
    }
    
    // 获取块头部位置
    var header_ptr: u64 = ptr - 8
    var block_size: u64 = *(u64*)header_ptr
    
    // 将块添加到空闲列表头部
    *(u64*)ptr = free_list_head
    *(u64*)(ptr + 4) = 0  // next指针
    free_list_head = header_ptr
}