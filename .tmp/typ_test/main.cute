import "std:console"
import "std:slices"

type Arg struct {
    name: string
    typ: string
}

fn main() int {
    var args: []*Arg = []*Arg{}
    var a1: *Arg = &Arg{name: "x"}
    var a2: *Arg = &Arg{name: "y"}
    slices.push(&args, a1)
    slices.push(&args, a2)

    for i := slices.len(&args) - 1; i >= 0; i-- {
        var a: *Arg = args[i]
        a.typ = "int"
    }

    for i := 0; i < slices.len(&args); i++ {
        var a: *Arg = args[i]
        console.println(a.name + ":" + a.typ)
    }
    ret 0
}
