// unicode package test

fn main() int {
    // isLetter: A=65
    var il1: bool = unicode.isLetter(65)
    if !il1 {
        ret 1
    }

    // isLetter: 0=48 (digit, not letter)
    var il2: bool = unicode.isLetter(48)
    if il2 {
        ret 2
    }

    // isDigit: 0=48
    var id1: bool = unicode.isDigit(48)
    if !id1 {
        ret 3
    }

    // isSpace: space=32
    var is1: bool = unicode.isSpace(32)
    if !is1 {
        ret 4
    }

    // isUpper: A=65
    var iu1: bool = unicode.isUpper(65)
    if !iu1 {
        ret 5
    }

    // isLower: a=97
    var ilw1: bool = unicode.isLower(97)
    if !ilw1 {
        ret 6
    }

    // toUpper: a=97 -> A=65
    var tu1: int = unicode.toUpper(97)
    if tu1 != 65 {
        ret 7
    }

    // toLower: A=65 -> a=97
    var tl1: int = unicode.toLower(65)
    if tl1 != 97 {
        ret 8
    }

    ret 42
}
