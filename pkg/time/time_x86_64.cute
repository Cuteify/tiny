build os("linux")
build arch("x86_64")

// clock_gettime(CLOCK_REALTIME=0, &ts)：x86_64 syscall 228
// nanosleep(&req)：x86_64 syscall 35

// now 返回当前 UTC 时间（CLOCK_REALTIME）
fn now() Time {
    var buf: u64 = 0
    var p: ptr = &buf
    syscall.syscall(228, 0, p, 0)
    var _p1: *ptr = p
    var sec: u64 = *_p1
    var _p2: *ptr = p + 8
    var nsec: u64 = *_p2
    var t: Time
    t.sec = sec
    t.nsec = nsec
    t.offset = 0
    ret t
}

// sleep 休眠 d 纳秒（nanosleep）
fn sleep(d u64) {
    var req: u64 = 0
    var p: ptr = &req
    var sec: u64 = d / SECOND
    var nsec: u64 = d % SECOND
    var _p3: *ptr = p
    *_p3 = unsafe.cast[ptr](sec)
    var _p4: *ptr = p + 8
    *_p4 = unsafe.cast[ptr](nsec)
    syscall.syscall(35, p, 0, 0)
}
// strSlots 写入 x86_64 字符串三槽（各 8 字节：ptr/len/cap）
fn strSlots(p: ptr, vptr: u64, vlen: u64, vcap: u64) {
    var _p5: *ptr = p
    *_p5 = unsafe.cast[ptr](vptr)
    var _p6: *ptr = p + 8
    *_p6 = unsafe.cast[ptr](vlen)
    var _p7: *ptr = p + 16
    *_p7 = unsafe.cast[ptr](vcap)
}

// numOut 按 x86_64 字宽写 int 值到指针目标（8 字节）
fn numOut(p: ptr, v: int) {
    var _p8: *ptr = p
    *_p8 = unsafe.cast[ptr](v)
}
