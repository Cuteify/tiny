build os("linux")
build arch("x86")

// clock_gettime(CLOCK_REALTIME=0, &ts)：i386 syscall 265
// nanosleep(&req)：i386 syscall 162
// i386 的 timespec 为 32 位 long：tv_sec(4) + tv_nsec(4)

// now 返回当前 UTC 时间（CLOCK_REALTIME）
fn now() Time {
    var buf: u32 = 0
    var p: ptr = &buf
    syscall.syscall(265, 0, p, 0)
    var _p1: *uint = p
    var sec: u64 = *_p1
    var _p2: *uint = p + 4
    var nsec: u64 = *_p2
    var t: Time
    t.sec = sec
    t.nsec = nsec
    t.offset = 0
    ret t
}

// sleep 休眠 d 纳秒（nanosleep）
fn sleep(d u64) {
    var req: u32 = 0
    var p: ptr = &req
    var sec: u64 = d / SECOND
    var nsec: u64 = d % SECOND
    var _p3: *uint = p
    *_p3 = unsafe.cast[uint](sec)
    var _p4: *uint = p + 4
    *_p4 = unsafe.cast[uint](nsec)
    syscall.syscall(162, p, 0, 0)
}
// strSlots 写入 x86 字符串三槽（各 4 字节：ptr/len/cap）
fn strSlots(p: ptr, vptr: uint, vlen: uint, vcap: uint) {
    var _p5: *uint = p
    *_p5 = unsafe.cast[uint](vptr)
    var _p6: *uint = p + 4
    *_p6 = unsafe.cast[uint](vlen)
    var _p7: *uint = p + 8
    *_p7 = unsafe.cast[uint](vcap)
}

// numOut 按 x86 字宽写 int 值到指针目标（4 字节，避免 store64 砸邻槽）
fn numOut(p: ptr, v: int) {
    var _p8: *uint = p
    *_p8 = unsafe.cast[uint](v)
}
