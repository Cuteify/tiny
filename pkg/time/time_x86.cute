build os("linux")
build arch("x86")

// clock_gettime(CLOCK_REALTIME=0, &ts)：i386 syscall 265
// nanosleep(&req)：i386 syscall 162
// i386 的 timespec 为 32 位 long：tv_sec(4) + tv_nsec(4)

// now 返回当前 UTC 时间（CLOCK_REALTIME）
fn now() Time {
    var buf: u32 = 0
    var p: ptr = &buf
    syscall.syscall(265, 0, p, 0)
    var sec: u64 = memory.load32(p)
    var nsec: u64 = memory.load32(p + 4)
    var t: Time
    t.sec = sec
    t.nsec = nsec
    t.offset = 0
    ret t
}

// sleep 休眠 d 纳秒（nanosleep）
fn sleep(d u64) {
    var req: u32 = 0
    var p: ptr = &req
    var sec: u64 = d / SECOND
    var nsec: u64 = d % SECOND
    memory.store32(p, sec)
    memory.store32(p + 4, nsec)
    syscall.syscall(162, p, 0, 0)
}
// strSlots 写入 x86 字符串三槽（各 4 字节：ptr/len/cap）
fn strSlots(p: ptr, vptr: uint, vlen: uint, vcap: uint) {
    memory.store32(p, vptr)
    memory.store32(p + 4, vlen)
    memory.store32(p + 8, vcap)
}

// numOut 按 x86 字宽写 int 值到指针目标（4 字节，避免 store64 砸邻槽）
fn numOut(p: ptr, v: int) {
    memory.store32(p, v)
}
