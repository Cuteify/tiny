build os("linux")
import "std:memory"
build arch("x86")

// strView - 本地 str 覆写视图（P8 表 str{p,n,c} 镜像；P4 规约：覆写视图必须在使用文件内定义）
// x86 布局：12B 三槽 4B——p@0 / n@4 / c@8（= 编译器内建 string 容器 Go 序；type 不写偏移字面量，宽度由 arch 决定）
type strView struct {
    p: ptr
    n: uint
    c: uint
}

// 字符串容器槽位（x86 三槽各 4 字节）：ptr+0 / len+4 / cap+8
// len/cap/toCstring 返回 uint（平台原生字宽，x86 为 4 字节）。
// uint 与 i32/u32/u64 同为数值类型可隐式转换：作 u64 形参实参时由实参扩展（高 32 补 0）处理。

fn len(s string) uint {
    build link("__string_len")
    var p: ptr = &s
    var _p1: *uint = p + 4
    ret *_p1
}

fn cap(s string) uint {
    build link("__string_cap")
    var p: ptr = &s
    var _p2: *uint = p + 8
    ret *_p2
}

fn eq(s string, t string) bool {
    build link("__string_eq")
    // 内容比较：ptr/len 槽位相同不代表字符串相等（构造串与字面量可异址同值）
    if strings.compare(s, t) == 0 {
        ret true
    }
    ret false
}

fn ne(s string, t string) bool {
    build link("__string_ne")
    if strings.compare(s, t) != 0 {
        ret true
    }
    ret false
}

fn toCstring(s string) uint {
    build link("__string_toCstring")
    var p: ptr = &s
    var _p11: *uint = p
    ret *_p11
}
// toU64 int→u64 位模式桥（语言层无 int↔uint 转换，地址/位模式拷贝实现）
// 缺陷⑬绕行（x86 生成器）：`ret *_p12` 的 uint→u64 返回转换会走坏的 u64-mul
// 内建模板（空源 `mov ebx, ; a.lo`），第一版 struct shim（u64Box 半字拼装）也已废：
// 缺陷⑯定谳 = x86 生成器对 u64 返回签名走双 dword 接收装配，但栈分配只按 4B 推游标，
// hi 半字踩上邻槽（toString.neg / builderWrite.n0 全踩实，gdb eax=0x20 现场）。
// 绕行 = x86 文件全链去 u64：域内消费点值域恒 <2^32（char/段数/digit），uint 语义等价。
// x86_64 版保持原生 u64 不动（rc=42 已验证）。build link 只别名挂接，签名可变。
fn toU64(n int) uint {
    build link("__string_toU64")
    var p: ptr = &n
    var _p12: *uint = p
    var lo: uint = *_p12
    ret lo
}

// fromI64 u64→int 位模式桥（x86 特化版：形参 uint 化绕缺陷⑯——x86 下 u64 形参/返回
// 装配不安全；x86 域内不存在真 64 位源值，位模式直传等价。x86_64 版 u64 原生不动）
fn fromI64(n uint) int {
    build link("__string_fromI64")
    var x: int = 0
    var p: ptr = &x
    var _p13: *uint = p
    *_p13 = n
    ret x
}

// toString 整数转字符串（2-62 进制，负数带负号）
fn toString(n int, base uint) string {
    build link("__string_toString")
    var neg: bool = false
    var num: uint = 0
    if n < 0 {
        neg = true
        num = toU64(0 - n)
    } else {
        num = toU64(n)
    }
    var digits: uint = 1
    var tmp: uint = num
    for tmp >= base {
        tmp = tmp / base
        digits = digits + 1
    }
    var total: uint = digits
    if neg {
        total = total + 1
    }
    var bufN: uint = total + 1
    var buf: ptr = memory.malloc(bufN)
    var v: uint = num
    if v == 0 {
        var _p14: *u8 = buf
        *_p14 = unsafe.cast[u8](48)
    } else {
        var i: uint = 0
        for v > 0 {
            var digit: uint = v % base
            var ch: uint = 0
            if digit < 10 {
                ch = digit + 48
            } else if digit < 36 {
                ch = digit + 97 - 10
            } else {
                ch = digit + 65 - 36
            }
            var _p15: *u8 = buf + (total - 1 - i)
            *_p15 = unsafe.cast[u8](ch)
            v = v / base
            i = i + 1
        }
    }
    if neg {
        var _p16: *u8 = buf
        *_p16 = unsafe.cast[u8](45)
    }
    var _p17: *u8 = buf + total
    *_p17 = unsafe.cast[u8](0)
    var s: string
    var p: ptr = &s
    var b: uint = buf
    var _p18: *uint = p
    *_p18 = unsafe.cast[uint](b)
    var _p19: *uint = p + 4
    *_p19 = unsafe.cast[uint](total)
    var _p20: *uint = p + 8
    *_p20 = unsafe.cast[uint](total)
    ret s
}

// parse 字符串转整数（2-62 进制，支持负号；非法字符停止解析）
fn parse(s string, base uint) int {
    build link("__string_parse")
    var p: ptr = &s
    var _p21: *uint = p
    var ptrVal: ptr = *_p21
    var _p22: *uint = p + 4
    var n: uint = *_p22
    var i: uint = 0
    var neg: bool = false
    var _p23: *u8 = ptrVal
    var c: uint = *_p23
    if c == 45 {
        neg = true
        i = 1
    }
    var val: int = 0
    var bad: bool = false
    for i < n {
        var _p24: *u8 = ptrVal + i
        var d: uint = *_p24
        var v: uint = 0
        if d >= 48 && d <= 57 {
            v = d - 48
        } else if d >= 97 && d <= 122 {
            v = d - 97 + 10
        } else if d >= 65 && d <= 90 {
            v = d - 65 + 36
        } else {
            bad = true
        }
        if !bad {
            val = val * base + v
        }
        i = i + 1
    }
    var r: int = val
    if neg {
        r = 0 - r
    }
    ret r
}

// notFound 返回 uint 最大值，表示"未找到"
fn notFound() uint {
    var v: int = 0 - 1
    var p: ptr = &v
    var _p25: *uint = p
    ret *_p25
}

// view 从底层组件构建 string 值（仅包装**已有** ptr）：
// 不分配、不拥有、不跟踪底层缓冲；LLR 视返回值为“外部视图”，调用方自行管理 buf 生命周期。
// 需要一份 GC 可跟踪的可写 string 时，用编译器内建 new(string, n)（返回 {ptr,len=cap=n} 三槽，
// 底层 malloc 由 LLR 在帧尾释放；写入用 unsafe.cast[*u8](s) 取得数据指针）。
fn view(ptr: ptr, length: uint, capVal: uint) string {
    var result: string
    var rp: ptr = &result
    var _p26: *uint = rp
    *_p26 = unsafe.cast[uint](ptr)
    var _p27: *uint = rp + 4
    *_p27 = unsafe.cast[uint](length)
    var _p28: *uint = rp + 8
    *_p28 = unsafe.cast[uint](capVal)
    ret result
}

// indexFrom 从 startPos 开始搜索 substr，未找到返回 notFound
fn indexFrom(sPtr: ptr, sLen: uint, tPtr: ptr, tLen: uint, startPos: uint) uint {
    if tLen == 0 {
        ret 0
    }
    if tLen > sLen {
        ret notFound()
    }
    var i: uint = startPos
    var limit: uint = sLen - tLen
    for i <= limit {
        var found: bool = true
        var j: uint = 0
        for j < tLen {
            var _p29: *u8 = sPtr + i + j
            var _p30: *u8 = tPtr + j
            if *_p29 != *_p30 {
                found = false
                break
            }
            j = j + 1
        }
        if found {
            ret i
        }
        i = i + 1
    }
    ret notFound()
}

// index 返回 substr 在 s 中首次出现的位置，未找到返回 -1
fn index(s string, substr string) int {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var tPtr: ptr = toCstring(substr)
    var tLen: uint = len(substr)
    var nf: uint = notFound()
    var r: uint = indexFrom(sPtr, sLen, tPtr, tLen, 0)
    if r == nf {
        ret 0 - 1
    }
    ret r
}

// contains 判断 s 是否包含 substr
fn contains(s string, substr string) bool {
    if index(s, substr) >= 0 {
        ret true
    }
    ret false
}

// hasPrefix 判断 s 是否以 prefix 开头
fn hasPrefix(s string, prefix string) bool {
    var sLen: uint = len(s)
    var tLen: uint = len(prefix)
    if tLen > sLen {
        ret false
    }
    if tLen == 0 {
        ret true
    }
    var sPtr: ptr = toCstring(s)
    var tPtr: ptr = toCstring(prefix)
    var i: uint = 0
    for i < tLen {
        var _p31: *u8 = sPtr + i
        var _p32: *u8 = tPtr + i
        if *_p31 != *_p32 {
            ret false
        }
        i = i + 1
    }
    ret true
}

// hasSuffix 判断 s 是否以 suffix 结尾
fn hasSuffix(s string, suffix string) bool {
    var sLen: uint = len(s)
    var tLen: uint = len(suffix)
    if tLen > sLen {
        ret false
    }
    if tLen == 0 {
        ret true
    }
    var sPtr: ptr = toCstring(s)
    var tPtr: ptr = toCstring(suffix)
    var offset: uint = sLen - tLen
    var i: uint = 0
    for i < tLen {
        var _p33: *u8 = sPtr + offset + i
        var _p34: *u8 = tPtr + i
        if *_p33 != *_p34 {
            ret false
        }
        i = i + 1
    }
    ret true
}

// toUpper 返回 s 的大写副本
fn toUpper(s string) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var bufN: uint = sLen + 1
    var buf: ptr = memory.malloc(bufN)
    var i: uint = 0
    for i < sLen {
        var _p35: *u8 = sPtr + i
        var ch: uint = *_p35
        if ch >= 97 && ch <= 122 {
            ch = ch - 32
        }
        var _p36: *u8 = buf + i
        *_p36 = unsafe.cast[u8](ch)
        i = i + 1
    }
    var _p37: *u8 = buf + sLen
    *_p37 = unsafe.cast[u8](0)
    ret view(buf, sLen, sLen)
}

// toLower 返回 s 的小写副本
fn toLower(s string) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var bufN: uint = sLen + 1
    var buf: ptr = memory.malloc(bufN)
    var i: uint = 0
    for i < sLen {
        var _p38: *u8 = sPtr + i
        var ch: uint = *_p38
        if ch >= 65 && ch <= 90 {
            ch = ch + 32
        }
        var _p39: *u8 = buf + i
        *_p39 = unsafe.cast[u8](ch)
        i = i + 1
    }
    var _p40: *u8 = buf + sLen
    *_p40 = unsafe.cast[u8](0)
    ret view(buf, sLen, sLen)
}

// trimSpace 返回去除两端空白字符的 s
fn trimSpace(s string) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var start: uint = 0
    for start < sLen {
        var _p41: *u8 = sPtr + start
        var ch: uint = *_p41
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        start = start + 1
    }
    var end: uint = sLen
    for end > start {
        var _p42: *u8 = sPtr + end - 1
        var ch: uint = *_p42
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end = end - 1
    }
    var newLen: uint = end - start
    var bufN: uint = newLen + 1
    var buf: ptr = memory.malloc(bufN)
    var i: uint = 0
    for i < newLen {
        var _p43: *u8 = buf + i
        var _p44: *u8 = sPtr + start + i
        var _pc_p44: uint = *_p44
        *_p43 = unsafe.cast[u8](_pc_p44)
        i = i + 1
    }
    var _p45: *u8 = buf + newLen
    *_p45 = unsafe.cast[u8](0)
    ret view(buf, newLen, newLen)
}

// trimPrefix 返回去除 s 前缀 prefix 的字符串
fn trimPrefix(s string, prefix string) string {
    if hasPrefix(s, prefix) {
        var sPtr: ptr = toCstring(s)
        var sLen: uint = len(s)
        var tLen: uint = len(prefix)
        var newLen: uint = sLen - tLen
        var bufN: uint = newLen + 1
        var buf: ptr = memory.malloc(bufN)
        var i: uint = 0
        for i < newLen {
            var _p46: *u8 = buf + i
            var _p47: *u8 = sPtr + tLen + i
            var _pc_p47: uint = *_p47
            *_p46 = unsafe.cast[u8](_pc_p47)
            i = i + 1
        }
        var _p48: *u8 = buf + newLen
        *_p48 = unsafe.cast[u8](0)
        ret view(buf, newLen, newLen)
    }
    ret s
}

// trimSuffix 返回去除 s 后缀 suffix 的字符串
fn trimSuffix(s string, suffix string) string {
    if hasSuffix(s, suffix) {
        var sPtr: ptr = toCstring(s)
        var sLen: uint = len(s)
        var tLen: uint = len(suffix)
        var newLen: uint = sLen - tLen
        var bufN: uint = newLen + 1
        var buf: ptr = memory.malloc(bufN)
        var i: uint = 0
        for i < newLen {
            var _p49: *u8 = buf + i
            var _p50: *u8 = sPtr + i
            var _pc_p50: uint = *_p50
            *_p49 = unsafe.cast[u8](_pc_p50)
            i = i + 1
        }
        var _p51: *u8 = buf + newLen
        *_p51 = unsafe.cast[u8](0)
        ret view(buf, newLen, newLen)
    }
    ret s
}

// repeat 返回 s 重复 count 次的新字符串
fn repeat(s string, count uint) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var total: uint = sLen * count
    var bufN: uint = total + 1
    var buf: ptr = memory.malloc(bufN)
    var i: uint = 0
    for i < count {
        var j: uint = 0
        for j < sLen {
            var _p52: *u8 = buf + i * sLen + j
            var _p53: *u8 = sPtr + j
            var _pc_p53: uint = *_p53
            *_p52 = unsafe.cast[u8](_pc_p53)
            j = j + 1
        }
        i = i + 1
    }
    var _p54: *u8 = buf + total
    *_p54 = unsafe.cast[u8](0)
    ret view(buf, total, total)
}

// replace 返回将 s 中前 n 个 old 替换为 new 的字符串（n=0 替换全部）
fn replace(s string, old string, new string, n uint) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var oPtr: ptr = toCstring(old)
    var oLen: uint = len(old)
    var nPtr: ptr = toCstring(new)
    var nLen: uint = len(new)
    var nf: uint = notFound()
    if oLen == 0 {
        ret s
    }
    var count: uint = 0
    var scanPos: uint = 0
    var scanning: bool = true
    for ; scanning; {
        var idx: uint = indexFrom(sPtr, sLen, oPtr, oLen, scanPos)
        if idx == nf {
            break
        }
        count = count + 1
        scanPos = idx + oLen
    }
    if n > 0 {
        if n < count {
            count = n
        }
    }
    if count == 0 {
        ret s
    }
    var newLen: uint = sLen + count * (nLen - oLen)
    var bufN: uint = newLen + 1
    var buf: ptr = memory.malloc(bufN)
    var srcPos: uint = 0
    var dstPos: uint = 0
    var replaced: uint = 0
    for replaced < count {
        var idx: uint = indexFrom(sPtr, sLen, oPtr, oLen, srcPos)
        var segLen: uint = idx - srcPos
        var k: uint = 0
        for k < segLen {
            var _p55: *u8 = buf + dstPos + k
            var _p56: *u8 = sPtr + srcPos + k
            var _pc_p56: uint = *_p56
            *_p55 = unsafe.cast[u8](_pc_p56)
            k = k + 1
        }
        dstPos = dstPos + segLen
        k = 0
        for k < nLen {
            var _p57: *u8 = buf + dstPos + k
            var _p58: *u8 = nPtr + k
            var _pc_p58: uint = *_p58
            *_p57 = unsafe.cast[u8](_pc_p58)
            k = k + 1
        }
        dstPos = dstPos + nLen
        srcPos = idx + oLen
        replaced = replaced + 1
    }
    var rest: uint = sLen - srcPos
    var k: uint = 0
    for k < rest {
        var _p59: *u8 = buf + dstPos + k
        var _p60: *u8 = sPtr + srcPos + k
        var _pc_p60: uint = *_p60
        *_p59 = unsafe.cast[u8](_pc_p60)
        k = k + 1
    }
    var _p61: *u8 = buf + newLen
    *_p61 = unsafe.cast[u8](0)
    ret view(buf, newLen, newLen)
}

// ===== 字符串连接 =====

// join 用 sep 连接多个字符串，返回结果
fn join(strs ptr, count int, sep string) string {
    if count <= 0 {
        ret view(nil, 0, 0)
    }
    var sepPtr: ptr = toCstring(sep)
    var sepLen: uint = len(sep)

    var totalLen: uint = 0
    var i: int = 0
    for ; i < count; {
        var _p62: *uint = strs + i * 12 + 4
        var sLen: uint = *_p62
        totalLen = totalLen + sLen
        i = i + 1
    }
    if count > 1 {
        totalLen = totalLen + (count - 1) * sepLen
    }

    var bufN: uint = totalLen + 1
    var buf: ptr = memory.malloc(bufN)
    var dstPos: uint = 0
    var j: int = 0
    for ; j < count; {
        var _p63: *uint = strs + j * 12
        var sPtr: ptr = *_p63
        var _p64: *uint = strs + j * 12 + 4
        var sLen2: uint = *_p64
        var k: uint = 0
        for ; k < sLen2; {
            var _p65: *u8 = buf + dstPos + k
            var _p66: *u8 = sPtr + k
            var _pc_p66: uint = *_p66
            *_p65 = unsafe.cast[u8](_pc_p66)
            k = k + 1
        }
        dstPos = dstPos + sLen2
        if j < count - 1 {
            k = 0
            for ; k < sepLen; {
                var _p67: *u8 = buf + dstPos + k
                var _p68: *u8 = sepPtr + k
                var _pc_p68: uint = *_p68
                *_p67 = unsafe.cast[u8](_pc_p68)
                k = k + 1
            }
            dstPos = dstPos + sepLen
        }
        j = j + 1
    }
    var _p69: *u8 = buf + totalLen
    *_p69 = unsafe.cast[u8](0)
    ret view(buf, totalLen, totalLen)
}

// ===== Wave St：块内 staging helper（D4 v3 防则：typed cast 只在 fn 顶层）=====

// _putByte 逐字节拷贝 helper：dst[i] = src[i]（stw01 pPutByte 终态形态）
fn _putByte(dst ptr, src ptr, i uint) {
    var dAddr: ptr = dst + i
    var dP: *u8 = unsafe.cast[*u8](dAddr)
    var sAddr: ptr = src + i
    var sP: *u8 = unsafe.cast[*u8](sAddr)
    var v: uint = *sP
    *dP = unsafe.cast[u8](v)
    ret
}

// _byteAt 读 src+i 字节 helper（stw03 pByteAt 终态形态）
fn _byteAt(src ptr, i uint) uint {
    var bAddr: ptr = src + i
    var bP: *u8 = unsafe.cast[*u8](bAddr)
    var bV: uint = *bP
    ret bV
}

// ===== Wave St：split / splitN 家族（Go 序容器 + strView 覆写视图）=====

// _putPiece 在 data 第 idx 个元素槽写入一段：独立 malloc 段 buffer（segLen+1、NUL 尾）
// + 逐字节拷贝（经 _putByte）+ 三槽写入（stw01 pPutPiece 终态形态；无返回值 fn 省略返回类型、显式 ret）
fn _putPiece(data ptr, idx uint, src ptr, segLen uint) {
    var bufN: uint = segLen + 1
    var buf: ptr = memory.malloc(bufN)
    var i: uint = 0
    for ; i < segLen; {
        _putByte(buf, src, i)
        i = i + 1
    }
    var tailIdx: uint = segLen
    var tailAddr: ptr = buf + tailIdx
    var tailP: *u8 = unsafe.cast[*u8](tailAddr)
    var zeroU: uint = 0
    *tailP = unsafe.cast[u8](zeroU)
    var elemSize: uint = 12
    var dstOff: uint = idx * elemSize
    var cellAddr: ptr = data + dstOff
    var cell: *strView = unsafe.cast[*strView](cellAddr)
    cell.p = buf
    cell.n = segLen
    cell.c = segLen
    ret
}

// splitN 按分隔符切分 s，返回手工构造的 Go 序 [*[]string] 容器头 ptr：
//   外头 12B：p@0=data / n@4=count / c@8=cap；元素 12B string 三槽。
//   n<0 全部；n=0 空（p=0，Go nil 切片语义、data 不 malloc）；n>0 最多 n 段且末段吃余下全部。
//   sep="" 为 byte 级分段（Go 为 rune 段——差异项备案）。
//   所有权：splitFree(r) 释放外头 + data 块 + 各元素 buffer；splitGet 返回借用段。
// （stw01 pSplitN 终态形态 + D2：sepLen==0 走 byte-walk 分支）
fn splitN(s string, sep string, n int) ptr {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var sepPtr: ptr = toCstring(sep)
    var sepLen: uint = len(sep)

    // 缺陷⑭绕行（x86 生成器）：bool 直赋比较（var b: bool = cmp）生成 setl→movzx mem
    // 非法形态，改 if-dispatch（toString neg 形态既有先例）
    var nNeg: bool = false
    if n < 0 {
        nNeg = true
    }
    var nMag: uint = 0
    if nNeg {
        var absN: int = 0 - n
        nMag = toU64(absN)
    } else {
        nMag = toU64(n)
    }

    // pieces 推导（表达式先提局部变量；malloc 实参一律简单中转变量）
    var totalPieces: uint = 0
    if sepLen > 0 {
        var numSeps: int = strings.count(s, sep)
        var withSelf: int = numSeps + 1
        totalPieces = toU64(withSelf)
    } else {
        if sLen < 1 {
            totalPieces = 1
        } else {
            totalPieces = sLen
        }
    }
    var pieces: uint = totalPieces
    if !nNeg {
        if pieces > nMag {
            pieces = nMag
        }
    }

    // 外头容器（12B 恒分配；data 仅 pieces>0 时分配）
    var outer: ptr = memory.malloc(12)
    var elemSize: uint = 12
    var dataSize: uint = 0
    if pieces > 0 {
        dataSize = pieces * elemSize
    }
    var hdr: *strView = unsafe.cast[*strView](outer)
    var data: ptr = 0
    if pieces > 0 {
        data = memory.malloc(dataSize)
    }
    hdr.p = data
    hdr.c = pieces

    // 输出各段（walk 循环 + 尾段；break 早退时 cellCount 校正段数）
    var cellCount: uint = 0
    if pieces > 0 {
        var scanPos: uint = 0
        var pieceI: uint = 0
        var nf: uint = notFound()
        if sepLen > 0 {
            var limitM1: uint = pieces - 1
            for ; pieceI < limitM1; {
                var sIdx: uint = indexFrom(sPtr, sLen, sepPtr, sepLen, scanPos)
                if sIdx == nf {
                    break
                }
                var segOff: uint = scanPos
                var segSrc: ptr = sPtr + segOff
                var segLenU: uint = sIdx - scanPos
                _putPiece(data, pieceI, segSrc, segLenU)
                scanPos = sIdx + sepLen
                pieceI = pieceI + 1
            }
        } else {
            // sep=="" byte 级分段：每字节独立一段（D2 补丁分支）
            var bsLimit: uint = pieces - 1
            for ; pieceI < bsLimit; {
                var bOff: uint = scanPos
                var bSrc: ptr = sPtr + bOff
                var bLen: uint = 1
                _putPiece(data, pieceI, bSrc, bLen)
                scanPos = scanPos + 1
                pieceI = pieceI + 1
            }
        }
        var tailOff: uint = scanPos
        var tailSrc: ptr = sPtr + tailOff
        var tailLen: uint = sLen - scanPos
        _putPiece(data, pieceI, tailSrc, tailLen)
        pieceI = pieceI + 1
        cellCount = pieceI
    }
    hdr.n = cellCount
    ret outer
}

// split 委托 splitN(-1)（Go strings.Split 与内部 genSplit 同构）
fn split(s string, sep string) ptr {
    ret splitN(s, sep, 0 - 1)
}

// splitLen 读容器段数（外头 n 槽）
fn splitLen(r ptr) uint {
    var rAddr: ptr = unsafe.cast[ptr](r)
    var hdr: *strView = unsafe.cast[*strView](rAddr)
    ret hdr.n
}

// splitGet 读第 i 段 string 值（不复制、借用段 buffer：splitFree 之前有效；勿 free 其 p 槽）
fn splitGet(r ptr, i uint) string {
    var rAddr: ptr = unsafe.cast[ptr](r)
    var hdr: *strView = unsafe.cast[*strView](rAddr)
    var data: ptr = hdr.p
    var elemSize: uint = 12
    var off: uint = i * elemSize
    var cellAddr: ptr = data + off
    var cell: *strView = unsafe.cast[*strView](cellAddr)
    ret view(cell.p, cell.n, cell.c)
}

// _cellP 读容器第 i 个 cell 的 p 字段 helper：typed staging 全顶层（D3/D4 v3：块内禁 cast）
fn _cellP(r ptr, i uint) ptr {
    var rAddrH: ptr = unsafe.cast[ptr](r)
    var hdrH: *strView = unsafe.cast[*strView](rAddrH)
    var dataH: ptr = hdrH.p
    var elemH: uint = 12
    var offH: uint = i * elemH
    var cellAddrH: ptr = dataH + offH
    var cellH: *strView = unsafe.cast[*strView](cellAddrH)
    var cellPH: ptr = cellH.p
    ret cellPH
}

// splitFree 释放 r 全家：外头 + data 块 + 各元素 buffer；重复调用/借用后调用为 UB（不测）
fn splitFree(r ptr) {
    var rAddr2: ptr = unsafe.cast[ptr](r)
    var hdr2: *strView = unsafe.cast[*strView](rAddr2)
    var count0: uint = hdr2.n
    var data2: ptr = hdr2.p
    if data2 != 0 {
        var i2: uint = 0
        for ; i2 < count0; {
            var cellP: ptr = _cellP(r, i2)
            if cellP != 0 {
                memory.free(cellP)
            }
            i2 = i2 + 1
        }
        memory.free(data2)
    }
    memory.free(rAddr2)
    ret
}

// ===== Wave St：fields（空白分段，跳空段）=====
// （本波次不含 fieldsFunc：fn 形参毒面⑨a，已摘除延期——见下方备案注释）

// fields 按空白字符（isSpace：32/9/10/13）切分 s，跳过空段；
// 返回手工 Go 序容器头 ptr（与 split 同形），所有权同 split（splitFree 释放全家）。
// （stw03 pFields 终态形态：两遍扫描 + _byteAt/_putPiece helper，块内零 typed staging）
fn fields(s string) ptr {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)

    // pass1：数字段数
    var fieldCount: uint = 0
    var scanI: uint = 0
    for ; scanI < sLen; {
        var ch0: uint = _byteAt(sPtr, scanI)
        var isWs0: bool = strings.isSpace(ch0)
        if isWs0 {
            scanI = scanI + 1
        } else {
            fieldCount = fieldCount + 1
            for ; scanI < sLen; {
                var ch1: uint = _byteAt(sPtr, scanI)
                var isWs1: bool = strings.isSpace(ch1)
                if isWs1 {
                    break
                }
                scanI = scanI + 1
            }
        }
    }

    // 外头 + data（与 split 同构）
    var outerF: ptr = memory.malloc(12)
    var elemSizeF: uint = 12
    var dataF: ptr = 0
    if fieldCount > 0 {
        var dataSizeF: uint = fieldCount * elemSizeF
        dataF = memory.malloc(dataSizeF)
    }
    var hdrF: *strView = unsafe.cast[*strView](outerF)
    hdrF.p = dataF
    hdrF.c = fieldCount

    // pass2：输出各段（复用 _putPiece；判定逻辑与 pass1 同款保证一致）
    var fieldI: uint = 0
    var scanJ: uint = 0
    for ; scanJ < sLen; {
        var ch2: uint = _byteAt(sPtr, scanJ)
        var isWs2: bool = strings.isSpace(ch2)
        if isWs2 {
            scanJ = scanJ + 1
        } else {
            var startI: uint = scanJ
            for ; scanJ < sLen; {
                var ch3: uint = _byteAt(sPtr, scanJ)
                var isWs3: bool = strings.isSpace(ch3)
                if isWs3 {
                    break
                }
                scanJ = scanJ + 1
            }
            var segOffF: uint = startI
            var segSrcF: ptr = sPtr + segOffF
            var segLenF: uint = scanJ - startI
            _putPiece(dataF, fieldI, segSrcF, segLenF)
            fieldI = fieldI + 1
        }
    }
    hdrF.n = fieldI
    ret outerF
}

// fieldsFunc 延期备案（缺陷⑨a 摘除）：fn 形参形态 `pred fn(ch uint) bool` 使 parser.ParseArgs
// 死循环挂死——探针 stw05/05a/05b 三形态挂证（parse 阶段烧 CPU 分钟级）。发布面 hang 不可接受，
// R15 延期；fields 体间零调用不受牵连。待编译器修复 fn 类型形参后再落此函数。

// ===== Wave St：Builder MVP（builderNew/Write/WriteString/Len/String/Free + _bGrow）=====
// 控制块 12B 三槽：p@0=数据 buf / n@4=当前长度 / c@8=容量（strView 同形，字段复用）。
// String() 不调 bufToString（其 view-then-free 为悬空陷阱 R11）；自 malloc 新 buffer 收编。

// builderNew 建一个容量 capacity 的字节 Builder；capacity<1 按 1 处理
fn builderNew(capacity uint) ptr {
    var b: ptr = memory.malloc(12)
    var box: *strView = unsafe.cast[*strView](b)
    var cap0: uint = capacity
    if cap0 < 1 {
        cap0 = 1
    }
    var bufN: uint = cap0
    var buf0: ptr = memory.malloc(bufN)
    box.p = buf0
    var zeroN: uint = 0
    box.n = zeroN
    box.c = cap0
    ret b
}

// _bGrow 私有扩容曲线：n+need 超 cap 时按 P2 曲线扩容并迁移旧数据（slice grow 同款）
fn _bGrow(b ptr, need uint) {
    var box: *strView = unsafe.cast[*strView](b)
    var n0: uint = box.n
    var c0: uint = box.c
    var total: uint = n0 + need
    if total > c0 {
        var ncap: uint = c0
        if c0 < 512 {
            ncap = c0 * 2
        } else {
            var q: uint = c0 / 4
            ncap = c0 + q
        }
        if ncap < total {
            ncap = total
        }
        var oldData: ptr = box.p
        var nbuf: ptr = memory.malloc(ncap)
        var moveN: uint = n0
        memory.memmove(nbuf, oldData, moveN)
        memory.free(oldData)
        box.p = nbuf
        box.c = ncap
    }
    ret
}

// builderWrite 追加单字节（ch 取 0–255；typed staging 全顶层 D4 v3）
fn builderWrite(b ptr, ch int) {
    _bGrow(b, 1)
    var box: *strView = unsafe.cast[*strView](b)
    var data: ptr = box.p
    var n0: uint = box.n
    var chU: uint = toU64(ch)
    var wAddr: ptr = data + n0
    var wP: *u8 = unsafe.cast[*u8](wAddr)
    *wP = unsafe.cast[u8](chU)
    var nNow: uint = box.n
    var nNext: uint = nNow + 1
    box.n = nNext
    ret
}

// builderWriteString 追加字符串 s 的全部字节（s 为只读借用，R10）
fn builderWriteString(b ptr, s string) {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    _bGrow(b, sLen)
    var box: *strView = unsafe.cast[*strView](b)
    var data: ptr = box.p
    var nN: uint = box.n
    var dstBase: ptr = data + nN
    var i: uint = 0
    for ; i < sLen; {
        _putByte(dstBase, sPtr, i)
        i = i + 1
    }
    var nAfter: uint = nN + sLen
    box.n = nAfter
    ret
}

// builderLen 读当前长度
fn builderLen(b ptr) uint {
    var box: *strView = unsafe.cast[*strView](b)
    ret box.n
}

// builderString 收编为新 string（malloc 新 buffer + 拷贝 + NUL；不消耗 builder、可重复调用）
fn builderString(b ptr) string {
    var box: *strView = unsafe.cast[*strView](b)
    var n0: uint = box.n
    var data: ptr = box.p
    var sizeN: uint = n0 + 1
    var out: ptr = memory.malloc(sizeN)
    var i: uint = 0
    for ; i < n0; {
        _putByte(out, data, i)
        i = i + 1
    }
    var tailIdx: uint = n0
    var tailAddr: ptr = out + tailIdx
    var tailP: *u8 = unsafe.cast[*u8](tailAddr)
    var zeroU: uint = 0
    *tailP = unsafe.cast[u8](zeroU)
    ret view(out, n0, n0)
}

// builderFree 释放 builder 全家（数据 buf + 控制块）；其后使用为 UB
fn builderFree(b ptr) {
    var box: *strView = unsafe.cast[*strView](b)
    var data: ptr = box.p
    if data != 0 {
        memory.free(data)
    }
    memory.free(b)
    ret
}
