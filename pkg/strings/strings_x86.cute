build os("linux")
build arch("x86")

// 字符串容器槽位（x86 三槽各 4 字节）：ptr+0 / len+4 / cap+8
// len/cap/toCstring 返回 uint（平台原生字宽，x86 为 4 字节）。
// uint 与 i32/u32/u64 同为数值类型可隐式转换：作 u64 形参实参时由实参扩展（高 32 补 0）处理。

fn len(s string) uint {
    build link("__string_len")
    var p: ptr = &s
    var _p1: *uint = p + 4
    ret *_p1
}

fn cap(s string) uint {
    build link("__string_cap")
    var p: ptr = &s
    var _p2: *uint = p + 8
    ret *_p2
}

fn eq(s string, t string) bool {
    build link("__string_eq")
    var p: ptr = &s
    var q: ptr = &t
    // 比较 ptr + len（值相等的字符串必须长度和内容都相同）
    var _p3: *uint = p
    var x0: uint = *_p3
    var _p4: *uint = q
    var y0: uint = *_p4
    if x0 != y0 {
        ret false
    }
    var _p5: *uint = p + 4
    var x1: uint = *_p5
    var _p6: *uint = q + 4
    var y1: uint = *_p6
    if x1 != y1 {
        ret false
    }
    ret true
}

fn ne(s string, t string) bool {
    build link("__string_ne")
    var p: ptr = &s
    var q: ptr = &t
    var _p7: *uint = p
    var x0: uint = *_p7
    var _p8: *uint = q
    var y0: uint = *_p8
    if x0 != y0 {
        ret true
    }
    var _p9: *uint = p + 4
    var x1: uint = *_p9
    var _p10: *uint = q + 4
    var y1: uint = *_p10
    if x1 != y1 {
        ret true
    }
    ret false
}

fn toCstring(s string) uint {
    build link("__string_toCstring")
    var p: ptr = &s
    var _p11: *uint = p
    ret *_p11
}
// toU64 int→u64 位模式桥（语言层无 int↔uint 转换，地址/位模式拷贝实现）
fn toU64(n int) u64 {
    build link("__string_toU64")
    var p: ptr = &n
    var _p12: *uint = p
    ret *_p12
}

// fromI64 u64→int 位模式桥
fn fromI64(n u64) int {
    build link("__string_fromI64")
    var x: int = 0
    var p: ptr = &x
    var _p13: *uint = p
    *_p13 = unsafe.cast[uint](n)
    ret x
}

// toString 整数转字符串（2-62 进制，负数带负号）
fn toString(n int, base uint) string {
    build link("__string_toString")
    var neg: bool = false
    var num: uint = 0
    if n < 0 {
        neg = true
        num = toU64(0 - n)
    } else {
        num = toU64(n)
    }
    var digits: uint = 1
    var tmp: uint = num
    for tmp >= base {
        tmp = tmp / base
        digits = digits + 1
    }
    var total: uint = digits
    if neg {
        total = total + 1
    }
    var buf: ptr = memory.malloc(total + 1)
    var v: uint = num
    if v == 0 {
        var _p14: *u8 = buf
        *_p14 = unsafe.cast[u8](48)
    } else {
        var i: uint = 0
        for v > 0 {
            var digit: uint = v % base
            var ch: uint = 0
            if digit < 10 {
                ch = digit + 48
            } else if digit < 36 {
                ch = digit + 97 - 10
            } else {
                ch = digit + 65 - 36
            }
            var _p15: *u8 = buf + (total - 1 - i)
            *_p15 = unsafe.cast[u8](ch)
            v = v / base
            i = i + 1
        }
    }
    if neg {
        var _p16: *u8 = buf
        *_p16 = unsafe.cast[u8](45)
    }
    var _p17: *u8 = buf + total
    *_p17 = unsafe.cast[u8](0)
    var s: string
    var p: ptr = &s
    var b: uint = buf
    var _p18: *uint = p
    *_p18 = unsafe.cast[uint](b)
    var _p19: *uint = p + 4
    *_p19 = unsafe.cast[uint](total)
    var _p20: *uint = p + 8
    *_p20 = unsafe.cast[uint](total)
    ret s
}

// parse 字符串转整数（2-62 进制，支持负号；非法字符停止解析）
fn parse(s string, base uint) int {
    build link("__string_parse")
    var p: ptr = &s
    var _p21: *uint = p
    var ptrVal: ptr = *_p21
    var _p22: *uint = p + 4
    var n: uint = *_p22
    var i: uint = 0
    var neg: bool = false
    var _p23: *u8 = ptrVal
    var c: uint = *_p23
    if c == 45 {
        neg = true
        i = 1
    }
    var val: int = 0
    var bad: bool = false
    for i < n {
        var _p24: *u8 = ptrVal + i
        var d: uint = *_p24
        var v: uint = 0
        if d >= 48 && d <= 57 {
            v = d - 48
        } else if d >= 97 && d <= 122 {
            v = d - 97 + 10
        } else if d >= 65 && d <= 90 {
            v = d - 65 + 36
        } else {
            bad = true
        }
        if !bad {
            val = val * base + v
        }
        i = i + 1
    }
    var r: int = val
    if neg {
        r = 0 - r
    }
    ret r
}

// notFound 返回 uint 最大值，表示"未找到"
fn notFound() uint {
    var v: int = 0 - 1
    var p: ptr = &v
    var _p25: *uint = p
    ret *_p25
}

// makeString 从底层组件构建 string 值
fn makeString(ptr: ptr, length: uint, capVal: uint) string {
    var result: string
    var rp: ptr = &result
    var _p26: *uint = rp
    *_p26 = unsafe.cast[uint](ptr)
    var _p27: *uint = rp + 4
    *_p27 = unsafe.cast[uint](length)
    var _p28: *uint = rp + 8
    *_p28 = unsafe.cast[uint](capVal)
    ret result
}

// indexFrom 从 startPos 开始搜索 substr，未找到返回 notFound
fn indexFrom(sPtr: ptr, sLen: uint, tPtr: ptr, tLen: uint, startPos: uint) uint {
    if tLen == 0 {
        ret 0
    }
    if tLen > sLen {
        ret notFound()
    }
    var i: uint = startPos
    var limit: uint = sLen - tLen
    for i <= limit {
        var found: bool = true
        var j: uint = 0
        for j < tLen {
            var _p29: *u8 = sPtr + i + j
            var _p30: *u8 = tPtr + j
            if *_p29 != *_p30 {
                found = false
                break
            }
            j = j + 1
        }
        if found {
            ret i
        }
        i = i + 1
    }
    ret notFound()
}

// index 返回 substr 在 s 中首次出现的位置，未找到返回 -1
fn index(s string, substr string) int {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var tPtr: ptr = toCstring(substr)
    var tLen: uint = len(substr)
    var nf: uint = notFound()
    var r: uint = indexFrom(sPtr, sLen, tPtr, tLen, 0)
    if r == nf {
        ret 0 - 1
    }
    ret r
}

// contains 判断 s 是否包含 substr
fn contains(s string, substr string) bool {
    if index(s, substr) >= 0 {
        ret true
    }
    ret false
}

// hasPrefix 判断 s 是否以 prefix 开头
fn hasPrefix(s string, prefix string) bool {
    var sLen: uint = len(s)
    var tLen: uint = len(prefix)
    if tLen > sLen {
        ret false
    }
    if tLen == 0 {
        ret true
    }
    var sPtr: ptr = toCstring(s)
    var tPtr: ptr = toCstring(prefix)
    var i: uint = 0
    for i < tLen {
        var _p31: *u8 = sPtr + i
        var _p32: *u8 = tPtr + i
        if *_p31 != *_p32 {
            ret false
        }
        i = i + 1
    }
    ret true
}

// hasSuffix 判断 s 是否以 suffix 结尾
fn hasSuffix(s string, suffix string) bool {
    var sLen: uint = len(s)
    var tLen: uint = len(suffix)
    if tLen > sLen {
        ret false
    }
    if tLen == 0 {
        ret true
    }
    var sPtr: ptr = toCstring(s)
    var tPtr: ptr = toCstring(suffix)
    var offset: uint = sLen - tLen
    var i: uint = 0
    for i < tLen {
        var _p33: *u8 = sPtr + offset + i
        var _p34: *u8 = tPtr + i
        if *_p33 != *_p34 {
            ret false
        }
        i = i + 1
    }
    ret true
}

// toUpper 返回 s 的大写副本
fn toUpper(s string) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var buf: ptr = memory.malloc(sLen + 1)
    var i: uint = 0
    for i < sLen {
        var _p35: *u8 = sPtr + i
        var ch: uint = *_p35
        if ch >= 97 && ch <= 122 {
            ch = ch - 32
        }
        var _p36: *u8 = buf + i
        *_p36 = unsafe.cast[u8](ch)
        i = i + 1
    }
    var _p37: *u8 = buf + sLen
    *_p37 = unsafe.cast[u8](0)
    ret makeString(buf, sLen, sLen)
}

// toLower 返回 s 的小写副本
fn toLower(s string) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var buf: ptr = memory.malloc(sLen + 1)
    var i: uint = 0
    for i < sLen {
        var _p38: *u8 = sPtr + i
        var ch: uint = *_p38
        if ch >= 65 && ch <= 90 {
            ch = ch + 32
        }
        var _p39: *u8 = buf + i
        *_p39 = unsafe.cast[u8](ch)
        i = i + 1
    }
    var _p40: *u8 = buf + sLen
    *_p40 = unsafe.cast[u8](0)
    ret makeString(buf, sLen, sLen)
}

// trimSpace 返回去除两端空白字符的 s
fn trimSpace(s string) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var start: uint = 0
    for start < sLen {
        var _p41: *u8 = sPtr + start
        var ch: uint = *_p41
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        start = start + 1
    }
    var end: uint = sLen
    for end > start {
        var _p42: *u8 = sPtr + end - 1
        var ch: uint = *_p42
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end = end - 1
    }
    var newLen: uint = end - start
    var buf: ptr = memory.malloc(newLen + 1)
    var i: uint = 0
    for i < newLen {
        var _p43: *u8 = buf + i
        var _p44: *u8 = sPtr + start + i
        *_p43 = unsafe.cast[u8](*_p44)
        i = i + 1
    }
    var _p45: *u8 = buf + newLen
    *_p45 = unsafe.cast[u8](0)
    ret makeString(buf, newLen, newLen)
}

// trimPrefix 返回去除 s 前缀 prefix 的字符串
fn trimPrefix(s string, prefix string) string {
    if hasPrefix(s, prefix) {
        var sPtr: ptr = toCstring(s)
        var sLen: uint = len(s)
        var tLen: uint = len(prefix)
        var newLen: uint = sLen - tLen
        var buf: ptr = memory.malloc(newLen + 1)
        var i: uint = 0
        for i < newLen {
            var _p46: *u8 = buf + i
            var _p47: *u8 = sPtr + tLen + i
            *_p46 = unsafe.cast[u8](*_p47)
            i = i + 1
        }
        var _p48: *u8 = buf + newLen
        *_p48 = unsafe.cast[u8](0)
        ret makeString(buf, newLen, newLen)
    }
    ret s
}

// trimSuffix 返回去除 s 后缀 suffix 的字符串
fn trimSuffix(s string, suffix string) string {
    if hasSuffix(s, suffix) {
        var sPtr: ptr = toCstring(s)
        var sLen: uint = len(s)
        var tLen: uint = len(suffix)
        var newLen: uint = sLen - tLen
        var buf: ptr = memory.malloc(newLen + 1)
        var i: uint = 0
        for i < newLen {
            var _p49: *u8 = buf + i
            var _p50: *u8 = sPtr + i
            *_p49 = unsafe.cast[u8](*_p50)
            i = i + 1
        }
        var _p51: *u8 = buf + newLen
        *_p51 = unsafe.cast[u8](0)
        ret makeString(buf, newLen, newLen)
    }
    ret s
}

// repeat 返回 s 重复 count 次的新字符串
fn repeat(s string, count uint) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var total: uint = sLen * count
    var buf: ptr = memory.malloc(total + 1)
    var i: uint = 0
    for i < count {
        var j: uint = 0
        for j < sLen {
            var _p52: *u8 = buf + i * sLen + j
            var _p53: *u8 = sPtr + j
            *_p52 = unsafe.cast[u8](*_p53)
            j = j + 1
        }
        i = i + 1
    }
    var _p54: *u8 = buf + total
    *_p54 = unsafe.cast[u8](0)
    ret makeString(buf, total, total)
}

// replace 返回将 s 中前 n 个 old 替换为 new 的字符串（n=0 替换全部）
fn replace(s string, old string, new string, n uint) string {
    var sPtr: ptr = toCstring(s)
    var sLen: uint = len(s)
    var oPtr: ptr = toCstring(old)
    var oLen: uint = len(old)
    var nPtr: ptr = toCstring(new)
    var nLen: uint = len(new)
    var nf: uint = notFound()
    if oLen == 0 {
        ret s
    }
    var count: uint = 0
    var scanPos: uint = 0
    for n == 0 || count < n {
        var idx: uint = indexFrom(sPtr, sLen, oPtr, oLen, scanPos)
        if idx == nf {
            break
        }
        count = count + 1
        scanPos = idx + oLen
    }
    if count == 0 {
        ret s
    }
    var newLen: uint = sLen + count * (nLen - oLen)
    var buf: ptr = memory.malloc(newLen + 1)
    var srcPos: uint = 0
    var dstPos: uint = 0
    var replaced: uint = 0
    for replaced < count {
        var idx: uint = indexFrom(sPtr, sLen, oPtr, oLen, srcPos)
        var segLen: uint = idx - srcPos
        var k: uint = 0
        for k < segLen {
            var _p55: *u8 = buf + dstPos + k
            var _p56: *u8 = sPtr + srcPos + k
            *_p55 = unsafe.cast[u8](*_p56)
            k = k + 1
        }
        dstPos = dstPos + segLen
        k = 0
        for k < nLen {
            var _p57: *u8 = buf + dstPos + k
            var _p58: *u8 = nPtr + k
            *_p57 = unsafe.cast[u8](*_p58)
            k = k + 1
        }
        dstPos = dstPos + nLen
        srcPos = idx + oLen
        replaced = replaced + 1
    }
    var rest: uint = sLen - srcPos
    var k: uint = 0
    for k < rest {
        var _p59: *u8 = buf + dstPos + k
        var _p60: *u8 = sPtr + srcPos + k
        *_p59 = unsafe.cast[u8](*_p60)
        k = k + 1
    }
    var _p61: *u8 = buf + newLen
    *_p61 = unsafe.cast[u8](0)
    ret makeString(buf, newLen, newLen)
}

// ===== 字符串连接 =====

// join 用 sep 连接多个字符串，返回结果
fn join(strs ptr, count int, sep string) string {
    if count <= 0 {
        ret makeString(nil, 0, 0)
    }
    var sepPtr: ptr = toCstring(sep)
    var sepLen: uint = len(sep)

    var totalLen: uint = 0
    var i: int = 0
    for ; i < count; {
        var _p62: *uint = strs + i * 12 + 4
        var sLen: uint = *_p62
        totalLen = totalLen + sLen
        i = i + 1
    }
    if count > 1 {
        totalLen = totalLen + (count - 1) * sepLen
    }

    var buf: ptr = memory.malloc(totalLen + 1)
    var dstPos: uint = 0
    var j: int = 0
    for ; j < count; {
        var _p63: *uint = strs + j * 12
        var sPtr: ptr = *_p63
        var _p64: *uint = strs + j * 12 + 4
        var sLen2: uint = *_p64
        var k: uint = 0
        for ; k < sLen2; {
            var _p65: *u8 = buf + dstPos + k
            var _p66: *u8 = sPtr + k
            *_p65 = unsafe.cast[u8](*_p66)
            k = k + 1
        }
        dstPos = dstPos + sLen2
        if j < count - 1 {
            k = 0
            for ; k < sepLen; {
                var _p67: *u8 = buf + dstPos + k
                var _p68: *u8 = sepPtr + k
                *_p67 = unsafe.cast[u8](*_p68)
                k = k + 1
            }
            dstPos = dstPos + sepLen
        }
        j = j + 1
    }
    var _p69: *u8 = buf + totalLen
    *_p69 = unsafe.cast[u8](0)
    ret makeString(buf, totalLen, totalLen)
}
