// pkg/strings/cstring.cute - C 风格字符串原语（NUL 结尾，裸指针操作）
// 平台无关实现，底层复用 std:memory 的 load8/store8

// strlen 返回 NUL 结尾字符串长度（不含结尾 NUL）
fn strlen(p: ptr) uint {
    var n: uint = 0
    for ; memory.load8(p + n) != 0; {
        n = n + 1
    }
    ret n
}

// strcpy 拷贝 NUL 结尾字符串（含结尾 NUL）到 dest，返回 dest
fn strcpy(dest: ptr, src: ptr) ptr {
    var i: uint = 0
    for ; memory.load8(src + i) != 0; {
        memory.store8(dest + i, memory.load8(src + i))
        i = i + 1
    }
    memory.store8(dest + i, 0)
    ret dest
}

// strcmp 比较两个 NUL 结尾字符串：相等返回 0，s1 小返回负，s1 大返回正
fn strcmp(s1: ptr, s2: ptr) i32 {
    var i: uint = 0
    for ; ; {
        var a: u8 = memory.load8(s1 + i)
        var b: u8 = memory.load8(s2 + i)
        if a != b {
            if a < b {
                ret 0 - 1
            }
            ret 1
        }
        if a == 0 {
            ret 0
        }
        i = i + 1
    }
}
