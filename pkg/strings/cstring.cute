// pkg/strings/cstring.cute - C 风格字符串原语（NUL 结尾，裸指针操作）
// 平台无关实现，底层复用 std:memory 的 load8/store8

// strlen 返回 NUL 结尾字符串长度（不含结尾 NUL）
fn strlen(p: ptr) uint {
    var n: uint = 0
    var _p1: *u8 = p + n
    for ; *_p1 != 0; {
        n = n + 1
    }
    ret n
}

// strcpy 拷贝 NUL 结尾字符串（含结尾 NUL）到 dest，返回 dest
fn strcpy(dest: ptr, src: ptr) ptr {
    var i: uint = 0
    var _p2: *u8 = src + i
    for ; *_p2 != 0; {
        var _p3: *u8 = dest + i
        var _p4: *u8 = src + i
        *_p3 = unsafe.cast[u8](*_p4)
        i = i + 1
    }
    var _p5: *u8 = dest + i
    *_p5 = unsafe.cast[u8](0)
    ret dest
}

// strcmp 比较两个 NUL 结尾字符串：相等返回 0，s1 小返回负，s1 大返回正
fn strcmp(s1: ptr, s2: ptr) i32 {
    var i: uint = 0
    for ; ; {
        var _p6: *u8 = s1 + i
        var a: u8 = *_p6
        var _p7: *u8 = s2 + i
        var b: u8 = *_p7
        if a != b {
            if a < b {
                ret 0 - 1
            }
            ret 1
        }
        if a == 0 {
            ret 0
        }
        i = i + 1
    }
}
