// resetStyle 重置所有样式（颜色、字体、装饰）
fn resetStyle() int {
    ret writeEsc1Param(48, 109)
}

// ===== 光标控制 API =====

fn moveCursor(row int, col int) int {
    ret writeEsc2Param(row, col, 72)
}

fn moveUp(n int) int {
    ret writeEsc1Param(n, CURSOR_UP)
}

fn moveDown(n int) int {
    ret writeEsc1Param(n, CURSOR_DOWN)
}

fn moveRight(n int) int {
    ret writeEsc1Param(n, CURSOR_RIGHT)
}

fn moveLeft(n int) int {
    ret writeEsc1Param(n, CURSOR_LEFT)
}

fn saveCursor() int {
    ret writeEscCSI(115)
}

fn restoreCursor() int {
    ret writeEscCSI(117)
}

fn hideCursor() int {
    ret writeEscParamCSI(1, 25, 108)
}

fn showCursor() int {
    ret writeEscParamCSI(1, 25, 104)
}

fn cursorShape(shape int) int {
    ret writeEsc2Param(shape, 1, 113)
}

// ===== 终端控制 API =====

fn clearScreen() int {
    ret writeEscCSI(74)
}

fn clearLine() int {
    ret writeEsc1Param(2, 75)
}

fn clearToEndOfLine() int {
    ret writeEsc1Param(0, 75)
}

fn clearToStartOfLine() int {
    ret writeEsc1Param(1, 75)
}

fn clearToEndOfScreen() int {
    ret writeEsc1Param(0, 74)
}

fn clearToStartOfScreen() int {
    ret writeEsc1Param(1, 74)
}

fn scrollUp(n int) int {
    ret writeEsc1Param(n, 83)
}

fn scrollDown(n int) int {
    ret writeEsc1Param(n, 84)
}

fn insertLines(n int) int {
    ret writeEsc1Param(n, 76)
}

fn deleteLines(n int) int {
    ret writeEsc1Param(n, 77)
}

fn insertChars(n int) int {
    ret writeEsc1Param(n, 64)
}

fn deleteChars(n int) int {
    ret writeEsc1Param(n, 80)
}

fn eraseChars(n int) int {
    ret writeEsc1Param(n, 88)
}

fn setScrollRegion(top int, bottom int) int {
    ret writeEsc2Param(top, bottom, 114)
}

// setWindowTitle 设置终端窗口标题
fn setWindowTitle(title string) int {
    var buf: ptr = strings.bufNew(256)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 93)
    strings.bufSetByte(buf, 2, 50)
    strings.bufSetByte(buf, 3, 59)
    var titlePtr: ptr = strings.toCstring(title)
    var titleLen: int = strings.len(title)
    strings.bufCopyFrom(buf, 4, titlePtr, titleLen)
    strings.bufSetByte(buf, 4 + titleLen, 7)
    ret bufAndStr(buf, 4 + titleLen + 1)
}

fn setTabWidth(n int) int {
    ret writeEsc1Param(n, 87)
}

// ===== 鼠标事件 API =====

fn enableMouse() int {
    if shouldUseAdvanced() == 0 || supportsMouse() == -1 {
        ret 0
    }
    ret writeEscParamCSI(1, 1003, 104)
}

fn disableMouse() int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    ret writeEscParamCSI(1, 1003, 108)
}

fn enableMouseSgr() int {
    if shouldUseAdvanced() == 0 || supportsMouse() == -1 {
        ret 0
    }
    var r1: int = writeEscParamCSI(1, 1006, 104)
    var r2: int = writeEscParamCSI(1, 1003, 104)
    ret r1 + r2
}

fn disableMouseSgr() int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    var r1: int = writeEscParamCSI(1, 1003, 108)
    var r2: int = writeEscParamCSI(1, 1006, 108)
    ret r1 + r2
}

// ===== 序列输出 API =====

// writeHexByte 以十六进制格式写入一个字节（如 "1B"）
fn writeHexByte(value int) int {
    var buf: ptr = strings.bufNew(4)
    var hi: int = value / 16
    var lo: int = value - hi * 16
    if hi < 10 {
        strings.bufSetByte(buf, 0, 48 + hi)
    } else {
        strings.bufSetByte(buf, 0, 55 + hi)
    }
    if lo < 10 {
        strings.bufSetByte(buf, 1, 48 + lo)
    } else {
        strings.bufSetByte(buf, 1, 55 + lo)
    }
    ret bufAndStr(buf, 2)
}

// ===== Sixel 图形 API =====

// sixelBegin 开始 Sixel 图像数据（发送 DCS 序列头）
fn sixelBegin(width int, height int, colors int) int {
    if shouldUseAdvanced() == 0 || supportsSixel() == -1 {
        ret -1
    }
    var buf: ptr = strings.bufNew(128)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 80)
    strings.bufSetByte(buf, 2, 48)
    strings.bufSetByte(buf, 3, 59)
    strings.bufSetByte(buf, 4, 48)
    strings.bufSetByte(buf, 5, 59)
    strings.bufSetByte(buf, 6, 48)
    strings.bufSetByte(buf, 7, 59)
    strings.bufSetByte(buf, 8, 48)
    strings.bufSetByte(buf, 9, 113)
    strings.bufSetByte(buf, 10, 34)
    strings.bufSetByte(buf, 11, 49)
    strings.bufSetByte(buf, 12, 59)
    strings.bufSetByte(buf, 13, 49)
    strings.bufSetByte(buf, 14, 59)
    var pos: int = 15
    pos = pos + strings.bufSetInt(buf, pos, width)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, height)
    strings.bufSetByte(buf, pos, 114)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// sixelColor 定义 Sixel 调色板颜色
fn sixelColor(index int, r int, g int, b int) int {
    if shouldUseAdvanced() == 0 || supportsSixel() == -1 {
        ret -1
    }
    var buf: ptr = strings.bufNew(64)
    strings.bufSetByte(buf, 0, 35)
    var pos: int = 1
    pos = pos + strings.bufSetInt(buf, pos, index)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, 2)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, r)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, g)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, b)
    ret bufAndStr(buf, pos)
}

// sixelData 写入 Sixel 行数据
fn sixelData(data ptr, len int) int {
    if shouldUseAdvanced() == 0 || supportsSixel() == -1 {
        ret -1
    }
    ret syscall.write(STDOUT_FD, data, len)
}

// sixelRowEnd 结束一行 Sixel 数据
fn sixelRowEnd() int {
    if shouldUseAdvanced() == 0 || supportsSixel() == -1 {
        ret -1
    }
    var buf: ptr = strings.bufNew(4)
    strings.bufSetByte(buf, 0, 36)
    strings.bufSetByte(buf, 1, 10)
    ret bufAndStr(buf, 2)
}

// sixelEnd 结束 Sixel 图像数据（发送 ST 终止序列）
fn sixelEnd() int {
    if shouldUseAdvanced() == 0 || supportsSixel() == -1 {
        ret -1
    }
    var buf: ptr = strings.bufNew(4)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 92)
    ret bufAndStr(buf, 2)
}

// sixelDisplay 显示 Sixel 图像（完整流程：begin + data + end）
fn sixelDisplay(width int, height int, data ptr, len int) int {
    if shouldUseAdvanced() == 0 || supportsSixel() == -1 {
        ret -1
    }
    var r1: int = sixelBegin(width, height, 0)
    var r2: int = sixelData(data, len)
    var r3: int = sixelEnd()
    ret r1 + r2 + r3
}

fn sixelClear() int {
    ret clearScreen()
}
