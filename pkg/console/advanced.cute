// pkg/console/advanced.cute - 高级终端控制 API
// 基于 ANSI/VT100 转义序列，支持颜色、字体样式、光标控制、终端控制和 Sixel 图形
// 平台无关，通过 syscall.write 输出转义序列
// 所有字节缓冲区操作通过 strings 包的 builder 函数完成

// ===== 常量 =====
const ESC: int = 27
const STDOUT_FD: int = 1

// 标准颜色（ANSI 30-37 / 40-47）
const COLOR_BLACK: int = 0
const COLOR_RED: int = 1
const COLOR_GREEN: int = 2
const COLOR_YELLOW: int = 3
const COLOR_BLUE: int = 4
const COLOR_MAGENTA: int = 5
const COLOR_CYAN: int = 6
const COLOR_WHITE: int = 7

// 亮色（ANSI 90-97 / 100-107）
const COLOR_BRIGHT_BLACK: int = 8
const COLOR_BRIGHT_RED: int = 9
const COLOR_BRIGHT_GREEN: int = 10
const COLOR_BRIGHT_YELLOW: int = 11
const COLOR_BRIGHT_BLUE: int = 12
const COLOR_BRIGHT_MAGENTA: int = 13
const COLOR_BRIGHT_CYAN: int = 14
const COLOR_BRIGHT_WHITE: int = 15

// SGR 样式代码
const STYLE_BOLD: int = 1
const STYLE_DIM: int = 2
const STYLE_ITALIC: int = 3
const STYLE_UNDERLINE: int = 4
const STYLE_BLINK: int = 5
const STYLE_REVERSE: int = 7
const STYLE_HIDDEN: int = 8
const STYLE_STRIKETHROUGH: int = 9

// 光标方向
const CURSOR_UP: int = 65
const CURSOR_DOWN: int = 66
const CURSOR_RIGHT: int = 67
const CURSOR_LEFT: int = 68

// ===== 内部辅助 =====

// writeStr 向 stdout 写入字符串
fn writeStr(s string) int {
    ret syscall.write(STDOUT_FD, strings.toCstring(s), strings.len(s))
}

// bufAndStr 构建字符串并输出，释放缓冲区
fn bufAndStr(buf ptr, pos int) int {
    var s: string = strings.bufToString(buf, pos)
    ret writeStr(s)
}

// writeEsc2Param 写入 ESC[<p1>;<p2><ch> 格式的转义序列
fn writeEsc2Param(p1 int, p2 int, ch int) int {
    var buf: ptr = strings.bufNew(32)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    var pos: int = 2
    pos = pos + strings.bufSetInt(buf, pos, p1)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, p2)
    strings.bufSetByte(buf, pos, ch)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// writeEsc1Param 写入 ESC[<n><ch> 格式的转义序列
fn writeEsc1Param(n int, ch int) int {
    var buf: ptr = strings.bufNew(32)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    var pos: int = 2
    pos = pos + strings.bufSetInt(buf, pos, n)
    strings.bufSetByte(buf, pos, ch)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// writeEscCSI 写入 ESC[<suffix> 格式的转义序列（无参数）
fn writeEscCSI(suffix int) int {
    var buf: ptr = strings.bufNew(8)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    strings.bufSetByte(buf, 2, suffix)
    ret bufAndStr(buf, 3)
}

// writeEscParamCSIPrefix 写入 ESC[?<n><suffix> 格式的转义序列
fn writeEscParamCSI(question int, n int, suffix int) int {
    var buf: ptr = strings.bufNew(32)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    var pos: int = 2
    if question == 1 {
        strings.bufSetByte(buf, pos, 63)
        pos = pos + 1
    }
    pos = pos + strings.bufSetInt(buf, pos, n)
    strings.bufSetByte(buf, pos, suffix)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// ===== 颜色 API =====

// rgbToAnsi256 将 RGB 转换为 256 色 ANSI 码（简化版：映射到 16 色）
fn rgbToAnsi256(r int, g int, b int) int {
    if r > 200 {
        if g > 200 {
            ret 11
        }
        if b > 200 {
            ret 13
        }
        ret 1
    }
    if g > 200 {
        ret 2
    }
    if b > 200 {
        ret 4
    }
    if r > 100 {
        if g > 100 {
            ret 3
        }
        ret 9
    }
    if g > 100 {
        ret 10
    }
    if b > 100 {
        ret 12
    }
    ret 7
}

// setFg 设置前景色（标准色 0-7，亮色 8-15）
fn setFg(color int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    ret writeEsc1Param(30 + color, 109)
}

// setBg 设置背景色（标准色 0-7，亮色 8-15）
fn setBg(color int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    ret writeEsc1Param(40 + color, 109)
}

// setFgBright 设置亮前景色（等效于 setFg(8+n)）
fn setFgBright(color int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    ret writeEsc1Param(90 + color, 109)
}

// setBgBright 设置亮背景色（等效于 setBg(8+n)）
fn setBgBright(color int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    ret writeEsc1Param(100 + color, 109)
}

// setFg256 使用 256 色调色板设置前景色
fn setFg256(color int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    if supports256Color() == -1 {
        var c16: int = color
        if c16 > 15 {
            c16 = c16 % 16
        }
        if c16 >= 8 {
            ret setFgBright(c16 - 8)
        }
        ret setFg(c16)
    }
    var buf: ptr = strings.bufNew(32)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    strings.bufSetByte(buf, 2, 51)
    strings.bufSetByte(buf, 3, 56)
    strings.bufSetByte(buf, 4, 59)
    strings.bufSetByte(buf, 5, 53)
    strings.bufSetByte(buf, 6, 59)
    var pos: int = 7
    pos = pos + strings.bufSetInt(buf, pos, color)
    strings.bufSetByte(buf, pos, 109)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// setBg256 使用 256 色调色板设置背景色
fn setBg256(color int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    if supports256Color() == -1 {
        var c16: int = color
        if c16 > 15 {
            c16 = c16 % 16
        }
        if c16 >= 8 {
            ret setBgBright(c16 - 8)
        }
        ret setBg(c16)
    }
    var buf: ptr = strings.bufNew(32)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    strings.bufSetByte(buf, 2, 52)
    strings.bufSetByte(buf, 3, 56)
    strings.bufSetByte(buf, 4, 59)
    strings.bufSetByte(buf, 5, 53)
    strings.bufSetByte(buf, 6, 59)
    var pos: int = 7
    pos = pos + strings.bufSetInt(buf, pos, color)
    strings.bufSetByte(buf, pos, 109)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// setFgRGB 使用 TrueColor (24-bit) 设置前景色
fn setFgRGB(r int, g int, b int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    if supportsTrueColor() == -1 {
        var idx: int = rgbToAnsi256(r, g, b)
        ret setFg256(idx)
    }
    var buf: ptr = strings.bufNew(48)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    strings.bufSetByte(buf, 2, 51)
    strings.bufSetByte(buf, 3, 56)
    strings.bufSetByte(buf, 4, 59)
    strings.bufSetByte(buf, 5, 50)
    strings.bufSetByte(buf, 6, 59)
    var pos: int = 7
    pos = pos + strings.bufSetInt(buf, pos, r)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, g)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, b)
    strings.bufSetByte(buf, pos, 109)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// setBgRGB 使用 TrueColor (24-bit) 设置背景色
fn setBgRGB(r int, g int, b int) int {
    if shouldUseAdvanced() == 0 {
        ret 0
    }
    if supportsTrueColor() == -1 {
        var idx: int = rgbToAnsi256(r, g, b)
        ret setBg256(idx)
    }
    var buf: ptr = strings.bufNew(48)
    strings.bufSetByte(buf, 0, ESC)
    strings.bufSetByte(buf, 1, 91)
    strings.bufSetByte(buf, 2, 52)
    strings.bufSetByte(buf, 3, 56)
    strings.bufSetByte(buf, 4, 59)
    strings.bufSetByte(buf, 5, 50)
    strings.bufSetByte(buf, 6, 59)
    var pos: int = 7
    pos = pos + strings.bufSetInt(buf, pos, r)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, g)
    strings.bufSetByte(buf, pos, 59)
    pos = pos + 1
    pos = pos + strings.bufSetInt(buf, pos, b)
    strings.bufSetByte(buf, pos, 109)
    pos = pos + 1
    ret bufAndStr(buf, pos)
}

// resetColor 重置所有颜色和样式为默认
fn resetColor() int {
    ret writeEsc1Param(48, 109)
}

// ===== 字体样式 API =====

fn setBold() int {
    ret writeEsc1Param(1, 109)
}

fn clearBold() int {
    ret writeEsc1Param(22, 109)
}

fn setDim() int {
    ret writeEsc1Param(2, 109)
}

fn clearDim() int {
    ret writeEsc1Param(22, 109)
}

fn setItalic() int {
    ret writeEsc1Param(3, 109)
}

fn clearItalic() int {
    ret writeEsc1Param(23, 109)
}

fn setUnderline() int {
    ret writeEsc1Param(4, 109)
}

fn clearUnderline() int {
    ret writeEsc1Param(24, 109)
}

fn setBlink() int {
    ret writeEsc1Param(5, 109)
}

fn clearBlink() int {
    ret writeEsc1Param(25, 109)
}

fn setReverse() int {
    ret writeEsc1Param(7, 109)
}

fn clearReverse() int {
    ret writeEsc1Param(27, 109)
}

fn setHidden() int {
    ret writeEsc1Param(8, 109)
}

fn clearHidden() int {
    ret writeEsc1Param(28, 109)
}

fn setStrikethrough() int {
    ret writeEsc1Param(9, 109)
