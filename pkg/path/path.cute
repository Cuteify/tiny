// pkg/path/path.cute - 路径操作库：纯字符串 manipulation
// 平台无关实现，不依赖 syscall

// isSlash 判断字节是否为斜杠 (/)
fn isSlash(ch: uint) bool {
    ret ch == 47
}

// lastSlash 返回 s 中最后一个 '/' 的位置，没有则返回 -1
fn lastSlash(s string) int {
    var sPtr: ptr = strings.toCstring(s)
    var sLen: uint = strings.len(s)
    var i: uint = sLen
    for i > 0 {
        i = i - 1
        var _p1: *u8 = sPtr + i
        if *_p1 == 47 {
            ret i
        }
    }
    ret 0 - 1
}

// firstSlash 返回 s 中第一个 '/' 的位置，没有则返回 -1
fn firstSlash(s string) int {
    var sPtr: ptr = strings.toCstring(s)
    var sLen: uint = strings.len(s)
    var i: uint = 0
    for ; i < sLen; {
        var _p2: *u8 = sPtr + i
        if *_p2 == 47 {
            ret i
        }
        i = i + 1
    }
    ret 0 - 1
}

// isAbs 判断路径是否为绝对路径（以 '/' 开头）
fn isAbs(path string) bool {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret false
    }
    var sPtr: ptr = strings.toCstring(path)
    var _p3: *u8 = sPtr
    ret *_p3 == 47
}

// base 返回路径最后一个元素
fn base(path string) string {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret "."
    }
    // 去除尾部斜杠
    var end: uint = sLen
    var sPtr: ptr = strings.toCstring(path)
    for ; end > 0; {
        var _p4: *u8 = sPtr + end - 1
        if *_p4 != 47 {
            break
        }
        end = end - 1
    }
    if end == 0 {
        ret "/"
    }
    // 找最后一个斜杠
    var last: int = 0 - 1
    var i: uint = end
    for ; i > 0; {
        i = i - 1
        var _p5: *u8 = sPtr + i
        if *_p5 == 47 {
            last = i
            break
        }
    }
    var start: uint = 0
    if last >= 0 {
        start = last + 1
    }
    var baseLen: uint = end - start
    var buf: ptr = memory.malloc(baseLen + 1)
    var k: uint = 0
    for ; k < baseLen; {
        var _p6: *u8 = buf + k
        var _p7: *u8 = sPtr + start + k
        *_p6 = unsafe.cast[u8](*_p7)
        k = k + 1
    }
    var _p8: *u8 = buf + baseLen
    *_p8 = unsafe.cast[u8](0)
    ret strings.makeString(buf, baseLen, baseLen)
}

// dir 返回路径的目录部分（最后一个斜杠之前的部分）
fn dir(path string) string {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret "."
    }
    var sPtr: ptr = strings.toCstring(path)
    // 去除尾部斜杠
    var end: uint = sLen
    for ; end > 0; {
        var _p9: *u8 = sPtr + end - 1
        if *_p9 != 47 {
            break
        }
        end = end - 1
    }
    if end == 0 {
        // 全是斜杠或空
        if sLen > 0 {
            ret "/"
        }
        ret "."
    }
    // 找最后一个斜杠
    var last: int = 0 - 1
    var i: uint = end
    for ; i > 0; {
        i = i - 1
        var _p10: *u8 = sPtr + i
        if *_p10 == 47 {
            last = i
            break
        }
    }
    if last < 0 {
        // 没有斜杠，返回 "."
        ret "."
    }
    // 跳过连续斜杠
    var dirEnd: uint = last
    for ; dirEnd > 0; {
        var _p11: *u8 = sPtr + dirEnd - 1
        if *_p11 != 47 {
            break
        }
        dirEnd = dirEnd - 1
    }
    if dirEnd == 0 {
        ret "/"
    }
    var dirLen: uint = dirEnd
    var buf: ptr = memory.malloc(dirLen + 1)
    var k: uint = 0
    for ; k < dirLen; {
        var _p12: *u8 = buf + k
        var _p13: *u8 = sPtr + k
        *_p12 = unsafe.cast[u8](*_p13)
        k = k + 1
    }
    var _p14: *u8 = buf + dirLen
    *_p14 = unsafe.cast[u8](0)
    ret strings.makeString(buf, dirLen, dirLen)
}

// ext 返回文件扩展名（包含 '.'），没有扩展名返回空字符串
fn ext(path string) string {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret ""
    }
    var sPtr: ptr = strings.toCstring(path)
    // 找到最后一个 '.'
    var lastDot: int = 0 - 1
    var lastSlashPos: int = 0 - 1
    var i: uint = 0
    for ; i < sLen; {
        var _p15: *u8 = sPtr + i
        var ch: uint = *_p15
        if ch == 46 {
            lastDot = i
        }
        if ch == 47 {
            lastSlashPos = i
        }
        i = i + 1
    }
    // 只有当 '.' 在最后一个 '/' 之后才认为是扩展名
    if lastDot >= 0 && lastDot > lastSlashPos {
        // 不要返回空扩展名（如 "file." 返回 ""）
        var extStart: uint = lastDot
        var extLen: uint = sLen - extStart
        var buf: ptr = memory.malloc(extLen + 1)
        var k: uint = 0
        for ; k < extLen; {
            var _p16: *u8 = buf + k
            var _p17: *u8 = sPtr + extStart + k
            *_p16 = unsafe.cast[u8](*_p17)
            k = k + 1
        }
        var _p18: *u8 = buf + extLen
        *_p18 = unsafe.cast[u8](0)
        ret strings.makeString(buf, extLen, extLen)
    }
    ret ""
}

// split 将路径拆分为目录和文件两部分
fn split(path string) (string, string) {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        return ".", "."
    }
    var sPtr: ptr = strings.toCstring(path)
    // 找最后一个斜杠
    var last: int = 0 - 1
    var i: uint = sLen
    for ; i > 0; {
        i = i - 1
        var _p19: *u8 = sPtr + i
        if *_p19 == 47 {
            last = i
            break
        }
    }
    if last < 0 {
        return ".", path
    }
    // 目录部分
    var dirPart: string
    if last == 0 {
        dirPart = "/"
    } else {
        var dirLen: uint = last
        var dirBuf: ptr = memory.malloc(dirLen + 1)
        var k: uint = 0
        for ; k < dirLen; {
            var _p20: *u8 = dirBuf + k
            var _p21: *u8 = sPtr + k
            *_p20 = unsafe.cast[u8](*_p21)
            k = k + 1
        }
        var _p22: *u8 = dirBuf + dirLen
        *_p22 = unsafe.cast[u8](0)
        dirPart = strings.makeString(dirBuf, dirLen, dirLen)
    }
    // 文件部分
    var fileLen: uint = sLen - last - 1
    if fileLen == 0 {
        return dirPart, ""
    }
    var fileBuf: ptr = memory.malloc(fileLen + 1)
    var k: uint = 0
    for ; k < fileLen; {
        var _p23: *u8 = fileBuf + k
        var _p24: *u8 = sPtr + last + 1 + k
        *_p23 = unsafe.cast[u8](*_p24)
        k = k + 1
    }
    var _p25: *u8 = fileBuf + fileLen
    *_p25 = unsafe.cast[u8](0)
    var filePart: string = strings.makeString(fileBuf, fileLen, fileLen)
    return dirPart, filePart
}

// clean 清理路径：去除多余斜杠、处理 "." 和 ".."
fn clean(path string) string {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret "."
    }
    var sPtr: ptr = strings.toCstring(path)

    // 简化实现：去掉连续斜杠、去掉末尾斜杠（根目录除外）
    var buf: ptr = memory.malloc(sLen + 1)
    var dst: uint = 0
    var src: uint = 0
    var prevWasSlash: bool = false

    // 处理绝对路径
    var _p26: *u8 = sPtr
    var isAbsolute: bool = *_p26 == 47

    for ; src < sLen; {
        var _p27: *u8 = sPtr + src
        var ch: uint = *_p27
        if ch == 47 {
            if !prevWasSlash {
                // 跳过可能的 "." 和 ".."
                var _p28: *u8 = buf + dst
                *_p28 = unsafe.cast[u8](47)
                dst = dst + 1
                prevWasSlash = true
            }
            src = src + 1
        } else {
            prevWasSlash = false
            var _p29: *u8 = buf + dst
            *_p29 = unsafe.cast[u8](ch)
            dst = dst + 1
            src = src + 1
        }
    }

    // 去掉末尾斜杠（根目录除外）
    var _p30: *u8 = buf + dst - 1
    if dst > 1 && *_p30 == 47 {
        if !(isAbsolute && dst == 1) {
            dst = dst - 1
        }
    }

    // 特殊情况：空字符串返回 "."
    if dst == 0 {
        if isAbsolute {
            var _p31: *u8 = buf
            *_p31 = unsafe.cast[u8](47)
            ret strings.makeString(buf, 1, 1)
        }
        var _p32: *u8 = buf
        *_p32 = unsafe.cast[u8](46)
        var _p33: *u8 = buf + 1
        *_p33 = unsafe.cast[u8](0)
        ret strings.makeString(buf, 1, 1)
    }

    var _p34: *u8 = buf + dst
    *_p34 = unsafe.cast[u8](0)
    ret strings.makeString(buf, dst, dst)
}

// join 连接两个路径元素
fn join(elem1 string, elem2 string) string {
    var len1: uint = strings.len(elem1)
    var len2: uint = strings.len(elem2)

    if len1 == 0 {
        ret elem2
    }
    if len2 == 0 {
        ret elem1
    }

    // 如果第二个是绝对路径，直接返回第二个
    if isAbs(elem2) {
        ret elem2
    }

    // 检查 elem1 末尾是否有斜杠
    var sPtr1: ptr = strings.toCstring(elem1)
    var _p35: *u8 = sPtr1 + len1 - 1
    var lastCh1: uint = *_p35

    if lastCh1 == 47 {
        // elem1 以斜杠结尾，直接拼接
        var totalLen: uint = len1 + len2
        var buf: ptr = memory.malloc(totalLen + 1)
        var k: uint = 0
        for ; k < len1; {
            var _p36: *u8 = buf + k
            var _p37: *u8 = sPtr1 + k
            *_p36 = unsafe.cast[u8](*_p37)
            k = k + 1
        }
        var sPtr2: ptr = strings.toCstring(elem2)
        k = 0
        for ; k < len2; {
            var _p38: *u8 = buf + len1 + k
            var _p39: *u8 = sPtr2 + k
            *_p38 = unsafe.cast[u8](*_p39)
            k = k + 1
        }
        var _p40: *u8 = buf + totalLen
        *_p40 = unsafe.cast[u8](0)
        ret strings.makeString(buf, totalLen, totalLen)
    }

    // 需要加一个斜杠
    var totalLen: uint = len1 + 1 + len2
    var buf: ptr = memory.malloc(totalLen + 1)
    var k: uint = 0
    for ; k < len1; {
        var _p41: *u8 = buf + k
        var _p42: *u8 = sPtr1 + k
        *_p41 = unsafe.cast[u8](*_p42)
        k = k + 1
    }
    var _p43: *u8 = buf + len1
    *_p43 = unsafe.cast[u8](47)
    var sPtr2: ptr = strings.toCstring(elem2)
    k = 0
    for ; k < len2; {
        var _p44: *u8 = buf + len1 + 1 + k
        var _p45: *u8 = sPtr2 + k
        *_p44 = unsafe.cast[u8](*_p45)
        k = k + 1
    }
    var _p46: *u8 = buf + totalLen
    *_p46 = unsafe.cast[u8](0)
    ret strings.makeString(buf, totalLen, totalLen)
}

// ============================================================
// filepath 功能（合并到 path 包）
// ============================================================

// separator 返回操作系统路径分隔符
fn separator() byte {
    ret 47  // '/'
}

// listSeparator 返回操作系统路径列表分隔符
fn listSeparator() byte {
    ret 58  // ':'
}

// volumeName 返回路径中的卷名（Linux 上始终为空）
fn volumeName(path string) string {
    ret ""
}

// volumeNameLen 返回卷名长度（Linux 上为 0）
fn volumeNameLen(path string) int {
    ret 0
}

// isLocal 判断路径是否为本地路径（不以 '/' 开头且不包含 ".."）
fn isLocal(path string) bool {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret true
    }
    var sPtr: ptr = strings.toCstring(path)
    // 不能以 '/' 开头
    var _p47: *u8 = sPtr
    if *_p47 == 47 {
        ret false
    }
    // 不能包含 ".."
    var i: uint = 0
    for ; i < sLen; {
        if i + 1 < sLen {
            var _p48: *u8 = sPtr + i
            var _p49: *u8 = sPtr + i + 1
            if *_p48 == 46 && *_p49 == 46 {
                // 检查是否是独立的 ".." 组件
                var _p50: *u8 = sPtr + i - 1
                if i == 0 || *_p50 == 47 {
                    var _p51: *u8 = sPtr + i + 2
                    if i + 2 >= sLen || *_p51 == 47 {
                        ret false
                    }
                }
            }
        }
        i = i + 1
    }
    ret true
}

// localize 将路径转换为本地路径（去除开头的 "/"）
fn localize(path string) string {
    var sLen: uint = strings.len(path)
    if sLen == 0 {
        ret path
    }
    var sPtr: ptr = strings.toCstring(path)
    var _p52: *u8 = sPtr
    if *_p52 != 47 {
        ret path
    }
    // 去掉开头的 '/'
    var newLen: uint = sLen - 1
    var buf: ptr = memory.malloc(newLen + 1)
    var i: uint = 0
    for ; i < newLen; {
        var _p53: *u8 = buf + i
        var _p54: *u8 = sPtr + 1 + i
        *_p53 = unsafe.cast[u8](*_p54)
        i = i + 1
    }
    var _p55: *u8 = buf + newLen
    *_p55 = unsafe.cast[u8](0)
    ret strings.makeString(buf, newLen, newLen)
}

// abs 获取绝对路径（通过 getcwd 获取当前目录并拼接）
fn abs(path string) string {
    // 如果已经是绝对路径，直接清理后返回
    if isAbs(path) {
        ret clean(path)
    }
    // 获取当前工作目录
    var cwdBuf: ptr = memory.malloc(4096)
    var result: ptr = syscall.getcwd(cwdBuf, 4096)
    if result == 0 {
        memory.free(cwdBuf)
        ret path
    }
    // 计算 cwd 长度
    var cwdLen: uint = 0
    var _p56: *u8 = result + cwdLen
    for ; *_p56 != 0; {
        cwdLen = cwdLen + 1
    }
    // 拼接 cwd + "/" + path
    var pathLen: uint = strings.len(path)
    var totalLen: uint = cwdLen + 1 + pathLen
    var buf: ptr = memory.malloc(totalLen + 1)
    var i: uint = 0
    for ; i < cwdLen; {
        var _p57: *u8 = buf + i
        var _p58: *u8 = result + i
        *_p57 = unsafe.cast[u8](*_p58)
        i = i + 1
    }
    var _p59: *u8 = buf + cwdLen
    *_p59 = unsafe.cast[u8](47  // '/')
    i = 0
    for ; i < pathLen; {
        var _p60: *u8 = buf + cwdLen + 1 + i
        var _p61: *u8 = strings.toCstring(path) + i
        *_p60 = unsafe.cast[u8](*_p61)
        i = i + 1
    }
    var _p62: *u8 = buf + totalLen
    *_p62 = unsafe.cast[u8](0)
    var joined: string = strings.makeString(buf, totalLen, totalLen)
    memory.free(cwdBuf)
    ret clean(joined)
}

// rel 计算从 basePath 到 targetPath 的相对路径
fn rel(basePath string, targetPath string) string {
    var baseClean: string = clean(basePath)
    var targetClean: string = clean(targetPath)

    // 如果相同，返回 "."
    if strings.eq(baseClean, targetClean) {
        ret "."
    }

    var basePtr: ptr = strings.toCstring(baseClean)
    var baseLen: uint = strings.len(baseClean)
    var targetPtr: ptr = strings.toCstring(targetClean)
    var targetLen: uint = strings.len(targetClean)

    // 找到共同前缀
    var commonLen: uint = 0
    var maxLen: uint = baseLen
    if targetLen < baseLen {
        maxLen = targetLen
    }
    var i: uint = 0
    for ; i < maxLen; {
        var _p63: *u8 = basePtr + i
        var _p64: *u8 = targetPtr + i
        if *_p63 != *_p64 {
            break
        }
        // 确保在斜杠处截断
        var _p65: *u8 = basePtr + i
        if *_p65 == 47 {
            commonLen = i
        }
        i = i + 1
    }
    // 处理完全匹配的情况
    if commonLen == 0 && i == maxLen {
        if baseLen == targetLen {
            commonLen = baseLen
        var _p66: *u8 = targetPtr + i
        } else if i == baseLen && *_p66 == 47 {
            commonLen = baseLen
        var _p67: *u8 = basePtr + i
        } else if i == targetLen && *_p67 == 47 {
            commonLen = targetLen
        }
    } else if i == maxLen && (baseLen == maxLen || targetLen == maxLen) {
        commonLen = maxLen
    }

    // 计算 basePath 中需要向上走的层数
    var upCount: uint = 0
    var pos: uint = commonLen
    var _p68: *u8 = basePtr + pos
    if pos < baseLen && *_p68 == 47 {
        pos = pos + 1
    }
    for ; pos < baseLen; {
        var _p69: *u8 = basePtr + pos
        if *_p69 == 47 {
            upCount = upCount + 1
        }
        pos = pos + 1
    }
    // 如果 basePath 在共同前缀后还有内容，多算一层
    var _p70: *u8 = basePtr + commonLen
    if commonLen < baseLen && *_p70 != 47 {
        // 共同前缀不在斜杠边界
        if commonLen > 0 {
            upCount = upCount + 1
        }
    }

    // 构建结果：N 个 ".." + 剩余的 target 路径
    var resultParts: string = ""
    var hasContent: bool = false

    // 添加 ".." 部分
    var u: uint = 0
    for ; u < upCount; {
        if hasContent {
            // 添加 "/"
            var newLen: uint = strings.len(resultParts) + 1
            var buf: ptr = memory.malloc(newLen + 1)
            var rPtr: ptr = strings.toCstring(resultParts)
            var k: uint = 0
            for ; k < strings.len(resultParts); {
                var _p71: *u8 = buf + k
                var _p72: *u8 = rPtr + k
                *_p71 = unsafe.cast[u8](*_p72)
                k = k + 1
            }
            var _p73: *u8 = buf + strings.len(resultParts)
            *_p73 = unsafe.cast[u8](47)
            var _p74: *u8 = buf + newLen
            *_p74 = unsafe.cast[u8](0)
            resultParts = strings.makeString(buf, newLen, newLen)
        }
        // 添加 ".."
        var dotDot: string = ".."
        var ddPtr: ptr = strings.toCstring(dotDot)
        var prevLen: uint = strings.len(resultParts)
        var newLen: uint = prevLen + 2
        var buf: ptr = memory.malloc(newLen + 1)
        var k: uint = 0
        if prevLen > 0 {
            var rPtr: ptr = strings.toCstring(resultParts)
            for ; k < prevLen; {
                var _p75: *u8 = buf + k
                var _p76: *u8 = rPtr + k
                *_p75 = unsafe.cast[u8](*_p76)
                k = k + 1
            }
        }
        var _p77: *u8 = buf + prevLen
        *_p77 = unsafe.cast[u8](46)
        var _p78: *u8 = buf + prevLen + 1
        *_p78 = unsafe.cast[u8](46)
        var _p79: *u8 = buf + newLen
        *_p79 = unsafe.cast[u8](0)
        resultParts = strings.makeString(buf, newLen, newLen)
        hasContent = true
        u = u + 1
    }

    // 添加 target 的剩余部分
    var targetStart: uint = commonLen
    var _p80: *u8 = targetPtr + targetStart
    if targetStart < targetLen && *_p80 == 47 {
        targetStart = targetStart + 1
    }
    var remaining: uint = targetLen - targetStart
    if remaining > 0 {
        if hasContent {
            // 添加 "/"
            var prevLen: uint = strings.len(resultParts)
            var newLen: uint = prevLen + 1
            var buf: ptr = memory.malloc(newLen + 1)
            var rPtr: ptr = strings.toCstring(resultParts)
            var k: uint = 0
            for ; k < prevLen; {
                var _p81: *u8 = buf + k
                var _p82: *u8 = rPtr + k
                *_p81 = unsafe.cast[u8](*_p82)
                k = k + 1
            }
            var _p83: *u8 = buf + prevLen
            *_p83 = unsafe.cast[u8](47)
            var _p84: *u8 = buf + newLen
            *_p84 = unsafe.cast[u8](0)
            resultParts = strings.makeString(buf, newLen, newLen)
        }
        var prevLen: uint = strings.len(resultParts)
        var newLen: uint = prevLen + remaining
        var buf: ptr = memory.malloc(newLen + 1)
        var k: uint = 0
        if prevLen > 0 {
            var rPtr: ptr = strings.toCstring(resultParts)
            for ; k < prevLen; {
                var _p85: *u8 = buf + k
                var _p86: *u8 = rPtr + k
                *_p85 = unsafe.cast[u8](*_p86)
                k = k + 1
            }
        }
        k = 0
        for ; k < remaining; {
            var _p87: *u8 = buf + prevLen + k
            var _p88: *u8 = targetPtr + targetStart + k
            *_p87 = unsafe.cast[u8](*_p88)
            k = k + 1
        }
        var _p89: *u8 = buf + newLen
        *_p89 = unsafe.cast[u8](0)
        resultParts = strings.makeString(buf, newLen, newLen)
    }

    if !hasContent && remaining == 0 {
        ret "."
    }
    ret resultParts
}

// match 简单的 glob 模式匹配（支持 * 和 ?）
// * 匹配任意字符序列，? 匹配单个字符
fn match(pattern string, name string) bool {
    var pPtr: ptr = strings.toCstring(pattern)
    var pLen: uint = strings.len(pattern)
    var nPtr: ptr = strings.toCstring(name)
    var nLen: uint = strings.len(name)

    var pi: uint = 0
    var ni: uint = 0
    var starPi: uint = 0
    var starNi: uint = 0
    var starMatch: bool = false

    for ; ni < nLen; {
        // 模式未结束且当前字符匹配
        var _p90: *u8 = pPtr + pi
        var _p91: *u8 = nPtr + ni
        var _p92: *u8 = pPtr + pi
        if pi < pLen && (*_p90 == *_p91 || *_p92 == 63) {
            pi = pi + 1
            ni = ni + 1
        var _p93: *u8 = pPtr + pi
        } else if pi < pLen && *_p93 == 42 {
            // '*' — 记录位置，尝试匹配 0 个字符
            starPi = pi
            starNi = ni
            starMatch = true
            pi = pi + 1
        } else if starMatch {
            // 回退：让 '*' 多匹配一个字符
            ni = starNi + 1
            starNi = ni
            pi = starPi + 1
        } else {
            ret false
        }
    }

    // 消耗模式中剩余的 '*'
    var _p94: *u8 = pPtr + pi
    for ; pi < pLen && *_p94 == 42; {
        pi = pi + 1
    }

    ret pi == pLen
}

// glob 检查路径是否匹配 glob 模式（简化版本）
fn glob(pattern string, path string) bool {
    ret match(pattern, path)
}

// evalSymlinks 解析符号链接（简化版本，直接返回原路径）
fn evalSymlinks(path string) string {
    ret path
}

// joinMulti 连接三个路径元素
fn joinMulti(elem1 string, elem2 string, elem3 string) string {
    ret join(join(elem1, elem2), elem3)
}

// walk 遍历路径下的所有文件，对每个文件调用回调函数
// 简化实现：使用 getdents 系统调用读取目录
fn walk(path string, callback fn(string)) {
    var pathPtr: ptr = strings.toCstring(path)
    var fd: i32 = syscall.open(pathPtr, 0, 0)
    if fd < 0 {
        ret
    }

    // getdents 缓冲区
    var bufSize: uint = 4096
    var buf: ptr = memory.malloc(bufSize)

    for ; true; {
        var n: i32 = syscall.getdents(fd, buf, bufSize)
        if n <= 0 {
            break
        }

        var pos: uint = 0
        for ; pos < n; {
            // linux_dirent 结构: inode(8), offset(8), reclen(2), type(1), name(变长)
            var _p95: *u8 = buf + pos + 16
            var _p96: *u8 = buf + pos + 17
            var reclen: uint = *_p95 | (*_p96 << 8)
            var namePtr: ptr = buf + pos + 18

            // 跳过 "." 和 ".."
            var _p97: *u8 = namePtr
            var firstCh: uint = *_p97
            var _p98: *u8 = namePtr + 1
            var _p99: *u8 = namePtr + 1
            var _p100: *u8 = namePtr + 2
            if firstCh != 46 || (*_p98 != 0 && !(*_p99 == 46 && *_p100 == 0)) {
                // 计算文件名长度
                var nameLen: uint = 0
                var _p101: *u8 = namePtr + nameLen
                for ; *_p101 != 0; {
                    nameLen = nameLen + 1
                }
                // 构建完整路径
                var baseLen: uint = strings.len(path)
                var totalLen: uint = baseLen + 1 + nameLen
                var fullPath: ptr = memory.malloc(totalLen + 1)
                var k: uint = 0
                for ; k < baseLen; {
                    var _p102: *u8 = fullPath + k
                    var _p103: *u8 = pathPtr + k
                    *_p102 = unsafe.cast[u8](*_p103)
                    k = k + 1
                }
                var _p104: *u8 = fullPath + baseLen
                *_p104 = unsafe.cast[u8](47)
                k = 0
                for ; k < nameLen; {
                    var _p105: *u8 = fullPath + baseLen + 1 + k
                    var _p106: *u8 = namePtr + k
                    *_p105 = unsafe.cast[u8](*_p106)
                    k = k + 1
                }
                var _p107: *u8 = fullPath + totalLen
                *_p107 = unsafe.cast[u8](0)
                var fullPathStr: string = strings.makeString(fullPath, totalLen, totalLen)
                callback(fullPathStr)
            }

            pos = pos + reclen
        }
    }

    syscall.close(fd)
}
