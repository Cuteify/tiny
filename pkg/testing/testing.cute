import "std:memory"
import "std:strings"
// pkg/testing/testing.cute - 简化测试框架（Wave F 真实现）
// 平台无关实现，底层复用 std:memory 和 std:strings
// 缺陷⑨a 纪律：本包禁止 fn 类型形参形态（fn f fn(*T) 曾致 parser 死循环，
// import 本包即挂死 60s+——2026-10-31 实证），Run 已改形为 NewT。
//
// 计分双轨：
//   - 全局轨 assertEq/assertEqU/assertEqS：不等时 assertFailCnt +1（计数器
//     单点累加，无 stdout 噪声），farm 终值经 assertFailNum() 进 rc；
//   - T 上下文轨 assertEqT/assertEqUT/assertEqST：不等走 Fail/Error 计分
//     （failed 标记 @16 + errors 文本 @17）。

// T 测试上下文结构体（手工布局突变：failed 标记 @16 1B，errors 文本 @17 8B）
type T struct {
    name: string
    failed: bool
    errors: string
}

// assertFailCnt 全局轨失败计数（不等断言累加；BSS 零初始化）
var assertFailCnt: int = 0

// NewT 创建一个空 T 上下文（failed=false、errors=空），返回 *T
fn NewT(name string) *T {
    var t: ptr = memory.malloc(24)
    var _p1: *ptr = t
    *_p1 = strings.toCstring(name)
    var _p2: *u8 = t + 16
    *_p2 = unsafe.cast[u8](0)
    var _p3: *ptr = t + 17
    *_p3 = unsafe.cast[ptr](0)
    var tp: *T
    tp = unsafe.cast[*T](t)
    ret tp
}

// Fail 标记测试为失败
fn Fail(t *T) {
    var tp: ptr = unsafe.cast[ptr](t)
    var _p4: *u8 = tp + 16
    *_p4 = unsafe.cast[u8](1)
}

// _tgFailed 读 T 的 failed 标记
fn _tgFailed(t *T) bool {
    var tp: ptr = unsafe.cast[ptr](t)
    var _p5: *u8 = tp + 16
    ret *_p5 != 0
}

// _tgErr 读 T 的 errors 文本指针槽（@17）
fn _tgErr(t *T) ptr {
    var tp: ptr = unsafe.cast[ptr](t)
    var _p6: *ptr = tp + 17
    ret *_p6
}

// _tgSetErr 写 T 的 errors 文本指针槽（@17）
fn _tgSetErr(t *T, msg: string) {
    var tp: ptr = unsafe.cast[ptr](t)
    var _p7: *ptr = tp + 17
    *_p7 = unsafe.cast[ptr](msg)
}

// Error 记录一条错误消息（failed 置位 + errors 文本拼接累加，\n 空格分隔）
fn Error(t *T, msg string) {
    var tp: ptr = unsafe.cast[ptr](t)
    var _p8: *u8 = tp + 16
    *_p8 = unsafe.cast[u8](1)
    var oldErrP: ptr = _tgErr(t)
    var oldLen: uint = 0
    if oldErrP != 0 {
        var oldStr: string
        oldStr = unsafe.cast[string](_tgErr(t))
        oldLen = strings.len(oldStr)
    }
    var newLen: uint = strings.len(msg)
    var sep: uint = 0
    if oldLen > 0 {
        sep = 2
    }
    var totalLen: uint = oldLen + sep + newLen
    var buf: ptr = memory.malloc(totalLen + 1)
    var pos: uint = 0
    // 拷贝旧错误消息
    if oldLen > 0 {
        var oldPtr: ptr = strings.toCstring(unsafe.cast[string](oldErrP))
        var k: uint = 0
        for k < oldLen {
            var _p7: *u8 = buf + k
            var _p8: *u8 = oldPtr + k
            *_p7 = unsafe.cast[u8](*_p8)
            k = k + 1
        }
        pos = oldLen
        var _p9: *u8 = buf + pos
        *_p9 = unsafe.cast[u8](10)
        pos = pos + 1
        var _p10: *u8 = buf + pos
        *_p10 = unsafe.cast[u8](32)
        pos = pos + 1
    }
    // 拷贝新错误消息
    var newPtr: ptr = strings.toCstring(msg)
    var k2: uint = 0
    for k2 < newLen {
        var _p11: *u8 = buf + pos + k2
        var _p12: *u8 = newPtr + k2
        *_p11 = unsafe.cast[u8](*_p12)
        k2 = k2 + 1
    }
    pos = pos + newLen
    var _p13: *u8 = buf + pos
    *_p13 = unsafe.cast[u8](0)
    _tgSetErr(t, strings.makeString(buf, totalLen, totalLen))
}

// Equal 断言两个整数相等，不等则标记失败（T 轨 int 家族）
fn Equal(t *T, a int, b int) {
    if a != b {
        var msg: string = _mkNeq("expected ", a, b)
        Error(t, msg)
    }
}

// _mkNeq 拼接 "expected <a> got <b>" 消息（int 十进制）
fn _mkNeq(head string, a int, b int) string {
    var msgBuf: ptr = memory.malloc(128)
    var pos: uint = 0
    var hp: ptr = strings.toCstring(head)
    var hn: uint = strings.len(head)
    var k: uint = 0
    for k < hn {
        var _p15: *u8 = msgBuf + k
        var _p16: *u8 = hp + k
        *_p15 = unsafe.cast[u8](*_p16)
        k = k + 1
    }
    pos = hn
    // 期望值
    var aStr: string = strings.toString(a, 10)
    var ap: ptr = strings.toCstring(aStr)
    var an: uint = strings.len(aStr)
    k = 0
    for k < an {
        var _p17: *u8 = msgBuf + pos + k
        var _p18: *u8 = ap + k
        *_p17 = unsafe.cast[u8](*_p18)
        k = k + 1
    }
    pos = pos + an
    // " got "
    var gp: ptr = strings.toCstring(" got ")
    var gn: uint = strings.len(" got ")
    k = 0
    for k < gn {
        var _p19: *u8 = msgBuf + pos + k
        var _p20: *u8 = gp + k
        *_p19 = unsafe.cast[u8](*_p20)
        k = k + 1
    }
    pos = pos + gn
    // 实际值
    var bStr: string = strings.toString(b, 10)
    var bp: ptr = strings.toCstring(bStr)
    var bn: uint = strings.len(bStr)
    k = 0
    for k < bn {
        var _p21: *u8 = msgBuf + pos + k
        var _p22: *u8 = bp + k
        *_p21 = unsafe.cast[u8](*_p22)
        k = k + 1
    }
    pos = pos + bn
    var _p23: *u8 = msgBuf + pos
    *_p23 = unsafe.cast[u8](0)
    ret strings.makeString(msgBuf, pos, pos)
}

// EqualStr 断言两个字符串相等，不等则标记失败（T 轨 string 家族）
fn EqualStr(t *T, a string, b string) {
    var eq: int = _strEqWalk(a, b)
    if eq != 0 {
        var msgBuf: ptr = memory.malloc(280)
        var pos: uint = 0
        var pp: ptr = strings.toCstring("expected ")
        var pn: uint = strings.len("expected ")
        var k: uint = 0
        for k < pn {
            var _p24: *u8 = msgBuf + k
            var _p25: *u8 = pp + k
            *_p24 = unsafe.cast[u8](*_p25)
            k = k + 1
        }
        pos = pn
        var ap: ptr = strings.toCstring(a)
        var alen: uint = strings.len(a)
        k = 0
        for k < alen {
            var _p26: *u8 = msgBuf + pos + k
            var _p27: *u8 = ap + k
            *_p26 = unsafe.cast[u8](*_p27)
            k = k + 1
        }
        pos = pos + alen
        var mp: ptr = strings.toCstring(" got ")
        var mn: uint = strings.len(" got ")
        k = 0
        for k < mn {
            var _p28: *u8 = msgBuf + pos + k
            var _p29: *u8 = mp + k
            *_p28 = unsafe.cast[u8](*_p29)
            k = k + 1
        }
        pos = pos + mn
        var bp: ptr = strings.toCstring(b)
        k = 0
        for k < strings.len(b) {
            var _p30: *u8 = msgBuf + pos + k
            var _p31: *u8 = bp + k
            *_p30 = unsafe.cast[u8](*_p31)
            k = k + 1
        }
        pos = pos + strings.len(b)
        var _p32: *u8 = msgBuf + pos
        *_p32 = unsafe.cast[u8](34)
        pos = pos + 1
        var _p33: *u8 = msgBuf + pos
        *_p33 = unsafe.cast[u8](0)
        Error(t, strings.makeString(msgBuf, pos, pos))
    }
}

// _strEqWalk 逐字节比较两字符串：相等 0，不等 1
fn _strEqWalk(a string, b string) int {
    var aLen: uint = strings.len(a)
    var bLen: uint = strings.len(b)
    if aLen != bLen {
        ret 1
    }
    var ap: ptr = strings.toCstring(a)
    var bp: ptr = strings.toCstring(b)
    var i: uint = 0
    for i < aLen {
        var _pa: *u8 = ap + i
        var _pb: *u8 = bp + i
        if *_pa != *_pb {
            ret 1
        }
        i = i + 1
    }
    ret 0
}

// ————————— 全局轨 assertEq 家族（不等 → assertFailCnt 计数） —————————

// assertEq int 家族（切片长度/索引/计数值断言主形态）
fn assertEq(a: int, b: int) bool {
    if a != b {
        assertFailCnt = assertFailCnt + 1
        ret false
    }
    ret true
}

// assertEqU uint 家族（位宽/无符号计数值断言）
fn assertEqU(a: uint, b: uint) bool {
    if a != b {
        assertFailCnt = assertFailCnt + 1
        ret false
    }
    ret true
}

// assertEqS string 家族（逐字节相等 + 长度相等）
fn assertEqS(a: string, b: string) bool {
    if _strEqWalk(a, b) != 0 {
        assertFailCnt = assertFailCnt + 1
        ret false
    }
    ret true
}

// assertFailNum 读全局轨累计失败数（farm 终值计分口）
fn assertFailNum() int {
    ret assertFailCnt
}

// ————————— T 轨 assertEq 家族（不等走 Fail/Error 计分） —————————

// assertEqT T 轨 int 家族：不等复用 Equal（expected X got Y 计分到 T）
fn assertEqT(t *T, a: int, b: int) bool {
    if a != b {
        var msg: string = _mkNeq("expected ", a, b)
        Error(t, msg)
        ret false
    }
    ret true
}

// assertEqUT T 轨 uint 家族
fn assertEqUT(t *T, a: uint, b: uint) bool {
    if a != b {
        var msg: string = _mkNeq("expected ", unsafe.cast[int](a), unsafe.cast[int](b))
        Error(t, msg)
        ret false
    }
    ret true
}

// assertEqST T 轨 string 家族：不等复用 EqualStr 计分
fn assertEqST(t *T, a: string, b: string) bool {
    if _strEqWalk(a, b) != 0 {
        var msgBuf: ptr = memory.malloc(64)
        var pos: uint = 0
        var pp: ptr = strings.toCstring("expected strings equal, got diff")
        var pn: uint = strings.len("expected strings equal, got diff")
        var i: uint = 0
        for i < pn {
            var _p34: *u8 = msgBuf + i
            var _p35: *u8 = pp + i
            *_p34 = unsafe.cast[u8](*_p35)
            i = i + 1
        }
        pos = pn
        var _p36: *u8 = msgBuf + pos
        *_p36 = unsafe.cast[u8](0)
        Error(t, strings.makeString(msgBuf, pos, pos))
        ret false
    }
    ret true
}

// Passed 返回测试是否通过（未标记失败）
fn Passed(t *T) bool {
    return !_tgFailed(t)
}
