import "std:syscall"
import "std:strings"
import "std:memory"
// pkg/log/log.cute - 日志库：输出到 stdout 和 stderr
// 平台无关实现，底层复用 std:syscall

const STDOUT: i32 = 1
const STDERR: i32 = 2

// log 打印消息到标准输出并换行
fn log(msg: string) {
    var c1: uint = strings.toCstring(msg)
    syscall.write(STDOUT, unsafe.cast[ptr](c1), strings.len(msg))
    memory.free(unsafe.cast[ptr](c1))
    var c2: uint = strings.toCstring("\n")
    syscall.write(STDOUT, unsafe.cast[ptr](c2), 1)
    memory.free(unsafe.cast[ptr](c2))
}

// logError 打印消息到标准错误并换行
fn logError(msg: string) {
    var c1: uint = strings.toCstring(msg)
    syscall.write(STDERR, unsafe.cast[ptr](c1), strings.len(msg))
    memory.free(unsafe.cast[ptr](c1))
    var c2: uint = strings.toCstring("\n")
    syscall.write(STDERR, unsafe.cast[ptr](c2), 1)
    memory.free(unsafe.cast[ptr](c2))
}
