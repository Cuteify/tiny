// pkg/encoding/asn1/asn1.cute - ASN.1 DER 编码存根
// 平台无关实现，提供基本的整数和字符串 DER 编码

// marshalInt 将整数编码为 ASN.1 DER INTEGER 格式
// 格式: tag(02) + length + value bytes
// 支持正整数和负整数（二进制补码）
fn marshalInt(v int) string {
    var buf: ptr = memory.malloc(64)
    // tag = 0x02 (INTEGER)
    var _p1: *u8 = buf
    *_p1 = unsafe.cast[u8](2)
    // 编码值为字节序列
    var valBuf: ptr = memory.malloc(32)
    var valLen: int = 0
    var negative: bool = false
    var num: int = v
    if num < 0 {
        negative = true
        // 补码表示：取绝对值，取反加 1
        num = 0 - num
    }
    if num == 0 {
        var _p2: *u8 = valBuf
        *_p2 = unsafe.cast[u8](0)
        valLen = 1
    } else {
        // 提取字节
        var tmp: int = num
        var byteCount: int = 0
        for ; tmp > 0; {
            byteCount = byteCount + 1
            tmp = tmp / 256
        }
        // 检查是否需要前导零（最高位为 1 时需要）
        var extraByte: int = 0
        var highByte: int = num
        var shift: int = (byteCount - 1) * 8
        for ; shift > 0; {
            highByte = highByte / 256
            shift = shift - 8
        }
        if highByte > 127 {
            extraByte = 1
        }
        var totalBytes: int = byteCount + extraByte
        var i: int = 0
        for ; i < totalBytes; {
            var shiftAmount: int = (totalBytes - 1 - i) * 8
            var divisor: int = 1
            var s: int = 0
            for ; s < shiftAmount; {
                divisor = divisor * 256
                s = s + 1
            }
            var byteVal: int = num / divisor
            num = num % divisor
            if negative {
                byteVal = 255 - byteVal
            }
            var _p3: *u8 = valBuf + i
            *_p3 = unsafe.cast[u8](byteVal)
            i = i + 1
        }
        if negative {
            // 补码加 1
            var carry: int = 1
            var j: int = totalBytes - 1
            for ; j >= 0; {
                var _p4: *u8 = valBuf + j
                var b: int = *_p4 + carry
                var _p5: *u8 = valBuf + j
                *_p5 = unsafe.cast[u8](b & 255)
                carry = b / 256
                j = j - 1
            }
        }
        valLen = totalBytes
    }
    // 编码长度
    var lenBytes: int = 0
    if valLen < 128 {
        var _p6: *u8 = buf + 1
        *_p6 = unsafe.cast[u8](valLen)
        lenBytes = 1
    } else {
        // 长度编码
        var tmpLen: int = valLen
        var tmpLen2: int = 0
        for ; tmpLen > 0; {
            tmpLen2 = tmpLen2 + 1
            tmpLen = tmpLen / 256
        }
        var _p7: *u8 = buf + 1
        *_p7 = unsafe.cast[u8](128 + tmpLen2)
        var k: int = 0
        for ; k < tmpLen2; {
            var shiftAmount: int = (tmpLen2 - 1 - k) * 8
            var divisor: int = 1
            var s: int = 0
            for ; s < shiftAmount; {
                divisor = divisor * 256
                s = s + 1
            }
            var _p8: *u8 = buf + 2 + k
            *_p8 = unsafe.cast[u8](valLen / divisor)
            k = k + 1
        }
        lenBytes = 1 + tmpLen2
    }
    // 复制值到 buf
    var i: int = 0
    for ; i < valLen; {
        var _p9: *u8 = buf + 1 + lenBytes + i
        var _p10: *u8 = valBuf + i
        *_p9 = unsafe.cast[u8](*_p10)
        i = i + 1
    }
    var totalLen: int = 1 + lenBytes + valLen
    memory.free(valBuf)
    ret strings.makeString(buf, totalLen, totalLen)
}

// marshalString 将字符串编码为 ASN.1 DER UTF8String 格式
// 格式: tag(0C) + length + value bytes
fn marshalString(s string) string {
    var sPtr: ptr = strings.toCstring(s)
    var sLen: uint = strings.len(s)
    var buf: ptr = memory.malloc(sLen + 16)
    // tag = 0x0C (UTF8String)
    var _p11: *u8 = buf
    *_p11 = unsafe.cast[u8](12)
    // 编码长度
    var lenBytes: int = 0
    if sLen < 128 {
        var _p12: *u8 = buf + 1
        *_p12 = unsafe.cast[u8](sLen)
        lenBytes = 1
    } else {
        var tmpLen: uint = sLen
        var tmpLen2: int = 0
        for ; tmpLen > 0; {
            tmpLen2 = tmpLen2 + 1
            tmpLen = tmpLen / 256
        }
        var _p13: *u8 = buf + 1
        *_p13 = unsafe.cast[u8](128 + tmpLen2)
        var k: int = 0
        for ; k < tmpLen2; {
            var shiftAmount: int = (tmpLen2 - 1 - k) * 8
            var divisor: int = 1
            var s2: int = 0
            for ; s2 < shiftAmount; {
                divisor = divisor * 256
                s2 = s2 + 1
            }
            var _p14: *u8 = buf + 2 + k
            *_p14 = unsafe.cast[u8](sLen / divisor)
            k = k + 1
        }
        lenBytes = 1 + tmpLen2
    }
    // 复制字符串内容
    var i: uint = 0
    for ; i < sLen; {
        var _p15: *u8 = buf + 1 + lenBytes + i
        var _p16: *u8 = sPtr + i
        *_p15 = unsafe.cast[u8](*_p16)
        i = i + 1
    }
    var totalLen: int = 1 + lenBytes + sLen
    ret strings.makeString(buf, totalLen, totalLen)
}
