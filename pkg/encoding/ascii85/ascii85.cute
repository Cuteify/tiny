// pkg/encoding/ascii85/ascii85.cute - Ascii85 (Base85) 编码/解码
// 平台无关实现，遵循 btoa/atob 标准格式
// 编码使用 '!' (33) 到 'u' (117) 共 85 个字符

// ascii85Alphabet 存储 Ascii85 字符集
// 起始字符为 '!' (33)

// encode 将字节数据编码为 Ascii85 字符串
// 每 4 字节输入转换为 5 字符输出
// 格式: <~encoded data~>
fn encode(data string) string {
    var dataPtr: ptr = strings.toCstring(data)
    var dataLen: uint = strings.len(data)
    // 每 4 字节 -> 5 字符，加 <~ ~> 包装
    var groups: uint = dataLen / 4
    var remainder: uint = dataLen % 4
    var totalChars: uint = groups * 5
    if remainder > 0 {
        totalChars = totalChars + 5
    }
    // <~ (2) + chars + ~> (2)
    var buf: ptr = memory.malloc(totalChars + 5 + 1)
    // 写入起始标记
    var _p1: *u8 = buf
    *_p1 = unsafe.cast[u8](60    // '<')
    var _p2: *u8 = buf + 1
    *_p2 = unsafe.cast[u8](126 // '~')
    var outPos: uint = 2
    var i: uint = 0
    for ; i < dataLen; {
        // 取 4 字节组成 u32（大端序）
        var group: u32 = 0
        var bytesInGroup: uint = 4
        if i + 4 > dataLen {
            bytesInGroup = dataLen - i
        }
        var j: uint = 0
        for ; j < bytesInGroup; {
            var _p3: *u8 = dataPtr + i + j
            var b: u32 = *_p3
            group = group | (b << ((3 - j) * 8))
            j = j + 1
        }
        // 如果不足 4 字节，右侧补零
        if bytesInGroup < 4 {
            var pad: uint = 4 - bytesInGroup
            var p: uint = 0
            for ; p < pad; {
                group = group << 8
                p = p + 1
            }
        }
        // 特殊情况：全零 -> 'u'
        if group == 0 && bytesInGroup == 4 {
            var _p4: *u8 = buf + outPos
            *_p4 = unsafe.cast[u8](117 // 'u')
            outPos = outPos + 1
        } else {
            // 转换为 5 个 base85 数字
            var digits: ptr = memory.malloc(5)
            var v: u32 = group
            var d: int = 4
            for ; d >= 0; {
                var digit: u32 = v % 85
                var _p5: *u8 = digits + d
                *_p5 = unsafe.cast[u8](33 + digit)
                v = v / 85
                d = d - 1
            }
            // 写入字符
            var writeLen: uint = 5
            if bytesInGroup < 4 {
                writeLen = bytesInGroup + 1
            }
            var k: uint = 0
            for ; k < writeLen; {
                var _p6: *u8 = buf + outPos
                var _p7: *u8 = digits + k
                *_p6 = unsafe.cast[u8](*_p7)
                outPos = outPos + 1
                k = k + 1
            }
            memory.free(digits)
        }
        i = i + 4
    }
    // 写入结束标记
    var _p8: *u8 = buf + outPos
    *_p8 = unsafe.cast[u8](126 // '~')
    var _p9: *u8 = buf + outPos + 1
    *_p9 = unsafe.cast[u8](62  // '>')
    outPos = outPos + 2
    var _p10: *u8 = buf + outPos
    *_p10 = unsafe.cast[u8](0)
    ret strings.makeString(buf, outPos, outPos)
}

// decode 将 Ascii85 字符串解码为字节数据
// 接受 <~ ~> 包装或裸编码数据
fn decode(s string) string {
    var sPtr: ptr = strings.toCstring(s)
    var sLen: uint = strings.len(s)
    // 跳过 <~ 前缀
    var start: uint = 0
    var _p11: *u8 = sPtr
    var _p12: *u8 = sPtr + 1
    if sLen >= 2 && *_p11 == 60 && *_p12 == 126 {
        start = 2
    }
    // 跳过 ~> 后缀
    var end: uint = sLen
    var _p13: *u8 = sPtr + end - 2
    var _p14: *u8 = sPtr + end - 1
    if end >= 2 && *_p13 == 126 && *_p14 == 62 {
        end = end - 2
    }
    var encodedLen: uint = end - start
    // 最坏情况：每 5 字符 -> 4 字节
    var buf: ptr = memory.malloc(encodedLen * 4 / 5 + 4)
    var outPos: uint = 0
    var i: uint = start
    for ; i < end; {
        // 收集 5 个字符
        var groupChars: ptr = memory.malloc(5)
        var j: uint = 0
        for ; j < 5; {
            if i + j < end {
                var _p15: *u8 = sPtr + i + j
                var ch: u8 = *_p15
                // 'u' 是特殊值（全零）
                if ch == 117 && j == 0 {
                    // 检查是否为 'u' 单字符组
                    var _p16: *u8 = groupChars
                    *_p16 = unsafe.cast[u8](117)
                    j = 1
                    break
                }
                var _p17: *u8 = groupChars + j
                *_p17 = unsafe.cast[u8](ch - 33)
            } else {
                var _p18: *u8 = groupChars + j
                *_p18 = unsafe.cast[u8](0)
            }
            j = j + 1
        }
        var charsUsed: uint = j
        // 将 5 个 base85 数字转换为 u32
        var value: u32 = 0
        var k: uint = 0
        for ; k < charsUsed; {
            var _p19: *u8 = groupChars + k
            value = value * 85 + *_p19
            k = k + 1
        }
        memory.free(groupChars)
        // 输出字节（大端序）
        var bytesToWrite: uint = charsUsed - 1
        if charsUsed == 1 {
            // 'u' 特殊情况：输出 4 个零字节
            bytesToWrite = 4
            value = 0
        }
        var b: int = 0
        for ; b < bytesToWrite; {
            var shift: int = (3 - b) * 8
            var divisor: int = 1
            var s2: int = 0
            for ; s2 < shift; {
                divisor = divisor * 256
                s2 = s2 + 1
            }
            var byteVal: u8 = (value / divisor) & 255
            var _p20: *u8 = buf + outPos
            *_p20 = unsafe.cast[u8](byteVal)
            outPos = outPos + 1
            b = b + 1
        }
        i = i + 5
    }
    var _p21: *u8 = buf + outPos
    *_p21 = unsafe.cast[u8](0)
    ret strings.makeString(buf, outPos, outPos)
}
