import "std:sort"
import "std:slices"
import "std:memory"
import "std:strings"
// sort package test
// 覆盖当前公开 API：quickSortInts / timsortInts / insertionSortStrings / quickSortStrings
// （旧版引用的 isSortedInts/searchInts/sortInts 已删除）

fn checkIntSorted(s *[]int) bool {
    var n: int = slices.len[int](s)
    var i: int = 0
    for ; i < n - 1; {
        var a: int = 0
        var b: int = 0
        slices.copyOut[int](s, i, &a)
        slices.copyOut[int](s, i + 1, &b)
        if a > b {
            ret false
        }
        i = i + 1
    }
    ret true
}

fn makeStrRow(a ptr, i int, s string) {
    // 先把调用结果落到 VarDecl，再写入裸行：绕开 deref-store 右值调用丢弃缺陷
    var sp: ptr = strings.toCstring(s)
    var sl: uint = strings.len(s)
    var p: *ptr = a + i * 24
    *p = unsafe.cast[ptr](sp)
    var q: *ptr = a + i * 24 + 8
    *q = unsafe.cast[ptr](sl)
    var c: *ptr = a + i * 24 + 16
    *c = unsafe.cast[ptr](sl)
}

fn rowString(a ptr, i int) string {
    var p: *ptr = a + i * 24
    var l: *ptr = a + i * 24 + 8
    var n: uint = unsafe.cast[uint](*l)
    ret strings.makeString(*p, n, n)
}

fn main() int {
    // 1) quickSortInts：基本排序
    var s1: *[]int = slices.make[int](8)
    slices.push[int](s1, 34)
    slices.push[int](s1, 7)
    slices.push[int](s1, 23)
    slices.push[int](s1, 32)
    slices.push[int](s1, 5)
    if !checkIntSorted(s1) {
        // 未排序状态不应通过（哨兵自检）
    } else {
        ret 1
    }
    sort.quickSortInts(s1)
    if !checkIntSorted(s1) {
        ret 2
    }
    var v0: int = 0
    var v4: int = 0
    slices.copyOut[int](s1, 0, &v0)
    slices.copyOut[int](s1, 4, &v4)
    if v0 != 5 || v4 != 34 {
        ret 3
    }

    // 2) timsortInts：含重复值，稳定排序后仍有序
    var s2: *[]int = slices.make[int](6)
    slices.push[int](s2, 3)
    slices.push[int](s2, 1)
    slices.push[int](s2, 3)
    slices.push[int](s2, 2)
    slices.push[int](s2, 1)
    sort.timsortInts(s2)
    if !checkIntSorted(s2) {
        ret 4
    }
    var t0: int = 0
    var t4: int = 0
    slices.copyOut[int](s2, 0, &t0)
    slices.copyOut[int](s2, 4, &t4)
    if t0 != 1 || t4 != 3 {
        ret 5
    }

    // 3) quickSortStrings：裸 24B string 行
    var arr: ptr = memory.malloc(3 * 24)
    makeStrRow(arr, 0, "pear")
    makeStrRow(arr, 1, "apple")
    makeStrRow(arr, 2, "banana")
    sort.quickSortStrings(arr, 3)
    if strings.compare(rowString(arr, 0), "apple") != 0 {
        ret 6
    }
    if strings.compare(rowString(arr, 1), "banana") != 0 {
        ret 7
    }
    if strings.compare(rowString(arr, 2), "pear") != 0 {
        ret 8
    }
    memory.free(arr)

    // 4) insertionSortStrings：前缀串按长度决胜
    var arr2: ptr = memory.malloc(3 * 24)
    makeStrRow(arr2, 0, "abc")
    makeStrRow(arr2, 1, "a")
    makeStrRow(arr2, 2, "ab")
    sort.insertionSortStrings(arr2, 3)
    if strings.compare(rowString(arr2, 0), "a") != 0 {
        ret 9
    }
    if strings.compare(rowString(arr2, 1), "ab") != 0 {
        ret 10
    }
    if strings.compare(rowString(arr2, 2), "abc") != 0 {
        ret 11
    }
    memory.free(arr2)

    ret 42
}
