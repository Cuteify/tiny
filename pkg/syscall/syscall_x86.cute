build os("linux")
build arch("x86")

fn syscall(trap: u32, a1: u32, a2: u32, a3: u32) u32 {
    build asm {
        mov EAX, $trap
        mov EBX, $a1
        mov ECX, $a2
        mov EDX, $a3
        int 0x80
        mov edx, 0
    }
}

fn syscall6(trap: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32) u32 {
    build asm {
        mov EAX, $trap
        mov EBX, $a1
        mov ECX, $a2
        mov EDX, $a3
        mov ESI, $a4
        mov EDI, $a5
        int 0x80
        mov edx, 0
    }
}

fn syscall64(trap: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32) u64 {
    build asm {
        mov EAX, $trap
        mov EBX, $a1
        mov ECX, $a2
        mov EDX, $a3
        mov ESI, $a4
        mov EDI, $a5
        int 0x80
        mov edx, 0
    }
}

// 常用系统调用便捷封装（小驼峰命名，纯 Cuteify 转发）

fn exit(code: i32) {
    syscall(1, code, 0, 0)
}

fn brk(addr: ptr) ptr {
    ret syscall(45, addr, 0, 0)
}

fn write(fd: i32, buf: ptr, count: u64) i32 {
    ret syscall(4, fd, buf, count)
}

fn read(fd: i32, buf: ptr, count: u64) i32 {
    ret syscall(3, fd, buf, count)
}

fn open(pathname: u64, flags: i32, mode: u32) i32 {
    ret syscall(5, pathname, flags, mode)
}

fn close(fd: i32) i32 {
    ret syscall(6, fd, 0, 0)
}

fn lseek(fd: i32, offset: i32, whence: i32) i32 {
    ret syscall(19, fd, offset, whence)
}

fn mkdir(pathname: u64, mode: u32) i32 {
    ret syscall(39, pathname, mode, 0)
}

fn rmdir(pathname: u64) i32 {
    ret syscall(40, pathname, 0, 0)
}

fn unlink(pathname: u64) i32 {
    ret syscall(10, pathname, 0, 0)
}

fn rename(oldpath: u64, newpath: u64) i32 {
    ret syscall(38, oldpath, newpath, 0)
}

fn stat(pathname: u64, statbuf: u64) i32 {
    ret syscall(197, pathname, statbuf, 0)
}

fn fstat(fd: i32, statbuf: u64) i32 {
    ret syscall(197, fd, statbuf, 0)
}

fn getdents(fd: i32, dirp: u32, count: u32) i32 {
    ret syscall(141, fd, dirp, count)
}

// getcwd 获取当前工作目录到 buf，返回 buf 指针（失败返回 0）
fn getcwd(buf: ptr, size: u32) ptr {
    ret syscall(183, buf, size, 0)
}
