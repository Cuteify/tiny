import "std:strings"
import "std:memory"
import "std:syscall"
// pkg/flag/flag.cute - 命令行参数解析包
// 简化实现：支持 --name=value 格式的参数解析
// 注意：Cuteify 没有 os.Args，这里使用全局变量模拟参数输入

// Flag 表示一个命令行标志
type Flag struct {
    name: string
    value: string
    defValue: string
    usage: string
    next: *Flag
}

// flagSet 内部存储结构（链表头 + 计数）
type flagSet struct {
    head: ptr
    count: uint
    capacity: uint
}

// 全局默认 flagSet（用指针而非全局结构体值：编译器对全局结构体字段寻址不可靠）
var defaultSet: *flagSet = 0
var flagSetReady: bool = false

// 全局参数存储（用于模拟 os.Args）
var gArgs: ptr = 0
var gArgCount: uint = 0

// init 初始化默认 flagSet
fn init() {
    defaultSet = memory.malloc(unsafe.cast[uint](sizeof[flagSet]()))
    defaultSet.head = 0
    defaultSet.count = 0
    defaultSet.capacity = 16
}

// ensureInit 保证 flagSet 已初始化
fn ensureInit() {
    if !flagSetReady {
        init()
        flagSetReady = true
    }
}

// setArgs 设置参数（用于模拟 os.Args）
fn setArgs(args: ptr, count: uint) {
    gArgs = args
    gArgCount = count
}

// defineString 定义字符串标志，返回默认值
fn defineString(name: string, value: string, usage: string) string {
    ensureInit()
    if defaultSet.count >= defaultSet.capacity {
        // 扩容（简化实现：不处理扩容）
        ret value
    }

    var f: *Flag = memory.malloc(unsafe.cast[uint](sizeof[Flag]()))
    f.name = name
    f.value = value
    f.defValue = value
    f.usage = usage
    f.next = defaultSet.head
    defaultSet.head = f
    defaultSet.count = defaultSet.count + 1
    ret value
}

// defineInt 定义整数标志，返回默认值
fn defineInt(name: string, value: int, usage: string) int {
    // 将整数转换为字符串存储
    var valueStr: string = strings.toString(value, 10)
    defineString(name, valueStr, usage)
    ret value
}

// defineBool 定义布尔标志，返回默认值
fn defineBool(name: string, value: bool, usage: string) bool {
    // 将布尔值转换为字符串存储
    var valueStr: string = "false"
    if value {
        valueStr = "true"
    }
    defineString(name, valueStr, usage)
    ret value
}

// parse 解析命令行参数（简化：只匹配 --name=value 格式）
fn parse() {
    // 简化实现：实际解析逻辑需要遍历 gArgs
    // 这里只是示例框架
}

// arg 获取位置参数
fn arg(index: int) string {
    if gArgs == 0 || index < 0 || uint(index) >= gArgCount {
        ret ""
    }
    // 从参数数组中获取（简化实现：元素是 NUL 结尾 C 串指针）
    var stride: int = sizeof[ptr]()
    var off: int = index * stride
    var slot: *ptr = gArgs + off
    var argPtr: ptr = *slot
    var argLen: uint = 0
    for ; true; {
        var ch: *u8 = argPtr + argLen
        if *ch == 0 {
            break
        }
        argLen = argLen + 1
    }
    ret strings.view(argPtr, argLen, argLen)
}

// nArgs 返回位置参数数量
fn nArgs() int {
    ret gArgCount
}

// printUsage 打印使用说明
fn printUsage() {
    ensureInit()
    var f: *Flag = defaultSet.head
    var k: uint = 0
    for ; k < defaultSet.count; {
        // 打印标志名
        syscall.write(1, strings.toCstring(f.name), strings.len(f.name))
        syscall.write(1, strings.toCstring("  "), 2)
        // 打印使用说明
        syscall.write(1, strings.toCstring(f.usage), strings.len(f.usage))
        syscall.write(1, strings.toCstring("\n"), 1)
        f = f.next
        k = k + 1
    }
}

// lookup 查找标志的值
fn lookup(name: string) string {
    ensureInit()
    var f: *Flag = defaultSet.head
    var k: uint = 0
    for ; k < defaultSet.count; {
        if strings.eq(f.name, name) {
            ret f.value
        }
        f = f.next
        k = k + 1
    }
    ret ""
}

// getString 获取字符串标志的值
fn getString(name: string) string {
    ret lookup(name)
}

// getInt 获取整数标志的值
fn getInt(name: string) int {
    var valueStr: string = lookup(name)
    if strings.len(valueStr) == 0 {
        ret 0
    }
    ret strings.parse(valueStr, 10)
}

// getBool 获取布尔标志的值
fn getBool(name: string) bool {
    var valueStr: string = lookup(name)
    if strings.eq(valueStr, "true") {
        ret true
    }
    ret false
}
