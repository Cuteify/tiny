import "std:syscall"
// ===== Cuteify Memory Manager v3 — 常量 =====

const TINY_MAX: uint = 1024
const SMALL_MAX: uint = 4096
const MIDDLE_MAX: uint = 65536
const LARGE_MAX: uint = 262144
const CHUNK_SIZE: uint = 65536
const IS_FREE: uint = 1
const PREV_FREE: uint = 2
const RC_BIT: uint = 4    // F1：RC 块标记位（与块大小位分离，杜绝与 LARGE 对齐后大小碰撞）
const FLAG_MASK: uint = 7
const HDR_SIZE: uint = 2
