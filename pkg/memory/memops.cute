import "std:syscall"
// ===== Cuteify Memory Manager v3 — Memory Operations =====
//
// 底层内存操作：memcpy 和 memset。
// 使用 word-size（8B）快拷 + byte 余量的方式，兼顾速度和对齐。

// memcpy 将 src 的 n 字节复制到 dest，返回 dest
// 先按 word（8B）对齐快拷，剩余按 byte 拷贝
// 要求 dest 和 src 至少有 n 字节可访问
fn memcpy(dest: ptr, src: ptr, n: uint) ptr {
    // 先按 word（ptrSize=8）批量拷贝
    var words: uint = n / ptrSize
    var i: uint = 0
    for ; i < words; {
        var dstP: *ptr = dest + ptrSize * i
        var srcP: *ptr = src + ptrSize * i
        *dstP = *srcP
        i = i + 1
    }
    // 剩余不足一个 word 的部分按 byte 拷贝
    var rem: uint = n - ptrSize * words
    var j: uint = 0
    for ; j < rem; {
        var dstB: *u8 = dest + ptrSize * words + j
        var srcB: *u8 = src + ptrSize * words + j
        *dstB = *srcB
        j = j + 1
    }
    ret dest
}

// memset 将 s 指向的 n 字节设为值 c，返回 s
// c==0 走 word 清零快路径（stdlib 清零用途的主力，行为与旧版逐位一致）；
// c!=0 退 byte 循环逐字节设置（F2 修复：旧版 word 路径恒写 0，c 只作用于 byte 尾）
fn memset(s: ptr, c: u8, n: uint) ptr {
    // 快路径：c==0 按 word 批量清零 + byte 余量
    if c == 0 {
        var words: uint = n / ptrSize
        var i: uint = 0
        for ; i < words; {
            var p: *ptr = s + ptrSize * i
            *p = 0
            i = i + 1
        }
        var rem: uint = n - ptrSize * words
        var j: uint = 0
        for ; j < rem; {
            var bp: *u8 = s + ptrSize * words + j
            *bp = c
            j = j + 1
        }
        ret s
    }
    // F2：c!=0 逐字节设置（正确性优先，stdlib 目前无此用途）
    var b: uint = 0
    for ; b < n; {
        var bp2: *u8 = s + b
        *bp2 = c
        b = b + 1
    }
    ret s
}
