build os("linux")
build arch("x86_64")

const ptrSize: uint = 8

fn load8(addr: ptr) u8 {
    build asm {
        mov RAX, $addr
        movzx EAX, byte[RAX]
    }
}

fn load32(addr: ptr) u32 {
    build asm {
        mov RAX, $addr
        mov EAX, [RAX]
    }
}

fn load64(addr: ptr) u64 {
    build asm {
        mov RAX, $addr
        mov RAX, [RAX]
    }
}

fn store8(addr: ptr, val: u8) {
    build asm {
        mov RAX, $addr
        mov CL, $val
        mov [RAX], CL
    }
}

fn store32(addr: ptr, val: u32) {
    build asm {
        mov RAX, $addr
        mov ECX, $val
        mov [RAX], ECX
    }
}

fn store64(addr: ptr, val: u64) {
    build asm {
        mov RAX, $addr
        mov RCX, $val
        mov [RAX], RCX
    }
}