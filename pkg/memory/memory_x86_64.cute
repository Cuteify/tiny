build os("linux")
build arch("x86_64")

const ptrSize: uint = 8

fn load8(addr: ptr) u8 {
    build asm {
        mov RAX, $addr
        movzx EAX, byte[RAX]
    }
}

fn load32(addr: ptr) u32 {
    build asm {
        mov RAX, $addr
        mov EAX, [RAX]
    }
}

fn load64(addr: ptr) u64 {
    build asm {
        mov RAX, $addr
        mov RAX, [RAX]
    }
}

fn store8(addr: ptr, val: u8) {
    build asm {
        mov RAX, $addr
        mov CL, $val
        mov [RAX], CL
    }
}

fn store32(addr: ptr, val: u32) {
    build asm {
        mov RAX, $addr
        mov ECX, $val
        mov [RAX], ECX
    }
}

fn store64(addr: ptr, val: u64) {
    build asm {
        mov RAX, $addr
        mov RCX, $val
        mov [RAX], RCX
    }
}
// ---- 块头字段访问（x86_64 布局：next@p(8B)，size@p+ptrSize(8B)）----

// hdrNext 读块头 next 字段
fn hdrNext(p: ptr) ptr {
    ret load64(p)
}

// hdrSetNext 写块头 next 字段
fn hdrSetNext(p: ptr, v: ptr) {
    store64(p, v)
}

// hdrSizeOf 读块头 size 字段
fn hdrSizeOf(p: ptr) uint {
    ret load64(p + ptrSize)
}

// hdrSetSize 写块头 size 字段
fn hdrSetSize(p: ptr, s: uint) {
    store64(p + ptrSize, s)
}
