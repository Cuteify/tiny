// 空闲块分桶头（块结构：[next: u64][size: u64]，16 字节头）
var gH0: ptr = 0
var gH1: ptr = 0
var gH2: ptr = 0
var gH3: ptr = 0
var gH4: ptr = 0
var gH5: ptr = 0
var gH6: ptr = 0
var gH7: ptr = 0
var gH8: ptr = 0

// slotOf 返回 size(+16 头) 所在桶序号（0..8）
fn slotOf(req: uint) uint {
    if req <= 32 {
        ret 0
    }
    if req <= 48 {
        ret 1
    }
    if req <= 64 {
        ret 2
    }
    if req <= 96 {
        ret 3
    }
    if req <= 128 {
        ret 4
    }
    if req <= 192 {
        ret 5
    }
    if req <= 256 {
        ret 6
    }
    if req <= 384 {
        ret 7
    }
    ret 8
}

// blkSizeOf 返回桶固定块大小
fn blkSizeOf(idx: uint) uint {
    if idx == 0 {
        ret 32
    }
    if idx == 1 {
        ret 48
    }
    if idx == 2 {
        ret 64
    }
    if idx == 3 {
        ret 96
    }
    if idx == 4 {
        ret 128
    }
    if idx == 5 {
        ret 192
    }
    if idx == 6 {
        ret 256
    }
    if idx == 7 {
        ret 384
    }
    ret 512
}

fn headOf(idx: uint) ptr {
    if idx == 0 {
        ret gH0
    }
    if idx == 1 {
        ret gH1
    }
    if idx == 2 {
        ret gH2
    }
    if idx == 3 {
        ret gH3
    }
    if idx == 4 {
        ret gH4
    }
    if idx == 5 {
        ret gH5
    }
    if idx == 6 {
        ret gH6
    }
    if idx == 7 {
        ret gH7
    }
    ret gH8
}

fn setHead(idx: uint, v: ptr) ptr {
    if idx == 0 {
        gH0 = v
        ret 0
    }
    if idx == 1 {
        gH1 = v
        ret 0
    }
    if idx == 2 {
        gH2 = v
        ret 0
    }
    if idx == 3 {
        gH3 = v
        ret 0
    }
    if idx == 4 {
        gH4 = v
        ret 0
    }
    if idx == 5 {
        gH5 = v
        ret 0
    }
    if idx == 6 {
        gH6 = v
        ret 0
    }
    if idx == 7 {
        gH7 = v
        ret 0
    }
    gH8 = v
    ret 0
}

// refill 向堆申请 4096 字节切成固定块填充桶
fn refill(idx: uint, blkSize: uint) ptr {
    var chunk: ptr = syscall.brk(0)
    var nb: ptr = syscall.brk(chunk + 4096)
    if nb < chunk + 4096 {
        ret 0
    }
    store64(chunk + ptrSize, blkSize)
    var head: ptr = chunk
    var prev: ptr = 0
    var p: ptr = chunk
    var end: ptr = chunk + 4096
    for ; p + blkSize <= end; {
        store64(p, 0)
        if prev != 0 {
            store64(prev, p)
        }
        store64(p + ptrSize, blkSize)
        prev = p
        p = p + blkSize
    }
    setHead(idx, head)
    ret chunk
}

// malloc 分配 size 字节，返回数据指针；失败返回 0
fn malloc(size: uint) ptr {
    var req: uint = size + ptrSize * 2
    if req > 512 {
        var old: ptr = syscall.brk(0)
        var nb: ptr = syscall.brk(old + req)
        if nb < old + req {
            ret 0
        }
        store64(old, 0)
        store64(old + ptrSize, req)
        ret old + ptrSize * 2
    }
    var idx: uint = slotOf(req)
    var blkSize: uint = blkSizeOf(idx)
    var head: ptr = headOf(idx)
    if head == 0 {
        head = refill(idx, blkSize)
        if head == 0 {
            ret 0
        }
    }
    var next: ptr = load64(head)
    setHead(idx, next)
    store64(head + ptrSize, blkSize)
    ret head + ptrSize * 2
}

// free 释放 ptr 指向的块：小块回桶，大块且为堆顶则收缩 brk
fn free(ptr: ptr) ptr {
    if ptr == 0 {
        ret 0
    }
    var blk: ptr = ptr - ptrSize * 2
    var size: uint = load64(blk + ptrSize)
    if size > 512 {
        var cur: ptr = syscall.brk(0)
        if blk + size == cur {
            syscall.brk(blk)
        }
        ret 0
    }
    var idx: uint = slotOf(size)
    var head: ptr = headOf(idx)
    store64(blk, head)
    setHead(idx, blk)
}

// realloc 调整 ptr 指向块的大小，返回新指针；失败返回 0（ptr 保持有效）
fn realloc(ptr: ptr, newSize: uint) ptr {
    if ptr == 0 {
        ret malloc(newSize)
    }
    var oldSize: uint = load64(ptr - ptrSize) - ptrSize * 2
    var np: ptr = malloc(newSize)
    if np == 0 {
        ret 0
    }
    var copySize: uint = oldSize
    if copySize > newSize {
        copySize = newSize
    }
    var i: uint = 0
    for ; i < copySize; {
        var b: u8 = load8(ptr + i)
        store8(np + i, b)
        i = i + 1
    }
    free(ptr)
    ret np
}