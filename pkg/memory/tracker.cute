import "std:syscall"
// ===== Cuteify Memory Manager v3 — Leak Tracker =====
//
// RC 泄漏追踪（旧 API，保持兼容）：trackAlloc/trackFree/reportLeaks/reportAllocCount/reportFreeCount
// 全量分配追踪（新 API）：trackAllocAll/trackFreeAll/reportAllLeaks/reportAllAllocCount/reportAllFreeCount
//   由 malloc/free 钩子调用，用于分析普通内存泄漏。

var gAllocCount: uint = 0   // RC 分配次数（兼容）
var gFreeCount: uint = 0    // RC 释放次数（兼容）
var gLeaks: ptr             // RC 未释放指针表（4096*8）
var gLeakSizes: ptr         // RC 未释放大小表（4096*8）
var gLeakCount: uint = 0    // RC 未释放数量

var gAllAllocCount: uint = 0
var gAllFreeCount: uint = 0
var gAllLeaks: ptr           // 全量未释放指针表（4096*8）
var gAllLeakSizes: ptr       // 全量未释放大小表（4096*8）
var gAllLeakCount: uint = 0
var gAllLeakOverflow: uint = 0  // 表满后置 1：禁用幂等守卫，避免误跳过合法释放

var gDropCount: uint = 0
fn dropInc() { gDropCount = gDropCount + 1 }
fn reportDropCount() uint { ret gDropCount }

fn initLeakTracker() {
    if gLeaks != 0 { ret }
    var cur: ptr = syscall.brk(0)
    var total: uint = 65536 + PTR_SIZE * 2
    var nb: ptr = syscall.brk(cur + total)
    if nb < cur + total { ret }
    hdrSetSizeRaw(cur, total)
    hdrSetFooter(cur, total)
    gLeaks = cur + PTR_SIZE
    gLeakSizes = cur + PTR_SIZE + 32768
}

fn initAllLeakTracker() {
    if gAllLeaks != 0 { ret }
    var cur: ptr = syscall.brk(0)
    var total: uint = 65536 + PTR_SIZE * 2
    var nb: ptr = syscall.brk(cur + total)
    if nb < cur + total { ret }
    hdrSetSizeRaw(cur, total)
    hdrSetFooter(cur, total)
    gAllLeaks = cur + PTR_SIZE
    gAllLeakSizes = cur + PTR_SIZE + 32768
}

fn leakLoad(tab: ptr, idx: uint) ptr {
    var _p: *ptr = tab + idx * 8
    ret *_p
}
fn leakStore(tab: ptr, idx: uint, v: ptr) {
    var _p: *ptr = tab + idx * 8
    *_p = v
}
fn leakSizeLoad(tab: ptr, idx: uint) uint {
    var _p: *ptr = tab + idx * 8
    ret unsafe.cast[uint](*_p)
}
fn leakSizeStore(tab: ptr, idx: uint, v: uint) {
    var _p: *ptr = tab + idx * 8
    *_p = unsafe.cast[ptr](v)
}

fn trackAlloc(p: ptr, size: uint) {
    if p == 0 { ret }
    initLeakTracker()
    gAllocCount = gAllocCount + 1
    if gLeakCount < 4096 {
        var cntV: uint = gLeakCount
        leakStore(gLeaks, cntV, p)
        leakSizeStore(gLeakSizes, cntV, size)
        gLeakCount = gLeakCount + 1
    }
}

fn trackFree(p: ptr) {
    if p == 0 { ret }
    initLeakTracker()
    gFreeCount = gFreeCount + 1
    var i: uint = 0
    for ; i < gLeakCount; {
        if leakLoad(gLeaks, i) == p {
            var lastIdx: uint = gLeakCount - 1
            leakStore(gLeaks, i, leakLoad(gLeaks, lastIdx))
            leakSizeStore(gLeakSizes, i, leakSizeLoad(gLeakSizes, lastIdx))
            gLeakCount = gLeakCount - 1
            ret
        }
        i = i + 1
    }
}

fn trackAllocAll(p: ptr, size: uint) {
    if p == 0 { ret }
    initAllLeakTracker()
    gAllAllocCount = gAllAllocCount + 1
    if gAllLeakCount < 4096 {
        var cntV: uint = gAllLeakCount
        leakStore(gAllLeaks, cntV, p)
        leakSizeStore(gAllLeakSizes, cntV, size)
        gAllLeakCount = gAllLeakCount + 1
    } else {
        gAllLeakOverflow = 1
    }
}

fn trackFreeAll(p: ptr) {
    if p == 0 { ret }
    initAllLeakTracker()
    gAllFreeCount = gAllFreeCount + 1
    var i: uint = 0
    for ; i < gAllLeakCount; {
        if leakLoad(gAllLeaks, i) == p {
            var lastIdx: uint = gAllLeakCount - 1
            leakStore(gAllLeaks, i, leakLoad(gAllLeaks, lastIdx))
            leakSizeStore(gAllLeakSizes, i, leakSizeLoad(gAllLeakSizes, lastIdx))
            gAllLeakCount = gAllLeakCount - 1
            ret
        }
        i = i + 1
    }
}

// untrackAll 从全量泄漏表中移除指针，不改变 alloc/free 计数。
// 用于进程生命周期内的永久分配（如 kw/delim 表），避免被误报为泄漏。
fn untrackAll(p: ptr) {
    if p == 0 { ret }
    if gAllLeaks == 0 { ret }
    var i: uint = 0
    for ; i < gAllLeakCount; {
        if leakLoad(gAllLeaks, i) == p {
            var lastIdx: uint = gAllLeakCount - 1
            leakStore(gAllLeaks, i, leakLoad(gAllLeaks, lastIdx))
            leakSizeStore(gAllLeakSizes, i, leakSizeLoad(gAllLeakSizes, lastIdx))
            gAllLeakCount = gAllLeakCount - 1
            ret
        }
        i = i + 1
    }
}

fn reportLeaks() uint { ret gLeakCount }
fn reportAllocCount() uint { ret gAllocCount }
fn reportFreeCount() uint { ret gFreeCount }
fn reportLeakPtr(idx: uint) ptr {
    if idx >= gLeakCount { ret 0 }
    ret leakLoad(gLeaks, idx)
}
fn reportLeakSize(idx: uint) uint {
    if idx >= gLeakCount { ret 0 }
    ret leakSizeLoad(gLeakSizes, idx)
}

fn reportAllLeaks() uint { ret gAllLeakCount }
fn reportAllAllocCount() uint { ret gAllAllocCount }
fn reportAllFreeCount() uint { ret gAllFreeCount }

fn releaseAllLeakTracker() {
    if gAllLeaks == 0 { ret }
    var base: ptr = gAllLeaks - PTR_SIZE
    var raw: uint = hdrSizeRaw(base)
    var pure: uint = raw & ~FLAG_MASK
    hdrSetSizeRaw(base, pure | IS_FREE)
    hdrSetFooter(base, pure | IS_FREE)
    var top: ptr = syscall.brk(0)
    var next: ptr = base + pure
    if next + PTR_SIZE <= top {
        var ns: uint = hdrSizeRaw(next)
        if ns != 0 {
            hdrSetSizeRaw(next, ns | PREV_FREE)
            hdrSetFooter(next, ns | PREV_FREE)
        }
    }
    insertFreeList(base)
    gAllLeaks = 0
    gAllLeakSizes = 0
    gAllLeakCount = 0
    gAllAllocCount = 0
    gAllFreeCount = 0
    gAllLeakOverflow = 0
}

fn releaseLeakTracker() {
    if gLeaks == 0 { ret }
    var base: ptr = gLeaks - PTR_SIZE
    var raw: uint = hdrSizeRaw(base)
    var pure: uint = raw & ~FLAG_MASK
    hdrSetSizeRaw(base, pure | IS_FREE)
    hdrSetFooter(base, pure | IS_FREE)
    var top: ptr = syscall.brk(0)
    var next: ptr = base + pure
    if next + PTR_SIZE <= top {
        var ns: uint = hdrSizeRaw(next)
        if ns != 0 {
            hdrSetSizeRaw(next, ns | PREV_FREE)
            hdrSetFooter(next, ns | PREV_FREE)
        }
    }
    insertFreeList(base)
    gLeaks = 0
    gLeakSizes = 0
    gLeakCount = 0
    gAllocCount = 0
    gFreeCount = 0
}
fn reportAllLeakPtr(idx: uint) ptr {
    if idx >= gAllLeakCount { ret 0 }
    ret leakLoad(gAllLeaks, idx)
}
fn reportAllLeakSize(idx: uint) uint {
    if idx >= gAllLeakCount { ret 0 }
    ret leakSizeLoad(gAllLeakSizes, idx)
}

fn isTrackedAll(p: ptr) bool {
    if p == 0 { ret false }
    if gAllLeaks == 0 { ret false }
    var i: uint = 0
    for ; i < gAllLeakCount; {
        if leakLoad(gAllLeaks, i) == p { ret true }
        i = i + 1
    }
    ret false
}

fn resetLeakTracker() {
    var zeroU: uint = 0
    gAllocCount = zeroU
    gFreeCount = zeroU
    gLeakCount = zeroU
    gAllAllocCount = zeroU
    gAllFreeCount = zeroU
    gAllLeakCount = zeroU
    gAllLeakOverflow = zeroU
    gAllLeaks = 0
    gAllLeakSizes = 0
}
