build os("linux")
build arch("x86")

const ptrSize: uint = 4

fn load8(addr: ptr) u8 {
    build asm {
        mov EAX, $addr
        movzx EAX, byte[EAX]
    }
}

fn load32(addr: ptr) u32 {
    build asm {
        mov EAX, $addr
        mov EAX, [EAX]
    }
}

fn load64(addr: ptr) u64 {
    build asm {
        mov EAX, $addr
        mov EDX, [EAX+4]
        mov EAX, [EAX]
    }
}

fn store8(addr: ptr, val: u8) {
    build asm {
        mov EAX, $addr
        mov ECX, $val
        mov [EAX], CL
    }
}

fn store32(addr: ptr, val: u32) {
    build asm {
        mov EAX, $addr
        mov ECX, $val
        mov [EAX], ECX
    }
}

fn store64(addr: ptr, val: u64) {
    build asm {
        mov EAX, $addr
        mov ECX, $val
        mov [EAX], ECX
        mov ECX, 0
        mov [EAX+4], ECX
    }
}