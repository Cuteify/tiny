build os("linux")
build arch("x86")

const ptrSize: uint = 4

fn load8(addr: ptr) u8 {
    build asm {
        mov EAX, $addr
        movzx EAX, byte[EAX]
    }
}

fn load32(addr: ptr) u32 {
    build asm {
        mov EAX, $addr
        mov EAX, [EAX]
    }
}

fn load64(addr: ptr) u64 {
    build asm {
        mov EAX, $addr
        mov EDX, [EAX+4]
        mov EAX, [EAX]
    }
}

fn store8(addr: ptr, val: u8) {
    build asm {
        mov EAX, $addr
        mov ECX, $val
        mov [EAX], CL
    }
}

fn store32(addr: ptr, val: u32) {
    build asm {
        mov EAX, $addr
        mov ECX, $val
        mov [EAX], ECX
    }
}

fn store64(addr: ptr, val: u64) {
    build asm {
        mov EAX, $addr
        mov ECX, $val
        mov [EAX], ECX
        mov ECX, 0
        mov [EAX+4], ECX
    }
}
// ---- 块头字段访问（x86 布局：next@p(4B)，size@p+ptrSize(4B)）----

// hdrNext 读块头 next 字段
fn hdrNext(p: ptr) ptr {
    ret load32(p)
}

// hdrSetNext 写块头 next 字段
fn hdrSetNext(p: ptr, v: ptr) {
    store32(p, v)
}

// hdrSizeOf 读块头 size 字段
fn hdrSizeOf(p: ptr) uint {
    ret load32(p + ptrSize)
}

// hdrSetSize 写块头 size 字段
fn hdrSetSize(p: ptr, s: uint) {
    store32(p + ptrSize, s)
}
