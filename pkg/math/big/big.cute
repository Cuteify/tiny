// Int 大整数结构体（占位）
type Int struct {
    sign: int      // 符号：1=正，-1=负，0=零
    abs: []uint32  // 绝对值的 32 位块（小端序）
}

// Float 大浮点结构体（占位）
type Float struct {
    sign: int      // 符号
    mantissa: []uint32  // 尾数
    exponent: int  // 指数
}

// newInt 从 int 创建大整数
fn newInt(x: int) Int {
    var r: Int
    r.sign = 0
    if x < 0 {
        r.sign = -1
    } else if x > 0 {
        r.sign = 1
    }
    r.abs = []uint32{}
    if x != 0 {
        var v: uint = 0
        if x < 0 {
            v = strings.toU64(0 - x)
        } else {
            v = strings.toU64(x)
        }
        r.abs = append(r.abs, v & 0xFFFFFFFF)
        if v > 0xFFFFFFFF {
            r.abs = append(r.abs, v >> 32)
        }
    }
    ret r
}

// newFloat 从 f64 创建大浮点（占位实现）
fn newFloat(x: f64) Float {
    var r: Float
    r.sign = 0
    r.mantissa = []uint32{}
    r.exponent = 0
    // TODO: 实现 IEEE 754 解析
    ret r
}

