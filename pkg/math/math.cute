// pkg/math/math.cute - 数学函数库
// 平台无关实现
// 浮点函数需要链接 -lm（gcc -lm 或 nasm+ld -lm）

// abs 返回整数的绝对值
fn abs(x int) int {
    if x < 0 {
        ret 0 - x
    }
    ret x
}

// min 返回两个整数中较小的一个
fn min(a int, b int) int {
    if a < b {
        ret a
    }
    ret b
}

// max 返回两个整数中较大的一个
fn max(a int, b int) int {
    if a > b {
        ret a
    }
    ret b
}

// sqrt 返回 x 的平方根（需要链接 -lm）
fn sqrt(x f64) f64 {
    build ext("sqrt")
}

// pow 返回 x 的 y 次方（需要链接 -lm）
fn pow(x f64, y f64) f64 {
    build ext("pow")
}

// ceil 返回大于等于 x 的最小整数（需要链接 -lm）
fn ceil(x f64) f64 {
    build ext("ceil")
}

// floor 返回小于等于 x 的最大整数（需要链接 -lm）
fn floor(x f64) f64 {
    build ext("floor")
}

// log 返回 x 的自然对数（需要链接 -lm）
fn log(x f64) f64 {
    build ext("log")
}

// log2 返回 x 以 2 为底的对数（需要链接 -lm）
fn log2(x f64) f64 {
    build ext("log2")
}

// log10 返回 x 以 10 为底的对数（需要链接 -lm）
fn log10(x f64) f64 {
    build ext("log10")
}

// sin 返回 x 的正弦值（需要链接 -lm）
fn sin(x f64) f64 {
    build ext("sin")
}

// cos 返回 x 的余弦值（需要链接 -lm）
fn cos(x f64) f64 {
    build ext("cos")
}

// tan 返回 x 的正切值（需要链接 -lm）
fn tan(x f64) f64 {
    build ext("tan")
}

// asin 返回 x 的反正弦值（需要链接 -lm）
fn asin(x f64) f64 {
    build ext("asin")
}

// acos 返回 x 的反余弦值（需要链接 -lm）
fn acos(x f64) f64 {
    build ext("acos")
}

// atan 返回 x 的反正切值（需要链接 -lm）
fn atan(x f64) f64 {
    build ext("atan")
}

// atan2 返回 y/x 的反正切值（需要链接 -lm）
fn atan2(y f64, x f64) f64 {
    build ext("atan2")
}

// exp 返回 e 的 x 次方（需要链接 -lm）
fn exp(x f64) f64 {
    build ext("exp")
}

// pi 返回圆周率 π
fn pi() f64 {
    ret 3.14159265358979323846
}

// e 返回自然常数 e
fn e() f64 {
    ret 2.71828182845904523536
}

// maxFloat64 返回 f64 的最大值
fn maxFloat64() f64 {
    ret 1.7976931348623157e+308
}

// minFloat64 返回 f64 的最小正正规值
fn minFloat64() f64 {
    ret 2.2250738585072014e-308
}

// inf 返回正无穷大
fn inf(sign int) f64 {
    if sign < 0 {
        ret -1.0 / 0.0
    }
    ret 1.0 / 0.0
}

// nan 返回 NaN
fn nan() f64 {
    ret 0.0 / 0.0
}

// isNaN 判断 x 是否为 NaN
fn isNaN(x f64) bool {
    // NaN != NaN
    if x != x {
        ret true
    }
    ret false
}

// isInf 判断 x 是否为无穷大
fn isInf(sign int) f64 {
    // 正无穷: x > 0 且 x * 2 == x
    // 负无穷: x < 0 且 x * 2 == x
    // 这里简化处理，实际需要更精确的判断
    ret 0.0
}

// mod 返回 x 对 y 取模（浮点数版本，需要链接 -lm）
fn mod(x f64, y f64) f64 {
    build ext("fmod")
}

// trunc 返回 x 截断为整数部分（需要链接 -lm）
fn trunc(x f64) f64 {
    build ext("trunc")
}

// round 返回 x 四舍五入到整数（需要链接 -lm）
fn round(x f64) f64 {
    build ext("round")
}

// copysign 返回大小为 |x| 符号为 y 的值（需要链接 -lm）
fn copysign(x f64, y f64) f64 {
    build ext("copysign")
}

// dim 返回 max(x-y, 0)（需要链接 -lm）
fn dim(x f64, y f64) f64 {
    build ext("fdim")
}

// maxFloat64 返回两个 f64 中较大的一个
fn maxFloat64Val(x f64, y f64) f64 {
    build ext("fmax")
}

// minFloat64 返回两个 f64 中较小的一个
fn minFloat64Val(x f64, y f64) f64 {
    build ext("fmin")
}

// cbrt 返回 x 的立方根（需要链接 -lm）
fn cbrt(x f64) f64 {
    build ext("cbrt")
}

// hypot 返回 sqrt(x*x + y*y)（需要链接 -lm）
fn hypot(x f64, y f64) f64 {
    build ext("hypot")
}

// remainder 返回 IEEE 754 余数（需要链接 -lm）
fn remainder(x f64, y f64) f64 {
    build ext("remainder")
}

// add 增加浮点精度（辅助函数）
fn add(x f64, y f64) f64 {
    ret x + y
}

// sub 减少浮点精度（辅助函数）
fn sub(x f64, y f64) f64 {
    ret x - y
}

// mul 乘法（辅助函数）
fn mul(x f64, y f64) f64 {
    ret x * y
}

// div 除法（辅助函数）
fn div(x f64, y f64) f64 {
    ret x / y
}

// eq 判断两个 f64 是否相等（辅助函数）
fn eq(x f64, y f64) bool {
    ret x == y
}

// ne 判断两个 f64 是否不相等（辅助函数）
fn ne(x f64, y f64) bool {
    ret x != y
}

// lt 判断 x < y（辅助函数）
fn lt(x f64, y f64) bool {
    ret x < y
}

// le 判断 x <= y（辅助函数）
fn le(x f64, y f64) bool {
    ret x <= y
}

// gt 判断 x > y（辅助函数）
fn gt(x f64, y f64) bool {
    ret x > y
}

// ge 判断 x >= y（辅助函数）
fn ge(x f64, y f64) bool {
    ret x >= y
}

// neg 返回 -x（辅助函数）
fn neg(x f64) f64 {
    ret 0.0 - x
}

// absF64 返回 f64 的绝对值（辅助函数）
fn absF64(x f64) f64 {
    if x < 0.0 {
        ret 0.0 - x
    }
    ret x
}

// sign 返回 x 的符号：-1, 0, 或 1（辅助函数）
fn sign(x f64) f64 {
    if x < 0.0 {
        ret -1.0
    }
    if x > 0.0 {
        ret 1.0
    }
    ret 0.0
}

// clamp 将 x 限制在 [lo, hi] 范围内（辅助函数）
fn clamp(x f64, lo f64, hi f64) f64 {
    if x < lo {
        ret lo
    }
    if x > hi {
        ret hi
    }
    ret x
}

// lerp 线性插值（辅助函数）
fn lerp(a f64, b f64, t f64) f64 {
    ret a + t*(b-a)
}

// deg2rad 将角度转换为弧度（辅助函数）
fn deg2rad(deg f64) f64 {
    ret deg * pi() / 180.0
}

// rad2deg 将弧度转换为角度（辅助函数）
fn rad2deg(rad f64) f64 {
    ret rad * 180.0 / pi()
}

// gcd 返回两个整数的最大公约数（辅助函数）
fn gcd(a int, b int) int {
    var x: int = abs(a)
    var y: int = abs(b)
    for ; y != 0; {
        var t: int = y
        y = x % y
        x = t
    }
    ret x
}

// lcm 返回两个整数的最小公倍数（辅助函数）
fn lcm(a int, b int) int {
    if a == 0 || b == 0 {
        ret 0
    }
    ret abs(a) / gcd(a, b) * abs(b)
}

// factorial 返回 n 的阶乘（辅助函数，n >= 0）
fn factorial(n int) int {
    if n <= 1 {
        ret 1
    }
    var result: int = 1
    var i: int = 2
    for ; i <= n; {
        result = result * i
        i = i + 1
    }
    ret result
}

// isPrime 判断 n 是否为素数（辅助函数）
fn isPrime(n int) bool {
    if n <= 1 {
        ret false
    }
    if n <= 3 {
        ret true
    }
    if n % 2 == 0 || n % 3 == 0 {
        ret false
    }
    var i: int = 5
    for ; i * i <= n; {
        if n % i == 0 || n % (i + 2) == 0 {
            ret false
        }
        i = i + 6
    }
    ret true
}
