fn leadingZeros[T](x T) int {
    var totalBits: int = sizeof(T) * 8
    if x == 0 {
        ret totalBits
    }
    var n: int = 0
    var v: T = x
    var h: int = totalBits / 2
    for ; h > 0; {
        var thresh: T = 1
        var kk: int = n + h
        for ; kk > 0; {
            thresh = thresh * 2
            kk = kk - 1
        }
        if v < thresh {
            n = n + h
            var shv: T = 1
            var ss: int = h
            for ; ss > 0; {
                shv = shv * 2
                ss = ss - 1
            }
            v = v * shv
        }
        h = h / 2
    }
    ret n
}

fn trailingZeros[T](x T) int {
    var totalBits: int = sizeof(T) * 8
    if x == 0 {
        ret totalBits
    }
    var n: int = 0
    var v: T = x
    var h: int = totalBits / 2
    for ; h > 0; {
        var mask: T = 1
        var sh: int = h
        for ; sh > 0; {
            mask = mask * 2
            sh = sh - 1
        }
        mask = mask - 1
        if v & mask == 0 {
            n = n + h
            var mv: T = 1
            var ms: int = h
            for ; ms > 0; {
                mv = mv * 2
                ms = ms - 1
            }
            v = v / mv
        }
        h = h / 2
    }
    ret n
}

fn onesCount[T](x T) int {
    var v: T = x
    var count: int = 0
    var bits: int = sizeof(T) * 8
    var i: int = 0
    for ; i < bits; {
        count = count + (v & 1)
        v = v >> 1
        i = i + 1
    }
    ret count
}

fn rotateLeft[T](x T, k int) T {
    var totalBits: int = sizeof(T) * 8
    var kk: int = k & (totalBits - 1)
    if kk == 0 {
        ret x
    }
    var mk: T = 1
    var sk: int = kk
    for ; sk > 0; {
        mk = mk * 2
        sk = sk - 1
    }
    var mr: T = 1
    var sr: int = totalBits - kk
    for ; sr > 0; {
        mr = mr * 2
        sr = sr - 1
    }
    ret (x * mk) | (x / mr)
}

fn rotateRight[T](x T, k int) T {
    var totalBits: int = sizeof(T) * 8
    var kk: int = k & (totalBits - 1)
    if kk == 0 {
        ret x
    }
    var mk: T = 1
    var sk: int = kk
    for ; sk > 0; {
        mk = mk * 2
        sk = sk - 1
    }
    var mr: T = 1
    var sr: int = totalBits - kk
    for ; sr > 0; {
        mr = mr * 2
        sr = sr - 1
    }
    ret (x / mk) | (x * mr)
}

fn bitLen[T](x T) int {
    ret sizeof(T) * 8 - leadingZeros(x)
}

fn div[T](x T, y T) T {
    if y == 0 {
        ret 0
    }
    ret x / y
}

fn mod[T](x T, y T) T {
    if y == 0 {
        ret 0
    }
    ret x % y
}

fn leadingZerosU32(x u32) int { ret bits.leadingZeros[u32](x) }
fn trailingZerosU32(x u32) int { ret bits.trailingZeros[u32](x) }
fn onesCountU32(x u32) int { ret bits.onesCount[u32](x) }
fn rotateLeftU32(x u32, k int) u32 { ret bits.rotateLeft[u32](x, k) }
fn rotateRightU32(x u32, k int) u32 { ret bits.rotateRight[u32](x, k) }
fn bitLenU32(x u32) int { ret bits.bitLen[u32](x) }
fn divU32(x u32, y u32) u32 { ret bits.div[u32](x, y) }
fn modU32(x u32, y u32) u32 { ret bits.mod[u32](x, y) }

fn leadingZeros64(x u64) int { ret bits.leadingZeros[u64](x) }
fn trailingZeros64(x u64) int { ret bits.trailingZeros[u64](x) }
fn onesCount64(x u64) int { ret bits.onesCount[u64](x) }
fn rotateLeft64(x u64, k int) u64 { ret bits.rotateLeft[u64](x, k) }
fn rotateRight64(x u64, k int) u64 { ret bits.rotateRight[u64](x, k) }
fn bitLen64(x u64) int { ret bits.bitLen[u64](x) }
fn div64(x u64, y u64) u64 { ret bits.div[u64](x, y) }
fn mod64(x u64, y u64) u64 { ret bits.mod[u64](x, y) }

fn reverse(x u32) u32 {
    var v: u32 = x
    var result: u32 = 0
    var i: int = 0
    for ; i < 32; {
        result = result << 1
        result = result | (v & 1)
        v = v >> 1
        i = i + 1
    }
    ret result
}

fn reverseBytes(x u32) u32 {
    var result: u32 = 0
    var i: int = 0
    for ; i < 4; {
        result = result << 8
        result = result | (x & 255)
        x = x >> 8
        i = i + 1
    }
    ret result
}

fn reverse64(x u64) u64 {
    var v: u64 = x
    var result: u64 = 0
    var i: int = 0
    for ; i < 64; {
        result = result << 1
        result = result | (v & 1)
        v = v >> 1
        i = i + 1
    }
    ret result
}

fn reverseBytes64(x u64) u64 {
    var result: u64 = 0
    var i: int = 0
    for ; i < 8; {
        result = result << 8
        result = result | (x & 255)
        x = x >> 8
        i = i + 1
    }
    ret result
}
