fn main() int {
    // bits.leadingZeros[u32](1) == 31
    if bits.leadingZeros[u32](1) != 31 {
        ret 1
    }

    // bits.trailingZeros[u32](8) == 3
    if bits.trailingZeros[u32](8) != 3 {
        ret 2
    }

    // bits.onesCount[u32](7) == 3
    if bits.onesCount[u32](7) != 3 {
        ret 3
    }

    // bits.reverse[u32](255) == 0xFF000000 (4278190080)
    if bits.reverse[u32](255) != 4278190080 {
        ret 4
    }

    // bits.reverseBytes[u32](16909060) == 67305985
    if bits.reverseBytes[u32](16909060) != 67305985 {
        ret 5
    }

    // bits.rotateLeft[u32](1, 1) == 2
    if bits.rotateLeft[u32](1, 1) != 2 {
        ret 6
    }

    // bits.bitLen[u32](0) == 0
    if bits.bitLen[u32](0) != 0 {
        ret 7
    }

    // bits.bitLen[u32](1) == 1
    if bits.bitLen[u32](1) != 1 {
        ret 8
    }

    // bits.bitLen[u32](255) == 8
    if bits.bitLen[u32](255) != 8 {
        ret 9
    }

    ret 42
}
