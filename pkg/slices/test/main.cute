import "std:slices"
import "std:memory"
import "std:strings"
// pkg/slices/test/main.cute - slices 标准库完整测试
fn main() int {
    var pass: int = 0
    var fail: int = 0

    // test 1: new + len + cap
    var s: *[]int = slices.make[int](8)
    if slices.len[int](s) != 0 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    if slices.cap[int](s) < 8 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 2: push + len
    slices.push[int](s, 10)
    slices.push[int](s, 20)
    slices.push[int](s, 30)
    if slices.len[int](s) != 3 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 3: getPtr + copyOut
    var v: int = 0
    slices.copyOut[int](s, 0, &v)
    if v != 10 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.copyOut[int](s, 2, &v)
    if v != 30 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 4: set
    slices.set[int](s, 1, 99)
    slices.copyOut[int](s, 1, &v)
    if v != 99 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 5: pop（取尾部，此时尾部为 index2=30）
    var popped: int = slices.pop[int](s)
    if popped != 30 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    if slices.len[int](s) != 2 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 6: insert
    slices.insert[int](s, 1, 55)
    if slices.len[int](s) != 3 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.copyOut[int](s, 1, &v)
    if v != 55 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 7: remove
    var removed: int = slices.remove[int](s, 1)
    if removed != 55 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 8: find
    slices.clear[int](s)
    slices.push[int](s, 100)
    slices.push[int](s, 200)
    slices.push[int](s, 300)
    var idx: int = slices.find[int](s, 200)
    if idx != 1 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    idx = slices.find[int](s, 999)
    if idx != -1 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 9: contains
    if !slices.contains[int](s, 300) {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    if slices.contains[int](s, 999) {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 10: reverse
    slices.clear[int](s)
    slices.push[int](s, 1)
    slices.push[int](s, 2)
    slices.push[int](s, 3)
    slices.reverse[int](s)
    slices.copyOut[int](s, 0, &v)
    if v != 3 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.copyOut[int](s, 2, &v)
    if v != 1 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }

    // test 11: clone + equal（深拷贝独立扰动；equal 逐元素）
    var c: *[]int = slices.clone[int](s)
    if !slices.equal[int](s, c) {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.set[int](c, 0, 99)
    if slices.equal[int](s, c) {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.free[int](c)

    // test 12: copy（min(len) 语义 + 覆盖校验）
    var d: *[]int = slices.make[int](2)
    slices.push[int](d, 0)
    slices.push[int](d, 0)
    var moved: int = slices.copy[int](d, s)
    if moved != 2 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.copyOut[int](d, 0, &v)
    if v != 3 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.free[int](d)

    // test 13: join（两段 sep 相接）
    var sa: *[]int = slices.make[int](2)
    slices.push[int](sa, 1)
    slices.push[int](sa, 2)
    var sp: *[]int = slices.make[int](1)
    slices.push[int](sp, 0)
    var sb: *[]int = slices.make[int](2)
    slices.push[int](sb, 3)
    slices.push[int](sb, 4)
    var j: *[]int = slices.join[int](sa, sp, sb)
    if slices.len[int](j) != 5 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.copyOut[int](j, 2, &v)
    if v != 0 {
        fail = fail + 1
    } else {
        pass = pass + 1
    }
    slices.free[int](j)
    slices.free[int](sa)
    slices.free[int](sp)
    slices.free[int](sb)

    slices.free[int](s)

    // 结果：pass*10 + fail
    ret pass * 10 + fail
}
