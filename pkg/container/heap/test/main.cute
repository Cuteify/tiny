import "std:container/heap"
import "std:memory"
import "std:strings"
fn main() int {
    var failures: int = 0

    // Create a new min-heap
    var h: *heap.Heap = heap.new()

    // Test len on empty heap
    if heap.len(h) != 0 {
        failures = failures + 1
    }

    // push several values
    heap.push(h, 5)
    heap.push(h, 3)
    heap.push(h, 8)
    heap.push(h, 1)
    heap.push(h, 4)

    // Test len after pushes
    if heap.len(h) != 5 {
        failures = failures + 1
    }

    // pop should return smallest first (min-heap property)
    var v1: int = heap.pop(h)
    if v1 != 1 {
        failures = failures + 1
    }

    var v2: int = heap.pop(h)
    if v2 != 3 {
        failures = failures + 1
    }

    var v3: int = heap.pop(h)
    if v3 != 4 {
        failures = failures + 1
    }

    var v4: int = heap.pop(h)
    if v4 != 5 {
        failures = failures + 1
    }

    var v5: int = heap.pop(h)
    if v5 != 8 {
        failures = failures + 1
    }

    // Test len after all pops
    if heap.len(h) != 0 {
        failures = failures + 1
    }

    // pop from empty heap should return 0
    var v6: int = heap.pop(h)
    if v6 != 0 {
        failures = failures + 1
    }

    if failures == 0 {
        syscall.exit(42)
    }
    syscall.exit(1)
}
