import "std:container/list"
import "std:memory"
import "std:strings"
fn main() int {
    var failures: int = 0

    // Create a new list
    var l: *list.List = list.new()

    // Test len on empty list
    if list.len(l) != 0 {
        failures = failures + 1
    }

    // pushBack some values using malloc'd storage
    var vp1: ptr = memory.malloc(8)
    var _p1: *ptr = vp1
    *_p1 = unsafe.cast[ptr](10)
    list.pushBack(l, vp1)

    var vp2: ptr = memory.malloc(8)
    var _p2: *ptr = vp2
    *_p2 = unsafe.cast[ptr](20)
    list.pushBack(l, vp2)

    var vp3: ptr = memory.malloc(8)
    var _p3: *ptr = vp3
    *_p3 = unsafe.cast[ptr](30)
    list.pushBack(l, vp3)

    // Test len
    if list.len(l) != 3 {
        failures = failures + 1
    }

    // Test front value
    var front: *list.Element = list.front(l)
    var _p4: *ptr = front.value
    var frontVal: u64 = *_p4
    if frontVal != 10 {
        failures = failures + 1
    }

    // Test back value
    var back: *list.Element = list.back(l)
    var _p5: *ptr = back.value
    var backVal: u64 = *_p5
    if backVal != 30 {
        failures = failures + 1
    }

    // pushFront a value
    var vp0: ptr = memory.malloc(8)
    var _p6: *ptr = vp0
    *_p6 = unsafe.cast[ptr](5)
    list.pushFront(l, vp0)

    // len should be 4 now
    if list.len(l) != 4 {
        failures = failures + 1
    }

    // front should now be 5
    var newFront: *list.Element = list.front(l)
    var _p7: *ptr = newFront.value
    var newFrontVal: u64 = *_p7
    if newFrontVal != 5 {
        failures = failures + 1
    }

    // Remove front element
    var removed: ptr = list.removeFn(l, newFront)
    var _p8: *ptr = removed
    var removedVal: u64 = *_p8
    if removedVal != 5 {
        failures = failures + 1
    }

    // len should be 3 after removal
    if list.len(l) != 3 {
        failures = failures + 1
    }

    if failures == 0 {
        syscall.exit(42)
    }
    syscall.exit(1)
}
